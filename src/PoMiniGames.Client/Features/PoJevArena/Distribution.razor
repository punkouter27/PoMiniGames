@using System.Globalization

@* One Jev choice distribution as sorted probability bars; the chosen option is highlighted. The
   bars are decorative — each row also states its number, so nothing depends on bar length. *@
<div class="jev-dist">
    <h3 class="jev-kicker">@Title</h3>
    @foreach (var (option, p) in Sorted)
    {
        <div class="jev-dist__row @(option == Chosen ? "is-chosen" : null)">
            <span class="jev-dist__label">@option</span>
            <span class="jev-dist__bar" aria-hidden="true"><span style="--pct: @((p * 100).ToString("0", CultureInfo.InvariantCulture))%"></span></span>
            <span class="jev-dist__value">@p.ToString("0.00", CultureInfo.InvariantCulture)</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public Dictionary<string, double>? Values { get; set; }
    [Parameter] public string? Chosen { get; set; }

    private IEnumerable<(string Option, double P)> Sorted =>
        (Values ?? []).OrderByDescending(kv => kv.Value).Select(kv => (kv.Key, kv.Value));
}
