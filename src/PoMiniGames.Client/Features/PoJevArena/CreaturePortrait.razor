@using System.Text.Json
@using PoMiniGames.Shared.Games.PoJevArena
@inject IJSRuntime JS
@implements IAsyncDisposable

@* One creature drawn by the arena engine: a still portrait (library cards, roster slots), or the
   Factory's looping preview that cycles idle → move → strike → ability → defense. *@
<canvas id="@_id" class="jev-portrait @Class" role="img" aria-label="@($"{Creature?.Name ?? "Empty slot"} portrait")"></canvas>

@code {
    [Parameter, EditorRequired] public ArenaCreature? Creature { get; set; }
    [Parameter] public string Team { get; set; } = "blue";
    [Parameter] public bool Animated { get; set; }
    [Parameter] public string? Class { get; set; }

    private readonly string _id = "jevp-" + Guid.NewGuid().ToString("N")[..10];
    private string? _drawnKey;
    private int _previewId;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || Creature is null) return;
        var json = JsonSerializer.Serialize(Creature, PoJevArenaJsonContext.Default.ArenaCreature);
        var key = $"{Team}|{Animated}|{json}";
        if (key == _drawnKey) return;
        _drawnKey = key;

        try
        {
            if (!await JS.InvokeAsync<bool>("loadEngine", "pojevarena")) return;
            if (_previewId != 0) await JS.InvokeVoidAsync("PoJevArena.stopPreview", _previewId);
            _previewId = 0;
            if (Animated) _previewId = await JS.InvokeAsync<int>("PoJevArena.preview", _id, json, Team);
            else await JS.InvokeVoidAsync("PoJevArena.portrait", _id, json, Team);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_previewId == 0) return;
        try { await JS.InvokeVoidAsync("PoJevArena.stopPreview", _previewId); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }
}
