@using System.Globalization

@* A labelled range input with its value spelled out, so the number never depends on the thumb. *@
<label class="jev-field jev-slider">
    <span class="jev-slider__row"><span>@Label</span><strong>@Show(Value)@Unit</strong></span>
    <input type="range" min="@Inv(Min)" max="@Inv(Max)" step="@Inv(Step)" value="@Inv(Value)"
           @oninput="e => ValueChanged.InvokeAsync(double.Parse(e.Value?.ToString() ?? Inv(Min), CultureInfo.InvariantCulture))" />
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public double Value { get; set; }
    [Parameter] public double Min { get; set; }
    [Parameter] public double Max { get; set; }
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public EventCallback<double> ValueChanged { get; set; }

    private static string Inv(double v) => v.ToString(CultureInfo.InvariantCulture);
    private string Show(double v) => Step >= 1 ? v.ToString("0", CultureInfo.InvariantCulture) : v.ToString("0.0", CultureInfo.InvariantCulture);
}
