@page "/pobrawl/multi"
@using System.Globalization
@using PoMiniGames.Shared.Games
@using PoMiniGamesClient.Features.Shared
@using PoBrawlFighter = PoMiniGames.Domain.Primitives.PoBrawlFighter
@using PoBrawlRoster = PoMiniGames.Domain.Primitives.PoBrawlRoster
@inject NavigationManager Nav
@inject ApiService Api
@inject ToastService ToastService
@inject PoBrawlDossierService Dossiers
@inject IBrowserStorage Storage
@implements IDisposable

<PageTitle>Brawl · Lobby · PoMiniGames</PageTitle>

@* Every way into a game opens on the same card: the opening card sits in front of the
   lobby, and the seat is taken when it is dismissed. The fighter is picked on that card
   (Setup, by face) and remembered, so the lobby itself asks for one thing: Ready. *@
<GameShell Title="@TitleContent" BackTo="/">
@* .pbl-room: this page's handle on the shared LobbyPanel (see the .razor.css). *@
<div class="pbl-room">
@if (!_introDone)
{
    <GameIntro CueScope="pobrawl"
               Title="@TitleContent"
               Objective="Real-time 1v1 in the arena — one 60-second round."
               Controls="@IntroKeys"
               OnStart="OnIntroStartAsync" />
}
else if (_failed is { } why)
{
    <InlineError Message="@why" OnRetry="ConnectAsync" RetryLabel="Try again" />
}
else
{
    @* 1v1: your seat and your opponent's on one row, one sentence above them that says what
       the room is waiting on, and one Ready button below. Both ready counts down from three
       and the host's client starts the fight; nobody has to find a Start button.
       HubPath carries this build's online version: the hub refuses one it cannot play with. *@
    <OnlineLobby TPlayer="PoBrawlLobbyPlayer"
                 HubPath="@HubPath"
                 Hint=""
                 MaxPlayersHint="2"
                 StartLabel="Start fight"
                 ShowReady="true"
                 HostReadies="true"
                 UnreadyLabel="Cancel Ready"
                 ShowStart="false"
                 ShowInvite="false"
                 QuietWhenConnected="true"
                 Heading="@Sentence"
                 OnClient="OnClientAsync"
                 OnStateChanged="OnLobbyStateAsync"
                 OnGameStarted="OnGameStarted"
                 OnLeave="LeaveAsync">
        <Picker>
            @* .pb-lobby only carries the --pb-* tokens; the .razor.css flattens it. *@
            <div class="pb-lobby">
                @* A watcher of an empty room (an old build asked to reload) is shown no seats:
                   two "open seat" cards beside "you cannot join" would contradict it. *@
                @if (_lobby?.State is { } room && (_lobby.Me is not null || room.Players.Count > 0))
                {
                    var me = _lobby.Me;
                    // Seated: you on the left, whoever else on the right. Watching (refused, or
                    // the seat moved to another tab): the two seats as the room has them.
                    var left = me ?? room.Players.ElementAtOrDefault(0);
                    var right = me is not null ? Opponent : room.Players.ElementAtOrDefault(1);
                    <div class="pb-select" data-stage="off">
                        <div class="pb-select-sides pbl-seats">
                            @SeatCard(left, 1, me is not null)
                            <span class="pb-select-vs" aria-hidden="true">VS</span>
                            @SeatCard(right, 2, false)
                        </div>
                    </div>
                    @if (me is not null)
                    {
                        <label class="lobby-inline-opt">
                            <span>Fighter</span>
                            <select aria-label="Fighter" value="@_pick" @onchange="OnFighterChangedAsync">
                                @foreach (var fighter in RosterForPicker)
                                {
                                    <option value="@fighter.Id">@fighter.Name</option>
                                }
                            </select>
                        </label>
                    }
                }
            </div>
        </Picker>
    </OnlineLobby>
}
</div>
</GameShell>

@code {
    private const string PickKey = "pominigames:pobrawl-online-fighter";
    private const int CountdownSeconds = 3;

    // The hub refuses a browser whose online version is not the server's (PoBrawlLobbyHub).
    private static readonly string HubPath =
        $"pobrawl/lobby-hub?v={PoBrawlRollbackSim.WireVersion.ToString(CultureInfo.InvariantCulture)}";

    private LobbyClient<PoBrawlLobbyPlayer>? _lobby;   // handed out by OnlineLobby
    private string? _failed;   // why the server could not be reached; the retry card shows it

    private bool _introDone;

    // The fighter chosen on the start card (or in the lobby), remembered between visits and sent
    // to the hub once this browser holds a seat.
    private string _pick = PoBrawlRoster.Bob.Id;
    private string? _pickAsked;   // the id already sent for the seat held now

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (PoBrawlRoster.Find(await Storage.GetItemAsStringAsync(PickKey)) is { } saved) _pick = saved.Id;
        }
        catch (Exception) { /* storage blocked: Bob it is */ }
        // The faces. Presentation: without them every tile keeps its lettered disc.
        _ = LoadFacesAsync();
    }

    private async Task LoadFacesAsync()
    {
        if (await Dossiers.EnsureLoadedAsync()) StateHasChanged();
    }

    // The opening card was dismissed. The lobby card goes up first, saying "connecting…",
    // once the availability probe passes.
    private async Task OnIntroStartAsync()
    {
        _introDone = true;
        StateHasChanged();
        await ConnectAsync();
    }

    private static RenderFragment TitleContent => GameCatalog.TitleFor(GameKeys.PoBrawl);
    private static RenderFragment IntroKeys => @<PoBrawlControls Mode="online" Part="keys" />;

    // One seat: a face, who it is, the fighter and whether it is ready.
    // An empty seat is the invitation.
    private RenderFragment SeatCard(PoBrawlLobbyPlayer? p, int side, bool mine) => @<div class="pb-select-side pb-select-side--p@(side) pb-select-side--static pbl-seat @(p?.IsReady == true ? "pb-select-side--locked" : "") @(p is null ? "pbl-seat--open" : "")"
                                                                                         data-seat="@(mine ? "you" : p is null ? "open" : "taken")">
        @if (p is null)
        {
            <span class="pb-select-who">Open seat</span>
            @if (_lobby?.Me is not null)
            {
                <InviteLink Label="Invite a friend" />
            }
        }
        else
        {
            <span class="pbl-face" aria-hidden="true">
                <span>@FighterName(p.Fighter.Id)[..1]</span>
                @if (FaceOf(p.Fighter.Id) is { Length: > 0 } src && !_faceFailed.Contains(p.Fighter.Id))
                {
                    <img src="@src" alt="" decoding="async" referrerpolicy="no-referrer" @onerror="() => _faceFailed.Add(p.Fighter.Id)" />
                }
            </span>
            <span class="pbl-seat-text">
                <span class="pb-select-who">@(mine ? "You" : LeaderboardNames.Pretty(p.DisplayName))</span>
                <span class="pb-select-pick">@FighterName(p.Fighter.Id)</span>
                <span class="pb-select-state">@if (p.IsReady) { <span class="material-symbols-outlined" aria-hidden="true">check</span> }@(p.IsReady ? "Ready" : "Not ready")</span>
            </span>
            @if (p.IsReady)
            {
                <span class="pb-select-seal" aria-hidden="true">@PoBrawlPage.SealSvg</span>
            }
        }
    </div>;

    // Picker order: 1P avatar first, then the presidents roster in ladder order.
    private static readonly IReadOnlyList<PoBrawlFighter> RosterForPicker =
        new[] { PoBrawlRoster.Bob }.Concat(PoBrawlRoster.Fighters).ToList();

    // An id this build no longer knows still renders, as itself.
    private static string FighterName(string id) => PoBrawlRoster.NameOf(id) ?? id;

    private readonly HashSet<string> _faceFailed = [];

    private string? FaceOf(string fighterId) => Dossiers.Peek(fighterId)?.ThumbnailUrl;

    private bool EveryoneReady =>
        _lobby?.State is { } s && _lobby.Me is not null && s.Players.Count == s.MaxPlayers && s.Players.All(p => p.IsReady);

    private bool MyReady => _lobby?.IsReady ?? false;
    private PoBrawlLobbyPlayer? Opponent => _lobby?.State?.Players.FirstOrDefault(p => p.ConnectionId != _lobby.ConnectionId);

    // ── The one sentence ─────────────────────────────────────────────────────────
    // What the room is waiting on and what to press, in place of "Players · 1/2", a hint line,
    // "Picking" and "Seat open". A refusal or a lost seat is worded by OnlineLobby instead.
    private RenderFragment Sentence => @<span>@SentenceText</span>;

    private string SentenceText
    {
        get
        {
            if (_lobby?.State is not { } room) return "Finding the room…";
            if (_lobby.Me is null) return room.Players.Count >= room.MaxPlayers ? "The room is full." : "Taking a seat…";
            if (_countdown is { } n) return n > 0 ? $"Both ready. Fight in {n}…" : "Starting the fight…";
            if (Opponent is not { } opp) return MyReady ? "You're ready. Waiting for an opponent…" : "Press Ready. The fight starts when an opponent is ready too.";
            var who = LeaderboardNames.Pretty(opp.DisplayName);
            if (MyReady) return $"Waiting for {who} to press Ready…";
            return opp.IsReady ? $"{who} is ready. Press Ready to fight." : $"{who} is here. Press Ready to fight.";
        }
    }

    // ── Both ready: three, two, one ──────────────────────────────────────────────
    // Each browser counts for itself from the state that made both seats ready, and the host's
    // starts the fight at zero. Un-readying (the Ready button now reads "Cancel Ready") calls it off.
    private CancellationTokenSource? _count;
    private int? _countdown;   // seconds left; 0 once the count ran out and the start is on its way

    private Task OnClientAsync(LobbyClient<PoBrawlLobbyPlayer> client)
    {
        _lobby = client;
        // The sentence and the seats already show a join, a pick and a ready; only someone
        // leaving changes the room in a way worth a line of its own.
        client.EventReceived += ev => { if (ev.Kind == "left") ToastService.Show(ev.Message, ToastType.Warning); };
        return Task.CompletedTask;
    }

    private async Task OnLobbyStateAsync(LobbyState<PoBrawlLobbyPlayer> room)
    {
        if (_lobby?.Me is null) _pickAsked = null;
        if (!EveryoneReady)
        {
            StopCountdown();
            await SyncPickAsync();
            return;
        }
        if (_count is null && _countdown is null) _ = CountDownAsync();
    }

    private async Task CountDownAsync()
    {
        var count = _count = new CancellationTokenSource();
        try
        {
            for (var n = CountdownSeconds; n > 0; n--)
            {
                _countdown = n;
                StateHasChanged();
                await Task.Delay(1000, count.Token);
            }
            _countdown = 0;
            StateHasChanged();
            if (_lobby is { IsHost: true } && EveryoneReady) await _lobby.StartGameAsync();
        }
        catch (OperationCanceledException) { /* someone un-readied or left */ }
        catch (Exception ex)
        {
            _countdown = null;
            ToastService.Show(PoBrawlNetSession.HubMessage(ex, "Couldn't start the fight."), ToastType.Warning);
            StateHasChanged();
        }
        finally
        {
            if (ReferenceEquals(_count, count)) _count = null;
            count.Dispose();
        }
    }

    private void StopCountdown()
    {
        _count?.Cancel();
        _count = null;
        _countdown = null;
    }

    // ── The pick ─────────────────────────────────────────────────────────────────
    private async Task OnFighterChangedAsync(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(id)) return;
        _pick = id;
        await RememberPickAsync();
        await SyncPickAsync();
    }

    private async Task RememberPickAsync()
    {
        try { await Storage.SetItemAsStringAsync(PickKey, _pick); }
        catch (Exception) { /* storage blocked: the pick lasts this visit */ }
    }

    /// <summary>Send the remembered pick once per seat (a new seat starts as the 1P avatar).</summary>
    private async Task SyncPickAsync()
    {
        if (_lobby?.Me is not { } me) return;
        if (string.Equals(me.Fighter.Id, _pick, StringComparison.OrdinalIgnoreCase) || _pickAsked == _pick) return;
        _pickAsked = _pick;
        try { await _lobby.SendAsync("PickFighter", _pick); }
        catch (Exception ex) { ToastService.Show(PoBrawlNetSession.HubMessage(ex, "Couldn't change fighter."), ToastType.Warning); }
    }

    private async Task ConnectAsync()
    {
        _failed = null;
        StateHasChanged();
        if (!await Api.IsAvailableAsync())
        {
            _failed = "The server isn't answering right now, so there's no lobby to join.";
            StateHasChanged();
        }
    }

    private void OnGameStarted(OnlineLobbyStart start) =>
        Nav.NavigateTo($"/pobrawl/online?code={Uri.EscapeDataString(start.MatchCode)}");

    private void LeaveAsync() => Nav.NavigateTo("/");

    public void Dispose() => StopCountdown();
}
