@namespace PoMiniGamesClient.Features.PoBrawl
@inject SettingsService Settings
@implements IDisposable

@* ─────────────────────────────────────────────────────────────────────────
   The Brawl row of the settings sheet (its "Games" fieldset): how much show a fight puts on.

   Simple (the default) is the fight and one result card: the fixed ringside camera, no instant
   replay, no balloon drop, LED boards, frosted result glass, KO shatter, pyro or belt ceremony,
   and no campaign-map interlude between ladder rungs. Full turns all of that on, with the
   director's TV cuts in the CPU-only modes (Demo and the Cup).

   Stored as a plain localStorage value (pominigames:pobrawl-show = "full" | "simple") so the engine
   (js/pobrawl/show.js fullShow) reads it directly, like the other engine-facing settings.
   It applies from the next fight the engine boots; a running one keeps what it started with.
   ───────────────────────────────────────────────────────────────────────── *@

<div class="prefs-row">
    <div class="prefs-label">
        <span class="prefs-name">Brawl show</span>
        <span class="prefs-hint">Full adds replays, balloons, LED boards, TV camera cuts and the belt ceremony.</span>
    </div>
    <div class="app-seg" role="radiogroup" aria-label="Brawl show">
        <button type="button" role="radio" class="app-seg__btn" aria-checked="@Aria(!_full)" @onclick="() => Set(false)">Simple</button>
        <button type="button" role="radio" class="app-seg__btn" aria-checked="@Aria(_full)" @onclick="() => Set(true)">Full</button>
    </div>
</div>

@code {
    /// <summary>The localStorage key; js/pobrawl/show.js reads the same one.</summary>
    public const string StorageKey = "pominigames:pobrawl-show";

    /// <summary>True when the player chose the Full show. Anything else, a missing key included, is Simple.</summary>
    public static bool IsFull => LocalStorageService.GetItem<string>(StorageKey) == "full";

    private bool _full;

    private static string Aria(bool value) => value ? "true" : "false";

    // Read when the sheet opens, never on mount: the sheet is in every page's layout.
    protected override void OnInitialized() => Settings.OpenRequested += OnOpenRequested;

    public void Dispose() => Settings.OpenRequested -= OnOpenRequested;

    private void OnOpenRequested() => InvokeAsync(() =>
    {
        _full = IsFull;
        StateHasChanged();
    });

    private void Set(bool full)
    {
        _full = full;
        LocalStorageService.SetItem(StorageKey, full ? "full" : "simple");
    }
}
