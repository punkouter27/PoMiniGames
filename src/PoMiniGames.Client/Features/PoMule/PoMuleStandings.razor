@namespace PoMiniGamesClient.Features.PoMule
@using PoMiniGames.Shared.Games.PoMule
@inject DialogService Dialogs
@inject IJSRuntime JS
@implements IDisposable

@* Phase 6 of every month, and the final results: who is worth what, how each colonist's
   Net Worth has moved, and whether the colony as a whole is holding together.

   While a human is playing (Modal = true), opens via Radzen DialogService.OpenAsync so focus
   is trapped inside it and Space/Enter/Escape on "Next month" carries on. A demo nobody is
   driving renders inline so the speed buttons and top bar stay interactive. *@
@if (!Modal)
{
    <div class="pm-standings pm-standings--inline" role="region" aria-labelledby="pm-standings-title">
        @StandingsCard
    </div>
}

@code {
    [Parameter, EditorRequired] public MatchState State { get; set; } = null!;
    [Parameter, EditorRequired] public List<PoMuleRow> Rows { get; set; } = [];
    [Parameter] public bool Final { get; set; }
    [Parameter] public bool CanContinue { get; set; }
    [Parameter] public EventCallback OnContinue { get; set; }
    [Parameter] public EventCallback OnQuit { get; set; }

    private ElementReference _dialog;
    private bool _narrow;
    private bool _confirmQuit;
    private bool _dialogOpen;

    // A human's match: the table blocks the board until they carry on.
    private bool Modal => CanContinue;

    private RenderFragment StandingsModal => @<div @ref="_dialog" class="pm-standings pm-standings--modal" role="dialog" aria-modal="true"
             aria-labelledby="pm-standings-title" @onkeydown="OnKeyDownAsync">
        @StandingsCard
        <PoDialogLifecycle OnMounted="OnDialogMountedAsync" />
    </div>;

    private RenderFragment StandingsCard => @<text>
        <RadzenMediaQuery Query="(max-width: 640px)" Change="OnNarrowChanged" />
        <RadzenCard Variant="Variant.Filled" class="pm-standings-card">
            <div class="pm-standings-head">
                <h2 class="pm-standings-title" id="pm-standings-title">@(Final ? "Final results" : $"Month {State.Month} standings")</h2>
                <RadzenBadge BadgeStyle="@(Survives ? BadgeStyle.Success : BadgeStyle.Danger)"
                             Text="@ColonyLine" />
            </div>

            <div class="pm-standings-body">
                <RadzenDataGrid Data="@Rows" TItem="PoMuleRow" Density="Density.Compact" AllowSorting="false" AllowPaging="false" class="pm-standings-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="PoMuleRow" Title="#" Width="40px">
                            <Template Context="r">@r.Rank</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PoMuleRow" Title="Colonist">
                            <Template Context="r">
                                <span class="pm-dot" style="background: @r.Color"></span>
                                <span>@r.Name</span>
                                @if (Final && r.Rank == 1)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="First Founder" class="rz-ml-2" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PoMuleRow" Title="Species" Width="150px" Visible="@(!_narrow)">
                            <Template Context="r">@r.SpeciesName</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PoMuleRow" Title="Plots" Width="60px" TextAlign="TextAlign.Right">
                            <Template Context="r">@r.Plots</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PoMuleRow" Title="Net Worth" Width="110px" TextAlign="TextAlign.Right">
                            <Template Context="r"><strong>@r.NetWorth.ToString("N0")</strong></Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>

                @if (State.History.Count > 1)
                {
                    <RadzenChart Style="height: clamp(110px, 22vh, 175px)">
                        @foreach (var p in State.Players)
                        {
                            var seat = p.Seat;
                            <RadzenLineSeries Data="@Line(seat)" CategoryProperty="Month" ValueProperty="Worth" Title="@p.Name"
                                              Stroke="@PoMuleUi.SeatColors[seat]" StrokeWidth="@(seat == 0 ? 4 : 2)" />
                        }
                        <RadzenCategoryAxis Step="1" />
                        <RadzenValueAxis>
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                        <RadzenLegend Visible="false" />
                    </RadzenChart>
                }
            </div>

            @if (!Final && CanContinue)
            {
                <div class="pm-standings-actions">
                    <RadzenButton Text="Next month" ButtonStyle="ButtonStyle.Warning" autofocus
                                  Click="@(_ => OnContinue.InvokeAsync())" />
                    <span class="pm-standings-hint">or press Space</span>
                    @if (OnQuit.HasDelegate)
                    {
                        @if (_confirmQuit)
                        {
                            <RadzenButton Text="Confirm new game" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                          Click="@(_ => OnQuit.InvokeAsync())" />
                            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                                          Click="@(_ => SetConfirmQuit(false))" />
                        }
                        else
                        {
                            <RadzenButton Text="Quit &amp; new game" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                                          Click="@(_ => SetConfirmQuit(true))" />
                        }
                    }
                </div>
            }
        </RadzenCard>
    </text>;

    protected override void OnInitialized() => Dialogs.OnClose += OnDialogClosed;

    protected override void OnParametersSet()
    {
        if (_dialogOpen) Dialogs.Refresh();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Modal && !_dialogOpen)
        {
            _dialogOpen = true;
            _ = Dialogs.OpenAsync(
                Final ? "Final results" : $"Month {State.Month} standings",
                _ => StandingsModal,
                new DialogOptions
                {
                    ShowTitle = false,
                    ShowClose = false,
                    CloseDialogOnEsc = false,
                    CloseDialogOnOverlayClick = false,
                    AutoFocusFirstElement = true,
                    CssClass = "po-rz-dialog po-rz-dialog--mule",
                    WrapperCssClass = "po-rz-dialog-wrapper po-rz-dialog-wrapper--mule",
                });
        }
        return Task.CompletedTask;
    }

    private async Task OnDialogMountedAsync()
    {
        try { await JS.InvokeVoidAsync("PoDialogInterop.trapFocus", _dialog); }
        catch { /* best effort */ }
    }

    private void OnNarrowChanged(bool narrow)
    {
        _narrow = narrow;
        if (_dialogOpen) Dialogs.Refresh();
    }

    private void SetConfirmQuit(bool value)
    {
        _confirmQuit = value;
        if (_dialogOpen) Dialogs.Refresh();
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !Final && CanContinue) await OnContinue.InvokeAsync();
    }

    private void OnDialogClosed(dynamic? _) => _dialogOpen = false;

    public void Dispose()
    {
        Dialogs.OnClose -= OnDialogClosed;
        if (_dialogOpen)
        {
            _dialogOpen = false;
            Dialogs.Close();
        }
    }

    private bool Survives => Final
        ? PoMuleScoring.ColonySurvives(Rows.Sum(r => r.NetWorth), State.CrisisMonths)
        : State.CrisisMonths <= PoMuleTuning.MaxCrisisMonths;

    private string ColonyLine => Final
        ? (Survives ? "The colony survives" : "The colony collapsed")
        : $"Crisis months: {State.CrisisMonths} of {PoMuleTuning.MaxCrisisMonths} allowed";

    private IEnumerable<WorthPoint> Line(int seat) =>
        State.History.Select((worths, i) => new WorthPoint(i + 1, worths[seat]));
}
