@* SandPlayground — a GPU sand-and-water physics sandbox.
   Blazor owns only the floating tool dock and its menu. Every pointer event, the
   keyboard shortcuts and the 60 FPS loop live in
   wwwroot/js/sand-playground/sand-playground-engine.js, which reports back
   through OnEngine so the dock never shows a stale tool.

   The dock floats over the sim's sky instead of sitting above it (the canvas takes
   the whole game area), tools are icon chips, and everything that is not a tool —
   worlds, challenges, saves, speed, weather, sharing — lives in one "⋯" menu. Eight
   tools are five chips: Pour and Sling each open a small tray for what they carry
   (sand / water / fire; TNT / balloon, plus the fuse and the charge), so a new
   material costs no dock space. There is no toolbar title, hint bar, mute button or
   slider: the shell already names the game, a tool's hint shows briefly when it is
   picked, sound follows the app's own volume, and brush size is the chip / the
   wheel / [ ]. *@

@* Escape closes the menu from anywhere in the sandbox (the ⋯ button keeps focus when it opens it). *@
<div class="sand-playground-root" @onpointerdown="WakeDock" @onkeydown="OnMenuKey">
    <div class="sand-playground-viewport">
        @* Fixed 800x600 simulation. The engine resizes both drawing buffers to the
           displayed size (the width/height here are only the first frame's).
           Pointer math reads the bounding rect, so touch stays accurate at any
           displayed size. *@
        <canvas @ref="_canvas" width="800" height="600" aria-hidden="true"></canvas>
        <canvas @ref="_overlay" width="800" height="600" class="sand-playground-overlay"
                aria-label="Sand Playground sandbox — drag to paint, drag in open air to slingshot ordnance"></canvas>

        @if (_failed)
        {
            <div class="sp-failed">
                <ErrorState Title="The sandbox could not start" OnRetry="StartEngineAsync" RetryLabel="Retry">
                    The simulation engine did not load. Check your connection and try again.
                </ErrorState>
            </div>
        }
        else if (_module is null)
        {
            <GameSkeleton Label="Loading sandbox…" />
        }

        @* One column floats over the sky: the dock, its tray under it and the menu
           under both. The column stacks them, so a dock that wraps to two rows on a
           narrow phone pushes the tray and menu down instead of hiding behind them. *@
        <div class="sp-chrome">
        @* In the attract reel the whole view is the simulation; the dock arrives
           with the first touch. *@
        @if (DockShown)
        {
        <div class="sand-playground-dock" role="toolbar" aria-label="Sand Playground tools">
            @foreach (var g in Groups)
            {
                var t = CurrentOf(g);
                <PoButton
                        class="@($"sp-btn {(GroupOf(ActiveTool) == g ? "active" : "")}")"
                        title="@($"{t.Label} ({t.Key}) — {t.Hint}")"
                        aria-label="@(g.Tools.Length > 1 ? $"{g.Label}: {t.Label}" : t.Label)"
                        aria-pressed="@Pressed(GroupOf(ActiveTool) == g)"
                        Disabled="@(!Array.Exists(g.Tools, x => ToolAllowed(x.Id)))"
                        Click="() => SelectToolAsync(CurrentOf(g).Id)">
                    @t.Icon
                    @if (GroupOf(ActiveTool) == g)
                    {
                        <span class="sp-btn-label">@t.Label</span>
                    }
                </PoButton>
            }

            <span class="sp-sep" aria-hidden="true"></span>

            <PoButton class="sp-btn sp-brush"
                    title="Brush size — click to cycle, or use the wheel / [ ]"
                    aria-label="@($"Brush size {BrushSize} pixels")"
                    Click="CycleBrushAsync">
                <span class="sp-brush-dot" style="--sp-brush: @BrushSize" aria-hidden="true"></span>@BrushSize
            </PoButton>
            <PoButton class="sp-btn"
                    title="@(Paused ? "Run (Space)" : "Pause (Space)")"
                    aria-label="@(Paused ? "Run" : "Pause")"
                    aria-pressed="@Pressed(Paused)"
                    Click="TogglePauseAsync">@(Paused ? "▶" : "⏸")</PoButton>
            @* Step only means something while paused, so it only exists then. *@
            @if (Paused)
            {
                <PoButton class="sp-btn" title="Advance one step (.)" aria-label="Step once"
                        Click="StepAsync">⏭</PoButton>
            }
            <PoButton class="sp-btn" title="Undo (Ctrl+Z)" aria-label="Undo"
                    Disabled="@(UndoDepth == 0)"
                    Click="UndoAsync">↶</PoButton>
            @* Only exists while radio-fused bombs are lying about. *@
            @if (RemoteBombs > 0)
            {
                <PoButton class="sp-btn sp-detonate" title="Detonate the radio bombs (Enter)"
                        aria-label="@($"Detonate {RemoteBombs} radio bombs")"
                        Click="DetonateAsync">💥@RemoteBombs</PoButton>
            }
            <PoButton class="@($"sp-btn {(MenuOpen ? "active" : "")}")"
                    title="Worlds, challenges, saves, speed, weather, share"
                    aria-label="Menu" aria-expanded="@Pressed(MenuOpen)" aria-controls="sand-playground-menu"
                    Click="ToggleMenuAsync">⋯</PoButton>
        </div>

        @* The tray under the dock: what the active tool carries. *@
        @if (TrayTools is { } tray)
        {
            <div class="sand-playground-tray" role="toolbar" aria-label="@($"{GroupOf(ActiveTool)?.Label} options")">
                @foreach (var t in tray)
                {
                    <PoButton class="@($"sp-pill {(ActiveTool == t.Id ? "active" : "")}")"
                            title="@($"{t.Label} ({t.Key}) — {t.Hint}")"
                            aria-pressed="@Pressed(ActiveTool == t.Id)"
                            Disabled="@(!ToolAllowed(t.Id))"
                            Click="() => SelectToolAsync(t.Id)">@t.Icon @t.Label</PoButton>
                }
                @if (ActiveTool == "tnt")
                {
                    <span class="sp-sep" aria-hidden="true"></span>
                    @foreach (var f in Fuses)
                    {
                        <PoButton class="@($"sp-pill {(Fuse == f.Id ? "active" : "")}")" title="@f.Hint"
                                aria-pressed="@Pressed(Fuse == f.Id)"
                                Click="() => SetFuseAsync(f.Id)">@f.Label</PoButton>
                    }
                    <span class="sp-sep" aria-hidden="true"></span>
                    <PoButton class="@($"sp-pill {(BigCharge ? "" : "active")}")" title="Small charge: about half the crater"
                            aria-pressed="@Pressed(!BigCharge)" Click="() => SetChargeAsync(false)">Small</PoButton>
                    <PoButton class="@($"sp-pill {(BigCharge ? "active" : "")}")" title="Full charge"
                            aria-pressed="@Pressed(BigCharge)" Click="() => SetChargeAsync(true)">Big</PoButton>
                }
            </div>
        }
        }

        @if (MenuOpen)
        {
            <div id="sand-playground-menu" class="sand-playground-menu" role="dialog" aria-label="Sand Playground menu">
                <section>
                    <h2>World</h2>
                    <div class="sp-row">
                        @foreach (var p in Presets)
                        {
                            <PoButton class="@($"sp-pill {(Preset == p.Id ? "active" : "")}")"
                                    title="@p.Hint" Click="() => LoadWorldAsync(p.Id)">@p.Label</PoButton>
                        }
                    </div>
                    <div class="sp-row">
                        <PoButton class="sp-pill" title="Same kind of world, new seed" Click="ResetAsync">New world</PoButton>
                        <PoButton class="sp-pill" title="Rebuild this exact world" Click="ReplaySeedAsync">↻ Replay seed @Seed</PoButton>
                        <PoButton class="sp-pill" title="The same world for everyone until midnight UTC" Click="DailyAsync">Today's world</PoButton>
                        <PoButton class="sp-pill" title="Copy a link that opens this exact world" Click="CopyLinkAsync">🔗 Copy link</PoButton>
                    </div>
                </section>

                <section>
                    <h2>Challenges</h2>
                    @foreach (var c in Challenges)
                    {
                        <PoButton class="@($"sp-line {(ChallengeId == c.Id ? "active" : "")}")"
                                title="@c.Hint" Click="() => StartChallengeAsync(c.Id)">
                            <span>@c.Name</span>
                            <span class="sp-dim">@(c.Best > 0 ? $"best {FormatTime(c.Best)}" : "not beaten")</span>
                        </PoButton>
                    }
                </section>

                <section>
                    <h2>Saves</h2>
                    @for (var s = 1; s <= 3; s++)
                    {
                        var slot = s;
                        var when = SlotTimes[slot - 1];
                        <div class="sp-row sp-row--slot">
                            <span class="sp-dim">@slot · @(when > 0 ? DateTimeOffset.FromUnixTimeMilliseconds(when).LocalDateTime.ToString("MMM d HH:mm") : "empty")</span>
                            <PoButton class="sp-pill" Click="() => SaveSlotAsync(slot)">Save</PoButton>
                            <PoButton class="sp-pill" Disabled="@(when == 0)" Click="() => LoadSlotAsync(slot)">Load</PoButton>
                        </div>
                    }
                    <div class="sp-row">
                        <PoButton class="sp-pill" title="Download this world as a file" Click="ExportAsync">Export file</PoButton>
                        <PoButton class="sp-pill" title="Load a world file" Click="ImportAsync">Import file</PoButton>
                    </div>
                </section>

                <section>
                    <h2>X-ray</h2>
                    <div class="sp-row" title="Draw one of the simulation's own fields instead of the materials (X cycles them)">
                        @for (var v = 0; v < Views.Length; v++)
                        {
                            var view = v;
                            <PoButton class="@($"sp-pill {(View == view ? "active" : "")}")"
                                    aria-pressed="@Pressed(View == view)"
                                    Click="() => SetViewAsync(view)">@Views[view]</PoButton>
                        }
                    </div>
                </section>

                <section>
                    <h2>Time &amp; weather</h2>
                    <div class="sp-row">
                        <span class="sp-dim">Speed</span>
                        @foreach (var sp in Speeds)
                        {
                            <PoButton class="@($"sp-pill {(Speed == sp.Value ? "active" : "")}")"
                                    aria-pressed="@Pressed(Speed == sp.Value)"
                                    Click="() => SetSpeedAsync(sp.Value)">@sp.Label</PoButton>
                        }
                    </div>
                    <div class="sp-row">
                        <span class="sp-dim">Sky</span>
                        @foreach (var sk in Skies)
                        {
                            <PoButton class="@($"sp-pill {(Sun == sk ? "active" : "")}")"
                                    aria-pressed="@Pressed(Sun == sk)"
                                    Click="() => SetSunAsync(sk)">@sk</PoButton>
                        }
                    </div>
                    <label class="sp-row">
                        <span class="sp-dim">Wind</span>
                        <input type="range" min="-100" max="100" step="10" value="@Wind" @oninput="OnWindAsync" />
                    </label>
                    <label class="sp-row" title="Past halfway it is a thunderstorm: lightning fuses dry sand to glass">
                        <span class="sp-dim">Rain</span>
                        <input type="range" min="0" max="100" step="10" value="@Rain" @oninput="OnRainAsync" />
                    </label>
                    <div class="sp-row" title="Bombs, debris and falling concrete. Sand and water cells are unaffected.">
                        <span class="sp-dim">Gravity</span>
                        @foreach (var g in Gravities)
                        {
                            <PoButton class="@($"sp-pill {(Gravity == g.Value ? "active" : "")}")"
                                    aria-pressed="@Pressed(Gravity == g.Value)"
                                    Click="() => SetGravityAsync(g.Value)">@g.Label</PoButton>
                        }
                    </div>
                    <div class="sp-row">
                        <PoButton class="@($"sp-pill {(DemoOn ? "active" : "")}")"
                                title="Rain a random TNT bomb every second"
                                aria-pressed="@Pressed(DemoOn)" Click="ToggleDemoAsync">💣 Auto-drop</PoButton>
                        <PoButton class="@($"sp-pill {(LabHud ? "active" : "")}")"
                                title="Show live sand/water cell counts and FPS readout"
                                aria-pressed="@Pressed(LabHud)" Click="ToggleLabHudAsync">🧪 Lab readout</PoButton>
                        <PoButton class="@($"sp-pill sp-touch-only {(Tilt ? "active" : "")}")"
                                title="Tilt the device to set the wind"
                                aria-pressed="@Pressed(Tilt)" Click="ToggleTiltAsync">📱 Tilt = wind</PoButton>
                    </div>
                </section>

                <section>
                    <h2>Share</h2>
                    <div class="sp-row">
                        <PoButton class="sp-pill" Click="ShotAsync">📷 Screenshot</PoButton>
                    </div>
                </section>
            </div>
        }
        </div>

        @* One transient line: a tool's hint when it is picked, a save confirmation,
           a challenge result. Keyed so each message restarts the fade. *@
        @if (!string.IsNullOrEmpty(_toast))
        {
            <div class="sand-playground-toast" role="status" @key="_toastId">
                @_toast
                @if (_toastUndo)
                {
                    <PoButton class="sp-pill" Click="UndoAsync">Undo</PoButton>
                }
            </div>
        }
    </div>
</div>
