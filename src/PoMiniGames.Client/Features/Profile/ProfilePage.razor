@page "/profile"
@using Microsoft.AspNetCore.Components
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@inject PlayerNameService PlayerNameService
@inject GameStatsService GameStatsService
@inject ApiService ApiService
@inject MatchHistoryService MatchHistory
@inject NavigationManager NavigationManager
@inject AuthStateService AuthState
@inject ToastService Toasts
@inject IJSRuntime JS
@inject InviteService Invites
@inject AchievementService Achievements
@implements IAsyncDisposable

<PageTitle>My Stats · PoMiniGames</PageTitle>

<div class="prf-page">
@if (_loading)
{
    @* role="status" is required, not decorative: `aria-label` is prohibited on a
       plain <div> with no role (axe: aria-prohibited-attr), so the label would
       be dropped and the loading state announced as nothing at all. "status"
       is the right role for a transient progress message and gives the label
       somewhere to live. *@
    <div class="profile-skel" role="status" aria-busy="true" aria-label="Loading profile">
        <div class="profile-skel__header">
            <div class="profile-skel__avatar"></div>
            <div class="profile-skel__lines">
                <div class="profile-skel__line profile-skel__line--w70"></div>
                <div class="profile-skel__line profile-skel__line--w40"></div>
                <div class="profile-skel__line profile-skel__line--w55"></div>
            </div>
        </div>
        <div class="profile-skel__row"></div>
        <div class="profile-skel__row"></div>
        <div class="profile-skel__row"></div>
    </div>
}
else
{
    @* One page, no tabs: tabs would each show a slice of the same record (win rate,
       W/L/D, streak and rating repeated) and the tab strip overflows a phone.

       The Gamer Card is the hero. Under it, one strip of headline numbers, one card
       per game the player has touched (its best score, its record and its ratings in
       the same card), the head-to-head tables, and the two charts folded away.
       "Your data" lives in the settings sheet, with the other account controls. *@
    <PageHeader Title="My Stats" />

    @* The card is fetched with the rest of the page (it feeds the Online half of the band
       below). Only a card in hand is passed down: a null Card makes PlayerCard fetch its
       own, which is the fallback when that read failed. *@
    @if (_card is not null)
    {
        <PlayerCard PlayerName="@_playerName" Card="@_card" />
    }
    else
    {
        <PlayerCard PlayerName="@_playerName" />
    }

    @* One band of headline numbers with a 1P | Online switch. The card above and this
       page used to each carry a strip, and win rate, record and streak appeared twice
       with different meanings side by side.

       "Saved matches" counts FINISHED, PERSISTED matches (the W/L record); sessions that
       carry no outcome (a simulation session) ride beside it so "0" is not the whole
       story. A stat not earned yet is a dash with a one-line how-to under it, as text:
       a tooltip on a box that cannot take focus reaches nobody on touch or keyboard.

       With nothing on either side the band is left out: it would be boxes of 0 and
       dashes under a card that already says "No ranked games yet". *@
    @if (Has1PRecord || HasOnlineRecord)
    {
        var online = ShowOnline;
        <section class="prf-band" aria-label="Headline stats">
            <div class="app-seg app-seg--quiet prf-band-seg" role="tablist" aria-label="Which record">
                <button type="button" role="tab" class="app-seg__btn" id="prf-band-1p"
                        aria-selected="@(online ? "false" : "true")" aria-controls="prf-band-panel"
                        @onclick="() => _bandOnline = false">1P</button>
                <button type="button" role="tab" class="app-seg__btn" id="prf-band-online"
                        aria-selected="@(online ? "true" : "false")" aria-controls="prf-band-panel"
                        disabled="@(_card is null)"
                        @onclick="() => _bandOnline = true">Online</button>
            </div>
            <div class="prf-chips" id="prf-band-panel" role="tabpanel"
                 aria-labelledby="@(online ? "prf-band-online" : "prf-band-1p")">
                @if (online)
                {
                    var c = _card!;
                    var ranked = c.Wins + c.Losses + c.Draws > 0;
                    <div class="prf-chip">
                        <span class="prf-chip-val">@(ranked ? c.WinRate.ToString("P0") : "—")</span>
                        <span class="prf-chip-lbl">Win Rate</span>
                        @if (!ranked)
                        {
                            <span class="prf-chip-hint">Play an online match</span>
                        }
                    </div>
                    <div class="prf-chip">
                        <span class="prf-chip-val">@c.Wins–@c.Draws–@c.Losses</span>
                        <span class="prf-chip-lbl">W–D–L</span>
                    </div>
                    <div class="prf-chip">
                        <span class="prf-chip-val">@c.PeakMmr.ToString("N0")</span>
                        <span class="prf-chip-lbl">Peak MMR</span>
                        <span class="prf-chip-hint">Now @c.Mmr.ToString("N0")</span>
                    </div>
                    <div class="prf-chip">
                        <span class="prf-chip-val">@(c.CurrentStreak switch { > 0 => $"+{c.CurrentStreak} W", < 0 => $"{c.CurrentStreak} L", _ => "—" })</span>
                        <span class="prf-chip-lbl">Streak</span>
                    </div>
                }
                else
                {
                    <div class="prf-chip">
                        <span class="prf-chip-val">@(_unsyncedSessions > 0 ? $"{_totalGames} +{_unsyncedSessions}" : _totalGames.ToString())</span>
                        <span class="prf-chip-lbl">Saved Matches</span>
                        @if (_unsyncedSessions > 0)
                        {
                            <span class="prf-chip-hint">+@_unsyncedSessions @(_unsyncedSessions == 1 ? "session" : "sessions") on this device</span>
                        }
                    </div>
                    <div class="prf-chip">
                        <span class="prf-chip-val">@(_totalGames > 0 ? $"{_totalWins * 100 / _totalGames}%" : "—")</span>
                        <span class="prf-chip-lbl">Win Rate</span>
                        @if (_totalGames == 0)
                        {
                            <span class="prf-chip-hint">Play a 1-player match</span>
                        }
                    </div>
                    @if (_totalGames > 0)
                    {
                        <div class="prf-chip">
                            <span class="prf-chip-val">@_totalWins–@_totalDraws–@_totalLosses</span>
                            <span class="prf-chip-lbl">W–D–L</span>
                        </div>
                    }
                    <div class="prf-chip">
                        <span class="prf-chip-val">@(_bestStreak > 0 ? _bestStreak.ToString() : "—")</span>
                        <span class="prf-chip-lbl">Best Streak</span>
                        @if (_bestStreak == 0)
                        {
                            <span class="prf-chip-hint">Win 2 in a row vs the CPU</span>
                        }
                    </div>
                    @* AdaptiveRating.StartingElo is 1200 (GameModels.cs): at or below it, nothing has been won. *@
                    <div class="prf-chip">
                        <span class="prf-chip-val">@(_topElo > 1200 ? _topElo.ToString() : "—")</span>
                        <span class="prf-chip-lbl">Top ELO</span>
                        @if (_topElo <= 1200)
                        {
                            <span class="prf-chip-hint">Win to pass 1200</span>
                        }
                    </div>
                    @if (_bestEntry != null)
                    {
                        <div class="prf-chip prf-chip--best">
                            <span class="prf-chip-val">🏆 @_bestEntry.Label</span>
                            <span class="prf-chip-lbl">Best Game</span>
                            <span class="prf-chip-hint">@($"{_bestEntry.WinRate:P0} of {_bestEntry.TotalGames}")</span>
                        </div>
                    }
                    @if (_nemesisEntry != null)
                    {
                        <div class="prf-chip prf-chip--nemesis">
                            <span class="prf-chip-val">💀 @_nemesisEntry.Label</span>
                            <span class="prf-chip-lbl">Nemesis</span>
                            <span class="prf-chip-hint">@($"{_nemesisEntry.WinRate:P0} of {_nemesisEntry.TotalGames}")</span>
                        </div>
                    }
                }
            </div>
        </section>
    }

    <!-- ── Games: one card per game played, the rest on one line ── -->
    var best = _highScoresByKey;
    var played = _entries.Where(g => HasActivity(g, best)).ToList();
    var unplayed = _entries.Where(g => !HasActivity(g, best)).ToList();

    <section class="prf-section">
        <h2 class="prf-section-title">Games</h2>
        @if (_highScoreLoadFailed)
        {
            <ErrorState Icon="⚠️"
                        Title="Couldn't load saved high scores"
                        OnRetry="() => LoadHighScoresAsync()">
                The leaderboard endpoints didn't respond. The records below are
                still accurate; only the cross-device best scores are missing.
            </ErrorState>
        }
        @if (played.Count > 0)
        {
            <div class="prf-game-grid">
                @foreach (var g in played)
                {
                    <div class="prf-game-card">
                        <div class="prf-game-header">
                            <span class="prf-game-icon material-symbols-outlined" aria-hidden="true">@g.Icon</span>
                            <span class="prf-game-name">@g.Label</span>
                            @* The server board's number (a score, a time), for the games that
                               have one. The AI games' "best" is their ELO, which the rating
                               rows below already carry. *@
                            @if (ScoreOf(g, best) is { } score)
                            {
                                <span class="prf-game-best" title="Your best on the leaderboard">@score</span>
                            }
                            @if (g.TotalGames > 0)
                            {
                                <span class="prf-game-wr">@g.WinRate.ToString("P0")</span>
                            }
                        </div>
                        @if (g.TotalGames > 0)
                        {
                            <div class="prf-bar" title="Win / Draw / Loss" style="--win-pct:@((int)g.WinPercent)%;--draw-pct:@((int)g.DrawPercent)%;--loss-pct:@((int)g.LossPercent)%">
                                <div class="prf-bar-win"></div>
                                <div class="prf-bar-draw"></div>
                                <div class="prf-bar-loss"></div>
                            </div>
                            <div class="prf-diffs">
                                @foreach (var d in g.Difficulties.Where(x => x.TotalGames > 0))
                                {
                                    <div class="prf-diff-row">
                                        <span class="prf-diff-name prf-diff-@d.Name.ToLowerInvariant()">@d.Name</span>
                                        <span class="prf-diff-wld">@d.Wins W · @d.Losses L · @d.Draws D</span>
                                        @if (d.EloRating != 1000)
                                        {
                                            <span class="prf-diff-elo">ELO @d.EloRating</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (g.Kind == RatingKind.PlayCountOnly)
                        {
                            <p class="prf-game-plays">
                                <span class="prf-game-plays-val">@g.PlayCount</span>
                                <span class="prf-game-plays-lbl">@(g.PlayCount == 1 ? "session" : "sessions")</span>
                                @if (DemoUrl(g.Key) is { } demo)
                                {
                                    <a class="prf-game-link" href="@demo">Watch again →</a>
                                }
                                else
                                {
                                    <a class="prf-game-link" href="@PlayUrl(g.Key)">Play again →</a>
                                }
                            </p>
                        }
                    </div>
                }
            </div>
        }
        @if (unplayed.Count > 0)
        {
            @* Every game still has a named entry here (a profile that listed three of
               ten games is the bug ProfileCoverageUiTests pins), but the fourteen-chip
               bucket that used to sit under the cards is now one row that names the
               count. A returning player scrolls past one line instead of a wall of
               games they have already decided not to play; open by default only when
               there is nothing else to look at. *@
            <details class="prf-unplayed" open="@(played.Count == 0 ? "open" : null)">
                <summary class="prf-unplayed-label">
                    @if (played.Count == 0)
                    {
                        <text>Nothing played yet — pick one</text>
                    }
                    else
                    {
                        <text>@unplayed.Count not played yet</text>
                    }
                </summary>
                <div class="prf-unplayed-chips">
                    @foreach (var g in unplayed)
                    {
                        <a class="prf-unplayed-chip" href="@PlayUrl(g.Key)">
                            <span class="prf-game-icon material-symbols-outlined" aria-hidden="true">@g.Icon</span>
                            <span class="prf-game-name">@g.Label</span>
                        </a>
                    }
                </div>
            </details>
        }
    </section>

    <!-- ── Achievements: earned on this device, locked ones greyed with how to earn them ── -->
    <section class="prf-section" aria-labelledby="prf-ach-title">
        <div class="prf-section-head">
            <h2 class="prf-section-title" id="prf-ach-title">Achievements · @Achievements.UnlockedCount of @AchievementService.All.Count</h2>
            @* The count said as a bar: "3 of 15" is a number to read, a bar is a number
               to feel. Radzen's progress bar follows the same tokens as the rest of the
               page once its theme is loaded, and the plain fallback keeps the row from
               collapsing while that happens. *@
            @if (_radzenReady)
            {
                <RadzenProgressBar Value="@AchievementPercent" ShowValue="false" class="prf-ach-bar"
                                   AriaLabel="@($"Achievements: {AchievementPercent}% complete")" />
            }
            else
            {
                <div class="prf-ach-bar-primitive" role="img"
                     aria-label="@($"Achievements: {AchievementPercent}% complete")">
                    <div class="prf-ach-bar-fill" style="width: @($"{AchievementPercent}%")"></div>
                </div>
            }
        </div>

        @* Three rows, then a disclosure. Fifteen locked achievements on every visit is
           the least valuable content on the page: it is a list of things that have not
           happened. The earned ones are always shown, because those are the news. *@
        <ul class="prf-ach-grid">
            @foreach (var a in AchievementsTop)
            {
                var earned = Achievements.IsUnlocked(a.Id);
                <li class="prf-ach @(earned ? "prf-ach--on" : "prf-ach--off")">
                    <span class="prf-ach-icon" aria-hidden="true">@a.Icon</span>
                    <span class="prf-ach-text">
                        <span class="prf-ach-title">@a.Title<span class="prf-sr-only">@(earned ? ", earned" : ", locked")</span></span>
                        <span class="prf-ach-hint">@a.Hint</span>
                    </span>
                </li>
            }
        </ul>

        @if (AchievementsRest.Count > 0)
        {
            <details class="prf-ach-more">
                <summary class="prf-ach-more-summary">Show all @AchievementService.All.Count achievements</summary>
                <ul class="prf-ach-grid">
                    @foreach (var a in AchievementsRest)
                    {
                        var earned = Achievements.IsUnlocked(a.Id);
                        <li class="prf-ach @(earned ? "prf-ach--on" : "prf-ach--off")">
                            <span class="prf-ach-icon" aria-hidden="true">@a.Icon</span>
                            <span class="prf-ach-text">
                                <span class="prf-ach-title">@a.Title<span class="prf-sr-only">@(earned ? ", earned" : ", locked")</span></span>
                                <span class="prf-ach-hint">@a.Hint</span>
                            </span>
                        </li>
                    }
                </ul>
            </details>
        }
    </section>

    <!-- ── Head-to-Head ── -->
    @if (_matchesLoading || _localOpponents.Count > 0 || _onlineOpponents.Count > 0)
    {
        <section class="prf-section">
            <div class="prf-section-head">
                <h2 class="prf-section-title">Head-to-Head · People You Played</h2>
                <span class="prf-h2h-legend" role="group" aria-label="Badge legend">
                    <span class="prf-h2h-badge prf-h2h-badge--guest" aria-hidden="true">G</span>
                    <span class="prf-h2h-legend-lbl">Guest</span>
                    <span class="prf-h2h-badge prf-h2h-badge--microsoft" aria-hidden="true">MS</span>
                    <span class="prf-h2h-legend-lbl">Microsoft</span>
                </span>
            </div>
            @if (_matchesLoading)
            {
                <p class="prf-h2h-note">Loading match history…</p>
            }
            else
            {
                <div class="prf-h2h-cols">
                    @if (_localOpponents.Count > 0)
                    {
                        <div class="prf-h2h-col">
                            <h3 class="prf-h2h-mode">👥 2-Player (local)</h3>
                            @RenderOpponentTable(_localOpponents, false)
                        </div>
                    }
                    @if (_onlineOpponents.Count > 0)
                    {
                        <div class="prf-h2h-col">
                            <h3 class="prf-h2h-mode">🌐 Online Multiplayer</h3>
                            @RenderOpponentTable(_onlineOpponents, true)
                        </div>
                    }
                </div>
            }
        </section>
    }

    <!-- ── Charts: the same record, drawn. Open, not folded: two charts are a scan,
         and the cards above are the detail. ── -->
    @if (_totalGames > 0)
    {
        <section class="prf-section" aria-labelledby="prf-charts-title">
            <h2 class="prf-section-title" id="prf-charts-title">Charts</h2>
            <div class="prf-charts">
                <div class="prf-chart-card prf-chart-card--wide">
                    <h3 class="prf-chart-title">Win Rate by Game</h3>
                    @* Radzen's bar chart, on the same tokens as the rest of the page. It
                       replaces a hand-rolled radar: a bar reads win rates against 100%
                       without the reader having to work out where a pentagon's corner
                       sits. The reserved height keeps the card from jumping when the
                       theme and script land. *@
                    @if (_radzenReady)
                    {
                        <RadzenChart class="prf-chart" Style="height: 220px">
                            <RadzenBarSeries Data="@WinRateRows" CategoryProperty="Label" ValueProperty="WinPercent"
                                             Title="Win rate" Fill="#6366f1">
                                <RadzenSeriesDataLabels Visible="true" />
                            </RadzenBarSeries>
                            <RadzenValueAxis Min="0" Max="100">
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                            <RadzenCategoryAxis />
                            <RadzenLegend Visible="false" />
                        </RadzenChart>
                    }
                    else
                    {
                        <div class="prf-chart-placeholder" aria-hidden="true"></div>
                    }
                </div>
                <div class="prf-chart-card">
                    <h3 class="prf-chart-title">Overall Record</h3>
                    @((MarkupString)BuildDonutSvg())
                    <div class="prf-donut-legend">
                        <span class="prf-legend-dot prf-legend-win"></span><span>Wins&nbsp;@_totalWins</span>
                        <span class="prf-legend-dot prf-legend-draw"></span><span>Draws&nbsp;@_totalDraws</span>
                        <span class="prf-legend-dot prf-legend-loss"></span><span>Losses&nbsp;@_totalLosses</span>
                    </div>
                </div>
            </div>
        </section>
    }
}
</div>

@code {
    // Only the markup-bearing member lives here; everything else is in
    // ProfilePage.razor.cs.
    //
    // This one cannot move: a RenderFragment written as inline Razor markup is
    // compiled by the Razor generator, not by csc, so it has to stay in the .razor.

    private RenderFragment RenderOpponentTable(List<OpponentRecord> opponents, bool invitable) => __builder =>
    {
        @*
            <Virtualize> wraps the opponent table body. A player's full head-to-head
            history is unbounded (each new opponent is a new row), so without virtualization
            a profile page with 200+ opponents allocates a DOM node per opponent. There is no
            inner scroll box: the virtualizer follows the page's own scroll, so a phone has
            one scroll, not a 360px well inside it.

            Under 640px each row is laid out as a card (badge and name, a W–L–D pill, a small
            Invite button) by CSS alone. The explicit table roles keep it a table to
            assistive tech once the rows stop being display: table-row.
        *@
        <div class="prf-h2h-vwrap">
            <table class="prf-h2h-table" role="table">
                <thead role="rowgroup">
                    <tr role="row">
                        <th role="columnheader">Opponent</th>
                        <th role="columnheader" class="prf-h2h-num"><abbr title="Wins">W</abbr></th>
                        <th role="columnheader" class="prf-h2h-num"><abbr title="Losses">L</abbr></th>
                        <th role="columnheader" class="prf-h2h-num"><abbr title="Draws">D</abbr></th>
                        @if (invitable)
                        {
                            <th role="columnheader" class="prf-h2h-invite"><span class="prf-sr-only">Invite</span></th>
                        }
                    </tr>
                </thead>
                <tbody role="rowgroup">
                    <Virtualize Items="opponents" Context="o" ItemSize="48" SpacerElement="tr">
                        <tr role="row" class="prf-h2h-row">
                            <td role="cell" class="prf-h2h-name">
                                <span class="prf-h2h-badge prf-h2h-badge--@o.Type" aria-hidden="true">@(o.Type == "microsoft" ? "MS" : "G")</span>
                                <span class="prf-h2h-who">@o.Name<span class="prf-sr-only">@(o.Type == "microsoft" ? " (Microsoft account)" : " (guest)")</span></span>
                            </td>
                            <td role="cell" class="prf-h2h-num prf-h2h-w">@o.Wins</td>
                            <td role="cell" class="prf-h2h-num prf-h2h-l">@o.Losses</td>
                            <td role="cell" class="prf-h2h-num prf-h2h-d">@o.Draws</td>
                            @if (invitable)
                            {
                                @* Online opponents only: a local 2-player name is whatever was
                                   typed on this device, not someone who can be reached. *@
                                <td role="cell" class="prf-h2h-invite">
                                    <button type="button" class="app-btn app-btn--secondary app-btn--sm"
                                            disabled="@(_inviting == o.Name)"
                                            aria-label="@($"Invite {o.Name} to play again")"
                                            @onclick="() => InviteAsync(o)">Invite</button>
                                </td>
                            }
                        </tr>
                    </Virtualize>
                </tbody>
            </table>
        </div>
    };
}
