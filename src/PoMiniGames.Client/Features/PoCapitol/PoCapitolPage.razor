@page "/pocapitol"
@page "/pocapitol/{Mode}"
@inject IJSRuntime JS
@inject GameResultService Results
@inject PlayerNameService PlayerNames
@inject ILogger<PoCapitolPage> Logger
@inject KioskCoordinator Kiosk

@* State, engine calls and the engine's records are in PoCapitolPage.razor.cs. This file is
   the markup and the render fragments handed to the shared shell. *@

<PageTitle>PoCapitol · PoMiniGames</PageTitle>

<GameShell Title="@TitleContent" Fullscreen="true" RequiresWebGl="true" Announcement="@_announcement"
           Loading="@(_status == "loading")"
           LoadingLabel="Preparing the scene…"
           OptionsContent="@ScenarioOptions"
           OptionsHeading="Scenario options"
           GameOver="@((_status is "completed" or "failed") && !_demo)"
           GameOverDelayMs="1800"
           Outcome="@ResultOutcome"
           Stats="@ResultStats"
           GameSummary="@ResultSummary"
           GameDetails="@ResultDetails"
           Diagnostics="@DiagStats"
           DiagnosticsContent="@TabHudContent">
    <ErrorBoundary @ref="_errorBoundary">
        <ChildContent>
            <div class="pc-root @(_demo ? "pc-phonecam" : null) @(_prefs.contrast == "high" ? "pc-contrast" : null)">
                <div id="pocapitol-scene" class="pc-scene" role="img" aria-label="Fictional Capitol grounds and interiors"></div>
                <div class="pc-film" aria-hidden="true"></div>
                @* Always in the tree while play is live, so a caption arriving or clearing
                   never inserts or removes a node over the scene. *@
                @if (_status == "active")
                {
                    <div class="pc-caption @(_caption.Length == 0 ? "pc-caption--idle" : null)" role="status" aria-live="polite">
                        @if (_caption.Length > 0)
                        {
                            <span class="pc-caption-tag">RADIO</span> @_caption
                        }
                    </div>
                }
                @if (_status != "active")
                {
                    <div class="pc-edition">PoCAPITOL <span>ALTERNATE HISTORY · FICTIONAL SCENARIO</span></div>
                }

                @* The shared start card, like every other game: one OK, controls beside the
                   rules, and this scenario's setup in the Options slot. *@
                @if (_status == "intro" && _ready)
                {
                    <GameIntro CueScope="pocapitol"
                               Title="@TitleContent"
                               Objective="One afternoon, five police lines. Play it as the crowd, the line, or an observer."
                               Controls="@IntroControls"
                               HowToPlay="@IntroRules"
                               Options="@IntroOptions"
                               Mode="@(_demo ? GameIntro.IntroMode.Demo : GameIntro.IntroMode.OnePlayer)"
                               Wide="true"
                               OnStart="StartAsync" />
                }
                else if (_status == "error")
                {
                    @* The shared error view, inside the game area: same headline, message and
                       one retry button as the rest of the app. `loading` renders nothing here —
                       GameShell's skeleton already covers the stage while the engine boots. *@
                    <div class="pc-panel pc-centered">
                        <ErrorState Icon="⚠️" Title="The scenario could not load" OnRetry="LoadAsync">
                            <p>@_error</p>
                        </ErrorState>
                    </div>
                }
                else
                {
                    @if (_selectedTelemetry != null)
                    {
                        <div class="pc-inspector-card" role="region" aria-label="Unit Telemetry">
                            <div class="pc-inspector-header">
                                <div class="pc-inspector-title">
                                    <span class="pc-badge @(_selectedTelemetry.faction == "police" ? "pc-badge--police" : "pc-badge--raider")">
                                        @_selectedTelemetry.faction.ToUpperInvariant()
                                    </span>
                                    <strong>@_selectedTelemetry.name</strong>
                                </div>
                                <button type="button" class="pc-debug-close" @onclick="ClearInspectAsync" aria-label="Close Inspector">✕</button>
                            </div>
                            <div class="pc-inspector-role">@_selectedTelemetry.role</div>
                            <div class="pc-inspector-status"><span>STATUS:</span> <b>@_selectedTelemetry.status</b></div>
                            <div class="pc-inspector-metrics">
                                <div>
                                    <span>STAMINA / HEALTH</span>
                                    <RadzenProgressBar Value="@_selectedTelemetry.health" Max="100" Unit="%" ShowValue="true"
                                                       ProgressBarStyle="@GetHealthProgressStyle(_selectedTelemetry.health)" />
                                </div>
                                <div>
                                    <span>MORALE</span>
                                    <RadzenProgressBar Value="@_selectedTelemetry.stamina" Max="100" Unit="%" ShowValue="true"
                                                       ProgressBarStyle="ProgressBarStyle.Info" />
                                </div>
                            </div>
                            <div class="pc-inspector-meta">
                                <span>@_selectedTelemetry.gear</span>
                                <span>Crowd density: @_selectedTelemetry.density.ToString("0.0") people/m²</span>
                                @if (!string.IsNullOrEmpty(_selectedTelemetry.lineAssignment))
                                {
                                    <span>Assignment: @_selectedTelemetry.lineAssignment</span>
                                }
                                @if (!string.IsNullOrEmpty(_selectedTelemetry.milestone))
                                {
                                    <span>Objective: @_selectedTelemetry.milestone</span>
                                }
                                @if (_selectedTelemetry.harmHits > 0)
                                {
                                    <span class="pc-harm">
                                        HARM: severity @_selectedTelemetry.harmSeverity/6 · @_selectedTelemetry.harmLossMl mL est.
                                        (@(_selectedTelemetry.harmHemorrhage == 0 ? "no class" : $"class {_selectedTelemetry.harmHemorrhage}")) ·
                                        triage <b>@_selectedTelemetry.harmTriage</b>
                                    </span>
                                }
                            </div>
                            <div class="pc-inspector-actions">
                                <button type="button" class="app-btn app-btn--primary" @onclick="ToggleLatchAsync">
                                    @(_selectedTelemetry.latched ? "Unlatch camera" : "Latch camera")
                                </button>
                                <button type="button" class="app-btn" @onclick="ClearInspectAsync">Deselect</button>
                            </div>
                        </div>
                    }
                    @if (_status == "active")
                    {
                        @if (Playing)
                        {
                            <div class="pc-crosshair" aria-hidden="true">+</div>
                        }
                        @if (!_demo)
                        {
                            <div class="pc-touch" aria-label="Touch controls">
                                <div class="pc-dpad">
                                    <button type="button" data-capitol-action="forward" aria-label="Move forward">↑</button>
                                    <button type="button" data-capitol-action="left" aria-label="Move left">←</button>
                                    <button type="button" data-capitol-action="back" aria-label="Move backward">↓</button>
                                    <button type="button" data-capitol-action="right" aria-label="Move right">→</button>
                                </div>
                                @if (Playing)
                                {
                                    <div class="pc-touch-actions">
                                        @if (Armed)
                                        {
                                            @* The same grenades as G and H, with what is left on the button. *@
                                            <button type="button" class="pc-throw" data-capitol-throw="concussion" disabled="@(_grenades == 0)"
                                                    aria-label="@($"Throw a concussion grenade, {_grenades} left")">GREN<small>@_grenades</small></button>
                                            <button type="button" class="pc-throw" data-capitol-throw="smoke" disabled="@(_smoke == 0)"
                                                    aria-label="@($"Throw a smoke grenade, {_smoke} left")">SMOKE<small>@_smoke</small></button>
                                        }
                                        <button type="button" class="pc-fire" data-capitol-action="push"
                                                aria-label="@(Armed ? "Fire" : "Push")">@(Armed ? "FIRE" : "PUSH")</button>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (_status == "paused")
                    {
                        <section class="pc-panel pc-centered">
                        <GamePauseDialog LabelledBy="pc-paused" OnResume="() => PauseAsync(false)">
                            <span class="pc-eyebrow">TAKE A BREATH</span><h2 id="pc-paused">Scenario paused.</h2>
                            <p>The clock, the crowd and the lines are stopped.</p>
                            <label class="pc-small" for="pc-graphics-paused">Graphics · now @_graphicsLabel</label>
                            @GraphicsPicker("pc-graphics-paused")
                            <div class="pc-actions">
                                <button type="button" class="app-btn app-btn--primary" @onclick="() => PauseAsync(false)">Resume</button>
                                <button type="button" class="app-btn" @onclick="StartAsync">Restart</button>
                            </div>
                            <details><summary>Historical context</summary>@ContextContent</details>
                        </GamePauseDialog>
                        </section>
                    }
                    @* completed / failed: the result is the shared end-of-game modal (GameShell's
                       GameOver → GameOverModal). Only this scenario's prose is projected into it. *@
                }

            </div>
        </ChildContent>
        <ErrorContent Context="ex">
            @* The shared error view, the same one the load failure uses; the exception text
               goes to the log, not the player. *@
            <div class="pc-panel pc-centered">
                <ErrorState Icon="⚠️" Title="An interface error occurred" OnRetry="RecoverFromError" RetryLabel="Recover scenario">
                    <p>The scenario hit an unexpected error. Recover to reload it, or return to all games.</p>
                </ErrorState>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</GameShell>

@code {
    /// <summary>The one graphics picker, used on the start card, the pause dialog and the options sheet.</summary>
    private RenderFragment<string> GraphicsPicker => id => @<RadzenSelectBar TValue="string" Value="@_graphics" Change="@(async (string value) => await SetGraphicsAsync(value))" id="@id">
        <Items>
            <RadzenSelectBarItem Text="Auto" Value="@("auto")" />
            <RadzenSelectBarItem Text="Low" Value="@("low")" />
            <RadzenSelectBarItem Text="High" Value="@("high")" />
        </Items>
    </RadzenSelectBar>;

    private RenderFragment ResultSummary => @<div>
        <div>@ResultBody</div>
        <div>@ResultNote</div>
        <div>What happened afterwards: the real building was cleared that evening, a citywide curfew began at 6:00 pm, the Senate reconvened at about 8:00 pm, and Congress finished certifying the election at about 3:40 am on January 7.</div>
    </div>;

    /// <summary>
    /// The debrief paragraph and, under it, what wrote it. The block keeps its height while a
    /// local model is still writing, so the card does not jump when the text lands.
    /// </summary>
    private RenderFragment DebriefBlock => @<div class="pc-debrief" aria-live="polite" aria-busy="@(_debriefBusy ? "true" : "false")">
        <span class="pc-debrief-head">Debrief</span>
        <p>@(_debrief is { text.Length: > 0 } d ? d.text : "Writing the debrief…")</p>
        <span class="pc-debrief-meta @(_debrief is { fallback: true } ? "pc-debrief-meta--warn" : null)">@DebriefMeta</span>
    </div>;

    /// <summary>
    /// The after-action report, below the result summary: what the attempt actually looked like,
    /// from the sampled series the engine already keeps. Charts and files only — no score, and
    /// nothing leaves the browser unless the player exports it.
    /// </summary>
    private RenderFragment ResultDetails => @<div class="pc-report">
        @if (_report is { svg.Length: > 0 } report)
        {
            @DebriefBlock
            <div class="pc-report-chart">@((MarkupString)report.svg)</div>
            <dl class="pc-report-facts">
                <div><dt>Milestones</dt><dd>@report.milestones / @Objectives.Length</dd></div>
                <div><dt>Lowest line</dt><dd>@report.lowestIntegrity%</dd></div>
                <div><dt>Peak pressure</dt><dd>@report.peakPressure.ToString("0.0")</dd></div>
                <div><dt>First break</dt><dd>@(report.firstBreak < 0 ? "never" : $"{report.firstBreak:0}s")</dd></div>
                <div><dt>Casualties</dt><dd>@report.casualties (@report.immediate immediate)</dd></div>
                <div><dt>Standing</dt><dd>@report.standing raiders · @report.police police</dd></div>
            </dl>
            <div class="pc-report-actions">
                <button type="button" class="app-btn app-btn--sm" @onclick="ExportCsvAsync">Export CSV</button>
                <button type="button" class="app-btn app-btn--sm" @onclick="ExportPngAsync">Save chart (PNG)</button>
                <button type="button" class="app-btn app-btn--sm" @onclick="CopySummaryAsync">Copy summary</button>
            </div>
        }
    </div>;

    private RenderFragment TabHudContent => @<div class="pc-tab-hud @(_prefs.contrast == "high" ? "pc-contrast" : null)">
        <div class="pc-tab-hud-head">
            <div>
                <div class="pc-hud-eyebrow-row">
                    <span class="pc-eyebrow">@HudEyebrow</span>
                    @if (_demo)
                    {
                        <span class="pc-rec-pill" aria-hidden="true"><i></i>REC</span>
                    }
                </div>
                <strong>@HudTitle</strong>
            </div>
            <button type="button" class="app-btn app-btn--sm" @onclick="() => PauseAsync(true)" disabled="@(_status != "active")">Pause</button>
        </div>

        <div class="pc-progress" aria-label="@($"{_milestone} of {Objectives.Length} milestones complete")">
            @for (var i = 0; i < Objectives.Length; i++)
            {
                <span class="@(i < _milestone ? "pc-done" : null)"></span>
            }
        </div>

        @if (_lineIndex >= 0)
        {
            <div class="pc-tab-bar">
                <div class="pc-line-header">
                    <span>LINE: @LineNames[_lineIndex].ToUpperInvariant()</span>
                    <span>@_lineIntegrity%</span>
                </div>
                <RadzenProgressBar Value="@_lineIntegrity" Max="100" Unit="" ShowValue="false"
                                   ProgressBarStyle="@GetLineProgressStyle(_lineIntegrity)" Class="pc-progress-bar" />
            </div>
        }

        @if (Playing)
        {
            <div class="pc-tab-bar">
                <div class="pc-health-header">
                    <span>STAMINA</span>
                    <span>@_health%</span>
                </div>
                <RadzenProgressBar Value="@_health" Max="100" Unit="" ShowValue="false"
                                   ProgressBarStyle="@GetHealthProgressStyle(_health)" Class="pc-progress-bar" />
                @if (Armed)
                {
                    <div class="pc-health-header pc-ammo">
                        <span>GRENADES · G</span>
                        <span>@_grenades</span>
                    </div>
                    <div class="pc-health-header pc-ammo">
                        <span>SMOKE · H</span>
                        <span>@_smoke</span>
                    </div>
                }
            </div>
        }

        <div class="pc-crowd">
            <span>@_activeRaiders / @_crowdTotal IN CROWD</span>
            <span>@_activePolice / @_totalPolice CAPITOL POLICE</span>
            @if (_demo && _subject > 0)
            {
                <b>FOLLOWING RAIDER @_subject.ToString("000")</b>
            }
        </div>

        <div class="pc-tab-meta">
            <span class="pc-weather-pill" title="Atmospheric conditions">⛅ @_weatherCondition</span>
            <span class="pc-time">@Clock</span>
        </div>

        @if (_demo)
        {
            <div class="pc-demo-chip" title="Armed demo variant for autonomous tactical simulation.">
                <span class="pc-rec-pill" aria-hidden="true"><i></i>LIVE SIMULATION</span>
                <strong>ARMED DEMO · @(_subject > 0 ? $"TRACKING RAIDER {_subject:000}" : "AUTONOMOUS")</strong>
            </div>
        }
        else if (_role == "raider")
        {
            <div class="pc-beacon-chip">BEACON · @Objective.ToUpperInvariant()</div>
        }

        <div class="pc-hint-chip">@BottomHint</div>

        <div class="pc-onthisday-chip" title="@OnTheDay.Text">
            <span class="pc-eyebrow">HISTORICAL RECORD · @OnTheDay.Time</span>
            <span>@OnTheDay.Text</span>
        </div>

        <div class="pc-tab-radar">
            <div class="pc-radar-header">
                <button type="button" class="pc-radar-toggle" @onclick="ToggleRadar" title="Toggle Tactical Radar" aria-expanded="@(_radarExpanded ? "true" : "false")">
                    <span>📡 RADAR</span>
                    <small>@(_radarExpanded ? "▲" : "▼")</small>
                </button>
            </div>
            @if (_radarExpanded)
            {
                <div class="pc-radar-body">
                    <canvas id="pocapitol-radar" class="pc-radar-canvas" width="200" height="270"></canvas>
                    <div class="pc-radar-legend">
                        <span><i class="dot-raider"></i>Raider</span>
                        <span><i class="dot-police"></i>Police</span>
                        <span><i class="dot-heat"></i>Crush</span>
                    </div>
                </div>
            }
        </div>

        @if (_report is { } report)
        {
            <div class="pc-tab-report">
                <strong>Last attempt</strong>
                <p class="pc-small">@report.mode · @report.outcome · @report.milestones milestones · lowest line @report.lowestIntegrity% · @report.casualties casualties</p>
                @DebriefBlock
                <div class="pc-report-actions">
                    <button type="button" class="app-btn app-btn--sm" @onclick="ExportCsvAsync">Export CSV</button>
                    <button type="button" class="app-btn app-btn--sm" @onclick="CopySummaryAsync">Copy summary</button>
                </div>
            </div>
        }

        <button type="button" class="app-btn app-btn--sm" @onclick="CopyDiagnosticsAsync">Copy diagnostics</button>
    </div>;

    /// <summary>
    /// Mid-match options for GameShell's shared gear (GameOptionsSheet): the same drawer every
    /// other game uses, split into four tabs so nothing needs a long scroll. Role and difficulty
    /// are *not* here — they belong on the start card — and diagnostics are the Tab panel.
    /// </summary>
    private RenderFragment ScenarioOptions => @<div class="pc-opts">
        <RadzenTabs RenderMode="TabRenderMode.Client">
            <Tabs>
                <RadzenTabsItem Text="Display">
                    <label class="pc-small" for="pc-opt-graphics">Graphics quality · now @_graphicsLabel</label>
                    @GraphicsPicker("pc-opt-graphics")

                    <label class="pc-small" for="pc-opt-weather">Atmospheric conditions (Open-Meteo)</label>
                    <RadzenSelectBar TValue="string" Value="@_weatherMode" Change="@(async (string val) => await SetWeatherAsync(val))" id="pc-opt-weather">
                        <Items>
                            <RadzenSelectBarItem Text="Jan 6 Archive" Value="@("historical")" />
                            <RadzenSelectBarItem Text="Live D.C." Value="@("live")" />
                            <RadzenSelectBarItem Text="Clear" Value="@("clear")" />
                            <RadzenSelectBarItem Text="Winter Gale" Value="@("blizzard")" />
                        </Items>
                    </RadzenSelectBar>
                    <p class="pc-small">@_weatherCondition</p>

                    <label class="pc-small" for="pc-opt-tracers">Ballistic tracers</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.tracers" Change="@(async (string val) => await SavePrefsAsync(tracers: val))" id="pc-opt-tracers">
                        <Items>
                            <RadzenSelectBarItem Text="Luminous" Value="@("luminous")" />
                            <RadzenSelectBarItem Text="Stealth" Value="@("stealth")" />
                            <RadzenSelectBarItem Text="Off" Value="@("off")" />
                        </Items>
                    </RadzenSelectBar>

                    <label class="pc-small" for="pc-opt-radar-palette">Radar palette</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.radar" Change="@(async (string value) => await SavePrefsAsync(radar: value))" id="pc-opt-radar-palette">
                        <Items>
                            <RadzenSelectBarItem Text="Auto" Value="@("auto")" />
                            <RadzenSelectBarItem Text="Tablet" Value="@("default")" />
                            <RadzenSelectBarItem Text="Colour-safe" Value="@("colorsafe")" />
                        </Items>
                    </RadzenSelectBar>

                    <button type="button" class="app-btn pc-opt-button" @onclick="ToggleRadar">
                        @(_radarExpanded ? "Hide tactical radar" : "Show tactical radar")
                    </button>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Comfort">
                    <label class="pc-small" for="pc-opt-sens">Camera sensitivity · @_prefs.sensitivity.ToString("0.00")×</label>
                    <input id="pc-opt-sens" class="pc-range" type="range" min="0.4" max="2.5" step="0.05"
                           value="@_prefs.sensitivity.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="OnSensitivityChanged" />

                    <label class="pc-small" for="pc-opt-fov">Field of view · @_prefs.fov°</label>
                    <input id="pc-opt-fov" class="pc-range" type="range" min="50" max="85" step="1"
                           value="@_prefs.fov" @onchange="OnFovChanged" />

                    <label class="pc-small" for="pc-opt-footage">Picture &amp; sound</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.footage" Change="@(async (string val) => await SavePrefsAsync(footage: val))" id="pc-opt-footage">
                        <Items>
                            <RadzenSelectBarItem Text="Phone footage" Value="@("on")" />
                            <RadzenSelectBarItem Text="Light" Value="@("light")" />
                            <RadzenSelectBarItem Text="Clean" Value="@("off")" />
                        </Items>
                    </RadzenSelectBar>

                    <label class="pc-small" for="pc-opt-motion">Combat motion &amp; shake</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.motion" Change="@(async (string val) => await SavePrefsAsync(motion: val))" id="pc-opt-motion">
                        <Items>
                            <RadzenSelectBarItem Text="Full" Value="@("full")" />
                            <RadzenSelectBarItem Text="Reduced" Value="@("reduced")" />
                        </Items>
                    </RadzenSelectBar>

                    <label class="pc-small" for="pc-opt-captions">Captions for spoken radio</label>
                    <RadzenSelectBar TValue="bool" Value="@_prefs.captions" Change="@(async (bool value) => await SavePrefsAsync(captions: value))" id="pc-opt-captions">
                        <Items>
                            <RadzenSelectBarItem Text="Off" Value="@false" />
                            <RadzenSelectBarItem Text="On" Value="@true" />
                        </Items>
                    </RadzenSelectBar>

                    <label class="pc-small" for="pc-opt-contrast">HUD contrast</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.contrast" Change="@(async (string value) => await SavePrefsAsync(contrast: value))" id="pc-opt-contrast">
                        <Items>
                            <RadzenSelectBarItem Text="Normal" Value="@("normal")" />
                            <RadzenSelectBarItem Text="High" Value="@("high")" />
                        </Items>
                    </RadzenSelectBar>

                    @if (_demo)
                    {
                        <label class="pc-small" for="pc-opt-director">Spectator camera</label>
                        <RadzenSelectBar TValue="bool" Value="@_prefs.director" Change="@(async (bool value) => await SavePrefsAsync(director: value))" id="pc-opt-director">
                            <Items>
                                <RadzenSelectBarItem Text="Auto-director" Value="@true" />
                                <RadzenSelectBarItem Text="Follow leader" Value="@false" />
                            </Items>
                        </RadzenSelectBar>
                    }
                </RadzenTabsItem>

                <RadzenTabsItem Text="Controls">
                    <p class="pc-small">Arrow keys always steer, whatever is bound here. Picking a key another action uses swaps the two. G throws a concussion grenade and H a smoke grenade; on a gamepad, X and Y.</p>
                    @foreach (var row in KeyRows)
                    {
                        <div class="pc-key-row">
                            <label for="@($"pc-key-{row.Action}")">@row.Label</label>
                            <select id="@($"pc-key-{row.Action}")" class="pc-key-select" value="@row.Code" @onchange="@(e => SetKeyAsync(row.Action, e.Value))">
                                @foreach (var option in KeyChoices)
                                {
                                    <option value="@option" selected="@(option == row.Code)">@DescribeKey(option)</option>
                                }
                            </select>
                        </div>
                    }
                </RadzenTabsItem>

                <RadzenTabsItem Text="Debrief">
                    <label class="pc-small" for="pc-opt-debrief">Who writes the after-action debrief</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.debrief" Change="@(async (string value) => await SavePrefsAsync(debrief: value))" id="pc-opt-debrief">
                        <Items>
                            <RadzenSelectBarItem Text="Built-in" Value="@("rules")" />
                            <RadzenSelectBarItem Text="Local model" Value="@("ollama")" />
                        </Items>
                    </RadzenSelectBar>
                    @if (_prefs.debrief == "ollama")
                    {
                        <p class="pc-small">Uses a model running on this computer through Ollama (localhost:11434). Nothing is sent to the internet and nothing costs money. If it does not answer, the built-in writer takes over after one retry.</p>
                        <div class="pc-key-row">
                            <label for="pc-opt-debrief-model">Model</label>
                            <input id="pc-opt-debrief-model" class="pc-key-select pc-model-input" type="text" maxlength="60" spellcheck="false"
                                   value="@_prefs.debriefModel" @onchange="OnDebriefModelChanged" />
                        </div>
                        <button type="button" class="app-btn pc-opt-button" @onclick="ProbeDebriefAsync">Check connection</button>
                        <p class="pc-small pc-probe" role="status">@_probeStatus</p>
                    }
                    else
                    {
                        <p class="pc-small">Instant, and written on this device from the attempt's own numbers.</p>
                    }
                    <p class="pc-small">Last debrief: @DebriefMeta</p>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </div>;

    private RenderFragment IntroControls => @<div>
        <p><kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd> move · <kbd>Mouse</kbd> look &amp; aim · <kbd>←</kbd> <kbd>→</kbd> turn camera · <kbd>Shift</kbd> sprint</p>
        <p><kbd>Space</kbd> / <kbd>Click</kbd> fire (in the crowd) or push (police line) · <kbd>G</kbd> concussion grenade · <kbd>H</kbd> smoke grenade</p>
        <p><kbd>Esc</kbd> / <kbd>P</kbd> pause</p>
        <p class="touch-only">Touch: d-pad to move, drag to look, FIRE / PUSH, and grenade buttons that show what is left.</p>
        <p>Gamepad: sticks move and look, right trigger fires or pushes, X grenade, Y smoke, Start pauses.</p>
    </div>;

    private RenderFragment IntroRules => @<div>
        <p>@_crowdTotal protestors start out on the grass; most watch and film, a few push. 44 police hold five lines, are reinforced to 64, and fall back in stages. 64 staff and members shelter inside until evacuated. 12:50 pm to the 6:00 pm curfew.</p>
        <p><strong>Fiction, not a reconstruction.</strong> Inspired by January 6, 2021. Adult themes; no injury is shown. As a solo raider you carry a machine gun, five concussion grenades and two smoke grenades; police hold with batons, spray, gas and a few grenades. The Demo is a separate armed variant in which both sides fire. The layout and police positions are invented.</p>
        <details><summary>Historical record</summary>@ContextContent</details>
    </div>;

    private RenderFragment IntroOptions => @<div>
        <label class="pc-small" for="pc-role">Who you are</label>
        <RadzenSelectBar TValue="string" @bind-Value="_role" id="pc-role">
            <Items>
                <RadzenSelectBarItem Text="In the crowd" Value="@("raider")" />
                <RadzenSelectBarItem Text="Police line" Value="@("police")" />
                <RadzenSelectBarItem Text="Observer" Value="@("observer")" />
            </Items>
        </RadzenSelectBar>
        <p class="pc-small pc-role-brief">@RoleBrief</p>
        <div class="pc-options">
            <div>
                <label class="pc-small" for="pc-difficulty">Difficulty</label>
                <RadzenSelectBar TValue="string" @bind-Value="_difficulty" id="pc-difficulty">
                    <Items>
                        <RadzenSelectBarItem Text="Story" Value="@("story")" />
                        <RadzenSelectBarItem Text="Standard" Value="@("standard")" />
                    </Items>
                </RadzenSelectBar>
            </div>
            <div>
                <label class="pc-small" for="pc-graphics">Graphics</label>
                @GraphicsPicker("pc-graphics")
            </div>
        </div>
    </div>;

    private RenderFragment ContextContent => @<div class="pc-context">
        <p>On January 6, 2021, Congress met to count and certify electoral votes, not to pass a law. The attack interrupted that proceeding; Congress reconvened that night and finished in the early hours of January 7.</p>
        <p>What this scenario takes from the record is the shape of the day: a crowd that was mostly watching and filming, a minority pushing on police lines, police using shields, batons, chemical spray, gas and flash-bangs, lines that fell back in stages, staff and members who sheltered and were evacuated, a House chamber that was never entered, and a 6:00 pm curfew. The staff and members here are bystanders to the simulation: nothing can target or reach them. The "On the day" times are approximate and come from the Senate committees' June 2021 staff report and the Congressional Record.</p>
        <p>What it invents: every character, the straight-line route and the way rooms connect, police numbers and positions, how fast anything happens, and who prevails. The clock runs one minute per second and is not synchronized with the real timeline. No real person is depicted. The weapons are invention too, and the opposite of what the record shows: a solo player in the crowd carries a machine gun and grenades while the rest of that crowd is unarmed, and in the spectator Demo both sides carry guns and those hit drop out. It is not a documentary, a real building plan, or an endorsement of the attack.</p>
        <p>Public references inform the ribbed dome and colonnaded drum, winter grounds and inauguration stands, the Crypt's columns, Rotunda floor rings, Statuary Hall, and the House rostrum and seating. Clothing, flags, signs, phones and police equipment evoke documented appearances, not specific people or an exact inventory. This is a stylized procedural interpretation, not a photorealistic or security-accurate replica.</p>
        <a href="https://www.congress.gov/117/crec/2021/01/06/CREC-2021-01-06-pt1-PgS18-2.pdf" target="_blank" rel="noopener noreferrer">Congressional Record: January 6 Senate proceedings</a>
        <a href="https://www.aoc.gov/explore-capitol-campus/buildings-grounds/capitol-building/rotunda" target="_blank" rel="noopener noreferrer">Architect of the Capitol: Rotunda</a>
        <a href="https://www.aoc.gov/explore-capitol-campus/buildings-grounds/capitol-building/capitol-dome" target="_blank" rel="noopener noreferrer">Architect of the Capitol: Dome</a>
        <a href="https://history.house.gov/Exhibitions-and-Publications/House-Chamber/Rostrum/" target="_blank" rel="noopener noreferrer">House history: rostrum</a>
        <a href="https://americanhistory.si.edu/press/releases/smithsonian-continues-collecting-artifacts-jan-6-capitol-attack-2" target="_blank" rel="noopener noreferrer">Smithsonian: flags and police equipment</a>
        <a href="https://nsarchive.gwu.edu/briefing-book/foia/2021-05-04/capitol-riot-documents-you-should-read-part-3" target="_blank" rel="noopener noreferrer">National Security Archive: shield testimony</a>
    </div>;
}
