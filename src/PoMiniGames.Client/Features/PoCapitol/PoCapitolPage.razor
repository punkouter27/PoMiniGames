@page "/pocapitol"
@page "/pocapitol/{Mode}"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject GameResultService Results
@inject PlayerNameService PlayerNames
@inject ILogger<PoCapitolPage> Logger
@inject KioskCoordinator Kiosk

<PageTitle>PoCapitol · PoMiniGames</PageTitle>

<GameShell Title="@TitleContent" Fullscreen="true" RequiresWebGl="true" Announcement="@_announcement"
           Loading="@(_status == "loading")"
           LoadingLabel="Preparing the scene…"
           OptionsContent="@ScenarioOptions"
           OptionsHeading="Scenario options"
           GameOver="@((_status is "completed" or "failed") && !_demo)"
           GameOverDelayMs="1800"
           Outcome="@ResultOutcome"
           Stats="@ResultStats"
           GameSummary="@ResultSummary"
           GameDetails="@ResultDetails"
           Diagnostics="@DiagStats"
           DiagnosticsContent="@TabHudContent">
    <ErrorBoundary @ref="_errorBoundary">
        <ChildContent>
            <div class="pc-root @(_demo ? "pc-phonecam" : null) @(_prefs.contrast == "high" ? "pc-contrast" : null)">
                <div id="pocapitol-scene" class="pc-scene" role="img" aria-label="Fictional Capitol grounds and interiors"></div>
                <div class="pc-film" aria-hidden="true"></div>
                @if (_status == "active" && _caption.Length > 0)
                {
                    <div class="pc-caption" role="status" aria-live="polite">
                        <span class="pc-caption-tag">RADIO</span> @_caption
                    </div>
                }
                @if (_status != "active")
                {
                    <div class="pc-edition">PoCAPITOL <span>ALTERNATE HISTORY · FICTIONAL SCENARIO</span></div>
                }
                
                @* The shared start card, like every other game: one OK, controls beside the
                   rules, and this scenario's setup in the Options slot. It replaces a
                   bespoke three-tab Radzen panel so the first thing a player sees is the
                   same card shape they met on the other games. *@
                @if (_status == "intro" && _ready)
                {
                    <GameIntro CueScope="pocapitol"
                               Title="@TitleContent"
                               Objective="One afternoon, five police lines. Play it as the crowd, the line, or an observer."
                               Controls="@IntroControls"
                               HowToPlay="@IntroRules"
                               Options="@IntroOptions"
                               Mode="@(_demo ? GameIntro.IntroMode.Demo : GameIntro.IntroMode.OnePlayer)"
                               Wide="true"
                               OnStart="StartAsync" />
                }
                else if (_status == "error")
                {
                    @* The shared error view, inside the game area: same headline, message and
                       one retry button as the rest of the app. `loading` renders nothing here —
                       GameShell's skeleton already covers the stage while the engine boots. *@
                    <div class="pc-panel pc-centered">
                        <ErrorState Icon="⚠️" Title="The scenario could not load" OnRetry="LoadAsync">
                            <p>@_error</p>
                        </ErrorState>
                    </div>
                }
                else
                {
                    @* Tactical Unit Inspector Telemetry Card *@
                    @if (_selectedTelemetry != null)
                    {
                        <div class="pc-inspector-card" role="region" aria-label="Unit Telemetry">
                            <div class="pc-inspector-header">
                                <div class="pc-inspector-title">
                                    <span class="pc-badge @(_selectedTelemetry.faction == "police" ? "pc-badge--police" : "pc-badge--raider")">
                                        @_selectedTelemetry.faction.ToUpperInvariant()
                                    </span>
                                    <strong>@_selectedTelemetry.name</strong>
                                </div>
                                <button type="button" class="pc-debug-close" @onclick="ClearInspectAsync" aria-label="Close Inspector">✕</button>
                            </div>
                            <div class="pc-inspector-role">@_selectedTelemetry.role</div>
                            <div class="pc-inspector-status"><span>STATUS:</span> <b>@_selectedTelemetry.status</b></div>
                            <div class="pc-inspector-metrics">
                                <div>
                                    <span>STAMINA / HEALTH</span>
                                    <RadzenProgressBar Value="@_selectedTelemetry.health" Max="100" Unit="%" ShowValue="true" 
                                                       ProgressBarStyle="@GetHealthProgressStyle(_selectedTelemetry.health)" />
                                </div>
                                <div>
                                    <span>MORALE</span>
                                    <RadzenProgressBar Value="@_selectedTelemetry.stamina" Max="100" Unit="%" ShowValue="true" 
                                                       ProgressBarStyle="ProgressBarStyle.Info" />
                                </div>
                            </div>
                            <div class="pc-inspector-meta">
                                <span>@_selectedTelemetry.gear</span>
                                <span>Crowd density: @_selectedTelemetry.density.ToString("0.0") people/m²</span>
                                @if (!string.IsNullOrEmpty(_selectedTelemetry.lineAssignment))
                                {
                                    <span>Assignment: @_selectedTelemetry.lineAssignment</span>
                                }
                                @if (!string.IsNullOrEmpty(_selectedTelemetry.milestone))
                                {
                                    <span>Objective: @_selectedTelemetry.milestone</span>
                                }
                                @if (_selectedTelemetry.harmHits > 0)
                                {
                                    <span class="pc-harm">
                                        HARM: severity @_selectedTelemetry.harmSeverity/6 · @_selectedTelemetry.harmLossMl mL est.
                                        (@(_selectedTelemetry.harmHemorrhage == 0 ? "no class" : $"class {_selectedTelemetry.harmHemorrhage}")) ·
                                        triage <b>@_selectedTelemetry.harmTriage</b>
                                    </span>
                                }
                            </div>
                            <div class="pc-inspector-actions">
                                <button type="button" class="app-btn app-btn--primary" @onclick="ToggleLatchAsync">
                                    @(_selectedTelemetry.latched ? "Unlatch camera" : "Latch camera")
                                </button>
                                <button type="button" class="app-btn" @onclick="ClearInspectAsync">Deselect</button>
                            </div>
                        </div>
                    }
                    @if (_status == "active")
                    {
                        @if (Playing)
                        {
                            <div class="pc-crosshair" aria-hidden="true">+</div>
                        }
                        @if (!_demo)
                        {
                            <div class="pc-touch" aria-label="Touch controls">
                                <div class="pc-dpad">
                                    <button data-capitol-key="KeyW" aria-label="Move forward">↑</button>
                                    <button data-capitol-key="KeyA" aria-label="Move left">←</button>
                                    <button data-capitol-key="KeyS" aria-label="Move backward">↓</button>
                                    <button data-capitol-key="KeyD" aria-label="Move right">→</button>
                                </div>
                                @if (Playing)
                                {
                                    <button class="pc-fire" data-capitol-key="Space" aria-label="Push">PUSH</button>
                                }
                            </div>
                        }
                    }
                    else if (_status == "paused")
                    {
                        <section class="pc-panel pc-centered">
                        <GamePauseDialog LabelledBy="pc-paused" OnResume="() => PauseAsync(false)">
                            <span class="pc-eyebrow">TAKE A BREATH</span><h2 id="pc-paused">Scenario paused.</h2>
                            <p>The clock, the crowd and the lines are stopped.</p>
                            <label class="pc-small" for="pc-graphics-paused">Graphics · now @_graphicsLabel</label>
                            <RadzenSelectBar TValue="string" Value="@_graphics" Change="@(async (string value) => await SetGraphicsAsync(value))" id="pc-graphics-paused">
                                <Items>
                                    <RadzenSelectBarItem Text="Auto" Value="@("auto")" />
                                    <RadzenSelectBarItem Text="Low" Value="@("low")" />
                                    <RadzenSelectBarItem Text="High" Value="@("high")" />
                                </Items>
                            </RadzenSelectBar>
                            <div class="pc-actions">
                                <button type="button" class="app-btn app-btn--primary" @onclick="() => PauseAsync(false)">Resume</button>
                                <button type="button" class="app-btn" @onclick="StartAsync">Restart</button>
                            </div>
                            <details><summary>Historical context</summary>@ContextContent</details>
                        </GamePauseDialog>
                        </section>
                    }
                    else if (_status is "completed" or "failed")
                    {
                        @* The result is the shared end-of-game modal now (GameShell's
                           GameOver → GameOverModal): the same card, the same one button,
                           the same place in every game. Only the extra prose that is
                           specific to this scenario is projected as the summary. *@
                    }
                }

            </div>
        </ChildContent>
        <ErrorContent Context="ex">
            <div class="pc-panel pc-centered" role="alert">
                <h2>An interface error occurred</h2>
                <p>The scenario encountered an unexpected error: @ex.Message</p>
                <div class="pc-actions">
                    <button type="button" class="app-btn app-btn--primary" @onclick="RecoverFromError">Recover scenario</button>
                </div>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</GameShell>

@code {
    [Parameter] public string? Mode { get; set; }
    private static RenderFragment TitleContent => GameCatalog.TitleFor(GameKeys.PoCapitol);
    private static readonly string[] Objectives =
        ["Pass the barricades", "Enter the Crypt", "Reach the Rotunda", "Enter Statuary Hall", "Cross Statuary Hall", "Reach the House chamber doors"];
    private static readonly string[] LineNames =
        ["Bike-rack barricade", "Crypt doors", "Rotunda doors", "Statuary Hall doorway", "House corridor"];
    // Approximate times from the public record (the Senate committees' June 2021 staff report
    // and the Congressional Record). Shown beside the fictional clock, never driven by it.
    private static readonly (int Minute, string Time, string Text)[] Timeline =
    [
        (12 * 60 + 50, "12:53 PM", "The crowd breaches the first barricade on the west side of the grounds."),
        (13 * 60 + 5, "1:05 PM", "The joint session of Congress convenes to count electoral votes."),
        (13 * 60 + 50, "1:50 PM", "A riot is declared as police lines on the west front are pressed."),
        (14 * 60 + 12, "2:12 PM", "The first people enter the building through a broken window."),
        (14 * 60 + 20, "2:20 PM", "The Senate and then the House go into recess; evacuations begin."),
        (14 * 60 + 45, "2:45 PM", "The chambers are being emptied. The House chamber doors are barricaded from inside."),
        (16 * 60 + 17, "4:17 PM", "A recorded message tells the crowd to go home."),
        (17 * 60 + 40, "5:40 PM", "Police report the interior of the building cleared."),
        (18 * 60, "6:00 PM", "The citywide curfew begins."),
    ];
    private DotNetObjectReference<PoCapitolPage>? _reference;
    private ErrorBoundary? _errorBoundary;
    private string _status = "loading", _difficulty = "standard", _error = "", _message = "", _announcement = "";
    private string _resultWarning = "", _role = "raider", _outcome = "", _graphics = "auto", _graphicsLabel = "Auto";
    private string _weatherMode = "historical", _weatherCondition = "Jan 6 Archive · 42.4°F";
    private string _tracerMode = "luminous", _motionMode = "full";
    private bool _radarExpanded = true;
    private TelemetryDto? _selectedTelemetry;
    private int _health = 100, _milestone;
    private double _elapsed;
    private bool _ready, _disposed, _recorded;
    private bool _demo;
    private string? _mode;
    private int _activeRaiders = 256, _activePolice = 44, _totalPolice = 44, _subject, _lineIndex, _lineIntegrity = 100, _sheltering = 64, _grenades;
    private bool _radarNeedsInit = true;
    private PrefsDto _prefs = new();
    private ReportDto? _report;
    private string _caption = "";
    private DateTime _captionStamp;

    private static readonly string[] KeyChoices =
        ["KeyW", "KeyA", "KeyS", "KeyD", "KeyQ", "KeyE", "KeyI", "KeyJ", "KeyK", "KeyL", "KeyF", "KeyR", "Space", "ShiftLeft", "ControlLeft", "KeyP"];

    private IEnumerable<(string Action, string Label, string Code)> KeyRows =>
    [
        ("forward", "Move forward", _prefs.forward),
        ("back", "Move back", _prefs.back),
        ("left", "Move left", _prefs.left),
        ("right", "Move right", _prefs.right),
        ("push", "Push", _prefs.push),
        ("sprint", "Sprint", _prefs.sprint),
        ("pause", "Pause", _prefs.pause),
    ];

    private bool Playing => !_demo && _role != "observer";
    private string Objective => _milestone < Objectives.Length ? Objectives[_milestone] : "Chamber doors reached";
    private string Clock => DateTime.Today.AddMinutes(12 * 60 + 50 + Math.Floor(_elapsed)).ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture);
    private (int Minute, string Time, string Text) OnTheDay =>
        Timeline.Last(entry => entry.Minute <= Math.Max(Timeline[0].Minute, 12 * 60 + 50 + (int)_elapsed));
    private string HudEyebrow => _role == "raider" || _demo ? $"OBJECTIVE {Math.Min(_milestone + 1, Objectives.Length)} / {Objectives.Length}"
        : _role == "police" ? "HOLD UNTIL THE 6:00 PM CURFEW" : "OBSERVING · CROWD PROGRESS";
    private string HudTitle => _role == "police" && !_demo
        ? (_lineIndex >= 0 ? $"Hold the {LineNames[_lineIndex].ToLowerInvariant()}" : "Fall back to the chamber doors") : Objective;
    private string RoleBrief => _role switch
    {
        "police" => "Stand in the line and push back. You win by keeping the crowd from the chamber doors until the curfew. Not saved to your stats.",
        "observer" => "Walk anywhere and watch. Nobody targets you, you cannot push, and nothing is saved.",
        _ => "Lean on a line with the crowd to tip it. Reach the House chamber doors before the curfew.",
    };
    private string BottomHint => _demo ? "AUTONOMOUS DEMO · P PAUSE"
        : _message.Length > 0 ? _message
        : _role == "observer" ? "WASD move · Click scene to look · P pause"
        : "WASD move · Click scene to look · Space fire · G grenade · P pause";
    private string ResultHeading => _outcome switch
    {
        "doors" => "The doors stayed shut.",
        "curfew" => "Six o'clock. Curfew.",
        "overcome" => _role == "police" ? "Pulled back from the line." : "Helped away.",
        "dispersed" => "The crowd is spent.",
        _ => "Attempt ended.",
    };
    private string ResultBody => _outcome switch
    {
        "doors" => "The crowd reached the House chamber doors and found them barricaded. The chamber behind them had been evacuated. "
            + (_role == "police" ? "The lines did not hold long enough." : "Nobody in this scenario gets in, as nobody did. Reaching the doors ends the game; it is not a historical victory."),
        "curfew" => _role == "police" ? "The lines held until the curfew and the building was cleared."
            : "The lines held. At 6:00 pm the curfew began and the building was cleared.",
        "overcome" => _role == "police" ? "You were worn down and pulled back behind the line. The scenario ends here."
            : "Batons, spray and gas wore you down, and street medics walked you back to the aid station. A new attempt starts outside.",
        "dispersed" => _demo ? "Every raider has been eliminated. The armed demo follows no record; it starts again shortly."
            : "Nobody in the crowd is still on their feet. The building is cleared.",
        _ => "The scenario has ended.",
    };

    // ── Shared start and end cards ──
    // The scenario used to carry its own three-tab start panel and its own result
    // panel. Both are the shared components now, so PoCapitol opens and closes the
    // way every other game does; only this scenario's own prose and numbers are fed in.

    private List<StatItem> ResultStats =>
    [
        new() { Label = "TIME OF DAY", Value = Clock },
        new() { Label = "MILESTONES", Value = $"{_milestone} / {Objectives.Length}" },
        new() { Label = "STILL STANDING", Value = _activeRaiders.ToString() },
    ];

    private GameResult ResultOutcome => _status switch
    {
        "completed" => GameResult.Win,
        "failed" => GameResult.Loss,
        _ => GameResult.InProgress,
    };

    private string ResultNote =>
        _role != "raider" ? "Police-line and observer attempts are not saved."
        : _resultWarning.Length > 0 ? _resultWarning
        : "Results stay in your local game stats. No public ranking and no score for harming anyone.";

    private RenderFragment ResultSummary => @<div>
        <div>@ResultBody</div>
        <div>@ResultNote</div>
        <div>What happened afterwards: the real building was cleared that evening, a citywide curfew began at 6:00 pm, the Senate reconvened at about 8:00 pm, and Congress finished certifying the election at about 3:40 am on January 7.</div>
    </div>;

    /// <summary>
    /// The after-action report, below the result summary: what the attempt actually looked like,
    /// from the sampled series the engine already keeps. Charts and files only — no score, and
    /// nothing leaves the browser unless the player exports it.
    /// </summary>
    private RenderFragment ResultDetails => @<div class="pc-report">
        @if (_report is { svg.Length: > 0 } report)
        {
            <div class="pc-report-chart">@((MarkupString)report.svg)</div>
            <dl class="pc-report-facts">
                <div><dt>Milestones</dt><dd>@report.milestones / @Objectives.Length</dd></div>
                <div><dt>Lowest line</dt><dd>@report.lowestIntegrity%</dd></div>
                <div><dt>Peak pressure</dt><dd>@report.peakPressure.ToString("0.0")</dd></div>
                <div><dt>First break</dt><dd>@(report.firstBreak < 0 ? "never" : $"{report.firstBreak:0}s")</dd></div>
                <div><dt>Casualties</dt><dd>@report.casualties (@report.immediate immediate)</dd></div>
                <div><dt>Standing</dt><dd>@report.standing raiders · @report.police police</dd></div>
            </dl>
            <div class="pc-report-actions">
                <button type="button" class="app-btn app-btn--sm" @onclick="ExportCsvAsync">Export CSV</button>
                <button type="button" class="app-btn app-btn--sm" @onclick="ExportPngAsync">Save chart (PNG)</button>
                <button type="button" class="app-btn app-btn--sm" @onclick="CopySummaryAsync">Copy summary</button>
            </div>
        }
    </div>;

    private IEnumerable<StatItem> DiagStats =>
    [
        new() { Label = "Status", Value = _status },
        new() { Label = "Role", Value = _role },
        new() { Label = "Objective", Value = $"{Math.Min(_milestone + 1, Objectives.Length)}/{Objectives.Length} · {HudTitle}" },
        new() { Label = "Clock", Value = $"{Clock} ({_elapsed:0.0}s)" },
        new() { Label = "Weather", Value = _weatherCondition },
        new() { Label = "Crowd", Value = $"{_activeRaiders} / 256 in crowd ({256 - _activeRaiders} down)" },
        new() { Label = "Police", Value = $"{_activePolice} / {_totalPolice} Capitol Police" },
        new() { Label = "Line", Value = _lineIndex >= 0 ? $"{LineNames[_lineIndex]} {_lineIntegrity}%" : "None" },
        new() { Label = "Sheltering", Value = _sheltering.ToString() },
        new() { Label = "Tier", Value = _graphicsLabel },
    ];

    private RenderFragment TabHudContent => @<div class="pc-tab-hud @(_prefs.contrast == "high" ? "pc-contrast" : null)">
        <div class="pc-tab-hud-head">
            <div>
                <div class="pc-hud-eyebrow-row">
                    <span class="pc-eyebrow">@HudEyebrow</span>
                    @if (_demo)
                    {
                        <span class="pc-rec-pill" aria-hidden="true"><i></i>REC</span>
                    }
                </div>
                <strong>@HudTitle</strong>
            </div>
            <button type="button" class="app-btn app-btn--sm" @onclick="() => PauseAsync(true)" disabled="@(_status != "active")">Pause</button>
        </div>

        <div class="pc-progress" aria-label="@($"{_milestone} of {Objectives.Length} milestones complete")">
            @for (var i = 0; i < Objectives.Length; i++)
            {
                <span class="@(i < _milestone ? "pc-done" : null)"></span>
            }
        </div>

        @if (_lineIndex >= 0)
        {
            <div class="pc-tab-bar">
                <div class="pc-line-header">
                    <span>LINE: @LineNames[_lineIndex].ToUpperInvariant()</span>
                    <span>@_lineIntegrity%</span>
                </div>
                <RadzenProgressBar Value="@_lineIntegrity" Max="100" Unit="" ShowValue="false"
                                   ProgressBarStyle="@GetLineProgressStyle(_lineIntegrity)" Class="pc-progress-bar" />
            </div>
        }

        @if (Playing)
        {
            <div class="pc-tab-bar">
                <div class="pc-health-header">
                    <span>STAMINA</span>
                    <span>@_health%</span>
                </div>
                <RadzenProgressBar Value="@_health" Max="100" Unit="" ShowValue="false"
                                   ProgressBarStyle="@GetHealthProgressStyle(_health)" Class="pc-progress-bar" />
                @if (_grenades > 0)
                {
                    <div class="pc-health-header" style="margin-top:.5rem;">
                        <span>GRENADES · G</span>
                        <span>@_grenades</span>
                    </div>
                }
            </div>
        }

        <div class="pc-crowd">
            <span>@_activeRaiders / 256 IN CROWD</span>
            <span>@_activePolice / @_totalPolice CAPITOL POLICE</span>
            @if (_demo && _subject > 0)
            {
                <b>FOLLOWING RAIDER @_subject:000</b>
            }
        </div>

        <div class="pc-tab-meta">
            <span class="pc-weather-pill" title="Atmospheric conditions">⛅ @_weatherCondition</span>
            <span class="pc-time">@Clock</span>
        </div>

        @if (_demo)
        {
            <div class="pc-demo-chip" title="Armed demo variant for autonomous tactical simulation.">
                <span class="pc-rec-pill" aria-hidden="true"><i></i>LIVE SIMULATION</span>
                <strong>ARMED DEMO · @(_subject > 0 ? $"TRACKING RAIDER {_subject:000}" : "AUTONOMOUS")</strong>
            </div>
        }
        else if (_role == "raider")
        {
            <div class="pc-beacon-chip">BEACON · @Objective.ToUpperInvariant()</div>
        }

        <div class="pc-hint-chip">@BottomHint</div>

        <div class="pc-onthisday-chip" title="@OnTheDay.Text">
            <span class="pc-eyebrow">HISTORICAL RECORD · @OnTheDay.Time</span>
            <span>@OnTheDay.Text</span>
        </div>

        <div class="pc-tab-radar">
            <div class="pc-radar-header">
                <button type="button" class="pc-radar-toggle" @onclick="ToggleRadar" title="Toggle Tactical Radar">
                    <span>📡 RADAR</span>
                    <small>@(_radarExpanded ? "▲" : "▼")</small>
                </button>
            </div>
            @if (_radarExpanded)
            {
                <div class="pc-radar-body">
                    <canvas id="pocapitol-radar" class="pc-radar-canvas" width="200" height="270"></canvas>
                    <div class="pc-radar-legend">
                        <span><i class="dot-raider"></i>Raider</span>
                        <span><i class="dot-police"></i>Police</span>
                        <span><i class="dot-heat"></i>Crush</span>
                    </div>
                </div>
            }
        </div>

        @if (_report is { } report)
        {
            <div class="pc-tab-report">
                <strong>Last attempt</strong>
                <p class="pc-small">@report.mode · @report.outcome · @report.milestones milestones · lowest line @report.lowestIntegrity% · @report.casualties casualties</p>
                <div class="pc-report-actions">
                    <button type="button" class="app-btn app-btn--sm" @onclick="ExportCsvAsync">Export CSV</button>
                    <button type="button" class="app-btn app-btn--sm" @onclick="CopySummaryAsync">Copy summary</button>
                </div>
            </div>
        }

        <button type="button" class="app-btn app-btn--sm" @onclick="CopyDiagnosticsAsync">Copy diagnostics</button>
    </div>;

    /// <summary>
    /// Mid-match options for GameShell's shared gear (GameOptionsSheet): the same drawer
    /// every other game uses. Role and difficulty are *not* here — they belong on the
    /// start card — and the diagnostics that used to live in this drawer are the Tab
    /// panel now, in every game.
    /// </summary>
    private RenderFragment ScenarioOptions => @<div>
        <label class="pc-small" for="pc-opt-graphics">Graphics quality</label>
        <RadzenSelectBar TValue="string" Value="@_graphics" Change="@(async (string value) => await SetGraphicsAsync(value))" id="pc-opt-graphics">
            <Items>
                <RadzenSelectBarItem Text="Auto" Value="@("auto")" />
                <RadzenSelectBarItem Text="Low" Value="@("low")" />
                <RadzenSelectBarItem Text="High" Value="@("high")" />
            </Items>
        </RadzenSelectBar>
        <p class="pc-small">Active tier: @_graphicsLabel</p>

        <label class="pc-small" for="pc-opt-weather">Atmospheric conditions (Open-Meteo)</label>
        <RadzenSelectBar TValue="string" Value="@_weatherMode" Change="@(async (string val) => await SetWeatherAsync(val))" id="pc-opt-weather">
            <Items>
                <RadzenSelectBarItem Text="Jan 6 Archive" Value="@("historical")" />
                <RadzenSelectBarItem Text="Live D.C." Value="@("live")" />
                <RadzenSelectBarItem Text="Clear" Value="@("clear")" />
                <RadzenSelectBarItem Text="Winter Gale" Value="@("blizzard")" />
            </Items>
        </RadzenSelectBar>
        <p class="pc-small">@_weatherCondition</p>

        <label class="pc-small" for="pc-opt-tracers">Ballistic tracers</label>
        <RadzenSelectBar TValue="string" Value="@_tracerMode" Change="@(async (string val) => await SetTracerModeAsync(val))" id="pc-opt-tracers">
            <Items>
                <RadzenSelectBarItem Text="Luminous" Value="@("luminous")" />
                <RadzenSelectBarItem Text="Stealth" Value="@("stealth")" />
                <RadzenSelectBarItem Text="Off" Value="@("off")" />
            </Items>
        </RadzenSelectBar>

        <label class="pc-small" for="pc-opt-motion">Combat motion &amp; shake</label>
        <RadzenSelectBar TValue="string" Value="@_motionMode" Change="@(async (string val) => await SetMotionModeAsync(val))" id="pc-opt-motion">
            <Items>
