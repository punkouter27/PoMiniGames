    private async Task OnSensitivityChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            await SavePrefsAsync(sensitivity: value);
        }
    }

    private async Task OnFovChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value)) await SavePrefsAsync(fov: value);
    }

    private Task SetKeyAsync(string action, object? value) => SavePrefsAsync(keyAction: action, keyCode: value?.ToString());

    private static string DescribeKey(string code) => code switch
    {
        "Space" => "Space",
        "ShiftLeft" => "Shift",
        "ControlLeft" => "Ctrl",
        _ => code.StartsWith("Key") ? code[3..] : code,
    };

    /// <summary>
    /// Save one or more comfort settings. Values are echoed back from the engine sanitised, so
    /// a slider that leaves the allowed range snaps to the clamped value rather than drifting.
    /// </summary>
    private async Task SavePrefsAsync(double? sensitivity = null, int? fov = null, bool? captions = null,
        string? contrast = null, string? radar = null, bool? director = null, string? keyAction = null, string? keyCode = null)
    {
        if (sensitivity is not null) _prefs.sensitivity = sensitivity.Value;
        if (fov is not null) _prefs.fov = fov.Value;
        if (captions is not null)
        {
            _prefs.captions = captions.Value;
            if (!_prefs.captions) _caption = "";
        }
        if (contrast is not null) _prefs.contrast = contrast;
        if (radar is not null) _prefs.radar = radar;
        if (director is not null) _prefs.director = director.Value;
        if (keyAction is not null && !string.IsNullOrEmpty(keyCode))
        {
            switch (keyAction)
            {
                case "forward": _prefs.forward = keyCode; break;
                case "back": _prefs.back = keyCode; break;
                case "left": _prefs.left = keyCode; break;
                case "right": _prefs.right = keyCode; break;
                case "push": _prefs.push = keyCode; break;
                case "sprint": _prefs.sprint = keyCode; break;
                case "pause": _prefs.pause = keyCode; break;
            }
        }
        try
        {
            _prefs = await JS.InvokeAsync<PrefsDto>("PoCapitol.setPrefs", new
            {
                sensitivity = _prefs.sensitivity,
                fov = _prefs.fov,
                captions = _prefs.captions,
                contrast = _prefs.contrast,
                radar = _prefs.radar,
                director = _prefs.director,
                keys = new
                {
                    forward = _prefs.forward,
                    back = _prefs.back,
                    left = _prefs.left,
                    right = _prefs.right,
                    push = _prefs.push,
                    sprint = _prefs.sprint,
                    pause = _prefs.pause,
                },
            });
        }
        catch (JSException ex)
        {
            // A comfort setting is not worth ending the scenario for: keep the local value and move on.
            Logger.LogWarning(ex, "PoCapitol could not persist comfort settings");
        }
        StateHasChanged();
    }

