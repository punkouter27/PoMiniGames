@page "/pocapitol"
@page "/pocapitol/{Mode}"
@using System.Globalization
@inject IJSRuntime JS
@inject GameResultService Results
@inject PlayerNameService PlayerNames
@inject ILogger<PoCapitolPage> Logger
@inject KioskCoordinator Kiosk
@inject ApiService Api

@* State, engine calls and the engine's records are in PoCapitolPage.razor.cs. This file is
   the markup and the render fragments handed to the shared shell. *@

<PageTitle>PoCapitol · PoMiniGames</PageTitle>

<GameShell Title="@TitleContent" Fullscreen="true" RequiresWebGl="true" Announcement="@_announcement"
           Loading="@(_status == "loading")"
           LoadingLabel="Preparing the scene…"
           OptionsContent="@ScenarioOptions"
           OptionsHeading="Scenario options"
           GameOver="@((_status is "completed" or "failed") && !_demo)"
           GameOverDelayMs="1800"
           Outcome="@ResultOutcome"
           Stats="@ResultStats"
           GameSummary="@ResultSummary"
           GameDetails="@ResultDetails"
           Diagnostics="@DiagStats"
           DiagnosticsContent="@TabHudContent">
    <ErrorBoundary @ref="_errorBoundary">
        <ChildContent>
            <div class="pc-root @(_demo ? "pc-phonecam" : null) @(_prefs.contrast == "high" ? "pc-contrast" : null)">
                <div id="pocapitol-scene" class="pc-scene" role="img" aria-label="Fictional Capitol grounds and interiors"></div>
                <div class="pc-film" aria-hidden="true"></div>
                @* Always in the tree while play is live, so a caption arriving or clearing
                   never inserts or removes a node over the scene. *@
                @if (_status == "active")
                {
                    <div class="pc-caption @(_caption.Length == 0 ? "pc-caption--idle" : null)" role="status" aria-live="polite">
                        @if (_caption.Length > 0)
                        {
                            <span class="pc-caption-tag">RADIO</span> @_caption
                        }
                    </div>
                    @HudContent
                }
                @if (_status != "active")
                {
                    <div class="pc-edition">PoCAPITOL <span>ALTERNATE HISTORY · FICTIONAL SCENARIO</span></div>
                }

                @* The shared start card, like every other game: one OK, controls beside the
                   rules, and this scenario's setup in the Options slot. *@
                @if (_status == "intro" && _ready)
                {
                    <GameIntro CueScope="pocapitol"
                               Title="@TitleContent"
                               Objective="One afternoon, five police lines. Play it as the crowd, the line, the commander, or an observer."
                               Controls="@IntroControls"
                               HowToPlay="@IntroRules"
                               Options="@IntroOptions"
                               Mode="@(_demo ? GameIntro.IntroMode.Demo : GameIntro.IntroMode.OnePlayer)"
                               Wide="true"
                               OnStart="StartAsync" />
                }
                else if (_status == "error")
                {
                    @* The shared error view, inside the game area: same headline, message and
                       one retry button as the rest of the app. `loading` renders nothing here —
                       GameShell's skeleton already covers the stage while the engine boots. *@
                    <div class="pc-panel pc-centered">
                        <ErrorState Icon="⚠️" Title="The scenario could not load" OnRetry="LoadAsync">
                            <p>@_error</p>
                        </ErrorState>
                    </div>
                }
                else
                {
                    @* Only while play is live: a paused or finished scenario has its own panel on top. *@
                    @if (_selectedTelemetry != null && _status == "active")
                    {
                        @* The card is tethered to the person it describes (leader.js writes the
                           anchor and the line every frame); without an anchor it sits in its corner. *@
                        <svg class="pc-leader" aria-hidden="true"><line x1="0" y1="0" x2="0" y2="0" /><circle cx="0" cy="0" r="5" /></svg>
                        <div class="pc-inspector-card" role="region" aria-label="Unit telemetry">
                            <div class="pc-inspector-header">
                                <div class="pc-inspector-title">
                                    <span class="pc-badge @(_selectedTelemetry.faction == "police" ? "pc-badge--police" : "pc-badge--raider")">
                                        @_selectedTelemetry.faction.ToUpperInvariant()
                                    </span>
                                    <strong>@_selectedTelemetry.name</strong>
                                </div>
                                <button type="button" class="pc-debug-close" @onclick="ClearInspectAsync" aria-label="Close inspector"><span class="material-symbols-outlined" aria-hidden="true">close</span></button>
                            </div>
                            <div class="pc-inspector-role">@_selectedTelemetry.role · <b>@_selectedTelemetry.status</b></div>
                            <div class="pc-inspector-metrics">
                                @* The DTO's `stamina` is the unit's morale (inspector.js), so it is labelled that. *@
                                <div class="pc-ring @(Tone(_selectedTelemetry.health))" style="--v: @_selectedTelemetry.health; --g: @_selectedTelemetry.health" role="meter"
                                     aria-valuenow="@_selectedTelemetry.health" aria-valuemin="0" aria-valuemax="100" aria-label="Health">
                                    <span class="pc-hud-num">@_selectedTelemetry.health</span><small>HEALTH</small>
                                </div>
                                <div class="pc-ring pc-ring--info" style="--v: @_selectedTelemetry.stamina; --g: @_selectedTelemetry.stamina" role="meter"
                                     aria-valuenow="@_selectedTelemetry.stamina" aria-valuemin="0" aria-valuemax="100" aria-label="Morale">
                                    <span class="pc-hud-num">@_selectedTelemetry.stamina</span><small>MORALE</small>
                                </div>
                                <dl class="pc-inspector-facts">
                                    <div><dt>Density</dt><dd>@_selectedTelemetry.density.ToString("0.0")/m²</dd></div>
                                    @if (!string.IsNullOrEmpty(_selectedTelemetry.lineAssignment))
                                    {
                                        <div><dt>Line</dt><dd>@_selectedTelemetry.lineAssignment</dd></div>
                                    }
                                    @if (!string.IsNullOrEmpty(_selectedTelemetry.milestone))
                                    {
                                        <div><dt>Heading for</dt><dd>@_selectedTelemetry.milestone</dd></div>
                                    }
                                </dl>
                            </div>
                            <div class="pc-inspector-meta">
                                <span>@_selectedTelemetry.gear</span>
                                @if (_selectedTelemetry.harmHits > 0)
                                {
                                    <span class="pc-harm">
                                        Harm: severity @_selectedTelemetry.harmSeverity/6 · @_selectedTelemetry.harmLossMl mL est.
                                        (@(_selectedTelemetry.harmHemorrhage == 0 ? "no class" : $"class {_selectedTelemetry.harmHemorrhage}")) ·
                                        triage <b>@_selectedTelemetry.harmTriage</b>
                                    </span>
                                }
                            </div>
                            <div class="pc-inspector-actions">
                                <button type="button" class="app-btn app-btn--primary" @onclick="ToggleLatchAsync">
                                    <span class="material-symbols-outlined" aria-hidden="true">@(_selectedTelemetry.latched ? "videocam_off" : "videocam")</span>
                                    @(_selectedTelemetry.latched ? "Unlatch camera" : "Latch camera")
                                </button>
                                <button type="button" class="app-btn" @onclick="ClearInspectAsync">Deselect</button>
                            </div>
                        </div>
                    }
                    @if (_status == "active")
                    {
                        @if (Playing)
                        {
                            <div class="pc-crosshair" aria-hidden="true">+</div>
                        }
                        @if (Commanding && _command is { } board)
                        {
                            var integrity = Csv(board.integrity);
                            var braced = Csv(board.braced);
                            var strain = Csv(board.strain);
                            var officers = Csv(board.officers);
                            <section class="pc-command" aria-label="Incident command">
                                <header class="pc-command-head">
                                    <span class="pc-eyebrow">INCIDENT COMMAND</span>
                                    <span class="pc-command-tally"><span class="material-symbols-outlined" aria-hidden="true">campaign</span>@board.issued
                                        <span class="material-symbols-outlined" aria-hidden="true">air</span>@board.gas</span>
                                </header>
                                <ol class="pc-command-lines">
                                    @for (var i = 0; i < LineNames.Length; i++)
                                    {
                                        var line = i;
                                        var value = line < integrity.Length ? integrity[line] : -1;
                                        var on = board.selected == line;
                                        var tired = line < strain.Length ? strain[line] : 0;
                                        var isBraced = line < braced.Length && braced[line] == 1;
                                        <li>
                                            <button type="button" class="pc-command-line @(on ? "pc-command-line--on" : null) @(value < 0 ? "pc-command-line--fallen" : null) @(isBraced ? "pc-command-line--braced" : null)"
                                                    aria-pressed="@(on ? "true" : "false")" disabled="@(value < 0)" @onclick="@(() => OrderAsync("select", line))"
                                                    aria-label="@($"{LineNames[line]}: {(value < 0 ? "fallen back" : $"{value}% holding, {(line < officers.Length ? officers[line] : 0)} officers, {tired}% tired{(isBraced ? ", braced" : "")}")}")">
                                                <span class="pc-ring pc-ring--sm @(Tone(Math.Max(0, value)))" style="--v: @Math.Max(0, value); --g: @Math.Max(0, value)" aria-hidden="true">
                                                    <span class="pc-hud-num">@(value < 0 ? "—" : value.ToString(CultureInfo.InvariantCulture))</span>
                                                </span>
                                                <span class="pc-command-text">
                                                    <span class="pc-command-name"><kbd>@(line + 1)</kbd> @LineNames[line]</span>
                                                    <span class="pc-command-meta" aria-hidden="true">
                                                        @if (value < 0)
                                                        {
                                                            <span>Fallen back</span>
                                                        }
                                                        else
                                                        {
                                                            <span><span class="material-symbols-outlined">groups</span>@(line < officers.Length ? officers[line] : 0)</span>
                                                            @if (isBraced)
                                                            {
                                                                <span class="pc-command-braced"><span class="material-symbols-outlined">shield</span>braced</span>
                                                            }
                                                        }
                                                    </span>
                                                    <span class="pc-command-tired" aria-hidden="true" title="Front rank fatigue"><i style="width: @tired%"></i></span>
                                                </span>
                                            </button>
                                        </li>
                                    }
                                </ol>
                                <div class="pc-command-orders">
                                    @foreach (var (order, label, key, icon) in Orders)
                                    {
                                        var wait = OrderWait(order);
                                        var name = order;
                                        var sweep = OrderSweep(order);
                                        <button type="button" class="pc-order @(wait > 0 ? "pc-order--cooling" : null)" style="--cd: @sweep"
                                                disabled="@(wait > 0 || (name == "gas" && board.gas == 0) || _orderBusy)"
                                                aria-label="@($"{label} ({key}){(wait > 0 ? $", ready in {wait} seconds" : "")}")"
                                                @onclick="() => OrderAsync(name, board.selected)">
                                            <span class="material-symbols-outlined" aria-hidden="true">@icon</span>
                                            <span class="pc-order-label">@label</span>
                                            <kbd aria-hidden="true">@(wait > 0 ? $"{wait}s" : key)</kbd>
                                        </button>
                                    }
                                </div>
                                <p class="pc-command-reply" role="status">@board.reply</p>
                            </section>
                        }
                        @if (_prefs.overlay == "density")
                        {
                            <div class="pc-legend" aria-label="Crowd density legend">
                                <span class="pc-eyebrow">DENSITY · FRUIN LEVEL OF SERVICE · V</span>
                                <span><i class="pc-swatch pc-swatch--b"></i>B &lt;1.1/m²</span>
                                <span><i class="pc-swatch pc-swatch--c"></i>C &lt;1.5</span>
                                <span><i class="pc-swatch pc-swatch--d"></i>D &lt;3.6</span>
                                <span><i class="pc-swatch pc-swatch--e"></i>E &lt;5.4</span>
                                <span><i class="pc-swatch pc-swatch--f"></i>F crush</span>
                                <span><i class="pc-swatch pc-swatch--risk"></i>Packed + force</span>
                            </div>
                        }
                        else if (_prefs.overlay == "contagion")
                        {
                            <div class="pc-legend" aria-label="Contagion legend">
                                <span class="pc-eyebrow">CONTAGION · V</span>
                                <span><i class="pc-swatch pc-swatch--push"></i>Pushing</span>
                                <span><i class="pc-swatch pc-swatch--tip"></i>Tipping</span>
                                <span><i class="pc-swatch pc-swatch--calm"></i>Calm</span>
                                <span><i class="pc-swatch pc-swatch--back"></i>Retreating</span>
                            </div>
                        }
                        @if (!_demo && !Commanding)
                        {
                            <div class="pc-touch" aria-label="Touch controls">
                                <div class="pc-dpad">
                                    <button type="button" data-capitol-action="forward" aria-label="Move forward">↑</button>
                                    <button type="button" data-capitol-action="left" aria-label="Move left">←</button>
                                    <button type="button" data-capitol-action="back" aria-label="Move backward">↓</button>
                                    <button type="button" data-capitol-action="right" aria-label="Move right">→</button>
                                </div>
                                @if (Playing)
                                {
                                    <div class="pc-touch-actions">
                                        @if (Armed)
                                        {
                                            @* The same grenades as G and H, with what is left on the button. *@
                                            <button type="button" class="pc-throw" data-capitol-throw="concussion" disabled="@(_grenades == 0)"
                                                    aria-label="@($"Throw a concussion grenade, {_grenades} left")">GREN<small>@_grenades</small></button>
                                            <button type="button" class="pc-throw" data-capitol-throw="smoke" disabled="@(_smoke == 0)"
                                                    aria-label="@($"Throw a smoke grenade, {_smoke} left")">SMOKE<small>@_smoke</small></button>
                                        }
                                        <button type="button" class="pc-fire" data-capitol-action="push"
                                                aria-label="@(Armed ? "Fire" : "Push")">@(Armed ? "FIRE" : "PUSH")</button>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (_status == "paused")
                    {
                        <section class="pc-panel pc-centered">
                        <GamePauseDialog LabelledBy="pc-paused" OnResume="() => PauseAsync(false)">
                            <span class="pc-eyebrow">TAKE A BREATH</span><h2 id="pc-paused">Scenario paused.</h2>
                            <p>The clock, the crowd and the lines are stopped.</p>
                            <label class="pc-small" for="pc-graphics-paused">Graphics · now @_graphicsLabel</label>
                            @GraphicsPicker("pc-graphics-paused")
                            <div class="pc-actions">
                                <button type="button" class="app-btn app-btn--primary" @onclick="() => PauseAsync(false)">Resume</button>
                                @* Held, not clicked: ui.js fills a ring and only then lets the click through. *@
                                <button type="button" class="app-btn pc-hold" data-hold @onclick="StartAsync" aria-describedby="pc-hold-hint">
                                    <span class="material-symbols-outlined" aria-hidden="true">restart_alt</span> Hold to restart
                                </button>
                                <span id="pc-hold-hint" class="pc-visually-hidden">Press and hold to restart the attempt.</span>
                            </div>
                            <details><summary>Historical context</summary>@ContextContent</details>
                        </GamePauseDialog>
                        </section>
                    }
                    @* completed / failed: the result is the shared end-of-game modal (GameShell's
                       GameOver → GameOverModal). Only this scenario's prose is projected into it. *@
                }

            </div>
        </ChildContent>
        <ErrorContent Context="ex">
            @* The shared error view, the same one the load failure uses; the exception text
               goes to the log, not the player. *@
            <div class="pc-panel pc-centered">
                <ErrorState Icon="⚠️" Title="An interface error occurred" OnRetry="RecoverFromError" RetryLabel="Recover scenario">
                    <p>The scenario hit an unexpected error. Recover to reload it, or return to all games.</p>
                </ErrorState>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</GameShell>

@code {
    /// <summary>The one graphics picker, used on the start card, the pause dialog and the options sheet.</summary>
    private RenderFragment<string> GraphicsPicker => id => @<RadzenSelectBar TValue="string" Value="@_graphics" Change="@(async (string value) => await SetGraphicsAsync(value))" id="@id">
        <Items>
            <RadzenSelectBarItem Text="Auto" Value="@("auto")" />
            <RadzenSelectBarItem Text="Low" Value="@("low")" />
            <RadzenSelectBarItem Text="High" Value="@("high")" />
        </Items>
    </RadzenSelectBar>;

    /// <summary>
    /// The always-on heads-up strip while play is live: the clock, milestone pips and what to do
    /// now at the top; the player's own vitals bottom-left. Everything else is the Tab panel's.
    /// </summary>
    private RenderFragment HudContent => @<div class="pc-hud">
        <div class="pc-hud-top">
            <div class="pc-hud-row">
                @if (_demo)
                {
                    <span class="pc-rec-pill" aria-hidden="true"><i></i>REC</span>
                }
                <span class="pc-hud-clock" aria-label="@($"Time {Clock}")">@Clock</span>
                <div class="pc-progress" role="img" aria-label="@($"{_milestone} of {Objectives.Length} milestones complete")">
                    @for (var i = 0; i < Objectives.Length; i++)
                    {
                        <span class="@(i < _milestone ? "pc-done" : null)"></span>
                    }
                </div>
            </div>
            <span class="pc-hud-title">@HudTitle</span>
        </div>

        @if (Playing)
        {
            <div class="pc-hud-vitals">
                <div class="pc-ring @(Tone(_health))" style="--v: @_health; --g: @_health" role="meter" aria-valuenow="@_health" aria-valuemin="0" aria-valuemax="100" aria-label="Stamina">
                    <span class="pc-hud-num">@_health</span><small>STAMINA</small>
                </div>
                @if (_role == "police" && _lineIndex >= 0)
                {
                    <div @key="_lineIndex" class="pc-ring pc-ring--line @(Tone(_lineIntegrity)) @(_lineIndex > 0 ? "pc-shake" : null)" style="--v: @_lineIntegrity; --g: @_lineIntegrity"
                         role="meter" aria-valuenow="@_lineIntegrity" aria-valuemin="0" aria-valuemax="100" aria-label="@($"{LineNames[_lineIndex]} holding")">
                        <span class="pc-hud-num">@_lineIntegrity</span><small>LINE @(_lineIndex + 1)</small>
                    </div>
                }
                @if (Armed)
                {
                    <div class="pc-ammo-chips">
                        <span class="pc-ammo-chip @(_grenades == 0 ? "pc-ammo-chip--empty" : null)" aria-label="@($"{_grenades} concussion grenades")">
                            <span class="material-symbols-outlined" aria-hidden="true">flare</span><span class="pc-hud-num">@_grenades</span><kbd>G</kbd>
                        </span>
                        <span class="pc-ammo-chip @(_smoke == 0 ? "pc-ammo-chip--empty" : null)" aria-label="@($"{_smoke} smoke grenades")">
                            <span class="material-symbols-outlined" aria-hidden="true">cloud</span><span class="pc-hud-num">@_smoke</span><kbd>H</kbd>
                        </span>
                    </div>
                }
            </div>
        }

        @* A milestone lands as a split-flap banner with a bloom of light behind it; the historical
           record's next entry slides in under the clock. Both show for a few seconds after the
           change (stamped in OnUpdate), so a pause and resume does not replay them. *@
        @if (ToastLive(_milestoneAt) && _milestone > 0)
        {
            var text = (_milestone >= Objectives.Length ? "Chamber doors reached" : Objectives[_milestone - 1]).ToUpperInvariant();
            <div @key="@($"m{_milestone}")" class="pc-toast" role="status">
                <span class="pc-eyebrow">MILESTONE @_milestone / @Objectives.Length</span>
                <strong class="pc-flap" aria-label="@text">
                    @for (var c = 0; c < text.Length; c++)
                    {
                        <span style="--i: @c" aria-hidden="true">@(text[c] == ' ' ? " " : text[c].ToString())</span>
                    }
                </strong>
            </div>
        }
        @if (ToastLive(_dayAt) && _dayShown.Length > 0)
        {
            <div @key="_dayShown" class="pc-day" role="status">
                <span class="pc-eyebrow">ON THE DAY · @OnTheDay.Time</span>
                <span>@OnTheDay.Text</span>
            </div>
        }
    </div>;

    private RenderFragment ResultSummary => @<div>
        <div>@ResultBody</div>
        <div>@ResultNote</div>
        <div>What happened afterwards: the real building was cleared that evening, a citywide curfew began at 6:00 pm, the Senate reconvened at about 8:00 pm, and Congress finished certifying the election at about 3:40 am on January 7.</div>
    </div>;

    /// <summary>
    /// The debrief paragraph and, under it, what wrote it. The block keeps its height while a
    /// local model is still writing, so the card does not jump when the text lands.
    /// </summary>
    private RenderFragment DebriefBlock => @<div class="pc-debrief" aria-live="polite" aria-busy="@(_debriefBusy ? "true" : "false")">
        <span class="pc-debrief-head">Debrief</span>
        <p>@(_debrief is { text.Length: > 0 } d ? d.text : "Writing the debrief…")</p>
        <span class="pc-debrief-meta @(_debrief is { fallback: true } ? "pc-debrief-meta--warn" : null)">@DebriefMeta</span>
    </div>;

    /// <summary>One stat card on the end card: a big figure, a caption and the series under it.</summary>
    private RenderFragment StatCard(string label, string value, string tone, string? spark, string? note = null) => @<div class="pc-stat pc-stat--@tone">
        <span class="pc-stat-label">@label</span>
        <strong class="pc-stat-value">@value</strong>
        @if (note is { Length: > 0 })
        {
            <span class="pc-stat-note">@note</span>
        }
        @if (Spark(spark) is { Count: > 1 } points)
        {
            <RadzenSparkline Class="pc-stat-spark" Style="height: 34px; width: 100%;">
                <RadzenLineSeries Data="@points" CategoryProperty="X" ValueProperty="Y" Smooth="true" StrokeWidth="2" />
                <RadzenValueAxis Visible="false" />
                <RadzenCategoryAxis Visible="false" />
            </RadzenSparkline>
        }
    </div>;

    /// <summary>
    /// The after-action report, below the result summary in "More details": three tabs (the
    /// story, the charts, the street map) instead of one long scroll, stat cards with their
    /// sparklines in place of a table, and one Export button that holds every file.
    /// </summary>
    private RenderFragment ResultDetails => @<div class="pc-report">
        @if (_report is { svg.Length: > 0 } report)
        {
            <RadzenTabs RenderMode="TabRenderMode.Client" @bind-SelectedIndex="_reportTab" Change="OnReportTabAsync" class="pc-report-tabs">
                <Tabs>
                    <RadzenTabsItem Text="Summary">
                        @DebriefBlock
                        <div class="pc-stats">
                            @(StatCard("Milestones", $"{report.milestones}/{Objectives.Length}", report.milestones >= Objectives.Length ? "bad" : report.milestones > 2 ? "warn" : "good", null))
                            @(StatCard("Lowest line", $"{report.lowestIntegrity}%", ToneName(report.lowestIntegrity), report.sparkIntegrity,
                                report.firstBreak < 0 ? "No line broke" : $"First break at {report.firstBreak:0}s"))
                            @(StatCard("Peak density", $"{report.peakDensity:0.0}/m²", report.peakGrade is "E" or "F" ? "bad" : report.peakGrade == "D" ? "warn" : "good", report.sparkPressure,
                                $"Level of service {report.peakGrade}"))
                            @(StatCard("Crush risk", $"{report.riskSeconds}s", report.riskSeconds > 30 ? "bad" : report.riskSeconds > 0 ? "warn" : "good", null,
                                $"{report.riskEpisodes} episodes"))
                            @(StatCard("Casualties", report.casualties.ToString(CultureInfo.InvariantCulture), report.casualties > 0 ? "bad" : "good", report.sparkCasualties,
                                $"{report.immediate} immediate"))
                            @(StatCard("Standing", report.standing.ToString(CultureInfo.InvariantCulture), "info", report.sparkRaiders, $"{report.police} police"))
                        </div>
                        <details class="pc-more">
                            <summary>More figures</summary>
                            <dl class="pc-report-facts">
                                <div><dt>Peak pressure</dt><dd>@report.peakPressure.ToString("0.0")</dd></div>
                                <div><dt>Packed (D or worse)</dt><dd>@report.packedShare.ToString("0.#")% of crowd-time</dd></div>
                                <div><dt>Contagion peak</dt><dd>@report.peakPushing.ToString("0")% pushing · @report.peakTipped.ToString("0")% tipping</dd></div>
                                @if (report.orders >= 0)
                                {
                                    <div><dt>Orders</dt><dd>@report.orders given · @report.withdrawn lines withdrawn</dd></div>
                                }
                            </dl>
                        </details>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Charts">
                        <div class="pc-aftermath">
                            <canvas id="pocapitol-aftermath" aria-label="Map of where the crowd stood during the attempt"></canvas>
                        </div>
                        <div class="pc-report-chart">@((MarkupString)report.svg)</div>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Street map">
                        <div class="pc-streetmap" data-state="@_mapState">
                            @if (_mapState is "loading" or "live")
                            {
                                <div id="pocapitol-streetmap" class="pc-streetmap-canvas" aria-label="The attempt on a street map of Capitol Hill"></div>
                            }
                            @if (_mapState == "failed")
                            {
                                <p class="pc-small">The street map could not load. The rest of the report is unchanged.</p>
                            }
                            <p class="pc-small">Where the crowd stood and where each line held, over an OpenStreetMap basemap of Capitol Hill. The route is invented, drawn at true scale from the Rotunda. Map tiles load from openstreetmap.org while this tab is open.</p>
                        </div>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
            <div class="pc-report-actions">
                <RadzenSplitButton Text="@(_cardBusy ? "Drawing card…" : "Save report card")" Icon="download" Disabled="@_cardBusy"
                                   Click="OnExportAsync" class="pc-export">
                    <ChildContent>
                        <RadzenSplitButtonItem Text="Report card (PNG)" Value="@("card")" Icon="image" />
                        <RadzenSplitButtonItem Text="Chart (PNG)" Value="@("chart")" Icon="show_chart" />
                        <RadzenSplitButtonItem Text="Samples (CSV)" Value="@("csv")" Icon="table_view" />
                        <RadzenSplitButtonItem Text="Route (GeoJSON)" Value="@("geojson")" Icon="map" />
                        <RadzenSplitButtonItem Text="Copy summary" Value="@("copy")" Icon="content_copy" />
                    </ChildContent>
                </RadzenSplitButton>
            </div>
        }
    </div>;

    /// <summary>
    /// The Tab panel: a debug and stats view only. What a player needs while playing is on the
    /// always-on strip (HudContent); this keeps the counts, the radar and the diagnostics copy.
    /// </summary>
    private RenderFragment TabHudContent => @<div class="pc-tab-hud @(_prefs.contrast == "high" ? "pc-contrast" : null)">
        <div class="pc-tab-hud-head">
            <div>
                <span class="pc-eyebrow">@HudEyebrow</span>
                <strong>@HudTitle</strong>
            </div>
            <button type="button" class="app-btn app-btn--sm" @onclick="() => PauseAsync(true)" disabled="@(_status != "active")">Pause</button>
        </div>

        <div class="pc-crowd">
            <span>@_activeRaiders / @_crowdTotal IN CROWD</span>
            <span>@_activePolice / @_totalPolice CAPITOL POLICE</span>
            @if (_demo && _subject > 0)
            {
                <b>FOLLOWING RAIDER @_subject.ToString("000")</b>
            }
            <span class="pc-time">@Clock · @_weatherCondition</span>
        </div>

        <div class="pc-tab-radar">
            <button type="button" class="pc-radar-toggle" @onclick="ToggleRadar" aria-expanded="@(_radarExpanded ? "true" : "false")">
                <span class="material-symbols-outlined" aria-hidden="true">radar</span>
                <span>RADAR</span>
                <span class="material-symbols-outlined" aria-hidden="true">@(_radarExpanded ? "expand_less" : "expand_more")</span>
            </button>
            @if (_radarExpanded)
            {
                <div class="pc-radar-body">
                    <canvas id="pocapitol-radar" class="pc-radar-canvas" width="200" height="270"></canvas>
                    <div class="pc-radar-legend">
                        <span><i class="dot-raider"></i>Raider</span>
                        <span><i class="dot-police"></i>Police</span>
                        <span><i class="dot-heat"></i>Crush</span>
                    </div>
                </div>
            }
        </div>

        <button type="button" class="app-btn app-btn--sm" @onclick="CopyDiagnosticsAsync">Copy diagnostics</button>
    </div>;

    /// <summary>
    /// Mid-match options for GameShell's shared gear (GameOptionsSheet): the same drawer every
    /// other game uses, in five short tabs. Role and difficulty are *not* here — they belong on
    /// the start card — and diagnostics are the Tab panel.
    /// </summary>
    private RenderFragment ScenarioOptions => @<div class="pc-opts">
        <RadzenTabs RenderMode="TabRenderMode.Client">
            <Tabs>
                <RadzenTabsItem Text="Display">
                    <label class="pc-small" for="pc-opt-graphics">Graphics quality · now @_graphicsLabel</label>
                    @GraphicsPicker("pc-opt-graphics")

                    <label class="pc-small" for="pc-opt-weather">Weather (Open-Meteo)</label>
                    <RadzenSelectBar TValue="string" Value="@_weatherMode" Change="@(async (string val) => await SetWeatherAsync(val))" id="pc-opt-weather">
                        <Items>
                            <RadzenSelectBarItem Text="Jan 6" Value="@("historical")" />
                            <RadzenSelectBarItem Text="Live D.C." Value="@("live")" />
                            <RadzenSelectBarItem Text="Clear" Value="@("clear")" />
                            <RadzenSelectBarItem Text="Gale" Value="@("blizzard")" />
                        </Items>
                    </RadzenSelectBar>
                    <p class="pc-small">@_weatherCondition</p>

                    <label class="pc-small" for="pc-opt-overlay">Analysis overlay (V)</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.overlay" Change="@(async (string val) => await SavePrefsAsync(overlay: val))" id="pc-opt-overlay">
                        <Items>
                            <RadzenSelectBarItem Text="Off" Value="@("off")" />
                            <RadzenSelectBarItem Text="Density" Value="@("density")" />
                            <RadzenSelectBarItem Text="Contagion" Value="@("contagion")" />
                        </Items>
                    </RadzenSelectBar>
                    <p class="pc-small">Density raises the ground where people are packed (Fruin's levels of service). Contagion marks who is pushing, who is about to join, and who is calm.</p>

                    <label class="pc-small" for="pc-opt-tracers">Tracers</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.tracers" Change="@(async (string val) => await SavePrefsAsync(tracers: val))" id="pc-opt-tracers">
                        <Items>
                            <RadzenSelectBarItem Text="On" Value="@("luminous")" />
                            <RadzenSelectBarItem Text="Off" Value="@("off")" />
                        </Items>
                    </RadzenSelectBar>

                    <label class="pc-small" for="pc-opt-footage">Camera look</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.footage" Change="@(async (string val) => await SavePrefsAsync(footage: val))" id="pc-opt-footage">
                        <Items>
                            <RadzenSelectBarItem Text="Phone" Value="@("on")" />
                            <RadzenSelectBarItem Text="Light" Value="@("light")" />
                            <RadzenSelectBarItem Text="Clean" Value="@("off")" />
                        </Items>
                    </RadzenSelectBar>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Sound">
                    <label class="pc-small" for="pc-opt-score">Adaptive music</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.score" Change="@(async (string val) => await SavePrefsAsync(score: val))" id="pc-opt-score">
                        <Items>
                            <RadzenSelectBarItem Text="On" Value="@("on")" />
                            <RadzenSelectBarItem Text="Off" Value="@("off")" />
                        </Items>
                    </RadzenSelectBar>

                    <label class="pc-small" for="pc-opt-hailer">Police loudhailer</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.hailer" Change="@(async (string val) => await SavePrefsAsync(hailer: val))" id="pc-opt-hailer">
                        <Items>
                            <RadzenSelectBarItem Text="Spoken orders" Value="@("on")" />
                            <RadzenSelectBarItem Text="Off" Value="@("off")" />
                        </Items>
                    </RadzenSelectBar>

                    <label class="pc-small" for="pc-opt-hudsound">Sound cues for the HUD</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.hudSound" Change="@(async (string val) => await SavePrefsAsync(hudSound: val))" id="pc-opt-hudsound">
                        <Items>
                            <RadzenSelectBarItem Text="On" Value="@("on")" />
                            <RadzenSelectBarItem Text="Off" Value="@("off")" />
                        </Items>
                    </RadzenSelectBar>
                    <p class="pc-small">A line under strain creaks and a packed crowd ticks faster, so you can hear trouble without looking.</p>

                    <label class="pc-small" for="pc-opt-captions">Captions for spoken radio</label>
                    <RadzenSelectBar TValue="bool" Value="@_prefs.captions" Change="@(async (bool value) => await SavePrefsAsync(captions: value))" id="pc-opt-captions">
                        <Items>
                            <RadzenSelectBarItem Text="Off" Value="@false" />
                            <RadzenSelectBarItem Text="On" Value="@true" />
                        </Items>
                    </RadzenSelectBar>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Comfort">
                    <label class="pc-small" for="pc-opt-sens">Camera sensitivity · @_prefs.sensitivity.ToString("0.00")×</label>
                    <input id="pc-opt-sens" class="pc-range" type="range" min="0.4" max="2.5" step="0.05" style="--p: @(((_prefs.sensitivity - 0.4) / 2.1 * 100).ToString("0", CultureInfo.InvariantCulture))%"
                           value="@_prefs.sensitivity.ToString(CultureInfo.InvariantCulture)" @onchange="OnSensitivityChanged" />

                    <label class="pc-small" for="pc-opt-fov">Field of view · @_prefs.fov°</label>
                    <input id="pc-opt-fov" class="pc-range" type="range" min="50" max="85" step="1" style="--p: @(((_prefs.fov - 50) / 35.0 * 100).ToString("0", CultureInfo.InvariantCulture))%"
                           value="@_prefs.fov" @onchange="OnFovChanged" />

                    <label class="pc-small" for="pc-opt-motion">Combat motion &amp; shake</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.motion" Change="@(async (string val) => await SavePrefsAsync(motion: val))" id="pc-opt-motion">
                        <Items>
                            <RadzenSelectBarItem Text="Full" Value="@("full")" />
                            <RadzenSelectBarItem Text="Reduced" Value="@("reduced")" />
                        </Items>
                    </RadzenSelectBar>

                    <label class="pc-small" for="pc-opt-contrast">HUD contrast</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.contrast" Change="@(async (string value) => await SavePrefsAsync(contrast: value))" id="pc-opt-contrast">
                        <Items>
                            <RadzenSelectBarItem Text="Normal" Value="@("normal")" />
                            <RadzenSelectBarItem Text="High" Value="@("high")" />
                        </Items>
                    </RadzenSelectBar>
                    <p class="pc-small">Colour-safe palettes for the radar and overlays follow the app-wide setting.</p>

                    @if (_demo)
                    {
                        <label class="pc-small" for="pc-opt-director">Spectator camera</label>
                        <RadzenSelectBar TValue="bool" Value="@_prefs.director" Change="@(async (bool value) => await SavePrefsAsync(director: value))" id="pc-opt-director">
                            <Items>
                                <RadzenSelectBarItem Text="Auto-director" Value="@true" />
                                <RadzenSelectBarItem Text="Follow leader" Value="@false" />
                            </Items>
                        </RadzenSelectBar>
                    }
                </RadzenTabsItem>

                <RadzenTabsItem Text="Keys">
                    <p class="pc-small">Select a key, then press the new one. A key another action uses swaps with it. Arrow keys always steer.</p>
                    <ul class="pc-keys">
                        @foreach (var row in KeyRows)
                        {
                            var action = row.Action;
                            var listening = _listening == action;
                            <li class="pc-key-row">
                                <span class="pc-key-label" id="@($"pc-key-label-{action}")">@row.Label</span>
                                <span class="pc-pad-glyph" title="Gamepad" aria-hidden="true">@PadGlyph(action)</span>
                                <button type="button" class="pc-keycap @(listening ? "pc-keycap--listening" : null) @(_swapped == action ? "pc-keycap--swapped" : null)"
                                        @key="@($"{action}-{row.Code}")"
                                        aria-labelledby="@($"pc-key-label-{action}")" aria-describedby="@($"pc-key-now-{action}")"
                                        @onclick="() => _listening = listening ? null : action"
                                        @onkeydown="e => CaptureKeyAsync(action, e)"
                                        @onkeydown:preventDefault="@listening" @onkeydown:stopPropagation="@listening"
                                        @onfocusout="() => { if (_listening == action) _listening = null; }">
                                    <span id="@($"pc-key-now-{action}")">@(listening ? "Press a key…" : DescribeKey(row.Code))</span>
                                </button>
                            </li>
                        }
                    </ul>
                    <p class="pc-small">G throws a concussion grenade and H a smoke grenade. Esc cancels a change.</p>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Debrief">
                    <label class="pc-small" for="pc-opt-debrief">Who writes the after-action debrief</label>
                    <RadzenSelectBar TValue="string" Value="@_prefs.debrief" Change="@(async (string value) => await SavePrefsAsync(debrief: value))" id="pc-opt-debrief">
                        <Items>
                            <RadzenSelectBarItem Text="Built-in" Value="@("rules")" />
                            <RadzenSelectBarItem Text="Local model" Value="@("ollama")" />
                            <RadzenSelectBarItem Text="In browser" Value="@("browser")" />
                        </Items>
                    </RadzenSelectBar>
                    @if (_prefs.debrief == "ollama")
                    {
                        <p class="pc-small">Uses a model running on this computer through Ollama (localhost:11434). Nothing is sent to the internet and nothing costs money. If it does not answer, the built-in writer takes over after one retry.</p>
                        <div class="pc-key-row">
                            <label for="pc-opt-debrief-model">Model</label>
                            <input id="pc-opt-debrief-model" class="pc-key-select pc-model-input" type="text" maxlength="60" spellcheck="false"
                                   value="@_prefs.debriefModel" @onchange="OnDebriefModelChanged" />
                        </div>
                        <button type="button" class="app-btn pc-opt-button" @onclick="ProbeDebriefAsync">Check connection</button>
                        <p class="pc-small pc-probe" role="status">@_probeStatus</p>
                    }
                    else if (_prefs.debrief == "browser")
                    {
                        <p class="pc-small">A small language model (SmolLM2, 360M) runs inside this page with Transformers.js, on the graphics card when the browser supports WebGPU. It writes the opening line; the figures always come from the built-in writer. The first debrief downloads about 270 MB from Hugging Face (390 MB without WebGPU), which the browser then keeps; the report itself never leaves the page. If it cannot load, the built-in writer takes over.</p>
                    }
                    else
                    {
                        <p class="pc-small">Instant, and written on this device from the attempt's own numbers.</p>
                    }
                    <p class="pc-small">Last debrief: @DebriefMeta</p>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </div>;

    private RenderFragment IntroControls => @<div>
        <p><kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd> move · <kbd>Mouse</kbd> look &amp; aim · <kbd>↑</kbd> <kbd>↓</kbd> move · <kbd>←</kbd> <kbd>→</kbd> turn camera · <kbd>Shift</kbd> sprint</p>
        <p><kbd>Space</kbd> / <kbd>Click</kbd> fire (in the crowd) or push (police line) · <kbd>G</kbd> concussion grenade · <kbd>H</kbd> smoke grenade</p>
        <p><kbd>P</kbd> pause · <kbd>Esc</kbd> back to the main menu · <kbd>V</kbd> analysis overlay (density, contagion)</p>
        <p>Commander: <kbd>1</kbd>–<kbd>5</kbd> pick a line · <kbd>B</kbd> brace · <kbd>R</kbd> reinforce · <kbd>T</kbd> rotate rank · <kbd>G</kbd> gas · <kbd>F</kbd> fall back · <kbd>←</kbd> <kbd>→</kbd> swing the camera</p>
        <p class="touch-only">Touch: d-pad to move, drag to look, FIRE / PUSH, and grenade buttons that show what is left.</p>
        <p>Gamepad: sticks move and look, right trigger fires or pushes, X grenade, Y smoke, Start pauses.</p>
    </div>;

    private RenderFragment IntroRules => @<div>
        <p>@_crowdTotal protestors start out on the grass; most watch and film, a few push. 44 police hold five lines, are reinforced to 64, and fall back in stages. 64 staff and members shelter inside until evacuated. 12:50 pm to the 6:00 pm curfew.</p>
        <p><strong>Fiction, not a reconstruction.</strong> Inspired by January 6, 2021. Adult themes; no injury is shown. As a solo raider you carry a machine gun, five concussion grenades and two smoke grenades; police hold with batons, spray, gas and a few grenades. The Demo is a separate armed variant in which both sides fire. The layout and police positions are invented.</p>
        <details><summary>Historical record</summary>@ContextContent</details>
    </div>;

    /// <summary>
    /// The scenario's setup: who you are, as four cards (a radio group: arrow keys move between
    /// them), then difficulty and graphics. Cards are inputs, not actions, so the card keeps its
    /// one OK.
    /// </summary>
    private RenderFragment IntroOptions => @<div class="pc-intro-opts">
        <span class="pc-small" id="pc-role-label">Who you are</span>
        <div class="pc-roles" role="radiogroup" aria-labelledby="pc-role-label" id="pc-role">
            @for (var i = 0; i < Roles.Length; i++)
            {
                var index = i;
                var (value, label, icon) = Roles[i];
                var on = _role == value;
                <button type="button" role="radio" aria-checked="@(on ? "true" : "false")" tabindex="@(on ? 0 : -1)"
                        class="pc-role @(on ? "pc-role--on" : null)" @ref="_roleRefs[index]"
                        @onclick="() => _role = value" @onkeydown="e => RoleKeyAsync(index, e)">
                    <span class="material-symbols-outlined" aria-hidden="true">@icon</span>
                    <span class="pc-role-name">@label</span>
                </button>
            }
        </div>
        <p class="pc-small pc-role-brief">@RoleBrief</p>
        <div class="pc-options">
            <div>
                <label class="pc-small" for="pc-difficulty">Difficulty</label>
                <RadzenSelectBar TValue="string" @bind-Value="_difficulty" id="pc-difficulty">
                    <Items>
                        <RadzenSelectBarItem Text="Story" Value="@("story")" />
                        <RadzenSelectBarItem Text="Standard" Value="@("standard")" />
                    </Items>
                </RadzenSelectBar>
            </div>
            <div>
                <label class="pc-small" for="pc-graphics">Graphics</label>
                @GraphicsPicker("pc-graphics")
            </div>
        </div>
    </div>;

    private RenderFragment ContextContent => @<div class="pc-context">
        <p>On January 6, 2021, Congress met to count and certify electoral votes, not to pass a law. The attack interrupted that proceeding; Congress reconvened that night and finished in the early hours of January 7.</p>
        <p>What this scenario takes from the record is the shape of the day: a crowd that was mostly watching and filming, a minority pushing on police lines, police using shields, batons, chemical spray, gas and flash-bangs, lines that fell back in stages, staff and members who sheltered and were evacuated, a House chamber that was never entered, and a 6:00 pm curfew. The staff and members here are bystanders to the simulation: nothing can target or reach them. The "On the day" times are approximate and come from the Senate committees' June 2021 staff report and the Congressional Record.</p>
        <p>What it invents: every character, the straight-line route and the way rooms connect, police numbers and positions, how fast anything happens, and who prevails. The clock runs one minute per second and is not synchronized with the real timeline. No real person is depicted. The weapons are invention too, and the opposite of what the record shows: a solo player in the crowd carries a machine gun and grenades while the rest of that crowd is unarmed, and in the spectator Demo both sides carry guns and those hit drop out. It is not a documentary, a real building plan, or an endorsement of the attack.</p>
        <p>Public references inform the ribbed dome and colonnaded drum, winter grounds and inauguration stands, the Crypt's columns, Rotunda floor rings, Statuary Hall, and the House rostrum and seating. Clothing, flags, signs, phones and police equipment evoke documented appearances, not specific people or an exact inventory. This is a stylized procedural interpretation, not a photorealistic or security-accurate replica.</p>
        <a href="https://www.congress.gov/117/crec/2021/01/06/CREC-2021-01-06-pt1-PgS18-2.pdf" target="_blank" rel="noopener noreferrer">Congressional Record: January 6 Senate proceedings</a>
        <a href="https://www.aoc.gov/explore-capitol-campus/buildings-grounds/capitol-building/rotunda" target="_blank" rel="noopener noreferrer">Architect of the Capitol: Rotunda</a>
        <a href="https://www.aoc.gov/explore-capitol-campus/buildings-grounds/capitol-building/capitol-dome" target="_blank" rel="noopener noreferrer">Architect of the Capitol: Dome</a>
        <a href="https://history.house.gov/Exhibitions-and-Publications/House-Chamber/Rostrum/" target="_blank" rel="noopener noreferrer">House history: rostrum</a>
        <a href="https://americanhistory.si.edu/press/releases/smithsonian-continues-collecting-artifacts-jan-6-capitol-attack-2" target="_blank" rel="noopener noreferrer">Smithsonian: flags and police equipment</a>
        <a href="https://nsarchive.gwu.edu/briefing-book/foia/2021-05-04/capitol-riot-documents-you-should-read-part-3" target="_blank" rel="noopener noreferrer">National Security Archive: shield testimony</a>
    </div>;
}
