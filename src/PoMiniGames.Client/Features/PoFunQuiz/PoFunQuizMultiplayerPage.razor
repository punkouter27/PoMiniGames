@page "/funquiz/multi"
@using PoMiniGames.Shared.Games
@using PoMiniGamesClient.Features.Shared
@using Microsoft.AspNetCore.SignalR.Client
@using PoMiniGamesClient.Features.PoFunQuiz.Services
@inject FunQuizHubService Hub
@inject PlayerNameService PlayerNameService
@inject MatchHistoryService MatchHistory
@inject ToastService Toasts
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Fun Quiz — Multiplayer · PoMiniGames</PageTitle>
<HeadContent><link rel="stylesheet" href="css/quiz.css" /></HeadContent>

@* Every game opens and ends the same way: the opening card sits in front of the lobby and its
   button leads straight in. The lobby is the shared OnlineLobby (one room, no codes): the first
   to arrive hosts and picks the category and question count, the guest readies, the host starts.
   Then both browsers claim their seats in the match by its internal code. The match ends on the
   shared end-of-game modal. *@
<GameShell Title=@TitleContent Player="@_playerName" BackTo="/"
           GameOver="@(_finished is not null)"
           Outcome="@Outcome"
           GameSummary="@GameSummaryContent">
    @if (!_introDone)
    {
        <GameIntro CueScope="quiz"
                   Title="@TitleContent"
                   Objective="Two players, the same questions. Correct answers score; a streak scores more."
                   Controls="@HowToPlayContent"
                   OnStart="OnIntroStart" />
    }
    @if (_reconnecting)
    {
        <div class="fq-reconnecting" role="status" aria-live="polite">
            <span class="fq-reconnecting__pulse" aria-hidden="true"></span>
            Reconnecting…
        </div>
    }
    @if (_introDone && !_inMatch)
    {
        <OnlineLobby TPlayer="FunQuizLobbyPlayer"
                     HubPath="funquiz/lobby-hub"
                     StartLabel="Start quiz"
                     MaxPlayersHint="2"
                     PickerTitle="Quiz"
                     HowTo="@HowToPlayContent"
                     OnClient="OnClientAsync"
                     OnStateChanged="OnLobbyStateAsync"
                     OnGameStarted="OnMatchStartedAsync"
                     OnLeave="Leave">
            <Picker>
                @* Category and question count are the host's: everyone else reads them off the
                   host's seat. *@
                @if (_lobby is { IsHost: true })
                {
                    <label class="fq-join__field">
                        <span class="fq-join__label">Category</span>
                        <select aria-label="Category" value="@HostCategory" @onchange="OnCategoryChanged">
                            @foreach (var c in FunQuizCategories.All)
                            {
                                <option value="@c.Value">@c.Label</option>
                            }
                        </select>
                    </label>
                    <label class="fq-join__field">
                        <span class="fq-join__label">Questions</span>
                        <select aria-label="Questions" value="@HostQuestionCount" @onchange="OnQuestionCountChanged">
                            @foreach (var n in QuestionCounts)
                            {
                                <option value="@n">@n questions</option>
                            }
                        </select>
                    </label>
                }
                else
                {
                    <p class="lobby__hint">@FunQuizCategories.LabelFor(HostCategory) · @HostQuestionCount questions, set by the host.</p>
                }
            </Picker>
        </OnlineLobby>
    }
    else if (_state is null)
    {
        <div class="fq-join">
            <div class="app-loading" role="status"><span class="app-loading__spinner" aria-hidden="true"></span>Waiting for your opponent…</div>
            <InlineError Message="@_error" />
        </div>
    }
    else
    {
        <div class="fq-multi">
            <h2 class="gps-phase-h">Fun Quiz · @CategoryLabel</h2>
            @if (IsInProgress && _currentQuestion is not null)
            {
                <div class="fq-question">
                    <h3>Question @(_state.CurrentQuestionIndex + 1) of @_state.Questions.Count</h3>
                    <p>@_currentQuestion.Text</p>
                    <div class="fq-options">
                        @for (var i = 0; i < _currentQuestion.Options.Count; i++)
                        {
                            var captured = i;
                            <QuizAnswer Index="captured" Label="@_currentQuestion.Options[i]"
                                        Class="@AnswerClass(captured)" Disabled="@_hasAnswered"
                                        Correct="@(_hasAnswered && captured == _currentQuestion.CorrectOptionIndex)" OnSelect="Select" />
                        }
                    </div>
                    <InlineError Message="@_error" />
                    @if (_hasAnswered)
                    {
                        <p>Answered. Waiting for opponent… (@_finishedThisQuestion / @_state.Players.Count)</p>
                    }
                    else
                    {
                        <p class="fq-2p-scores">@_playerName: <strong>@MyScore</strong> · @OpponentName: <strong>@OpponentScore</strong></p>
                    }
                    <p class="fq-credit">Questions: Open Trivia DB (CC BY-SA 4.0)</p>
                </div>
            }
        </div>
    }
</GameShell>

@code {
    private static readonly int[] QuestionCounts = [5, 10, 15, 20];

    private static RenderFragment TitleContent => GameCatalog.TitleFor(GameKeys.PoFunQuiz);

    private RenderFragment GameSummaryContent => @<div>
        @if (_finished is { } f)
        {
            <div>🏁 @(f.IsTie ? "It's a tie!" : f.Winner?.Name + " wins!")</div>
            @foreach (var kv in f.FinalScores.OrderByDescending(x => x.Value))
            {
                <div>@kv.Key — @kv.Value</div>
            }
        }
    </div>;

    // The closing cue: mine if my name is the winner's, a draw on a tie.
    private PoMiniGamesClient.Models.GameResult Outcome => _finished is not { } f ? PoMiniGamesClient.Models.GameResult.InProgress
        : f.IsTie ? PoMiniGamesClient.Models.GameResult.Draw
        : f.Winner?.Name == _playerName ? PoMiniGamesClient.Models.GameResult.Win
        : PoMiniGamesClient.Models.GameResult.Loss;

    private RenderFragment HowToPlayContent => @<div>
        <ul>
            <li>Tap or click the answer you think is right</li>
            <li>The host starts once both players are in</li>
        </ul>
    </div>;

    private bool _introDone;
    private bool _inMatch;
    private string _playerName = string.Empty;
    private string? _error;
    private bool _reconnecting;
    private LobbyClient<FunQuizLobbyPlayer>? _lobby;
    private CancellationTokenSource? _joinGuardCts;
    private FunQuizGameStateDto? _state;
    private FunQuizGameFinishedDto? _finished;
    private FunQuizQuestionDto? _currentQuestion;
    private bool _hasAnswered;
    private int _selectedOption = -1;
    private int _finishedThisQuestion;

    // The hub serialises the GameState enum with a camelCase policy (see Program.cs
    // AddJsonProtocol), so the wire value is "waiting" / "inProgress" — compare
    // case-insensitively rather than against a PascalCase literal.
    private bool IsInProgress => string.Equals(_state?.State, "InProgress", StringComparison.OrdinalIgnoreCase);

    // "ArtCulture" is the wire value; spell it the way the picker does.
    private string CategoryLabel => FunQuizCategories.LabelFor(_state?.Category);

    // The host's picks ride on every lobby seat; read them off the host's.
    private FunQuizLobbyPlayer? HostSeat => _lobby?.State is { } s
        ? s.Players.FirstOrDefault(p => p.ConnectionId == s.HostConnectionId) ?? s.Players.FirstOrDefault()
        : null;
    private string HostCategory => HostSeat?.Category ?? FunQuizCategories.Default;
    private int HostQuestionCount => HostSeat?.QuestionCount ?? 10;

    private int MyScore => _state?.Players.FirstOrDefault(p => p.Name == _playerName)?.Score ?? 0;
    private int OpponentScore => _state?.Players.FirstOrDefault(p => p.Name != _playerName)?.Score ?? 0;
    private string OpponentName => _state?.Players.FirstOrDefault(p => p.Name != _playerName)?.Name ?? "Opponent";

    protected override async Task OnInitializedAsync()
    {
        // The initials load from storage asynchronously: read them only once that is done.
        await PlayerNameService.InitializeAsync();
        _playerName = PlayerNameService.GetPlayerName();
        Hub.OnGameUpdated += HandleState;
        Hub.OnGameStarted += HandleState;
        Hub.OnScoreUpdated += HandleScoreUpdate;
        Hub.OnPlayerFinishedQuestion += HandlePlayerFinishedQuestion;
        Hub.OnGameFinished += HandleFinished;
        Hub.OnReconnecting += HandleReconnecting;
        Hub.OnReconnected += HandleReconnected;
        Hub.OnClosed += HandleClosed;
    }

    /// <summary>The opening card was dismissed: the lobby mounts, connects and takes a seat.</summary>
    private void OnIntroStart() => _introDone = true;

    private Task OnClientAsync(LobbyClient<FunQuizLobbyPlayer> client)
    {
        _lobby = client;
        return Task.CompletedTask;
    }

    // Repaints the host's picks for the guest as they change.
    private Task OnLobbyStateAsync(LobbyState<FunQuizLobbyPlayer> _) => Task.CompletedTask;

    private Task OnCategoryChanged(ChangeEventArgs e)
    {
        var category = e.Value?.ToString() ?? FunQuizCategories.Default;
        LocalStorageService.SetItem(FunQuizCategories.StorageKey, category);
        return _lobby?.SendAsync("SetOptions", category, HostQuestionCount) ?? Task.CompletedTask;
    }

    private Task OnQuestionCountChanged(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var count) && _lobby is not null
            ? _lobby.SendAsync("SetOptions", HostCategory, count)
            : Task.CompletedTask;

    // DisposeAsync drops the hub connections, which is what gives the seat back.
    private void Leave() => Navigation.NavigateTo("/");

    /// <summary>The host started: claim our seat in the reserved match by its internal code.</summary>
    private async Task OnMatchStartedAsync(OnlineLobbyStart start)
    {
        var seatName = _lobby?.Me?.DisplayName ?? _playerName;
        _playerName = seatName;
        _inMatch = true;
        _error = null;
        _joinGuardCts?.Cancel();
        _joinGuardCts = new CancellationTokenSource();
        StateHasChanged();
        _ = MatchJoinGuard.WatchAsync(() => _inMatch && !IsInProgress, BackToLobbyAsync, _joinGuardCts.Token);
        try
        {
            await Hub.ConnectAsync();
            await Hub.JoinMatch(start.MatchCode, seatName);
        }
        catch (Exception ex)
        {
            _error = $"Could not join the quiz: {ex.Message}";
            StateHasChanged();
        }
    }

    // The opponent never claimed their seat (closed the tab after Start): the shared rule is a
    // toast and back to a fresh lobby.
    private async Task BackToLobbyAsync()
    {
        Toasts.Show("Your opponent didn't make it. Back to the lobby.", ToastType.Warning);
        await ReturnToLobbyAsync();
    }

    private async Task ReturnToLobbyAsync()
    {
        _joinGuardCts?.Cancel();
        _state = null;
        _currentQuestion = null;
        _hasAnswered = false;
        _selectedOption = -1;
        _finishedThisQuestion = 0;
        _inMatch = false;
        await Hub.DisposeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void HandleReconnecting(Exception? ex)
    {
        // Show a "Reconnecting…" banner so the player knows the connection is healing.
        _reconnecting = true;
        InvokeAsync(StateHasChanged);
    }

    private void HandleReconnected(string? connectionId)
    {
        _reconnecting = false;
        InvokeAsync(StateHasChanged);
    }

    private void HandleClosed(Exception? ex)
    {
        _reconnecting = false;
        // Mid-match, the server has already torn our seat down via OnDisconnectedAsync, so the
        // state we hold is stale and will never receive another broadcast. Back to a fresh lobby
        // rather than a board that can never move.
        if (_inMatch && _finished is null)
        {
            Toasts.Show("Lost the connection. The quiz was closed.", ToastType.Warning);
            _ = ReturnToLobbyAsync();
            return;
        }
        InvokeAsync(StateHasChanged);
    }

    private void HandleState(FunQuizGameStateDto s)
    {
        _joinGuardCts?.Cancel();
        // If the question index advanced (or the game restarted), clear the
        // per-question "answered" flag so the player can submit again.
        if (_state is null || s.CurrentQuestionIndex != _state.CurrentQuestionIndex)
        {
            _hasAnswered = false;
            _finishedThisQuestion = 0;
        }
        _state = s;
        _currentQuestion = s.Questions.Count > s.CurrentQuestionIndex ? s.Questions[s.CurrentQuestionIndex] : null;
        // SignalR `.On` callbacks run outside the render loop — repaint explicitly.
        InvokeAsync(StateHasChanged);
    }

    private void HandlePlayerFinishedQuestion(FunQuizPlayerFinishedQuestionDto p)
    {
        _finishedThisQuestion = p.FinishedCount;
        InvokeAsync(StateHasChanged);
    }

    private void HandleScoreUpdate(FunQuizScoreUpdateDto u)
    {
        if (_state is null) return;
        var updated = _state.Players.Select(p => p.Name == u.PlayerName
            ? new FunQuizPlayerStateDto(p.Name, u.TotalScore, u.Streak)
            : p).ToList();
        _state = _state with { Players = updated };
        InvokeAsync(StateHasChanged);
    }

    private void HandleFinished(FunQuizGameFinishedDto f)
    {
        // One terminal result per match: a re-delivered GameFinished must not record the
        // head-to-head rows a second time.
        if (_finished is not null) return;
        _finished = f;
        InvokeAsync(StateHasChanged);
        _ = RecordOutcomesAsync(f);
    }

    // Record a head-to-head result against every other player, scored by final points.
    private async Task RecordOutcomesAsync(FunQuizGameFinishedDto f)
    {
        if (!f.FinalScores.TryGetValue(_playerName, out var myScore)) return;
        foreach (var (name, score) in f.FinalScores)
        {
            if (name == _playerName) continue;
            var outcome = myScore > score ? MatchOutcome.Win
                        : myScore < score ? MatchOutcome.Loss
                        : MatchOutcome.Draw;
            await MatchHistory.RecordAsync("pofunquiz", MatchMode.Multiplayer, name, outcome);
        }
    }

    private string AnswerClass(int option) => !_hasAnswered ? ""
        : option == _currentQuestion?.CorrectOptionIndex ? "fq-option--correct"
        : option == _selectedOption ? "fq-option--wrong" : "fq-option--muted";

    private async Task Select(int option)
    {
        if (_state is null || _currentQuestion is null || _hasAnswered) return;
        var isCorrect = option == _currentQuestion.CorrectOptionIndex;
        _hasAnswered = true;
        _selectedOption = option;
        _error = null;
        var scored = false;
        try
        {
            // For the consolidation MVP we treat every answer as 1.0× speed (no timer running yet).
            await Hub.UpdateScore(isCorrect, speedMultiplier: 1.0, secondsRemaining: 0);
            scored = true;
            // Mark the local player as finished for this question — once both
            // players finish, the server advances to the next question (or ends
            // the game on the last one).
            await Hub.PlayerFinished();
        }
        catch (Exception ex)
        {
            // Never show an answer the server didn't get as locked in. If the score never
            // landed, unlock the options so the player can answer again; if only the
            // "finished" mark failed, keep the pick (re-answering would score it twice).
            if (!scored)
            {
                _hasAnswered = false;
                _selectedOption = -1;
            }
            _error = $"Your answer didn't reach the server: {ex.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        _joinGuardCts?.Cancel();
        Hub.OnGameUpdated -= HandleState;
        Hub.OnGameStarted -= HandleState;
        Hub.OnScoreUpdated -= HandleScoreUpdate;
        Hub.OnPlayerFinishedQuestion -= HandlePlayerFinishedQuestion;
        Hub.OnGameFinished -= HandleFinished;
        Hub.OnReconnecting -= HandleReconnecting;
        Hub.OnReconnected -= HandleReconnected;
        Hub.OnClosed -= HandleClosed;
        await Hub.DisposeAsync();
    }
}
