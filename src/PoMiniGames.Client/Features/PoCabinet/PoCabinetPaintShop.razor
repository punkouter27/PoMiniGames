@*
    PoCabinetPaintShop — the car's colour, four swatches. The page reads the stored choice
    (PoCabinetPitWall.PaintKey) before the first render and passes it in; this component saves
    each pick through Blazored.LocalStorage (the framework's preference per Program.cs) and
    raises it. (Until 2026-10-19 it offered 4 liveries × 4 colours, but only the colour ever
    reached the car: the patterns were swatches and nothing else.)
*@

@using Blazored.LocalStorage
@inject ILocalStorageService LocalStorage

<div class="pocabinet-paintshop" role="radiogroup" aria-label="Pick a colour">
    @foreach (var (name, hex) in COLORS)
    {
        var isSelected = string.Equals(name, SelectedColor, StringComparison.OrdinalIgnoreCase);
        <button type="button"
                class="pocabinet-swatch @(isSelected ? "pocabinet-swatch--selected" : null)"
                role="radio"
                aria-checked="@(isSelected ? "true" : "false")"
                aria-label="@name"
                title="@name"
                style="--swatch: @hex;"
                @onclick="() => Select(name)">
        </button>
    }
</div>

@code {
    private static readonly (string Name, string Hex)[] COLORS =
    {
        ("Indigo",   "#3470d8"),
        ("Crimson",  "#c0392b"),
        ("Forest",   "#2e7d4f"),
        ("Gold",     "#d4af37"),
    };

    /// <summary>Hex for a paint name — what the car mesh, minimap and the server grid use.</summary>
    public static string HexFor(string? name)
    {
        foreach (var (n, hex) in COLORS)
        {
            if (string.Equals(n, name, StringComparison.OrdinalIgnoreCase)) return hex;
        }
        return COLORS[0].Hex;
    }

    [Parameter] public string? SelectedColor { get; set; }
    [Parameter] public EventCallback<string> SelectionChanged { get; set; }

    private async Task Select(string color)
    {
        try
        {
            await LocalStorage.SetItemAsStringAsync(PoCabinetPitWall.PaintKey, color);
        }
        catch
        {
            // ignore — the page keeps the choice for the rest of the session
        }
        await SelectionChanged.InvokeAsync(color);
    }
}
