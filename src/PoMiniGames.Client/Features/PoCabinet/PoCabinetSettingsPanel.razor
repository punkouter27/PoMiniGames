@* PoCabinetSettingsPanel — the settings that are Cabinet's own: music, HUD size,
   weather, controls and driver aids, in four groups. Bound two-way via Value + ValueChanged;
   persistence and JS-side application are the page's job — this component only edits
   the view model and raises the change. Native Blazor + design tokens, no Radzen: a
   choice of two or three is a row of pills (radio inputs), not a dropdown.
   Render quality and FOV are not settings: scene.js picks the quality tier from
   the measured frame rate.

   Volume, mute, reduced motion and colour-blind colours are the app's settings (the
   sheet in the top bar's account menu), not Cabinet's. A second switch here would not
   work: either source turns the option on, so with the app's switch on, turning
   Cabinet's off would do nothing. One button opens the sheet.

   It lives in two places: the start card's Settings tab (PoCabinetPreRace) and
   PoCabinetDrawer, which the pause card and the lobby open. The racing-line overlay was
   removed 2026-10-19: it was the centre line coloured by curvature, not a line to follow.

   Graphics: the quality tier is the APP's (window.PoQuality via SettingsService, the same
   switch as the app sheet's Graphics row), shown here because a 3D race is where it
   matters. Room scans is Cabinet's own (RoomDetail). The camera is not a stored setting:
   it is the race's C-key cycle, so its button only shows while a race is mounted. No
   Radzen here either: its theme is global CSS that the app loads only on the pages built
   on it (PoMule, Brawl HQ, the leaderboards), and it cannot be scoped to one panel. *@
@inject SettingsService AppSettings

<div class="pocabinet-settings" role="group" aria-label="Cabinet settings">
    <fieldset class="pocabinet-settings__group">
        <legend>Sound</legend>
        <label class="pocabinet-settings__row">
            <span>Race music</span>
            <input type="checkbox" role="switch" class="pocabinet-switch" checked="@Value.Music" @onchange="OnMusicChanged" />
        </label>
        @if (ShowAppSettings)
        {
            <div class="pocabinet-settings__row">
                <span>Volume, mute, motion and colours</span>
                <button type="button" class="pocabinet-secondary" @onclick="AppSettings.RequestOpen">App settings</button>
            </div>
        }
    </fieldset>

    <fieldset class="pocabinet-settings__group">
        <legend>Graphics &amp; camera</legend>
        @Pills("gfx", "Graphics quality", GraphicsOptions, AppSettings.Graphics, SetGraphicsAsync,
               "Every game's setting. Lower is smoother on a slow device.")
        @Pills("room", "Room scans", RoomOptions, Value.RoomDetail, v => RaiseAsync(s => s.RoomDetail = v),
               "Full is a 9.6 MB scan and heavier on phones; Lite draws the plain room.")
        @if (OnCycleCamera.HasDelegate)
        {
            <div class="pocabinet-settings__row">
                <span>Camera<small>Or press C in the race</small></span>
                <button type="button" class="pocabinet-secondary pocabinet-settings__inline" @onclick="() => OnCycleCamera.InvokeAsync()">Next view</button>
            </div>
        }
    </fieldset>

    <fieldset class="pocabinet-settings__group">
        <legend>Display</legend>
        @Pills("hud", "HUD size", HudOptions, Format(Value.HudScale), v => RaiseAsync(s => s.HudScale = ParseDouble(v, s.HudScale)))
        @if (ShowWeather)
        {
            @* The race holds its weather from the lights (the lap proof carries one wet flag),
               so a change mid-race is for the next one and says so. *@
            @Pills("weather", WeatherNextRace ? "Weather (next race)" : "Weather", WeatherOptions, Value.Weather, v => RaiseAsync(s => s.Weather = v))
        }
    </fieldset>

    <fieldset class="pocabinet-settings__group">
        <legend>Driving aids</legend>
        @Pills("assist", "Steering assist", AssistOptions, Value.SteeringAssist, v => RaiseAsync(s => s.SteeringAssist = v))
        <label class="pocabinet-settings__row">
            <span>Auto-brake for corners</span>
            <input type="checkbox" role="switch" class="pocabinet-switch" checked="@Value.AutoBrake" @onchange="e => RaiseAsync(s => s.AutoBrake = e.Value is bool b && b)" />
        </label>
    </fieldset>

    <fieldset class="pocabinet-settings__group">
        <legend>Touch screens</legend>
        @Pills("touch", "On-screen controls", TouchOptions, Value.TouchControls, v => RaiseAsync(s => s.TouchControls = v))
        @Pills("steer", "Steering", SteerOptions, Value.SteerMode, v => RaiseAsync(s => s.SteerMode = v))
        <label class="pocabinet-settings__row">
            <span>Sensitivity</span>
            <input type="range" min="0.5" max="1.5" step="0.05"
                   value="@Format(Value.SteerSensitivity)" @oninput="e => RaiseAsync(s => s.SteerSensitivity = ParseDouble(e.Value?.ToString(), s.SteerSensitivity))" />
            <span class="pocabinet-settings__value">@($"{Value.SteerSensitivity:0.00}×")</span>
        </label>
    </fieldset>
</div>

@code {
    [Parameter] public PoCabinetUiSettings Value { get; set; } = new();
    [Parameter] public EventCallback<PoCabinetUiSettings> ValueChanged { get; set; }
    /// <summary>False online: the server races dry, so rain would only be paint on the screen.</summary>
    [Parameter] public bool ShowWeather { get; set; } = true;
    /// <summary>A race is on screen: a weather change applies from the next one.</summary>
    [Parameter] public bool WeatherNextRace { get; set; }
    /// <summary>The "App settings" button. Off on the start card, whose one action is OK.</summary>
    [Parameter] public bool ShowAppSettings { get; set; } = true;
    /// <summary>A race is mounted: the camera row's button cycles its view (the C key).</summary>
    [Parameter] public EventCallback OnCycleCamera { get; set; }

    private static readonly (string Value, string Text)[] HudOptions = [("0.85", "Small"), ("1", "Normal"), ("1.15", "Large")];
    private static readonly (string Value, string Text)[] WeatherOptions = [("clear", "Clear"), ("rain", "Rain")];
    private static readonly (string Value, string Text)[] AssistOptions = [("off", "Off"), ("light", "Light"), ("strong", "Strong")];
    private static readonly (string Value, string Text)[] TouchOptions = [("auto", "Auto"), ("on", "Always"), ("off", "Hide")];
    private static readonly (string Value, string Text)[] SteerOptions = [("pad", "Steer pad"), ("tilt", "Tilt")];
    private static readonly (string Value, string Text)[] GraphicsOptions = [("auto", "Auto"), ("low", "Low"), ("medium", "Med"), ("high", "High")];
    private static readonly (string Value, string Text)[] RoomOptions = [("splat", "Full"), ("mesh", "Lite")];

    /// <summary>One labelled row of radio pills; the group name keeps each row its own radio set.</summary>
    private RenderFragment Pills(string name, string label, (string Value, string Text)[] options, string current, Func<string, Task> onPick, string? hint = null) => __builder =>
    {
        <div class="pocabinet-settings__row" role="radiogroup" aria-label="@label">
            <span>
                @label
                @if (hint is not null)
                {
                    <small>@hint</small>
                }
            </span>
            <span class="pocabinet-pills">
                @foreach (var (value, text) in options)
                {
                    <label class="pocabinet-pill">
                        <input type="radio" name="pocabinet-@name" value="@value" checked="@(value == current)" @onchange="() => onPick(value)" />
                        <span>@text</span>
                    </label>
                }
            </span>
        </div>
    };

    private static string Format(double d) =>
        d.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private async Task RaiseAsync(Action<PoCabinetUiSettings> mutate)
    {
        mutate(Value);
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(Value);
    }

    // The app's tier: SettingsService persists it (pominigames:fx-tier) and applies it (PoQuality).
    private async Task SetGraphicsAsync(string tier)
    {
        if (AppSettings.Graphics == tier) return;
        try { await AppSettings.SetGraphicsAsync(tier); }
        catch { /* interop gone: the sheet still shows the stored choice */ }
    }

    private Task OnMusicChanged(ChangeEventArgs e) =>
        RaiseAsync(s => s.Music = e.Value is bool b && b);

    private static double ParseDouble(string? raw, double fallback) =>
        double.TryParse(raw, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : fallback;
}
