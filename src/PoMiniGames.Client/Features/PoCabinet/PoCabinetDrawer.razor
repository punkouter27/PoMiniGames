@*
    PoCabinetDrawer — Cabinet's car and settings once the start card is gone: a side sheet on
    desktop, a bottom sheet on phones, opened from the pause card and the lobby (the start card
    has the same panels as tabs, PoCabinetPreRace). The car's
    colour is on top (a change applies from the next race); the settings below it.

    A native <dialog> opened through PoDialogInterop.showModalAlone, which puts the layer
    under it away (the pause dialog, the intro card) and brings it back on close. Esc closes
    it natively; input.js ignores Esc inside any dialog but the pause one, so it never also
    resumes the race. A click on the backdrop closes it too.
*@

@inject IJSRuntime JS

<dialog @ref="_dialog" class="pocabinet-drawer" aria-labelledby="pocabinet-drawer-title"
        @onclose="OnClosedAsync" @onclick="CloseAsync">
    <div class="pocabinet-drawer__panel" @onclick:stopPropagation="true">
        <header class="pocabinet-drawer__head">
            <h2 id="pocabinet-drawer-title">Car &amp; settings</h2>
            <button type="button" class="app-btn app-btn--ghost pocabinet-drawer__close" aria-label="Close settings" @onclick="CloseAsync">✕</button>
        </header>
        <div class="pocabinet-drawer__body">
            @if (_open)
            {
                <section class="pocabinet-drawer__section" aria-label="Car colour and livery">
                    <h3>Car colour &amp; livery <span class="pocabinet-muted">@Color</span></h3>
                    <PoCabinetPaintShop SelectedColor="@Color" SelectionChanged="PaintChanged"
                                        SelectedLivery="@Livery" LiveryChanged="LiveryChanged" />
                </section>
                <PoCabinetSettingsPanel Value="Settings" ValueChanged="SettingsChanged"
                                        ShowWeather="ShowWeather" WeatherNextRace="WeatherNextRace"
                                        OnCycleCamera="@(ShowCamera ? OnCycleCamera : default)" />
            }
        </div>
    </div>
</dialog>

@code {
    [Parameter] public PoCabinetUiSettings Settings { get; set; } = new();
    [Parameter] public EventCallback<PoCabinetUiSettings> SettingsChanged { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public EventCallback<string> PaintChanged { get; set; }
    [Parameter] public int Livery { get; set; } = 1;
    [Parameter] public EventCallback<int> LiveryChanged { get; set; }
    [Parameter] public bool ShowWeather { get; set; } = true;
    [Parameter] public bool WeatherNextRace { get; set; }
    /// <summary>A race is mounted: the settings offer its camera cycle.</summary>
    [Parameter] public bool ShowCamera { get; set; }
    [Parameter] public EventCallback OnCycleCamera { get; set; }

    private ElementReference _dialog;
    private bool _open;

    public async Task OpenAsync()
    {
        _open = true;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("PoDialogInterop.showModalAlone", _dialog); }
        catch { _open = false; }
    }

    private async Task CloseAsync()
    {
        try { await JS.InvokeVoidAsync("PoDialogInterop.close", _dialog); }
        catch { /* torn down */ }
    }

    // Esc, the ✕ and the backdrop all end here, through the dialog's own close event.
    private Task OnClosedAsync()
    {
        _open = false;
        return Task.CompletedTask;
    }
}
