@*
    PoCabinetDrawer — Cabinet's car and settings once the start card is gone: a Radzen side dialog
    (DialogService.OpenSideAsync), opened from the pause card and the lobby.
*@

@inject DialogService Dialogs
@implements IDisposable

@code {
    [Parameter] public PoCabinetUiSettings Settings { get; set; } = new();
    [Parameter] public EventCallback<PoCabinetUiSettings> SettingsChanged { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public EventCallback<string> PaintChanged { get; set; }
    [Parameter] public int Livery { get; set; } = 1;
    [Parameter] public EventCallback<int> LiveryChanged { get; set; }
    [Parameter] public bool ShowWeather { get; set; } = true;
    [Parameter] public bool WeatherNextRace { get; set; }
    /// <summary>A race is mounted: the settings offer its camera cycle.</summary>
    [Parameter] public bool ShowCamera { get; set; }
    [Parameter] public EventCallback OnCycleCamera { get; set; }

    private bool _open;

    private RenderFragment DrawerContent => @<div class="pocabinet-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="pocabinet-drawer-title">
        <header class="pocabinet-drawer__head">
            <h2 id="pocabinet-drawer-title">Car &amp; settings</h2>
            <PoButton class="app-btn app-btn--ghost pocabinet-drawer__close" aria-label="Close settings" Click="CloseAsync"><span class="material-symbols-outlined" aria-hidden="true">close</span></PoButton>
        </header>
        <div class="pocabinet-drawer__body">
            <section class="pocabinet-drawer__section" aria-label="Car colour and livery">
                <h3>Car colour &amp; livery <span class="pocabinet-muted">@Color</span></h3>
                <PoCabinetPaintShop SelectedColor="@Color" SelectionChanged="PaintChanged"
                                    SelectedLivery="@Livery" LiveryChanged="LiveryChanged" />
            </section>
            <PoCabinetSettingsPanel Value="Settings" ValueChanged="SettingsChanged"
                                    ShowWeather="ShowWeather" WeatherNextRace="WeatherNextRace"
                                    OnCycleCamera="@(ShowCamera ? OnCycleCamera : default)" />
        </div>
    </div>;

    protected override void OnParametersSet()
    {
        if (_open) Dialogs.Refresh();
    }

    public Task OpenAsync()
    {
        if (_open) return Task.CompletedTask;
        _open = true;
        _ = RunSideDialogAsync();
        return Task.CompletedTask;
    }

    private async Task RunSideDialogAsync()
    {
        try
        {
            await Dialogs.OpenSideAsync<PoDialogFragmentHost>(
                "Car & settings",
                new Dictionary<string, object?> { [nameof(PoDialogFragmentHost.Content)] = DrawerContent },
                new SideDialogOptions
                {
                    Position = DialogPosition.Right,
                    ShowTitle = false,
                    ShowClose = false,
                    CloseDialogOnOverlayClick = true,
                    CssClass = "po-rz-side-dialog",
                    WrapperCssClass = "po-rz-dialog-wrapper po-rz-dialog-wrapper--side",
                });
        }
        finally
        {
            _open = false;
        }
    }

    private Task CloseAsync()
    {
        if (!_open) return Task.CompletedTask;
        _open = false;
        Dialogs.CloseSide();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        if (_open)
        {
            _open = false;
            Dialogs.CloseSide();
        }
    }
}
