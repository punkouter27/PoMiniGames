@*
    PoCabinetLobby — the one shared lobby (no codes: the first arrival hosts, later arrivals take
    the next seats) on the shared OnlineLobby: it owns the connection, the roster, Ready / Start /
    Leave and the panel; this page supplies only what is Cabinet's own. The host's Picker holds
    nothing (the AI always fills the grid to 64 cars, so there is no picker);
    the host can remove a seat between races (PlayerActions, the generic Kick). Car & settings opens
    the page's drawer (OnOpenSettings); a paint change flows in through Color and is sent as
    SetColor. gameStarted (every start, including rematches, so this listens on the client rather
    than on OnGameStarted) hands everyone to the race through OnRaceStarting. The page keeps this
    component mounted, hidden, while the race runs, so the roster is still here for the rematch.
    Arriving while a race runs (or all eight seats are taken) shows a waiting note and re-tries the
    seat on every broadcast, so the next reopen seats you.
*@

@using PoMiniGames.Shared.Games
@using PoMiniGamesClient.Features.Shared
@using PoMiniGamesClient.Services.Play

<div class="pocabinet-lobby" aria-label="Multiplayer lobby">
    <OnlineLobby TPlayer="PoCabinetLobbyPlayer"
                 HubPath="pocabinet/lobby-hub"
                 StartLabel="Start race"
                 WaitingHint="@WaitingHint"
                 Hint="@PanelHint"
                 MaxPlayersHint="PoCabinetCatalog.CarCount"
                 CanStart="@Startable"
                 CanReady="@CanReady"
                 SeatNotices="false"
                 OnClient="OnClientAsync"
                 OnStateChanged="OnStateAsync"
                 OnGameStarted="IgnoreStartAsync"
                 OnLeave="OnExit">
        <PlayerLabel>
            <span class="pocabinet-seat__chip" style="--chip:@SeatColor(context.Color)" aria-hidden="true"></span>@context.DisplayName
        </PlayerLabel>
        <PlayerActions>
            @if (IsHost && context.ConnectionId != _client?.ConnectionId && !InRace)
            {
                @* Host only, between races: one AFK seat must not block every rematch. *@
                <PoButton class="pocabinet-seat__kick" Disabled="@_busy"
                        aria-label="@($"Remove {(context.DisplayName)} from the lobby")" title="Remove from the lobby"
                        Click="() => KickAsync(context.ConnectionId)"><span class="material-symbols-outlined" aria-hidden="true">close</span></PoButton>
            }
        </PlayerActions>
        <Status>
            @if (CurrentNotice is { Length: > 0 } notice)
            {
                <p class="pocabinet-lobby__notice">@notice</p>
            }
            @if (_kickedReason is not null)
            {
                @* Our seat was freed (the host, or the rematch ready timeout): nothing rejoins on its own. *@
                <div class="pocabinet-lobby__notice" role="alert">
                    <span>@_kickedReason</span>
                    <PoButton class="app-btn app-btn--secondary" Disabled="@_busy" Click="RejoinAsync">Rejoin the lobby</PoButton>
                </div>
            }
            else if (InRace && Me is null)
            {
                <div class="pocabinet-lobby__notice">
                    <span>Race in progress — you'll get a seat when it finishes.</span>
                    <PoButton class="app-btn app-btn--secondary" Click="WatchAsync">Watch</PoButton>
                </div>
            }
            else if (State is not null && Me is null)
            {
                <p class="pocabinet-lobby__notice">All @PoCabinetCatalog.CarCount seats are taken — you'll get one as soon as someone leaves.</p>
            }
            @if (!string.IsNullOrEmpty(_error))
            {
                <InlineError Message="@_error" />
            }
        </Status>
    </OnlineLobby>
</div>

@code {
    /// <summary>Paint hex this player races in.</summary>
    [Parameter] public string? Color { get; set; }
    /// <summary>A race is starting (or being watched): its internal race code.</summary>
    [Parameter] public EventCallback<string> OnRaceStarting { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }
    /// <summary>Car &amp; settings: the page owns the one drawer.</summary>
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    /// <summary>A line from the page, e.g. how the last race ended when its finish was missed.</summary>
    [Parameter] public string? Notice { get; set; }

    private LobbyClient<PoCabinetLobbyPlayer>? _client;
    private string? _error;
    private bool _busy;
    private bool _rejoining;
    private string? _sentColor;
    /// <summary>Our seat was freed (kicked, or the rematch ready timeout); why, until we rejoin.</summary>
    private string? _kickedReason;
    /// <summary>The latest notice broadcast (e.g. who lost a seat to the ready timeout).</summary>
    private string? _notice;

    private LobbyState<PoCabinetLobbyPlayer>? State => _client?.State;

    private PoCabinetLobbyPlayer? Me => _client?.Me;

    private bool IsHost => _client?.IsHost == true;

    private bool InRace => State?.InProgress == true;

    private int Humans => State?.Players.Count ?? 0;

    /// <summary>The AI that fills the grid: 64 minus the humans.</summary>
    private int BotSeats => PoCabinetLobbyRules.BotSeats(Humans);

    private string FieldLine => $"{Humans} player{(Humans == 1 ? "" : "s")} + {BotSeats} AI · {PoCabinetCatalog.OnlineGridSize} cars";

    private bool CanReady => Me is not null && !InRace;

    /// <summary>The host may start: every other seat is ready and two cars would line up, AI counted.</summary>
    private bool Startable => State is { InProgress: false } s && Me is not null
        && s.Players.All(p => p.ConnectionId == s.HostConnectionId || p.IsReady);

    // The button always reads "Start race" (every lobby keeps its Start label fixed); what the
    // host is waiting on is the panel's waiting line.
    private string WaitingHint =>
        InRace ? "Race running…"
        : "Waiting for everyone to ready up…";

    private string PanelHint => State is null ? "Single shared room — first to arrive becomes host."
        : IsHost ? $"You're the host: {FieldLine}. Start when everyone is ready."
        : $"{FieldLine} · the host starts";

    private string? CurrentNotice => _notice ?? Notice;

    /// <summary>The server's sanitised hex, or the grid's default green when the player sent none.</summary>
    private static string SeatColor(string? hex) => string.IsNullOrEmpty(hex) ? PoCabinetCatalog.DefaultSeatColor : hex;

    protected override async Task OnParametersSetAsync() => await SyncSeatAsync();

    private Task OnClientAsync(LobbyClient<PoCabinetLobbyPlayer> client)
    {
        _client = client;
        client.Kicked += reason => _ = InvokeAsync(() =>
        {
            _kickedReason = reason;
            StateHasChanged();
        });
        client.EventReceived += e =>
        {
            if (e.Kind != "notice") return;
            _ = InvokeAsync(() =>
            {
                _notice = e.Message;
                StateHasChanged();
            });
        };
        // Every start, rematches included (OnGameStarted only reports the first).
        client.GameStarted += code => _ = InvokeAsync(() =>
        {
            _notice = null;
            return OnRaceStarting.InvokeAsync(code);
        });
        return Task.CompletedTask;
    }

    private Task IgnoreStartAsync(OnlineLobbyStart start) => Task.CompletedTask;

    private async Task OnStateAsync(LobbyState<PoCabinetLobbyPlayer> state)
    {
        await SyncSeatAsync();
        // No seat while it could be had (a race just ended, or someone left): ask again. Not
        // awaited here — this runs off the hub's receive loop, which has to stay free for the reply.
        if (Me is null && !state.InProgress && state.Players.Count < PoCabinetCatalog.CarCount && _kickedReason is null && !_rejoining)
            _ = InvokeAsync(RejoinAsync);
    }

    /// <summary>Send the paint once seated (join does not take it).</summary>
    private async Task SyncSeatAsync()
    {
        if (_client is null || Me is not { } me) return;
        var wanted = Color ?? "";
        if (wanted.Length > 0 && !string.Equals(me.Color, wanted, StringComparison.OrdinalIgnoreCase)
            && !string.Equals(_sentColor, wanted, StringComparison.OrdinalIgnoreCase))
        {
            _sentColor = wanted;
            try { await _client.SendAsync("SetColor", wanted); }
            catch { /* best effort: the seat keeps its old colour */ }
        }
    }

    /// <summary>Take a seat again after losing it (kick, timeout, or a dropped connection).</summary>
    private async Task RejoinAsync()
    {
        if (_client is null || _rejoining) return;
        _rejoining = true;
        _kickedReason = null;
        _notice = null;
        try { await _client.ReconnectAsync(); }
        catch (Exception ex) { _error = $"Could not reach the lobby: {ex.Message}"; }
        finally { _rejoining = false; }
        StateHasChanged();
    }

    private async Task SendAsync(string method, object value)
    {
        if (_client is null) return;
        _busy = true;
        try { await _client.SendAsync(method, value); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task KickAsync(string connectionId)
    {
        if (_client is null) return;
        _busy = true;
        try
        {
            if (!await _client.KickAsync(connectionId)) _error = "Could not remove that player — a race may have just started.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    /// <summary>Follow the running race; a seated player gets their car back, anyone else spectates.</summary>
    private Task WatchAsync() =>
        State is { } state ? OnRaceStarting.InvokeAsync(state.GameCode) : Task.CompletedTask;
}
