@*
    PoCabinetLobby — joins the one lobby (no codes: the first arrival hosts, later arrivals
    take the next seats) and the seat grid mirrors the server's LobbyState broadcasts: humans,
    the AI officials filling free seats, ready flags, host badge. The host picks the track and
    how many officials race, and starts; the RaceStarting broadcast hands everyone to the race
    through OnRaceStarting. After a race the same lobby reopens — coming back here is the
    rematch. Arriving while a race runs (or all eight seats are taken) shows a waiting note
    and re-tries the seat on every broadcast, so the next reopen seats you.

    Layout: a header (leave, seat count, car & settings, invite), the eight seats in a fixed
    4 × 2 grid (2 × 4 on a phone) with each driver's paint chip, then one toolbar with what
    this player can do. Car & settings opens the page's drawer (OnOpenSettings); a paint
    change there re-joins with the new colour (PoCabinetPage), which the server applies to
    the seat and broadcasts.
*@

@using PoMiniGames.Shared.Games
@implements IAsyncDisposable
@inject PlayerNameService PlayerNameSvc
@inject PoCabinetSession Session

<div class="pocabinet-lobby" aria-label="Multiplayer lobby">
    <header class="pocabinet-lobby__header">
        <button type="button" class="app-btn app-btn--ghost pocabinet-lobby__leave" @onclick="LeaveAsync">← Leave</button>
        <h2>Lobby @if (_view is { } v) { <span class="pocabinet-muted">· @v.Players.Count of @PoCabinetCatalog.CarCount drivers</span> }</h2>
        <span class="pocabinet-lobby__headbtns">
            <button type="button" class="app-btn app-btn--secondary" @onclick="OnOpenSettings">Car &amp; settings</button>
            <InviteLink />
        </span>
    </header>

    @if (CurrentNotice is { Length: > 0 } notice)
    {
        <p class="pocabinet-lobby__notice" role="status">@notice</p>
    }

    @if (_kickedReason is not null)
    {
        @* Our seat was freed (the host, or the rematch ready timeout): nothing rejoins on its own. *@
        <div class="pocabinet-lobby__notice" role="alert">
            <span>@_kickedReason</span>
            <button type="button" class="app-btn app-btn--secondary" disabled="@_joining" @onclick="RejoinAsync">Rejoin the lobby</button>
        </div>
    }
    else if (_view is { } view)
    {
        <section class="pocabinet-lobby__seats" aria-label="Grid">
            @foreach (var seat in view.Players)
            {
                var mine = seat.SeatId == Session.MySeatId;
                <div class="pocabinet-seat pocabinet-seat--filled @(mine ? "pocabinet-seat--me" : "")">
                    <span class="pocabinet-seat__chip" style="--chip:@SeatColor(seat.Color)" aria-hidden="true"></span>
                    <span class="pocabinet-seat__who">
                        <strong title="@seat.DisplayName">@seat.DisplayName@(mine ? " (you)" : "")</strong>
                        <span class="pocabinet-seat__state @(seat.IsReady ? "pocabinet-seat__state--ready" : null)">@(seat.IsReady ? "Ready ✓" : "Not ready")</span>
                    </span>
                    @if (seat.IsHost) { <span class="pocabinet-seat__badge">Host</span> }
                    else if (IsHost && !mine && !view.InRace)
                    {
                        @* Host only, between races: one AFK seat must not block every rematch. *@
                        <button type="button" class="pocabinet-seat__kick" disabled="@_busy"
                                aria-label="Remove @seat.DisplayName from the lobby" title="Remove from the lobby"
                                @onclick="() => KickAsync(seat.SeatId)">✕</button>
                    }
                </div>
            }
            @foreach (var bot in BotSeats(view))
            {
                <div class="pocabinet-seat pocabinet-seat--bot">
                    <span class="pocabinet-seat__chip pocabinet-seat__chip--bot" aria-hidden="true"></span>
                    <span class="pocabinet-seat__who">
                        <strong>@bot</strong>
                        <span class="pocabinet-seat__state">AI official</span>
                    </span>
                </div>
            }
            @for (var i = view.Players.Count + view.BotSeats; i < PoCabinetCatalog.CarCount; i++)
            {
                <div class="pocabinet-seat pocabinet-seat--empty"><span>Open seat</span></div>
            }
        </section>

        <section class="pocabinet-lobby__toolbar" aria-label="Race setup">
            @if (IsHost)
            {
                <PoCabinetTrackSelector SelectedTrackId="@view.TrackId" SelectedTrackIdChanged="SetTrackAsync" Compact="true" />
                <div class="pocabinet-lobby__bots">
                    <span id="pocabinet-bots-label">AI officials</span>
                    <div class="pocabinet-stepper" role="group" aria-labelledby="pocabinet-bots-label">
                        <button type="button" aria-label="Fewer AI officials" disabled="@(view.BotCount <= 0)" @onclick="() => SetBotsAsync(view.BotCount - 1)">−</button>
                        <output aria-live="polite">@view.BotCount</output>
                        <button type="button" aria-label="More AI officials" disabled="@(view.BotCount >= PoCabinetCatalog.MaxBots)" @onclick="() => SetBotsAsync(view.BotCount + 1)">+</button>
                    </div>
                </div>
                <button class="app-btn app-btn--primary pocabinet-lobby__start" disabled="@(!view.Startable || _busy)" @onclick="StartAsync">
                    @StartLabel(view)
                </button>
            }
            else if (MySeat(view) is not null)
            {
                <p class="pocabinet-lobby__track">Track <strong>@PoCabinetCatalog.GetTrack(view.TrackId).Name</strong> · @view.BotCount AI official@(view.BotCount == 1 ? "" : "s") · the host starts</p>
                <button class="app-btn app-btn--primary pocabinet-lobby__ready" disabled="@(view.InRace || _busy)" @onclick="ToggleReadyAsync"
                        title="After a race, ready up within @ReadyTimeoutSeconds seconds or the seat is freed for someone else">
                    @(MySeat(view)?.IsReady == true ? "Ready ✓ — tap to cancel" : "Ready up")
                </button>
            }
        </section>

        @if (view.InRace)
        {
            <div class="pocabinet-lobby__notice" role="status">
                <span>@(MySeat(view) is null ? "Race in progress — you'll get a seat when it finishes." : "A race is running for this lobby. It reopens here when it ends.")</span>
                <button type="button" class="app-btn app-btn--secondary" @onclick="WatchAsync">Watch</button>
            </div>
        }
        else if (MySeat(view) is null)
        {
            <p class="pocabinet-lobby__notice" role="status">All @PoCabinetCatalog.CarCount seats are taken — you'll get one as soon as someone leaves.</p>
        }
    }
    else if (string.IsNullOrEmpty(_error))
    {
        <p class="pocabinet-lobby__notice" role="status">Connecting to the lobby…</p>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="pocabinet-lobby__notice" role="alert">
            <span class="pocabinet-lobby__error">@_error</span>
            @if (_connectionLost)
            {
                <button type="button" class="app-btn app-btn--secondary" disabled="@_joining" @onclick="RejoinAsync">Reconnect</button>
            }
        </div>
    }
</div>

@code {
    /// <summary>Track the lobby opens on if this player is the first to arrive.</summary>
    [Parameter] public string? InitialTrackId { get; set; }
    /// <summary>Paint hex this player races in.</summary>
    [Parameter] public string? Color { get; set; }
    [Parameter] public EventCallback<(string Code, string TrackId)> OnRaceStarting { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }
    /// <summary>Car &amp; settings: the page owns the one drawer.</summary>
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    /// <summary>A line from the page, e.g. how the last race ended when its finish was missed.</summary>
    [Parameter] public string? Notice { get; set; }

    private PoCabinetLobbyView? _view;
    private string? _error;
    private bool _busy;
    private bool _joining;
    /// <summary>The lobby connection failed or closed: the error offers Reconnect.</summary>
    private bool _connectionLost;
    /// <summary>Our seat was freed (kicked, or the rematch ready timeout); why, until we rejoin.</summary>
    private string? _kickedReason;
    /// <summary>The latest LobbyNotice broadcast.</summary>
    private string? _notice;

    /// <summary>Mirrors the server's PoCabinetLobbyService.ReadyTimeout.</summary>
    private const int ReadyTimeoutSeconds = 90;

    private string? CurrentNotice => _notice ?? Notice;

    private bool IsHost => Session.MySeatId is not null && _view?.Players.FirstOrDefault(p => p.IsHost)?.SeatId == Session.MySeatId;

    protected override async Task OnInitializedAsync()
    {
        Session.LobbyChanged += OnLobbyChangedAsync;
        Session.RaceStarting += OnRaceStartingAsync;
        Session.Kicked += OnKickedAsync;
        Session.LobbyNotice += OnLobbyNoticeAsync;
        Session.LobbyLost += OnLobbyLostAsync;
        await JoinAsync();
    }

    /// <summary>Take (or retake) a seat. Guarded: our own join's broadcast arrives before its reply.</summary>
    private async Task JoinAsync()
    {
        if (_joining) return;
        _joining = true;
        try
        {
            _view = await Session.JoinLobbyAsync(PlayerNameSvc.GetOrReadInitialName(), InitialTrackId, Color) ?? _view;
            if (_connectionLost) _error = null;
            _connectionLost = false;
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the lobby: {ex.Message}";
            _connectionLost = true;
        }
        finally
        {
            _joining = false;
        }
    }

    /// <summary>Reconnect after a lost connection, or take a seat again after losing it.</summary>
    private async Task RejoinAsync()
    {
        _kickedReason = null;
        _notice = null;
        await JoinAsync();
    }

    private Task OnKickedAsync(string reason) => InvokeAsync(() =>
    {
        _kickedReason = reason;
        _view = null;
        StateHasChanged();
    });

    private Task OnLobbyNoticeAsync(string text) => InvokeAsync(() =>
    {
        _notice = text;
        StateHasChanged();
    });

    private Task OnLobbyLostAsync(string message) => InvokeAsync(() =>
    {
        _error = message;
        _connectionLost = true;
        StateHasChanged();
    });

    private Task OnLobbyChangedAsync(PoCabinetLobbyView view)
    {
        _view = view;
        // Waiting for a seat: the race just ended or someone left, so try again. Not awaited —
        // this runs on the hub's receive loop, which has to stay free to deliver the reply.
        if (Session.MySeatId is null && !view.InRace && view.Players.Count < PoCabinetCatalog.CarCount)
            _ = InvokeAsync(async () => { await JoinAsync(); StateHasChanged(); });
        return InvokeAsync(StateHasChanged);
    }

    private Task OnRaceStartingAsync(string code, string trackId) =>
        InvokeAsync(() => OnRaceStarting.InvokeAsync((code, trackId)));

    private static PoCabinetLobbySeat? MySeatIn(PoCabinetLobbyView view, string? seatId) =>
        view.Players.FirstOrDefault(p => p.SeatId == seatId);

    private PoCabinetLobbySeat? MySeat(PoCabinetLobbyView view) => MySeatIn(view, Session.MySeatId);

    /// <summary>The officials the server will seat (it says how many fit), by name.</summary>
    private static IEnumerable<string> BotSeats(PoCabinetLobbyView view) =>
        PoCabinetCatalog.Officials.Take(view.BotSeats).Select(o => o.Name);

    /// <summary>The server's sanitised hex, or the grid's default green when the player sent none.</summary>
    private static string SeatColor(string? hex) => string.IsNullOrEmpty(hex) ? PoCabinetCatalog.DefaultSeatColor : hex;

    private static string StartLabel(PoCabinetLobbyView view) =>
        view.InRace ? "Race running…"
        : view.Players.Count + view.BotSeats < 2 ? "Add an AI official or wait for a friend"
        : view.Players.All(p => p.IsReady) ? "Start race"
        : "Waiting for everyone to ready up…";

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try { await action(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private Task SetTrackAsync(string trackId) => RunAsync(() => Session.SetTrackAsync(trackId));

    private Task SetBotsAsync(int count) => RunAsync(() => Session.SetBotsAsync(Math.Clamp(count, 0, PoCabinetCatalog.MaxBots)));

    private Task ToggleReadyAsync() => RunAsync(() => Session.ToggleReadyAsync());

    private Task KickAsync(string seatId) => RunAsync(async () =>
    {
        if (!await Session.KickAsync(seatId)) _error = "Could not remove that player — a race may have just started.";
    });

    private Task StartAsync() => RunAsync(async () =>
    {
        if (!await Session.TryStartAsync()) _error = "Could not start — someone may have just un-readied.";
    });

    private async Task LeaveAsync()
    {
        await Session.LeaveLobbyAsync();
        await OnExit.InvokeAsync();
    }

    /// <summary>Follow the running race; a seated player gets their car back, anyone else spectates.</summary>
    private Task WatchAsync() =>
        _view is { } view ? OnRaceStarting.InvokeAsync((view.Code, view.TrackId)) : Task.CompletedTask;

    public ValueTask DisposeAsync()
    {
        Session.LobbyChanged -= OnLobbyChangedAsync;
        Session.RaceStarting -= OnRaceStartingAsync;
        Session.Kicked -= OnKickedAsync;
        Session.LobbyNotice -= OnLobbyNoticeAsync;
        Session.LobbyLost -= OnLobbyLostAsync;
        return ValueTask.CompletedTask;
    }
}
