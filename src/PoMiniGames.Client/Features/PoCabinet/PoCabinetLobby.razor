@*
    PoCabinetLobby — joins the one lobby (no codes: the first arrival hosts, later arrivals
    take the next seats) and renders it on the shared LobbyPanel: the server's LobbyState
    broadcast is mapped into the panel's LobbyState (seat id = connection id), so the roster,
    host / ready chips, Ready / Start / Leave, Invite and the folded how-to look like every
    other lobby. The host's Picker holds the track dropdown (every track plus today's Daily,
    the solo card's names) and the AI-driver count; the host can remove a seat between races
    (PlayerActions). Car & settings opens the page's drawer (OnOpenSettings); a paint change
    there re-joins with the new colour (PoCabinetPage), which the server applies to the seat.
    The RaceStarting broadcast hands everyone to the race through OnRaceStarting; after a race
    the same lobby reopens (the rematch). Arriving while a race runs (or all eight seats are
    taken) shows a waiting note in the panel's status area and re-tries the seat on every
    broadcast, so the next reopen seats you.
*@

@using Microsoft.AspNetCore.SignalR.Client
@using PoMiniGames.Shared.Games
@using PoMiniGamesClient.Features.Shared
@implements IAsyncDisposable
@inject PlayerNameService PlayerNameSvc
@inject PoCabinetSession Session

<div class="pocabinet-lobby" aria-label="Multiplayer lobby">
    <LobbyPanel TPlayer="CabinetSeat"
                State="@_state"
                LocalConnectionId="@(Session.MySeatId ?? "")"
                ConnectionState="@PanelConnection"
                Hint="@PanelHint"
                MaxPlayersHint="PoCabinetCatalog.CarCount"
                StartLabel="@(_view is { } sv ? StartLabel(sv) : "Start race")"
                CanStart="@(_view is { Startable: true, InRace: false })"
                CanReady="@CanReady"
                OnReconnect="RejoinAsync"
                OnReady="ToggleReadyAsync"
                OnStart="StartAsync"
                OnLeave="LeaveAsync">
        <PlayerLabel>
            <span class="pocabinet-seat__chip" style="--chip:@SeatColor(context.Color)" aria-hidden="true"></span>@context.DisplayName
        </PlayerLabel>
        <PlayerActions>
            @if (IsHost && context.ConnectionId != Session.MySeatId && _view is { InRace: false })
            {
                @* Host only, between races: one AFK seat must not block every rematch. *@
                <button type="button" class="pocabinet-seat__kick" disabled="@_busy"
                        aria-label="Remove @context.DisplayName from the lobby" title="Remove from the lobby"
                        @onclick="() => KickAsync(context.ConnectionId)"><span class="material-symbols-outlined" aria-hidden="true">close</span></button>
            }
        </PlayerActions>
        <Picker>
            @if (IsHost && _view is { } pv)
            {
                <div class="pocabinet-pick">
                    <label>
                        <span>Track</span>
                        <select value="@pv.TrackId" disabled="@_busy" @onchange="e => SetTrackAsync(e.Value?.ToString() ?? PoCabinetCatalog.DefaultTrackId)">
                            @foreach (var track in AllTracks)
                            {
                                <option value="@track.Id">@track.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>AI drivers</span>
                        <select value="@pv.BotCount" disabled="@_busy" @onchange="e => SetBotsAsync(int.TryParse(e.Value?.ToString(), out var n) ? n : 0)">
                            @for (var n = 0; n <= PoCabinetCatalog.MaxBots; n++)
                            {
                                <option value="@n">@n</option>
                            }
                        </select>
                    </label>
                </div>
            }
        </Picker>
        <Status>
            @if (CurrentNotice is { Length: > 0 } notice)
            {
                <p class="pocabinet-lobby__notice">@notice</p>
            }
            @if (_kickedReason is not null)
            {
                @* Our seat was freed (the host, or the rematch ready timeout): nothing rejoins on its own. *@
                <div class="pocabinet-lobby__notice" role="alert">
                    <span>@_kickedReason</span>
                    <button type="button" class="app-btn app-btn--secondary" disabled="@_joining" @onclick="RejoinAsync">Rejoin the lobby</button>
                </div>
            }
            else if (_view is { InRace: true })
            {
                <div class="pocabinet-lobby__notice">
                    <span>@(MySeat is null ? "Race in progress — you'll get a seat when it finishes." : "A race is running for this lobby. It reopens here when it ends.")</span>
                    <button type="button" class="app-btn app-btn--secondary" @onclick="WatchAsync">Watch</button>
                </div>
            }
            else if (_view is not null && MySeat is null)
            {
                <p class="pocabinet-lobby__notice">All @PoCabinetCatalog.CarCount seats are taken — you'll get one as soon as someone leaves.</p>
            }
            @if (!string.IsNullOrEmpty(_error))
            {
                <InlineError Message="@_error" RetryLabel="Reconnect"
                             OnRetry="@(_connectionLost && !_joining ? EventCallback.Factory.Create(this, RejoinAsync) : default)" />
            }
        </Status>
        <ExtraActions>
            <button type="button" class="app-btn app-btn--secondary" @onclick="OnOpenSettings">Car &amp; settings</button>
        </ExtraActions>
        <HowTo>
            <p>One shared room: the first driver in hosts, picks the track and the AI drivers, and starts once everyone is ready. After a race you come back here for the rematch; ready up within @ReadyTimeoutSeconds seconds or the seat is freed.</p>
        </HowTo>
    </LobbyPanel>
</div>

@code {
    /// <summary>Track the lobby opens on if this player is the first to arrive.</summary>
    [Parameter] public string? InitialTrackId { get; set; }
    /// <summary>Paint hex this player races in.</summary>
    [Parameter] public string? Color { get; set; }
    [Parameter] public EventCallback<(string Code, string TrackId)> OnRaceStarting { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }
    /// <summary>Car &amp; settings: the page owns the one drawer.</summary>
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    /// <summary>A line from the page, e.g. how the last race ended when its finish was missed.</summary>
    [Parameter] public string? Notice { get; set; }

    /// <summary>A seat on the shared panel: the seat id is the panel's connection id.</summary>
    private sealed record CabinetSeat(string ConnectionId, string DisplayName, bool IsReady, string? Color) : ILobbyPlayer
    {
        public bool IsGuest => false;
    }

    private PoCabinetLobbyView? _view;
    private LobbyState<CabinetSeat>? _state;
    private string? _error;
    private bool _busy;
    private bool _joining;
    /// <summary>The lobby connection failed or closed: the error offers Reconnect.</summary>
    private bool _connectionLost;
    /// <summary>Our seat was freed (kicked, or the rematch ready timeout); why, until we rejoin.</summary>
    private string? _kickedReason;
    /// <summary>The latest LobbyNotice broadcast.</summary>
    private string? _notice;

    /// <summary>Mirrors the server's PoCabinetLobbyService.ReadyTimeout.</summary>
    private const int ReadyTimeoutSeconds = 90;

    /// <summary>The fixed tracks, then today's daily circuit (UTC), as on the solo start card.</summary>
    private static IReadOnlyList<PoCabinetTrackInfo> AllTracks =>
        [.. PoCabinetCatalog.Tracks, PoCabinetCatalog.Today(DateTime.UtcNow)];

    private static LobbyState<CabinetSeat>? Map(PoCabinetLobbyView? view) => view is null ? null : new LobbyState<CabinetSeat>(
        [.. view.Players.Select(p => new CabinetSeat(p.SeatId, p.DisplayName, p.IsReady, p.Color))],
        view.Players.FirstOrDefault(p => p.IsHost)?.SeatId,
        view.Code, PoCabinetCatalog.CarCount, DateTimeOffset.UtcNow);

    private HubConnectionState PanelConnection =>
        _view is not null || _kickedReason is not null ? HubConnectionState.Connected
        : _connectionLost ? HubConnectionState.Disconnected : HubConnectionState.Connecting;

    private bool CanReady => _view is { InRace: false } && MySeat is not null;

    private string PanelHint => _view is not { } v ? "Single shared room — first to arrive becomes host."
        : IsHost ? "You're the host: pick the track and AI drivers, then start."
        : $"Track {PoCabinetCatalog.GetTrack(v.TrackId).Name} · {v.BotSeats} AI driver{(v.BotSeats == 1 ? "" : "s")} · the host starts";

    private PoCabinetLobbySeat? MySeat => _view?.Players.FirstOrDefault(p => p.SeatId == Session.MySeatId);

    private string? CurrentNotice => _notice ?? Notice;

    private bool IsHost => Session.MySeatId is not null && _view?.Players.FirstOrDefault(p => p.IsHost)?.SeatId == Session.MySeatId;

    protected override async Task OnInitializedAsync()
    {
        Session.LobbyChanged += OnLobbyChangedAsync;
        Session.RaceStarting += OnRaceStartingAsync;
        Session.Kicked += OnKickedAsync;
        Session.LobbyNotice += OnLobbyNoticeAsync;
        Session.LobbyLost += OnLobbyLostAsync;
        await JoinAsync();
    }

    /// <summary>Take (or retake) a seat. Guarded: our own join's broadcast arrives before its reply.</summary>
    private async Task JoinAsync()
    {
        if (_joining) return;
        _joining = true;
        try
        {
            _view = await Session.JoinLobbyAsync(PlayerNameSvc.GetOrReadInitialName(), InitialTrackId, Color) ?? _view;
            _state = Map(_view);
            if (_connectionLost) _error = null;
            _connectionLost = false;
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the lobby: {ex.Message}";
            _connectionLost = true;
        }
        finally
        {
            _joining = false;
        }
    }

    /// <summary>Reconnect after a lost connection, or take a seat again after losing it.</summary>
    private async Task RejoinAsync()
    {
        _kickedReason = null;
        _notice = null;
        await JoinAsync();
    }

    private Task OnKickedAsync(string reason) => InvokeAsync(() =>
    {
        _kickedReason = reason;
        _view = null;
        _state = null;
        StateHasChanged();
    });

    private Task OnLobbyNoticeAsync(string text) => InvokeAsync(() =>
    {
        _notice = text;
        StateHasChanged();
    });

    private Task OnLobbyLostAsync(string message) => InvokeAsync(() =>
    {
        _error = message;
        _connectionLost = true;
        StateHasChanged();
    });

    private Task OnLobbyChangedAsync(PoCabinetLobbyView view)
    {
        _view = view;
        _state = Map(view);
        // Waiting for a seat: the race just ended or someone left, so try again. Not awaited —
        // this runs on the hub's receive loop, which has to stay free to deliver the reply.
        if (Session.MySeatId is null && !view.InRace && view.Players.Count < PoCabinetCatalog.CarCount)
            _ = InvokeAsync(async () => { await JoinAsync(); StateHasChanged(); });
        return InvokeAsync(StateHasChanged);
    }

    private Task OnRaceStartingAsync(string code, string trackId) =>
        InvokeAsync(() => OnRaceStarting.InvokeAsync((code, trackId)));

    /// <summary>The server's sanitised hex, or the grid's default green when the player sent none.</summary>
    private static string SeatColor(string? hex) => string.IsNullOrEmpty(hex) ? PoCabinetCatalog.DefaultSeatColor : hex;

    private static string StartLabel(PoCabinetLobbyView view) =>
        view.InRace ? "Race running…"
        : view.Players.Count + view.BotSeats < 2 ? "Add an AI driver or wait for a friend"
        : view.Players.All(p => p.IsReady) ? "Start race"
        : "Waiting for everyone to ready up…";

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try { await action(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private Task SetTrackAsync(string trackId) => RunAsync(() => Session.SetTrackAsync(trackId));

    private Task SetBotsAsync(int count) => RunAsync(() => Session.SetBotsAsync(Math.Clamp(count, 0, PoCabinetCatalog.MaxBots)));

    private Task ToggleReadyAsync() => RunAsync(() => Session.ToggleReadyAsync());

    private Task KickAsync(string seatId) => RunAsync(async () =>
    {
        if (!await Session.KickAsync(seatId)) _error = "Could not remove that player — a race may have just started.";
    });

    private Task StartAsync() => RunAsync(async () =>
    {
        if (!await Session.TryStartAsync()) _error = "Could not start — someone may have just un-readied.";
    });

    private async Task LeaveAsync()
    {
        await Session.LeaveLobbyAsync();
        await OnExit.InvokeAsync();
    }

    /// <summary>Follow the running race; a seated player gets their car back, anyone else spectates.</summary>
    private Task WatchAsync() =>
        _view is { } view ? OnRaceStarting.InvokeAsync((view.Code, view.TrackId)) : Task.CompletedTask;

    public ValueTask DisposeAsync()
    {
        Session.LobbyChanged -= OnLobbyChangedAsync;
        Session.RaceStarting -= OnRaceStartingAsync;
        Session.Kicked -= OnKickedAsync;
        Session.LobbyNotice -= OnLobbyNoticeAsync;
        Session.LobbyLost -= OnLobbyLostAsync;
        return ValueTask.CompletedTask;
    }
}
