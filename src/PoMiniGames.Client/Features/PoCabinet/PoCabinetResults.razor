@*
    PoCabinetResults — the race's results, inside the shared end-of-game modal's summary (the page
    wraps it in the modal's section). One card: the place, this race's best lap and how it sits
    against the personal best, then the primary Race again (online: Back to lobby). The rest
    (the field, every lap, the telemetry and the race engineer) is one "Race details" tap
    below it. The modal's own Back to main menu stays the way out. The telemetry canvas is drawn
    by race.js (PoCabinet.showTelemetry) once this renders: the details are collapsed by height,
    not display:none, so the canvas keeps its width for the chart while they are shut.
*@

@using PoMiniGames.Shared.Games

<header class="pocabinet-results__hero">
    @if (IsSpectating)
    {
        @* No place: the HUD followed the leader. *@
    }
    else if (Dnf)
    {
        @* A wreck is classified behind every car that kept going: no place to celebrate. *@
        <p class="pocabinet-results__place pocabinet-results__place--dnf"><strong>DNF</strong></p>
    }
    else
    {
        <p class="pocabinet-results__place">P<strong>@Position</strong><small>/@TotalCars</small></p>
    }
    <div class="pocabinet-results__headline">
        <h2>@Headline <span class="pocabinet-muted">· @TrackName</span></h2>
        @if (!IsSpectating)
        {
            <dl class="pocabinet-results__facts">
                <div>
                    <dt>Best lap</dt>
                    <dd>@(RaceBest > 0 ? PoCabinetCatalog.FormatLap(RaceBest) : "—")</dd>
                </div>
                <div>
                    <dt>@(IsPersonalBest ? "Personal best" : "vs your best")</dt>
                    <dd class="@DeltaClass">
                        @DeltaText
                        @if (ReferenceBest > 0)
                        {
                            <small>@(IsPersonalBest ? "was" : "best") @PoCabinetCatalog.FormatLap(ReferenceBest)</small>
                        }
                    </dd>
                </div>
            </dl>
        }
        <p class="pocabinet-results__chips">
            @if (IsPersonalBest)
            {
                <span class="pocabinet-chip pocabinet-chip--pb" role="status">★ New personal best</span>
            }
        </p>
    </div>
</header>
<div class="pocabinet-results__actions">
    @if (OnRaceAgain.HasDelegate)
    {
        <PoButton class="app-btn app-btn--primary pocabinet-results__again" Click="() => OnRaceAgain.InvokeAsync()">@RaceAgainLabel</PoButton>
    }
    <PoButton class="app-btn app-btn--ghost pocabinet-results__more-toggle"
            aria-expanded="@(_details ? "true" : "false")" aria-controls="pocabinet-results-details"
            Click="() => _details = !_details">@(_details ? "Hide race details" : "Race details")</PoButton>
</div>
<div id="pocabinet-results-details" class="pocabinet-results__details @(_details ? "pocabinet-results__details--open" : null)"
     inert="@(!_details)">
<div class="pocabinet-results__grid">
    <div class="pocabinet-results__col">
        @if (Standings is { Count: > 0 } standings)
        {
            <ol class="pocabinet-standings" aria-label="Standings">
                @foreach (var (entry, idx) in standings.Take(3).Select((c, i) => (c, i)))
                {
                    <li class="pocabinet-standings__podium @(entry.IsLocal ? "pocabinet-standings__me" : null)">
                        <span class="pocabinet-standings__pos" aria-hidden="true">@(idx == 0 ? "🥇" : idx == 1 ? "🥈" : "🥉")</span>
                        <span class="pocabinet-sr">P@(idx + 1)</span>
                        <span class="pocabinet-standings__name">@entry.Name</span>
                        <span class="pocabinet-standings__detail">@entry.Detail</span>
                    </li>
                }
                @foreach (var (place, entry) in BelowPodium(standings))
                {
                    @if (entry is null)
                    {
                        <li class="pocabinet-standings__gap" aria-hidden="true">⋯</li>
                    }
                    else
                    {
                        @* The place is written out: with gaps in the list the markers (hidden by the reset anyway) would lie. *@
                        <li class="@(entry.IsLocal ? "pocabinet-standings__me" : null)">
                            <span class="pocabinet-standings__pos">P@(place)</span>
                            <span class="pocabinet-standings__name">@entry.Name</span>
                            <span class="pocabinet-standings__detail">@entry.Detail</span>
                        </li>
                    }
                }
            </ol>
        }
        @if (Laps.LapRows > 0)
        {
            @* Each lap's sectors and time in one sortable grid. Green: a personal-best sector; violet: this race's best. *@
            <RadzenDataGrid Data="@LapGridRows()" TItem="LapGridRow" AllowSorting="true" Density="Density.Compact" class="pocabinet-laps">
                <Columns>
                    <RadzenDataGridColumn TItem="LapGridRow" Property="Lap" Title="Lap" Width="54px" />
                    <RadzenDataGridColumn TItem="LapGridRow" Property="S1" Title="S1">
                        <Template Context="r"><span class="pocabinet-sector @Laps.SectorClass(r.S1, 0)">@(r.S1 is { } v ? PoCabinetCatalog.FormatLap(v) : "—")</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LapGridRow" Property="S2" Title="S2">
                        <Template Context="r"><span class="pocabinet-sector @Laps.SectorClass(r.S2, 1)">@(r.S2 is { } v ? PoCabinetCatalog.FormatLap(v) : "—")</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LapGridRow" Property="S3" Title="S3">
                        <Template Context="r"><span class="pocabinet-sector @Laps.SectorClass(r.S3, 2)">@(r.S3 is { } v ? PoCabinetCatalog.FormatLap(v) : "—")</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LapGridRow" Property="Time" Title="Time">
                        <Template Context="r">
                            <span class="@(r.Deleted ? "pocabinet-lap--deleted" : r.IsBest ? "pocabinet-laps__best" : null)"
                                  title="@(r.Deleted ? "Deleted: track limits" : null)">@(r.Time > 0 ? PoCabinetCatalog.FormatLap(r.Time) : "—")</span>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </div>
    @if (!IsSpectating)
    {
        <div class="pocabinet-telemetry">
            <div class="pocabinet-telemetry__head">
                <h3>Telemetry — best lap@(HasReferenceLap ? " vs your personal best" : "")</h3>
            </div>
            @* No lap at all (an early wreck): the canvas stays for race.js, but an empty box is not shown. *@
            <canvas id="pocabinetTelemetry" class="pocabinet-telemetry__chart @(Laps.LapRows == 0 ? "pocabinet-telemetry__chart--empty" : null)" role="img"
                    aria-label="@(TelemetrySummary ?? "Speed, time delta and pedal trace for your best lap")"></canvas>
            @if (!string.IsNullOrEmpty(TelemetrySummary))
            {
                <p class="pocabinet-telemetry__summary">@TelemetrySummary</p>
            }
            @if (Debrief is { } debrief)
            {
                <section class="pocabinet-debrief" aria-label="Race engineer">
                    <p class="pocabinet-debrief__headline">📰 @debrief.Headline</p>
                    <ul class="pocabinet-debrief__tips">
                        @foreach (var tip in debrief.Tips)
                        {
                            <li>@tip</li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
</div>
</div>
@if (!string.IsNullOrEmpty(Status))
{
    <p class="pocabinet-status" role="status">@Status</p>
}
@code {
    /// <summary>One results row: name plus a short detail (finish time, "You", "AI official").</summary>
    public sealed record Row(string Name, string Detail, bool IsLocal);

    private sealed record LapGridRow(int Lap, double? S1, double? S2, double? S3, double Time, bool Deleted, bool IsBest);

    private List<LapGridRow> LapGridRows()
    {
        var list = new List<LapGridRow>(Laps.LapRows);
        for (var i = 0; i < Laps.LapRows; i++)
        {
            var sectors = i < Laps.LapSectors.Count ? Laps.LapSectors[i] : null;
            var time = i < Laps.LapTimes.Count ? Laps.LapTimes[i] : 0;
            var deleted = i < Laps.LapDeleted.Count && Laps.LapDeleted[i];
            list.Add(new LapGridRow(
                i + 1,
                sectors is { Length: > 0 } ? sectors[0] : null,
                sectors is { Length: > 1 } ? sectors[1] : null,
                sectors is { Length: > 2 } ? sectors[2] : null,
                time,
                deleted,
                time > 0 && time == Laps.BestValidLap));
        }
        return list;
    }

    [Parameter, EditorRequired] public PoCabinetLapBook Laps { get; set; } = new();
    [Parameter] public List<Row>? Standings { get; set; }
    [Parameter] public int Position { get; set; }
    [Parameter] public int TotalCars { get; set; }
    [Parameter] public string TrackName { get; set; } = "";
    [Parameter] public bool IsSpectating { get; set; }
    [Parameter] public bool IsMultiplayer { get; set; }
    /// <summary>Online: the local car is home but the server has not called the race yet.</summary>
    [Parameter] public bool AwaitingFinal { get; set; }
    [Parameter] public bool IsPersonalBest { get; set; }
    [Parameter] public double PreviousBest { get; set; }
    [Parameter] public PoCabinetTalk.Debrief? Debrief { get; set; }
    [Parameter] public string? TelemetrySummary { get; set; }
    [Parameter] public bool HasReferenceLap { get; set; }
    [Parameter] public string? Status { get; set; }
    /// <summary>The player's car was wrecked: did not finish, classified behind every runner.</summary>
    [Parameter] public bool Dnf { get; set; }
    /// <summary>The card's primary button: race again (online: back to the lobby).</summary>
    [Parameter] public EventCallback OnRaceAgain { get; set; }
    [Parameter] public string RaceAgainLabel { get; set; } = "Race again";

    /// <summary>The field, the laps, the telemetry and the debrief: shut until asked for.</summary>
    private bool _details;

    /// <summary>This race's best lap: the best that counted, else the best timed.</summary>
    private double RaceBest => Laps.BestValidLap > 0 ? Laps.BestValidLap : Laps.BestLapSession;

    /// <summary>The best lap before this race: the stored record's answer, else what the race loaded.</summary>
    private double ReferenceBest => PreviousBest > 0 ? PreviousBest : Laps.StoredBestLap;

    private double? Delta => RaceBest > 0 && ReferenceBest > 0 ? RaceBest - ReferenceBest : null;

    private string DeltaText => Delta is { } d
        ? (d < 0 ? "−" : "+") + Math.Abs(d).ToString("0.000", System.Globalization.CultureInfo.InvariantCulture) + " s"
        : RaceBest > 0 ? "First lap on record" : "No lap counted";

    private string? DeltaClass => Delta is { } d
        ? d < 0 ? "pocabinet-results__delta--faster" : d > 0 ? "pocabinet-results__delta--slower" : null
        : "pocabinet-results__delta--none";

    private string Headline => AwaitingFinal ? "You're home — waiting for the field…"
        : Dnf ? "Wrecked — did not finish"
        : "Race finished";

    /// <summary>
    /// The standings below the podium. A solo field is a hundred rows, so only the places round
    /// the player (two either side) are listed; a gap shows as a null row. A multiplayer-sized
    /// field (twelve or fewer) is listed whole.
    /// </summary>
    private static IEnumerable<(int Place, Row? Row)> BelowPodium(List<Row> standings)
    {
        var mine = standings.FindIndex(r => r.IsLocal);
        var last = 3;
        for (var i = 3; i < standings.Count; i++)
        {
            if (standings.Count > 12 && (mine < 0 || Math.Abs(i - mine) > 2)) continue;
            if (i > last) yield return (0, null);
            yield return (i + 1, standings[i]);
            last = i + 1;
        }
        if (last < standings.Count) yield return (0, null);
    }
}
