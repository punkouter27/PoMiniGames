@*
    PoCabinetBroadcast — the demo's timing tower (broadcast.js), shown only while the Stats panel
    is open (Tab). Every data-bc text
    node is rendered EMPTY on purpose and written by JS a few times a second, like the gauge, so
    Blazor owns no text that JS changes. aria-hidden: an attract loop; the page's announcer
    covers the finish.
*@

<div id="pocabinetBroadcast" class="pocabinet-bc" aria-hidden="true">
    <div class="pocabinet-bc__tower">
        <div class="pocabinet-bc__head"><span class="pocabinet-bc__live">Live</span><span class="pocabinet-bc__lap" data-bc="lap"></span></div>
        @* Blazor's own text (broadcast.js never touches it): where the race is. *@
        <div class="pocabinet-bc__venue">@TrackName</div>
        <ol class="pocabinet-bc__rows">
            @for (var i = 0; i < Rows; i++)
            {
                <li class="pocabinet-bc__row" data-bc-row data-state="off">
                    <span class="pocabinet-bc__rpos" data-bc="rpos"></span>
                    <span class="pocabinet-bc__rchip" data-bc="rchip"></span>
                    <span class="pocabinet-bc__rcode" data-bc="rcode"></span>
                    <span class="pocabinet-bc__rgap" data-bc="rgap"></span>
                </li>
            }
        </ol>
    </div>
</div>

@code {
    /// <summary>The timing tower rows: the top ten, a gap, and the car on screen when it is further back (broadcast.js).</summary>
    private const int Rows = 12;

    [Parameter] public string TrackName { get; set; } = "";
}
