@page "/"
@inject NavigationManager NavigationManager
@inject KioskCoordinator Kiosk
@inject IJSRuntime JS
@inject ActivityFeedService ActivityFeed
@inject UiFeedbackService Feedback
@inject OnlineStatusService OnlineStatus
@inject ToastService Toasts
@inject IWebAssemblyHostEnvironment Env
@implements IAsyncDisposable

@* ─────────────────────────────────────────────────────────────────────────
   Home — one card per game, one chip per mode.

   This replaced four mode-keyed sections (Demo / 1P / 2P / Multiplayer), each
   of which listed the games that supported it. That shape had two costs:

     • Nine of ten games appeared two-to-four times on one screen, and each
       section carried its own duplicate 🏆 Leaderboard link to the same URL.
     • A game was only discoverable in a mode if someone remembered to add it
       to that section's list, so a game could be watch-only from here despite
       having a working single-player route.

   Pivoting to game-major fixes both: the card is the game, the chips are
   whatever modes it declares in GameCatalog, so a supported mode cannot go
   un-listed. See GameCatalog.All.
   ───────────────────────────────────────────────────────────────────────── *@

<PageTitle>Home · PoMiniGames</PageTitle>

<div class="home-container">
    <span class="home-mesh" aria-hidden="true"></span>
    @* GPU-accelerated ambient particle field. WebGL2-only; falls back to the
       CSS gradient on browsers without WebGL2 (Safari TP, etc.). *@
    <canvas @ref="_ambientCanvas" class="home-ambient" aria-hidden="true"></canvas>

    @* The page's heading, its finder and the demo reel, in the shared header: the brand
       above already says the name, so the h1 is for the outline only, and a page whose
       only navigation is fourteen cards needs a way to find one of them by typing.

       Leaderboards, My Stats and Settings live in the top bar's account menu, on every
       route. Links carrying data-hub-nav are launched by js/app.js: an in-app navigation
       wrapped in a view transition that morphs the pressed card into the game's title. *@
    <PageHeader Title="PoMiniGames" VisuallyHidden="true">
        <Actions>
            <div class="home-tools">
                @* A native search field rather than a Radzen one: the hub does not load
                   Radzen's theme or script, and adding both to the most-visited page to
                   style one input would cost more than the whole grid. *@
                <div class="home-search" role="search">
                    <span class="material-symbols-outlined home-search__icon" aria-hidden="true">search</span>
                    <input type="search" class="home-search__input"
                           placeholder="Find a game"
                           aria-label="Find a game by name or description"
                           value="@_query"
                           @oninput="OnSearchInput" />
                    @if (_query.Length > 0)
                    {
                        <button type="button" class="home-search__clear" aria-label="Clear search" @onclick="ClearSearch">×</button>
                    }
                </div>

                @* aria-pressed is a literal string, not a bare bool: Blazor renders a
                   bool-valued attribute as an HTML boolean attribute, which is not a valid
                   ARIA state. The visible text shortens on a narrow phone, so the full
                   name is the aria-label. *@
                <button type="button"
                        class="home-action home-action--demo @(Kiosk.IsActive ? "home-action--on" : null)"
                        aria-pressed="@(Kiosk.IsActive ? "true" : "false")"
                        aria-label="@(Kiosk.IsActive ? "Stop demos" : "Watch all demos")"
                        title="@(Kiosk.IsActive ? "Stop watching all demos" : "Auto-play every demo in turn")"
                        @onclick="ToggleWatchAll">
                    <span class="home-action-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="3" width="20" height="14" rx="2"/>
                            <path d="M8 21h8"/><path d="M12 17v4"/>
                            <polygon points="10 8 15 10.5 10 13 10 8" fill="currentColor" stroke="none"/>
                        </svg>
                    </span>
                    <span class="home-action-label">@(Kiosk.IsActive ? "Stop demos" : "Watch all demos")</span>
                </button>
            </div>
        </Actions>
    </PageHeader>

    <div class="home-grid">
        @foreach (var game in VisibleGames)
        {
            var playable = IsPlayable(game.Primary);
            <article class="home-card" aria-labelledby="@($"home-card-{game.Key.Value}")">
                @* The heading opens the game's main mode: one large target on every card,
                   however small a short phone makes the chips. Out of the tab order,
                   because the first chip is the same destination for a keyboard. *@
                @if (playable)
                {
                    <a class="home-card-head" href="@game.Primary.Url" data-hub-nav tabindex="-1"
                       title="@($"Play {game.Title} — {GameModes.ToDescription(game.Primary.Mode)}")">
                        <span class="home-card-icon material-symbols-outlined" aria-hidden="true">@game.Icon</span>
                        <span class="home-card-title" id="@($"home-card-{game.Key.Value}")">@game.Title</span>
                    </a>
                }
                else
                {
                    <div class="home-card-head home-card-head--offline"
                         aria-disabled="true"
                         title="Needs a connection — unavailable offline">
                        <span class="home-card-icon material-symbols-outlined" aria-hidden="true">@game.Icon</span>
                        <span class="home-card-title" id="@($"home-card-{game.Key.Value}")">@game.Title</span>
                    </div>
                }

                @* Four chips, then a "+N" that opens the rest in a popover. Brawl used to
                   spend six chips on one card, which made its whole grid row taller than
                   every other one; the popover keeps those modes one tap away instead of
                   spending the layout on them. *@
                <div class="home-card-modes">
                    @foreach (var m in game.Modes.Take(HomeChipLimit))
                    {
                        @ModeChip(game, m)
                    }
                    @if (game.Modes.Count > HomeChipLimit)
                    {
                        var rest = game.Modes.Skip(HomeChipLimit).ToList();
                        var panelId = $"home-more-{game.Key.Value}";
                        @* One anchor name per card. A single shared name would have every
                           panel anchor to whichever button the browser picked last, which
                           put Brawl's folded modes under the Racer card. *@
                        <button type="button" class="home-mode-chip home-mode-chip--more"
                                popovertarget="@panelId" aria-haspopup="true"
                                style="@($"anchor-name: --home-more-{game.Key.Value}")"
                                aria-label="@($"{game.Title}: {rest.Count} more modes")">+@rest.Count</button>
                        <div id="@panelId" popover="auto" class="home-more-panel"
                             role="group" aria-label="@($"{game.Title} other modes, {game.Description}")"
                             style="@($"position-anchor: --home-more-{game.Key.Value}")">
                            @foreach (var m in rest)
                            {
                                @ModeChip(game, m)
                            }
                        </div>
                    }
                </div>

                @* What the game is. Sits on its own line under the title and chips. *@
                <p class="home-card-desc">@game.Description</p>
            </article>
        }
    </div>

    @if (VisibleGames.Count == 0)
    {
        <div class="home-no-results" role="status">
            <p>No game matches “@_query.Trim()”.</p>
            <button type="button" class="app-btn app-btn--secondary app-btn--sm" @onclick="ClearSearch">Show every game</button>
        </div>
    }

    @* Home page activity feed: surfaces the player's most recent matches
       so the page never feels empty even on a fresh install. Pulled from the
       existing /api/matches endpoint via ActivityFeedService — no new API. *@
    @if (_activity.Count > 0)
    {
        <section class="home-activity" aria-label="Your recent activity">
            <h2 class="home-activity__title">Your recent activity</h2>
            <ul class="home-activity__list">
                @foreach (var item in _activity)
                {
                    <li class="home-activity__card">
                        <span class="home-activity__icon" aria-hidden="true">@item.Icon</span>
                        <span class="home-activity__body">
                            <a class="home-activity__game" href="@item.Url">@item.GameTitle</a>
                            <span class="home-activity__msg">@item.Message</span>
                        </span>
                        <span class="home-activity__time" title="@item.When.ToString("u")">@FormatRelative(item.When)</span>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@code {
    private ElementReference _ambientCanvas;
    private IJSObjectReference? _ambientModule;
    private bool _ambientStarted;

    // How many mode chips a card shows before the rest fold into a "+N" popover. Three,
    // not four: a 305px card on a laptop cannot hold a title and four chips — the fourth
    // was being clipped mid-word by the card's paint containment.
    private const int HomeChipLimit = 3;

    // The finder's query. Filtering happens in memory over fourteen catalogue entries,
    // so there is nothing to debounce and no round trip to make.
    private string _query = "";

    private List<CatalogGame> VisibleGames
    {
        get
        {
            var q = _query.Trim();
            if (q.Length == 0) return [.. GameCatalog.AllSorted];
            return GameCatalog.AllSorted
                .Where(g => Matches(g, q))
                .ToList();
        }
    }

    private static bool Matches(CatalogGame game, string query) =>
        game.Title.Contains(query, StringComparison.OrdinalIgnoreCase)
        || game.Description.Contains(query, StringComparison.OrdinalIgnoreCase)
        || game.Modes.Any(m =>
            (m.ChipLabel?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
            || (m.ChipDescription?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false));

    private void OnSearchInput(ChangeEventArgs e) => _query = e.Value?.ToString() ?? "";

    private void ClearSearch() => _query = "";

    // Activity feed (recent matches).
    private IReadOnlyList<ActivityFeedService.FeedItem> _activity = Array.Empty<ActivityFeedService.FeedItem>();

    // Offline, a hub-backed or API-backed mode is not playable: with the service
    // worker installed the shell loads fine without a network, so leaving these
    // navigable would drop the player into a lobby that can never connect. Modes
    // that run locally stay fully playable.
    private bool IsPlayable(CatalogMode mode) => !mode.RequiresNetwork || OnlineStatus.IsOnline;

    // data-hub-nav: js/app.js launches the game in place, morphing the card into its title.
    private static string ModeLabel(CatalogMode mode) => mode.ChipLabel ?? GameModes.ToLabel(mode.Mode);
    private static string ModeDescription(CatalogMode mode) => mode.ChipDescription ?? GameModes.ToDescription(mode.Mode);

    private RenderFragment ModeChip(CatalogGame game, CatalogMode m) =>
        IsPlayable(m)
            ? @<a class="home-mode-chip home-mode-chip--@(m.Mode.ToString().ToLowerInvariant())"
                  href="@(m.ChipUrl ?? m.Url)" data-hub-nav
                  title="@($"{game.Title} — {ModeDescription(m)}")"
                  aria-label="@($"{game.Title}, {ModeDescription(m)}")">@ModeLabel(m)</a>
            : @<span class="home-mode-chip home-mode-chip--offline"
                     aria-disabled="true"
                     aria-label="@($"{game.Title}, {ModeDescription(m)} — unavailable offline")"
                     title="Needs a connection — unavailable offline">@ModeLabel(m)</span>;

    protected override void OnInitialized()
    {
        // Subscribe to kiosk state so the Demo button (Start ↔ Stop) updates
        // reactively when the coordinator starts/stops/pauses/advances.
        Kiosk.Changed += OnKioskStateChanged;
        // Connectivity drives which chips are navigable (see IsPlayable), so the grid
        // has to re-render the moment the browser goes offline or comes back.
        OnlineStatus.StateChanged += OnOnlineStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        // Pull the feed once on initial render. The ActivityFeedService is
        // best-effort — it never throws — so we can await it without a try
        // and still get a graceful empty feed if the API is offline.
        try
        {
            _activity = await ActivityFeed.GetRecentAsync(limit: 5);
        }
        catch
        {
            _activity = Array.Empty<ActivityFeedService.FeedItem>();
        }
    }

    private static string FormatRelative(DateTimeOffset when)
    {
        var diff = DateTimeOffset.UtcNow - when;
        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return when.ToString("MMM d");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Lazy WebGL bootstrap — only on first paint so we don't ship the
        // JS payload during SSR / prerender. Gate on the device-capability
        // probe so low-memory phones and prefers-reduced-motion users skip
        // the GPU wake entirely; the CSS gradient behind the canvas is the
        // fallback for everyone else.
        if (firstRender && !_ambientStarted)
        {
            _ambientStarted = true;
            // The --audio-* bands the card icons and the top bar's edge move to (fx.css).
            // Off by default in visualRuntime.js; on here and off in DisposeAsync so only
            // the catalog and the lobbies pay for the per-frame write.
            try { await JS.InvokeVoidAsync("PoVisualRuntime.enableAudioReactive", true); } catch { /* module not loaded */ }
            try
            {
                var canRender = await JS.InvokeAsync<bool>("probeWebGL2");
                if (!canRender)
                {
                    _ambientModule = null;
                    return;
                }
                _ambientModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./js/ambientParticles.js");
                await _ambientModule.InvokeVoidAsync("start", _ambientCanvas);
            }
            catch
            {
                // WebGL2 unavailable — the CSS gradient behind the canvas is the fallback.
                _ambientModule = null;
            }
        }
    }

    private void OnKioskStateChanged() => InvokeAsync(StateHasChanged);

    private void OnOnlineStateChanged() => InvokeAsync(StateHasChanged);

    // "Watch all demos": start (or stop) the auto-rotating kiosk over every demo game.
    private async Task ToggleWatchAll()
    {
        await Feedback.TapAsync();
        if (Kiosk.IsActive)
        {
            Kiosk.Stop();
            return;
        }
        await BeginKioskFromAsync(0);
    }

    /// <summary>
    /// Start the kiosk reel at the given demo index. The "Watch all demos"
    /// button always passes 0; the index parameter survives because the reel
    /// itself re-enters here when a game hands off to the next one.
    /// </summary>
    private async Task BeginKioskFromAsync(int index)
    {
        var demos = GameCatalog.Demo;
        if (demos.Count == 0) return;
        if (index < 0 || index >= demos.Count) index = 0;

        Kiosk.RegisterEntries(demos.Select(d => new Services.Play.DemoEntry(DemoEntryKey(d), d.Url, d.Title, d.Icon)));
        // Clear every active toast before entering the reel — the PWA "Update now"
        // prompt and any error toast are persistent (ShowAction never auto-expires) and
        // would otherwise follow the user into the loop and steal taps from the reel
        // controls. One-shot entry, not per-game.
        Toasts.DismissAll();
        var entry = demos[index];
        var sep = entry.Url.Contains('?') ? '&' : '?';
        // Display index `index` with advance pointer `index` so the first rotation
        // lands on `index + 1`. Starting at 1 instead of 0 used to skip the second
        // demo on every lap; the same logic has to work for non-zero starts.
        Kiosk.Start(index);
        NavigationManager.NavigateTo($"{entry.Url}{sep}kiosk={index}");
    }

    private static string DemoEntryKey(CatalogEntry entry) =>
        entry.Url.Split('?', '#')[0] == "/pobrawl/ffa" ? "pobrawl-ffa" : entry.Key.Value;


    public async ValueTask DisposeAsync()
    {
        Kiosk.Changed -= OnKioskStateChanged;
        OnlineStatus.StateChanged -= OnOnlineStateChanged;
        try { await JS.InvokeVoidAsync("PoVisualRuntime.enableAudioReactive", false); } catch { /* page unloading */ }
        if (_ambientModule is not null)
        {
            try
            {
                await _ambientModule.InvokeVoidAsync("stop");
                await _ambientModule.DisposeAsync();
            }
            catch { /* module never loaded — fine */ }
            _ambientModule = null;
        }
    }
}
