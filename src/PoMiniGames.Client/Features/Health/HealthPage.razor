@page "/diag"
@page "/health"
@using PoMiniGames.Shared.Diagnostics
@implements IAsyncDisposable
@inject ApiService ApiService

@*
    /diag — the plain-English status page (fleet /diag standard, 2026-11-17). /health stays as
    an alias: the server's GET /health hands a browser (Accept: text/html) the Blazor shell
    and the router lands here, while monitors and the deploy gate keep the JSON contract
    (HealthEndpoints.PrefersHtml). /health/live is the separate dependency-free probe.

    Everything shown comes from GET /api/diag (DiagEndpoints): the server's own health checks
    plus a configured/not-configured note per external service. That payload carries no
    secrets or addresses, so the page is safe to leave open to anyone. Drawn with the
    estate's /diag classes (po-diag__card, po-badge--ok|warn|bad in po-tokens.css): groups
    API, Data and Services, one card per dependency.
*@

<PageTitle>Status · PoMiniGames</PageTitle>

<div class="dg po-diag">
    <PageHeader Title="Status">
        <Actions>
            <button type="button" class="app-btn app-btn--secondary" disabled="@_loading" aria-busy="@(_loading ? "true" : "false")"
                    @onclick="RefreshAsync" aria-label="Refresh the status">
                @(_loading ? "Checking…" : "Refresh")
            </button>
        </Actions>
    </PageHeader>

    <div class="dg-body" aria-live="polite">
        @if (_report is null && _error is null)
        {
            <div class="dg-loading" role="status">
                <span>Checking the API, storage and services…</span>
            </div>
        }
        else if (_error is not null)
        {
            <div class="dg-banner dg-banner--bad" role="alert">
                <span class="po-badge po-badge--bad">Down</span>
                <div>
                    <p class="dg-banner-title">The API is not answering</p>
                    <p class="dg-banner-text">@_error</p>
                </div>
            </div>
        }
        else if (_report is { } r)
        {
            <div class="dg-banner dg-banner--@BadgeClass(r.Status)" data-testid="diag-banner">
                <span class="po-badge po-badge--@BadgeClass(r.Status)">@r.Status</span>
                <div>
                    <p class="dg-banner-title">@BannerTitle(r.Status)</p>
                    <p class="dg-banner-text">@BannerText(r.Status)</p>
                </div>
            </div>

            <section class="dg-section po-diag__group" aria-labelledby="dg-api">
                <h2 class="dg-h2" id="dg-api">API</h2>
                <div class="dg-card po-diag__card">
                    <span class="dg-name">PoMiniGames API</span>
                    <span class="po-badge po-badge--ok">Reachable</span>
                    <p class="dg-desc">Serves the games, scores and leaderboards. Answered in @Ms(_roundTripMs).</p>
                </div>
            </section>

            <section class="dg-section po-diag__group" aria-labelledby="dg-stores">
                <h2 class="dg-h2" id="dg-stores">Data</h2>
                @if (r.Stores.Count == 0)
                {
                    <p class="dg-empty">This server has no storage checks registered.</p>
                }
                else
                {
                    @foreach (var c in r.Stores)
                    {
                        @CheckCard(c)
                    }
                }
            </section>

            <section class="dg-section po-diag__group" aria-labelledby="dg-services">
                <h2 class="dg-h2" id="dg-services">Services</h2>
                @if (r.Services.Count == 0)
                {
                    <p class="dg-empty">This app uses no external services.</p>
                }
                else
                {
                    @foreach (var c in r.Services)
                    {
                        @CheckCard(c)
                    }
                }
            </section>

            <section class="dg-section po-diag__group" aria-labelledby="dg-about">
                <h2 class="dg-h2" id="dg-about">About this build</h2>
                <div class="dg-card">
                    <dl class="dg-facts">
                        <dt>Version</dt><dd data-testid="diag-version">@BuildInfo.Date</dd>
                        <dt>Server build</dt><dd>@r.Version</dd>
                        <dt>Environment</dt><dd>@r.Environment</dd>
                        <dt>Last checked</dt><dd>@r.CheckedAtUtc.ToLocalTime().ToString("HH:mm:ss")</dd>
                    </dl>
                </div>
            </section>
        }
    </div>
</div>

@code {
    private DiagReport? _report;
    private string? _error;
    private double _roundTripMs;
    private bool _loading;
    private readonly CancellationTokenSource _cts = new();

    private RenderFragment CheckCard(DiagCheck c) => @<div class="dg-card po-diag__card">
        <span class="dg-name">@c.Name</span>
        <span class="po-badge po-badge--@BadgeClass(c.Status)">@c.Status</span>
        <p class="dg-desc">@c.Description</p>
        <p class="dg-meta">
            @(c.LatencyMs is { } ms ? $"Checked in {Ms(ms)}" : "Not probed")
            · last checked @(_report?.CheckedAtUtc.ToLocalTime().ToString("HH:mm:ss"))
            @if (c.Error is not null)
            {
                <span> · error: @c.Error</span>
            }
        </p>
    </div>;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        if (_loading || _cts.IsCancellationRequested) return;
        _loading = true;
        StateHasChanged();
        try
        {
            var (report, roundTrip, error) = await ApiService.GetDiagReportAsync(_cts.Token);
            if (_cts.IsCancellationRequested) return;
            _report = report;
            _roundTripMs = roundTrip;
            _error = report is null ? error ?? "The API sent no report." : null;
        }
        finally
        {
            _loading = false;
            if (!_cts.IsCancellationRequested) StateHasChanged();
        }
    }

    private static string Ms(double ms) => ms < 1 ? "under 1 ms" : $"{ms:0} ms";

    // po-badge--ok|warn|bad (po-tokens.css). Anything that is not healthy or degraded,
    // including "Not configured", reads as a warning rather than an outage.
    private static string BadgeClass(string status) => status switch
    {
        "Healthy" => "ok",
        "Degraded" => "warn",
        "Unhealthy" => "bad",
        _ => "warn",
    };

    private static string BannerTitle(string status) => status switch
    {
        "Healthy" => "Everything is working",
        "Degraded" => "Running, with a problem",
        _ => "Something is down",
    };

    private static string BannerText(string status) => status switch
    {
        "Healthy" => "The API, its storage and its services all answered normally.",
        "Degraded" => "The games still play, but scores or leaderboards may not save until storage recovers.",
        _ => "A required part of the app is not answering. Details are below.",
    };

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        return ValueTask.CompletedTask;
    }
}
