@page "/pofighter"
@page "/pofighter/{Mode}"
@implements IAsyncDisposable
@using PoMiniGamesClient.Features.Shared
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@inject IJSRuntime JS
@inject PlayerNameService PlayerNameService
@inject ILogger<PoFighterPage> Logger

<PageTitle>PoFighter · PoMiniGames</PageTitle>

@* PoFighter (preview): one fighter cut from a filmed performer, in a practice room.
   Blazor owns only this static markup. wwwroot/js/pofighter/index.js runs the loop, reads
   keyboard, gamepad and the touch buttons, and writes the hit counter and the lit move row
   straight into the elements marked data-pf-*; there are no .NET callbacks and nothing is
   scored or sent. Product requirements: DOCS/20261112/PoFighter-PRD.md. *@
<GameShell Title=@TitleContent
           Player="@_playerName"
           BackTo="/"
           GameKey="pofighter"
           Fullscreen="true">
    @if (!_introDismissed)
    {
        <GameIntro CueScope="pofighter"
                   Title=@TitleContent
                   Objective="Preview: a practice room. Try every move on the bag."
                   Controls="@ControlsContent"
                   Mode="GameIntro.IntroMode.OnePlayer"
                   OnStart="@(() => _introDismissed = true)" />
    }
    else
    {
        <div class="pf-room" @ref="_room" data-pf-device="keys">
            <canvas class="pf-canvas" data-pf-canvas
                    aria-label="Practice room: your fighter on the left, a punching bag on the right"></canvas>

            @if (_failed)
            {
                <div class="pf-error"><ErrorState Title="The fighter could not be loaded">Check your connection and reopen the game.</ErrorState></div>
            }

            <div class="pf-panel pf-moves" aria-label="Moves and their controls">
                <ul>
                    @foreach (var m in Moves)
                    {
                        <li data-pf-move="@m.Id">
                            <span class="pf-name">@m.Name</span>
                            <span class="pf-ctl pf-ctl-keys">@m.Keys</span>
                            <span class="pf-ctl pf-ctl-pad">@m.Pad</span>
                        </li>
                    }
                </ul>
            </div>

            <div class="pf-panel pf-status">
                <span class="pf-hits" role="status">Hits <strong data-pf-hits>0</strong></span>
                <select class="pf-select" aria-label="Select fighter" value="@_fighterId" @onchange="OnFighterChangedAsync">
                    <option value="p1">Default (P1)</option>
                    @foreach (var f in _customFighters)
                    {
                        <option value="@f.Id">@f.Name</option>
                    }
                </select>
                <button type="button" class="pf-chip" @onclick="OpenStudioAsync" title="Create a fighter from webcam or video (MediaPipe WASM)">✨ Studio</button>
                <button type="button" class="pf-chip" data-pf-btn="victory" title="Celebrate (V)">Cheer</button>
                <button type="button" class="pf-chip" data-pf-btn="ko" title="Get knocked down; any button gets up (X)">Fall</button>
                <button type="button" class="pf-chip" data-pf-action="reset" title="Reset the room (R)">Reset</button>
                <button type="button" class="pf-chip" data-pf-action="slow" aria-pressed="false"
                        title="Quarter speed, to judge a move picture by picture (T)">Slow</button>
            </div>

            @if (_studioOpen)
            {
                <div class="pf-studio" role="dialog" aria-modal="true" aria-label="PoFighter Studio">
                    <div class="pf-studio-card">
                        <header class="pf-studio-head">
                            <h2>PoFighter Studio</h2>
                            <button type="button" class="pf-chip" @onclick="CloseStudioAsync"><span class="material-symbols-outlined" aria-hidden="true">close</span> Close</button>
                        </header>
                        <p class="pf-studio-status" @ref="_studioStatus">Ready — use webcam capture or upload a short clip (MediaPipe WASM runs 100% in your browser).</p>
                        <div class="pf-studio-body">
                            <div class="pf-studio-cams">
                                <video @ref="_studioVideo" class="pf-studio-video" muted playsinline></video>
                                <canvas @ref="_studioPreview" class="pf-studio-preview" width="240" height="240"></canvas>
                            </div>
                            <div class="pf-studio-controls">
                                <label class="pf-studio-name">
                                    <span>Fighter name</span>
                                    <input type="text" maxlength="24" @bind="_studioFighterName" placeholder="My Fighter" />
                                </label>
                                <div class="pf-studio-row">
                                    <button type="button" class="pf-chip" @onclick="StartWebcamAsync">📷 Start Webcam</button>
                                    <button type="button" class="pf-chip" @onclick="CaptureBgAsync">🖼️ Capture BG</button>
                                    <label class="pf-chip pf-upload">
                                        🎞️ Upload Video
                                        <input @ref="_studioFile" type="file" accept="video/*" @onchange="ImportVideoAsync" hidden />
                                    </label>
                                </div>
                                <div class="pf-studio-moves">
                                    @foreach (var m in StudioMoves)
                                    {
                                        var count = _studioCounts.TryGetValue(m.Id, out var c) ? c : 0;
                                        <button type="button" class="pf-chip" @onclick="() => CaptureMoveAsync(m.Id)" title="@m.Hint">
                                            @m.Label (@count)
                                        </button>
                                    }
                                </div>
                                <div class="pf-studio-row">
                                    <button type="button" class="pf-chip pf-chip--primary" disabled="@(_studioTotalFrames == 0 || _studioBusy)" @onclick="SaveStudioFighterAsync">
                                        ⚔️ Save &amp; Fight (@_studioTotalFrames frames)
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="pf-touch pf-touch-move" aria-label="Movement">
                <button type="button" data-pf-btn="left" aria-label="Walk backward">◀</button>
                <div class="pf-touch-stack">
                    <button type="button" data-pf-btn="up" aria-label="Jump"><span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_up</span></button>
                    <button type="button" data-pf-btn="down" aria-label="Crouch"><span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_down</span></button>
                </div>
                <button type="button" data-pf-btn="right" aria-label="Walk forward">▶</button>
            </div>
            <div class="pf-touch pf-touch-attack" aria-label="Attacks">
                <button type="button" data-pf-btn="punchMid">Punch</button>
                <button type="button" data-pf-btn="kick">Kick</button>
            </div>
        </div>
    }
</GameShell>

@code {
    [Parameter] public string? Mode { get; set; }

    private sealed record MoveRow(string Id, string Name, string Keys, string Pad);

    // Ids match the move names in wwwroot/data/pofighter/p1.json.
    private static readonly MoveRow[] Moves =
    [
        new("idle", "Stance", "—", "—"),
        new("walkF", "Walk forward", "→ / D", "D-pad →"),
        new("walkB", "Walk backward", "← / A", "D-pad ←"),
        new("crouch", "Crouch", "↓ / S", "D-pad ↓"),
        new("jump", "Jump", "↑ / W", "D-pad ↑"),
        new("punchMid", "Punch", "J", "X"),
        new("kick", "Kick", "L", "A"),
        new("victory", "Cheer · every 10 hits", "V", "LB"),
        new("ko", "Knockdown · any key gets up", "X", "RB"),
    ];

    private ElementReference _room;
    private ElementReference _studioVideo;
    private ElementReference _studioPreview;
    private ElementReference _studioStatus;
    private ElementReference _studioFile;
    private string _playerName = "";
    private bool _introDismissed;
    private bool _started;
    private bool _failed;
    private string _fighterId = "p1";
    private List<CustomFighterItem> _customFighters = [];
    private bool _studioOpen;
    private bool _studioBusy;
    private string _studioFighterName = "My Fighter";
    private Dictionary<string, int> _studioCounts = [];
    private int _studioTotalFrames => _studioCounts.Values.Sum();
    private IJSObjectReference? _studioModule;
    private IJSObjectReference? _studioCtrl;
    private DotNetObjectReference<PoFighterPage>? _selfRef;

    private sealed record CustomFighterItem(string Id, string Name);
    private sealed record StudioMoveDef(string Id, string Label, string Hint);
    private static readonly StudioMoveDef[] StudioMoves =
    [
        new("idle", "Stance", "Stand in fighting guard"),
        new("walkF", "Walk", "Step forward and back"),
        new("punchMid", "Punch", "Throw a straight punch"),
        new("kick", "Kick", "Throw a front or side kick"),
        new("jump", "Jump", "Hop in place"),
        new("crouch", "Crouch", "Duck low into guard"),
        new("victory", "Cheer", "Raise both arms"),
        new("ko", "Fall", "Drop or lean down"),
    ];

    private static RenderFragment TitleContent => GameCatalog.TitleFor(GameKeys.PoFighter);

    private static RenderFragment ControlsContent => @<div>
        <p><kbd>←</kbd> <kbd>→</kbd> walk · <kbd>↑</kbd> jump · <kbd>↓</kbd> crouch · <kbd>J</kbd> punch · <kbd>L</kbd> kick.</p>
        <p><kbd>V</kbd> cheers (it also happens every 10 hits) and <kbd>X</kbd> takes a fall; any key gets back up.</p>
        <p><kbd>R</kbd> resets the room and <kbd>T</kbd> slows it down. A gamepad works too, and a phone gets on-screen buttons.</p>
    </div>;

    protected override void OnInitialized() => _playerName = PlayerNameService.GetPlayerName();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_introDismissed || _started) return;
        _started = true;
        try
        {
            if (await JS.InvokeAsync<bool>("loadEngine", "pofighter")
                && await JS.InvokeAsync<bool>("PoFighter.start", _room, _fighterId))
            {
                await RefreshFightersAsync();
                return;
            }
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "PoFighter failed to start");
        }

        _failed = true;
        StateHasChanged();
    }

    private async Task RefreshFightersAsync()
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(
                await JS.InvokeAsync<string>("JSON.stringify", await JS.InvokeAsync<object?>("PoFighter.listFighters")));
            _customFighters = doc.RootElement.EnumerateArray()
                .Select(el => new CustomFighterItem(
                    el.GetProperty("id").GetString() ?? "",
                    el.GetProperty("name").GetString() ?? "Fighter"))
                .Where(f => !string.IsNullOrEmpty(f.Id))
                .ToList();
            StateHasChanged();
        }
        catch { }
    }

    private async Task OnFighterChangedAsync(ChangeEventArgs e)
    {
        _fighterId = e.Value?.ToString() ?? "p1";
        await JS.InvokeAsync<bool>("PoFighter.start", _room, _fighterId);
    }

    private async Task OpenStudioAsync()
    {
        _studioOpen = true;
        _studioCounts.Clear();
        await JS.InvokeVoidAsync("PoFighter.stop");
        StateHasChanged();
        _studioModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/pofighter/studio.js");
        _selfRef ??= DotNetObjectReference.Create(this);
        _studioCtrl = await _studioModule.InvokeAsync<IJSObjectReference>(
            "createStudioController", _studioVideo, _studioPreview, _studioStatus, _selfRef);
    }

    private async Task CloseStudioAsync()
    {
        if (_studioCtrl is not null)
        {
            try { await _studioCtrl.InvokeVoidAsync("dispose"); await _studioCtrl.DisposeAsync(); } catch { }
            _studioCtrl = null;
        }
        _studioOpen = false;
        await JS.InvokeAsync<bool>("PoFighter.start", _room, _fighterId);
    }

    private async Task StartWebcamAsync()
    {
        if (_studioCtrl is not null) await _studioCtrl.InvokeAsync<bool>("startWebcam");
    }

    private async Task CaptureBgAsync()
    {
        if (_studioCtrl is not null) await _studioCtrl.InvokeAsync<bool>("captureBackground");
    }

    private async Task CaptureMoveAsync(string moveId)
    {
        if (_studioCtrl is null || _studioBusy) return;
        _studioBusy = true;
        try { await _studioCtrl.InvokeAsync<int>("captureMove", moveId); }
        finally { _studioBusy = false; }
    }

    private async Task ImportVideoAsync()
    {
        if (_studioCtrl is null || _studioBusy) return;
        _studioBusy = true;
        try { await _studioCtrl.InvokeAsync<bool>("importVideo", _studioFile); }
        finally { _studioBusy = false; }
    }

    private async Task SaveStudioFighterAsync()
    {
        if (_studioCtrl is null || _studioBusy) return;
        _studioBusy = true;
        try
        {
            var id = await _studioCtrl.InvokeAsync<string>("save", _studioFighterName);
            if (!string.IsNullOrEmpty(id))
            {
                _fighterId = id;
                await RefreshFightersAsync();
                await CloseStudioAsync();
            }
        }
        finally { _studioBusy = false; }
    }

    [JSInvokable]
    public void OnStudioCounts(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var next = new Dictionary<string, int>();
            foreach (var prop in doc.RootElement.EnumerateObject())
                next[prop.Name] = prop.Value.GetInt32();
            _studioCounts = next;
            InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_studioCtrl is not null)
        {
            try { await _studioCtrl.InvokeVoidAsync("dispose"); await _studioCtrl.DisposeAsync(); } catch { }
        }
        if (_studioModule is not null)
        {
            try { await _studioModule.DisposeAsync(); } catch { }
        }
        _selfRef?.Dispose();
        if (!_started) return;
        try { await JS.InvokeVoidAsync("PoFighter.stop"); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }
}
