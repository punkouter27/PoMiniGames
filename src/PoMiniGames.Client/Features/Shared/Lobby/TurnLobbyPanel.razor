@namespace PoMiniGamesClient.Features.Shared
@using PoMiniGames.Shared.Games
@using PoMiniGamesClient.Services.Play

@* The turn games' preset of OnlineLobby (Connect Five, Tic-Tac-Toe): the one shared room, host
   plays first, the guest readies and the host starts. It renders only while the session is in
   the lobby; the host's start hands the internal match code to the session, which claims the
   seat, and the page swaps to the board once the match begins. *@
@if (Session is { Phase: QuickMatchPhase.Lobby })
{
    <OnlineLobby TPlayer="TurnLobbyPlayer"
                 HubPath="@Session.LobbyHubPath"
                 Hint="First in hosts and moves first."
                 MaxPlayersHint="2"
                 MinPlayers="2"
                 StartLabel="Start game"
                 HowTo="@HowTo"
                 OnGameStarted="@(start => Session.JoinMatchAsync(start.MatchCode, start.WasHost))"
                 OnLeave="OnLeave" />
}

@code {
    [Parameter, EditorRequired] public OnlineTurnSession? Session { get; set; }
    /// <summary>The game's rules, folded under the lobby buttons.</summary>
    [Parameter] public RenderFragment? HowTo { get; set; }
    /// <summary>Leave the lobby (the page navigates away).</summary>
    [Parameter] public EventCallback OnLeave { get; set; }
}
