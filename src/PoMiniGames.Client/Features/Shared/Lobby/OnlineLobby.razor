@namespace PoMiniGamesClient.Features.Shared
@using Microsoft.AspNetCore.SignalR.Client
@using PoMiniGames.Shared.Games
@using PoMiniGamesClient.Services.Http
@using PoMiniGamesClient.Services.Play
@using PoMiniGamesClient.Services.Ui
@typeparam TPlayer where TPlayer : ILobbyPlayer
@inject ApiEndpoints Endpoints
@inject PlayerNameService PlayerNames
@inject ToastService Toasts
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

@* ─────────────────────────────────────────────────────────────────────────
   OnlineLobby — every game's online mode, end to end (owner rule 2026-11-18: one shared lobby
   per game, no codes). It owns the lobby connection (LobbyClient: connect, take a seat, re-join
   after a reconnect), renders the shared LobbyPanel, and wires Ready / Start / Leave / Reconnect.
   When the host starts, it hands the page the internal match code (OnGameStarted) and the page
   swaps to its game; the page never touches the hub plumbing.

   A game supplies only what is its own: the lobby hub path, the start label, the host's
   settings (Picker), per-player badges or actions, and what to do with the match. Game-specific
   hub calls (a map pick, a fighter pick) go through the LobbyClient handed out by OnClient.
   Server side every lobby is a LobbyHub + LobbyRoom.

   No seat, and why (SeatNotices): a browser the room refused (full, a game running, an old
   build) or took a seat from (another tab, the host, idling) is told in the server's words,
   with the one button that fixes it, in place of a "couldn't reach the lobby" toast beside a
   green "connected" pill. Nothing rejoins by itself: there are no queues, the player presses.
   ───────────────────────────────────────────────────────────────────────── *@
<LobbyPanel TPlayer="TPlayer"
            State="@_client?.State"
            LocalConnectionId="@(_client?.ConnectionId ?? "")"
            ConnectionState="@(_client?.ConnectionState ?? HubConnectionState.Connecting)"
            Hint="@Hint"
            MaxPlayersHint="@MaxPlayersHint"
            StartLabel="@StartLabel"
            CanStart="@CanStart"
            MinPlayers="@MinPlayers"
            WaitingHint="@WaitingHint"
            CanReady="@CanReady"
            HostReadies="@HostReadies"
            UnreadyLabel="@UnreadyLabel"
            ShowReady="@ShowReady"
            ShowStart="@ShowStart"
            HowTo="@HowTo"
            PlayerLabel="@PlayerLabel"
            PlayerBadges="@PlayerBadges"
            PlayerActions="@PlayerActions"
            Picker="@Picker"
            PickerTitle="@PickerTitle"
            Status="@(_notice is null ? Status : NoticeContent)"
            Heading="@(_notice is not null && Heading is not null ? NoticeHeading : Heading)"
            QuietWhenConnected="@QuietWhenConnected"
            ShowInvite="@ShowInvite"
            NoSeat="@(_notice is not null)"
            ExtraActions="@ExtraActions"
            OnReady="ReadyAsync"
            OnStart="StartAsync"
            OnLeave="LeaveAsync"
            OnReconnect="ReconnectAsync" />

@code {
    /// <summary>The game's lobby hub, relative to the API base (e.g. <c>poracer/lobby-hub</c>).</summary>
    [Parameter, EditorRequired] public string HubPath { get; set; } = "";
    [Parameter, EditorRequired] public string StartLabel { get; set; } = "Start";
    [Parameter] public string Hint { get; set; } = "One shared room — the first to arrive hosts.";
    [Parameter] public int MaxPlayersHint { get; set; } = 2;
    [Parameter] public bool? CanStart { get; set; }
    /// <summary>Seats that must be filled before Start is offered (LobbyPanel.MinPlayers).</summary>
    [Parameter] public int MinPlayers { get; set; } = 1;
    [Parameter] public string WaitingHint { get; set; } = "Waiting for everyone to mark Ready…";
    [Parameter] public bool CanReady { get; set; } = true;
    [Parameter] public bool HostReadies { get; set; }
    [Parameter] public string UnreadyLabel { get; set; } = "Not Ready";
    [Parameter] public bool ShowReady { get; set; } = true;
    [Parameter] public bool ShowStart { get; set; } = true;
    [Parameter] public RenderFragment? HowTo { get; set; }
    [Parameter] public RenderFragment<TPlayer>? PlayerLabel { get; set; }
    [Parameter] public RenderFragment<TPlayer>? PlayerBadges { get; set; }
    [Parameter] public RenderFragment<TPlayer>? PlayerActions { get; set; }
    [Parameter] public RenderFragment? Picker { get; set; }
    [Parameter] public string? PickerTitle { get; set; }
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public RenderFragment? ExtraActions { get; set; }
    /// <summary>The game's own sentence in place of "Players · n/m" (see <c>LobbyPanel.Heading</c>). A seat notice takes its place while one is up.</summary>
    [Parameter] public RenderFragment? Heading { get; set; }
    [Parameter] public bool QuietWhenConnected { get; set; }
    [Parameter] public bool ShowInvite { get; set; } = true;
    /// <summary>
    /// False for a lobby that words its own "no seat" states (Cabinet: a race in progress is
    /// watched from the lobby, and it rejoins by itself when the race ends).
    /// </summary>
    [Parameter] public bool SeatNotices { get; set; } = true;

    /// <summary>The live client, once created: game-specific hub calls and the current state.</summary>
    [Parameter] public EventCallback<LobbyClient<TPlayer>> OnClient { get; set; }
    /// <summary>Every roster/state broadcast (a page mirrors the host's picks from it).</summary>
    [Parameter] public EventCallback<LobbyState<TPlayer>> OnStateChanged { get; set; }
    /// <summary>The host started: the internal match code and whether this browser hosted.</summary>
    [Parameter, EditorRequired] public EventCallback<OnlineLobbyStart> OnGameStarted { get; set; }
    /// <summary>The player left the lobby (after the seat is given up). Default: the page decides.</summary>
    [Parameter] public EventCallback OnLeave { get; set; }

    private LobbyClient<TPlayer>? _client;
    private bool _started;
    private bool _disposed;

    // ── No seat, and why ─────────────────────────────────────────────────────────
    private enum NoticeKind { Refused, SeatOpen, Removed, Reload }

    /// <summary>Why this browser has no seat, and the label of the button that asks for one.</summary>
    private sealed record SeatNotice(NoticeKind Kind, string Message, string Action);

    private SeatNotice? _notice;
    private bool _acting;      // the notice's button is mid-call
    private bool _wasSeated;   // this browser has held a seat in this room
    private bool _lostCheck;   // a "did we lose the seat?" look is already scheduled

    private RenderFragment NoticeHeading => @<span>@_notice?.Message</span>;

    // With a Heading the sentence is up there and only the button is needed here.
    private RenderFragment NoticeContent => @<div class="lobby-notice-stack">
        @if (_notice is { } n)
        {
            <div class="lobby-notice" role="alert">
                @if (Heading is null)
                {
                    <span>@n.Message</span>
                }
                <PoButton class="app-btn app-btn--primary" Disabled="@_acting" Click="ActOnNoticeAsync">@n.Action</PoButton>
            </div>
        }
        @Status
    </div>;

    private bool Seated(LobbyState<TPlayer> state) =>
        _client is { } c && state.Players.Any(p => p.ConnectionId == c.ConnectionId);

    private static bool HasRoom(LobbyState<TPlayer> state) =>
        !state.InProgress && state.Players.Count < state.MaxPlayers;

    /// <summary>Every state that lands: a seat clears the notice, and a refused visitor sees a seat open or close.</summary>
    private void TrackSeat(LobbyState<TPlayer> state)
    {
        if (Seated(state))
        {
            _wasSeated = true;
            _notice = null;
            return;
        }
        if (!SeatNotices || _started) return;
        if (_notice is { Kind: NoticeKind.Refused } && HasRoom(state))
        {
            _notice = new SeatNotice(NoticeKind.SeatOpen, "A seat just opened.", "Take the seat");
        }
        else if (_notice is { Kind: NoticeKind.SeatOpen } && !HasRoom(state))
        {
            _notice = new SeatNotice(NoticeKind.Refused, "The seat was taken. The room is full again.", "Try again");
        }
        else if (_notice is null && _wasSeated && !_lostCheck)
        {
            // Held a seat, and this roster has none for us, with no "kicked" to say why (the
            // server restarted, or the room was reset). Looked at again after a moment: the
            // automatic re-join after a reconnect passes through this same state.
            _lostCheck = true;
            _ = InvokeAsync(ConfirmSeatLostAsync);
        }
    }

    private async Task ConfirmSeatLostAsync()
    {
        await Task.Delay(1500);
        _lostCheck = false;
        if (_disposed || _started || _notice is not null) return;
        if (_client is not { State: { } now, ConnectionState: HubConnectionState.Connected } || Seated(now)) return;
        _notice = new SeatNotice(NoticeKind.Removed, "You lost your seat in this room.", "Rejoin here");
        StateHasChanged();
    }

    /// <summary>A join that came back: most hubs answer a full room with the roster and no seat.</summary>
    private void NoteJoined(LobbyState<TPlayer>? state)
    {
        if (state is null || !SeatNotices || Seated(state)) return;
        _notice = new SeatNotice(NoticeKind.Refused,
            state.InProgress ? "A game is running. You can join when it ends." : "The room is full.", "Try again");
    }

    /// <summary>A join that failed: the server's reason becomes the notice; a dead connection keeps its toast.</summary>
    private void NoteFailure(Exception ex, string unreachable)
    {
        if (!SeatNotices || HubErrors.Reason(ex) is not { } reason)
        {
            Toasts.Show(unreachable, ToastType.Warning);
            return;
        }
        _notice = reason.StartsWith(LobbyRefusal.ReloadPrefix, StringComparison.Ordinal)
            ? new SeatNotice(NoticeKind.Reload, reason[LobbyRefusal.ReloadPrefix.Length..], "Reload")
            : new SeatNotice(NoticeKind.Refused, reason, "Try again");
    }

    private async Task ActOnNoticeAsync()
    {
        if (_notice is not { } notice || _acting || _client is null) return;
        if (notice.Kind == NoticeKind.Reload)
        {
            // Through the service worker: a plain reload would bring the old build back.
            try { await JS.InvokeVoidAsync("poPwa.applyUpdate"); }
            catch (Exception) { Nav.NavigateTo(Nav.Uri, forceLoad: true); }
            return;
        }
        _acting = true;
        try
        {
            NoteJoined(await _client.ReconnectAsync());
        }
        catch (Exception ex)
        {
            NoteFailure(ex, "Still can't reach the lobby.");
        }
        finally
        {
            _acting = false;
        }
        // Pressed, asked, still no seat: the sentence has not changed, so say that it was tried.
        if (_notice is { Kind: NoticeKind.Refused }) Toasts.Show("Still no seat.", ToastType.Info);
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _client = new LobbyClient<TPlayer>(Endpoints, HubPath);
        _client.StateChanged += s => _ = InvokeAsync(async () => { TrackSeat(s); await OnStateChanged.InvokeAsync(s); StateHasChanged(); });
        _client.ConnectionChanged += state => _ = InvokeAsync(StateHasChanged);
        _client.GameStarted += code => _ = InvokeAsync(() => HandleStartedAsync(code));
        _client.ReconnectFailed += error => _ = InvokeAsync(() => { NoteFailure(error, "Lost the lobby. Tap Reconnect."); StateHasChanged(); });
        _client.Kicked += reason => _ = InvokeAsync(() =>
        {
            // The seat was taken away (another tab of the same player, the host, idling).
            if (SeatNotices) _notice = new SeatNotice(NoticeKind.Removed, reason, "Rejoin here");
            StateHasChanged();
        });
        await OnClient.InvokeAsync(_client);
        await JoinAsync();
    }

    private async Task JoinAsync()
    {
        if (_client is null || _disposed) return;
        try
        {
            await PlayerNames.InitializeAsync();
            var name = PlayerNames.GetPlayerName();
            NoteJoined(await _client.ConnectAndJoinAsync(string.IsNullOrWhiteSpace(name) ? "Player" : name.Trim(), isGuest: false));
        }
        catch (Exception ex)
        {
            NoteFailure(ex, "Couldn't reach the lobby. Tap Reconnect.");
        }
        StateHasChanged();
    }

    private async Task HandleStartedAsync(string code)
    {
        if (_started || _disposed) return;
        _started = true;
        await OnGameStarted.InvokeAsync(new OnlineLobbyStart(code, _client?.IsHost == true));
    }

    private Task ReadyAsync() => _client?.ToggleReadyAsync() ?? Task.CompletedTask;

    private async Task StartAsync()
    {
        if (_client is null) return;
        try { await _client.StartGameAsync(); }
        catch (Exception) { Toasts.Show("Couldn't start. Try again.", ToastType.Warning); }
    }

    private async Task ReconnectAsync()
    {
        if (_client is null) return;
        try { NoteJoined(await _client.ReconnectAsync()); }
        catch (Exception ex) { NoteFailure(ex, "Still can't reach the lobby."); }
        StateHasChanged();
    }

    private async Task LeaveAsync()
    {
        if (_client is not null) await _client.LeaveLobbyAsync();
        await OnLeave.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        var client = _client;
        _client = null;
        if (client is null) return;
        // Leaving before a start gives the seat back at once; after a start the room has
        // already ended and the hub's disconnect does the rest.
        if (!_started) await client.LeaveLobbyAsync();
        await client.DisposeAsync();
    }
}
