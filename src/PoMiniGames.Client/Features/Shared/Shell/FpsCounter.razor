@namespace PoMiniGamesClient.Features.Shared
@using PoMiniGamesClient.Models
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

@* Live frame-rate and graphics-API badge in the top center of the nav bar.

   Shown automatically on every minigame route (and on any route with `?debug=1`).
   Displays `60 FPS · WebGPU` / `WebGL 2` / `WebGL` / `2D`, driven by gl-fps.js
   and gpuBackend.js once the first 500 ms sample lands. *@
@if (_enabled && _hasReading)
{
    <span class="gl-fps gl-fps--centered" title="Frames per second and the graphics API the game is drawing with" data-tier="@_tier">@_label</span>
}

@code {
    private static readonly HashSet<string> GameSegments = BuildGameSegments();

    private string _label = "— FPS";
    private string _tier = "ok";
    private bool _hasReading;
    private bool _enabled;
    private DotNetObjectReference<FpsCounter>? _ref;
    private IJSObjectReference? _module;
    private bool _running;

    private static HashSet<string> BuildGameSegments()
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var game in GameCatalog.All)
        {
            foreach (var mode in game.Modes)
            {
                var seg = FirstPathSegment(mode.Url);
                if (!string.IsNullOrEmpty(seg)) set.Add(seg);
            }
        }
        return set;
    }

    private static string FirstPathSegment(string uriOrPath)
    {
        var path = Uri.TryCreate(uriOrPath, UriKind.Absolute, out var abs)
            ? abs.AbsolutePath
            : uriOrPath;
        var q = path.IndexOfAny(['?', '#']);
        if (q >= 0) path = path[..q];
        path = path.Trim('/');
        if (path.Length == 0) return "";
        var slash = path.IndexOf('/');
        return slash >= 0 ? path[..slash] : path;
    }

    private static bool ShouldShowFor(string uri) =>
        GameSegments.Contains(FirstPathSegment(uri))
        || uri.IndexOf("debug=1", StringComparison.OrdinalIgnoreCase) >= 0;

    protected override void OnInitialized()
    {
        _enabled = ShouldShowFor(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var next = ShouldShowFor(e.Location);
        if (next == _enabled) return;
        _enabled = next;
        _hasReading = false;
        _ = InvokeAsync(async () =>
        {
            if (_enabled) await StartSamplerAsync();
            else await StopSamplerAsync();
            StateHasChanged();
        });
    }

    // Ownership token for the single global sampler: each layout carries its own
    // <FpsCounter />, so on navigation two instances briefly coexist. The token
    // lets this instance's Dispose stop the loop only if it still owns it — see
    // the note atop js/platform/gl-fps.js.
    private static int _nextToken;
    private readonly int _token = System.Threading.Interlocked.Increment(ref _nextToken);

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        firstRender ? StartSamplerAsync() : Task.CompletedTask;

    private async Task StartSamplerAsync()
    {
        if (_running || !_enabled) return;
        try
        {
            _running = true;
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/platform/gl-fps.js");
            _ref ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("glFps.start", _ref, _token);
        }
        catch
        {
            // Interop can throw during pre-render, or the module may be blocked.
            // The badge is a diagnostic — never let it break a page.
            _running = false;
        }
    }

    private async Task StopSamplerAsync()
    {
        if (!_running) return;
        _running = false;
        try { await JSRuntime.InvokeVoidAsync("glFps.stop", _token); } catch { /* circuit or page gone */ }
    }

    // gl-fps.js counts frames itself and calls this once per ~500 ms window,
    // not once per frame.
    [JSInvokable]
    public void OnSample(int frames, double elapsedMs, string? backend)
    {
        if (!_enabled || frames <= 0 || elapsedMs <= 0) return;
        var fps = Math.Round(frames * 1000.0 / elapsedMs);
        // The graphics API of the canvas on screen (js/platform/gpuBackend.js):
        // WebGPU, WebGL 2 or WebGL; "2D" on a page with no 3D GPU canvas.
        var api = string.IsNullOrEmpty(backend) ? "2D" : backend;
        var next = $"{fps:0} FPS · {api}";
        var nextTier = fps >= 55 ? "ok" : fps >= 30 ? "warn" : "bad";
        if (next == _label && nextTier == _tier && _hasReading) return;
        _label = next;
        _tier = nextTier;
        _hasReading = true;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        await StopSamplerAsync();
        _ref?.Dispose();
        _ref = null;
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
            _module = null;
        }
    }
}
