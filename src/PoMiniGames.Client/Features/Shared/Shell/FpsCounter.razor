@namespace PoMiniGamesClient.Features.Shared
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject IWebAssemblyHostEnvironment Env
@inject NavigationManager Navigation

@* Live frame-rate badge in the top nav.

   The badge is shown in Development, or in any environment when the page URL
   carries `?debug=1` (evaluated on load — add the parameter and reload). It is
   developer diagnostics, so production players do not see it; `?debug=1` is the
   switch, no settings page needed.

   The chip stays hidden until the sampler has produced its first real reading,
   so the first paint of any game page never shows a placeholder dash that the
   user can't distinguish from "this game is at zero fps". *@
@if (_enabled && _hasReading)
{
    <span class="gl-fps gl-fps--centered" title="Frames per second and the graphics API the game is drawing with" data-tier="@_tier">@_label</span>
}

@code {
    private string _label = "— FPS";
    private string _tier = "ok";
    private bool _hasReading;
    private bool _enabled;
    private DotNetObjectReference<FpsCounter>? _ref;
    private IJSObjectReference? _module;
    private bool _running;

    protected override void OnInitialized()
    {
        // Only surface the top-bar FPS chip when explicitly requested via ?debug=1 so
        // the 56 px header stays uncluttered during normal play.
        _enabled = Navigation.Uri.IndexOf("debug=1", StringComparison.OrdinalIgnoreCase) >= 0;
    }

    // Ownership token for the single global sampler: each layout carries its own
    // <FpsCounter />, so on navigation two instances briefly coexist. The token
    // lets this instance's Dispose stop the loop only if it still owns it — see
    // the note atop js/platform/gl-fps.js.
    private static int _nextToken;
    private readonly int _token = System.Threading.Interlocked.Increment(ref _nextToken);

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        firstRender ? StartSamplerAsync() : Task.CompletedTask;

    private async Task StartSamplerAsync()
    {
        if (_running || !_enabled) return;
        try
        {
            _running = true;
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/platform/gl-fps.js");
            _ref ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("glFps.start", _ref, _token);
        }
        catch
        {
            // Interop can throw during pre-render, or the module may be blocked.
            // The badge is a diagnostic — never let it break a page.
            _running = false;
        }
    }

    // gl-fps.js counts frames itself and calls this once per ~500 ms window,
    // not once per frame.
    [JSInvokable]
    public void OnSample(int frames, double elapsedMs, string? backend)
    {
        if (frames <= 0 || elapsedMs <= 0) return;
        var fps = Math.Round(frames * 1000.0 / elapsedMs);
        // The graphics API of the canvas on screen (js/platform/gpuBackend.js):
        // WebGPU, WebGL 2 or WebGL; "No 3D" on a page with no GPU canvas.
        var api = string.IsNullOrEmpty(backend) ? "No 3D" : backend;
        var next = $"{fps:0} FPS · {api}";
        var nextTier = fps >= 55 ? "ok" : fps >= 30 ? "warn" : "bad";
        if (next == _label && nextTier == _tier && _hasReading) return;
        _label = next;
        _tier = nextTier;
        _hasReading = true;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _running = false;
        try { await JSRuntime.InvokeVoidAsync("glFps.stop", _token); } catch { /* circuit or page gone */ }
        _ref?.Dispose();
        _ref = null;
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
            _module = null;
        }
    }
}
