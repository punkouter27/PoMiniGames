@namespace PoMiniGamesClient.Features.Shared
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

@*
    A game's mid-match options (mode, online) in a side drawer. Difficulty is not one of
    them: it is chosen before play, in GameIntro's Options slot on the start card (see
    PoRacer's Pace), never here or in Settings. It opens the way the
    Settings sheet does: a native modal <dialog> pinned to the right edge on a wide window
    and a bottom sheet on a phone, so it has the focus trap, Esc and the inert page behind
    for free. GameShell renders it, and a gear button to open it, only for a page that
    passes OptionsContent.

    It closes itself on navigation: a mode switch inside it changes the address, and a
    dialog left in the top layer across a route change reads as a frozen page.
*@

<PoButton class="game-opts-gear" aria-label="@Heading" title="@Heading"
        aria-haspopup="dialog" Click="OpenAsync">
    @* Sliders, not a gear: the app's Settings gear sits beside this one in the top bar. *@
    <span class="material-symbols-outlined" aria-hidden="true">tune</span>
</PoButton>

<dialog @ref="_dialog" class="game-opts-sheet" closedby="any" aria-labelledby="game-opts-title">
    <header class="game-opts-head">
        <h2 id="game-opts-title" class="game-opts-title">@Heading</h2>
        <PoButton class="game-opts-close" aria-label="Close game options" Click="CloseAsync"><span class="material-symbols-outlined" aria-hidden="true">close</span></PoButton>
    </header>
    <div class="game-opts-body">
        @ChildContent
    </div>
</dialog>

@code {
    /// <summary>The page's option controls. Rendered inside the drawer.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The drawer's heading and the gear's accessible name.</summary>
    [Parameter] public string Heading { get; set; } = "Game options";

    private ElementReference _dialog;
    private bool _open;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private async Task OpenAsync()
    {
        _open = true;
        await _dialog.ShowModalAloneAsync(JS);
    }

    private async Task CloseAsync()
    {
        _open = false;
        await _dialog.CloseAsync(JS);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_open) return;
        _ = InvokeAsync(async () =>
        {
            try { await CloseAsync(); }
            catch (JSDisconnectedException) { /* page torn down */ }
        });
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
