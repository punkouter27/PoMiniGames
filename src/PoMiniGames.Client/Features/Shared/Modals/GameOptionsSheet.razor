@namespace PoMiniGamesClient.Features.Shared
@inject DialogService Dialogs
@inject NavigationManager Nav
@implements IDisposable

@*
    A game's mid-match options (mode, online) in a Radzen side dialog (DialogService.OpenSideAsync).
    Difficulty is not one of them: it is chosen before play, in GameIntro's Options slot on the
    start card. GameShell renders it, and a button to open it, only for a page that passes
    OptionsContent. Closes automatically on navigation.
*@

<PoButton class="game-opts-gear" aria-label="@Heading" title="@Heading"
        aria-haspopup="dialog" Click="OpenAsync">
    <span class="material-symbols-outlined" aria-hidden="true">tune</span>
</PoButton>

@code {
    /// <summary>The page's option controls. Rendered inside the drawer.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The drawer's heading and the gear's accessible name.</summary>
    [Parameter] public string Heading { get; set; } = "Game options";

    private bool _open;

    private RenderFragment SheetContent => @<div class="game-opts-sheet" role="dialog" aria-modal="true" aria-labelledby="game-opts-title">
        <header class="game-opts-head">
            <h2 id="game-opts-title" class="game-opts-title">@Heading</h2>
            <PoButton class="game-opts-close" aria-label="Close game options" Click="CloseAsync"><span class="material-symbols-outlined" aria-hidden="true">close</span></PoButton>
        </header>
        <div class="game-opts-body">
            @ChildContent
        </div>
    </div>;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet()
    {
        if (_open) Dialogs.Refresh();
    }

    private Task OpenAsync()
    {
        if (_open) return Task.CompletedTask;
        _open = true;
        _ = RunSideDialogAsync();
        return Task.CompletedTask;
    }

    private async Task RunSideDialogAsync()
    {
        try
        {
            await Dialogs.OpenSideAsync<PoDialogFragmentHost>(
                Heading,
                new Dictionary<string, object?> { [nameof(PoDialogFragmentHost.Content)] = SheetContent },
                new SideDialogOptions
                {
                    Position = DialogPosition.Right,
                    ShowTitle = false,
                    ShowClose = false,
                    CloseDialogOnOverlayClick = true,
                    CssClass = "po-rz-side-dialog",
                    WrapperCssClass = "po-rz-dialog-wrapper po-rz-dialog-wrapper--side",
                });
        }
        finally
        {
            _open = false;
        }
    }

    private Task CloseAsync()
    {
        if (!_open) return Task.CompletedTask;
        _open = false;
        Dialogs.CloseSide();
        return Task.CompletedTask;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_open) return;
        _ = InvokeAsync(CloseAsync);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        if (_open)
        {
            _open = false;
            Dialogs.CloseSide();
        }
    }
}
