@namespace PoMiniGamesClient.Features.Shared
@inject PlayerNameService PlayerNames
@inject UiFeedbackService Feedback
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Forms
@using PoMiniGames.Shared.Validation
@inject FluentValidation.IValidator<InitialsInput> Validator
@implements IDisposable

@if (ShouldShow)
{
    <div class="arcade-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="arcade-initials-title" @onkeydown="OnKeyDown">
        @* A real form (forms standard, 2026-11-17): the shared InitialsInputValidator runs on
           submit and on every keystroke, the error shows inline under the slots, and the
           Save button is disabled while a save is in flight so a double tap saves once. *@
        <div class="arcade-modal-crt">
        <EditForm EditContext="_editContext" OnValidSubmit="ConfirmAsync" novalidate>
            <FluentValidationValidator TModel="InitialsInput" Validator="Validator" />
            <div class="arcade-modal-header">
                <h2 id="arcade-initials-title" class="arcade-modal-title">Enter your initials</h2>
                <p class="arcade-modal-sub">They label your scores on the leaderboards.</p>
            </div>

            <div class="arcade-slots-wrap">
                <div class="arcade-slots" aria-hidden="true">
                    @for (var i = 0; i < 3; i++)
                    {
                        var ch = i < _letters.Length ? _letters[i].ToString() : "_";
                        <span class="arcade-slot @(i == _letters.Length && _letters.Length < 3 ? "arcade-slot--active" : "")">@ch</span>
                    }
                </div>
                <input @ref="_inputRef"
                       id="arcade-initials-input"
                       name="initials"
                       type="text"
                       class="arcade-hidden-input"
                       autocomplete="off"
                       autocapitalize="characters"
                       spellcheck="false"
                       aria-label="Enter 3-letter initials (A to Z)"
                       aria-invalid="@(_editContext.GetValidationMessages(_initialsField).Any() ? "true" : "false")"
                       value="@_letters"
                       @oninput="OnInput" />
            </div>

            <p class="arcade-modal-hint">Type three letters, A to Z.</p>

            <div class="arcade-modal-error" aria-live="polite">
                <ValidationMessage For="() => _model.Initials" class="arcade-field-error" />
            </div>

            <div class="arcade-modal-actions">
                <PoButton ButtonType="ButtonType.Submit"
                        class="arcade-btn arcade-btn--primary"
                        Disabled="@_submitting"
                        aria-busy="@(_submitting ? "true" : "false")">
                    @(_submitting ? "Saving…" : "Save initials")
                </PoButton>
                <PoButton
                        class="arcade-btn arcade-btn--skip"
                        Disabled="@_submitting"
                        Click="SkipAsync">
                    Skip
                </PoButton>
            </div>
        </EditForm>
        </div>
    </div>
}

@code {
    private readonly InitialsInput _model = new();
    private EditContext _editContext = default!;
    private FieldIdentifier _initialsField;
    private bool _submitting;
    private ElementReference _inputRef;
    private string _letters = string.Empty;
    private bool _wasOpen;
    private Action? _onStateChanged;

    // A first-time visitor (nothing saved in this browser) is asked straight away; after that
    // the prompt opens only on request. Po standard (2026-11-18): it never covers the header
    // (the backdrop starts below it) and it waits while the visitor is on a page that is not
    // about playing (/diag, /settings), so a status check is never blocked.
    private bool ShouldShow =>
        PlayerNames.IsInitialized &&
        PlayerNames.IsPromptOpen &&
        !OnUtilityPage;

    private static readonly string[] UtilityPages = ["/diag"];

    private bool OnUtilityPage
    {
        get
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
            return UtilityPages.Any(p => string.Equals(path, p, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
        _initialsField = FieldIdentifier.Create(() => _model.Initials);
        SyncFromService();
        _onStateChanged = () => InvokeAsync(() =>
        {
            SyncFromService();
            StateHasChanged();
        });
        PlayerNames.StateChanged += _onStateChanged;
        Navigation.LocationChanged += OnLocationChanged;

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ShouldShow && !_wasOpen)
        {
            _wasOpen = true;
            try
            {
                await _inputRef.FocusAsync();
            }
            catch
            {
                // ignore focus failures during navigation
            }
        }
        else if (!ShouldShow)
        {
            _wasOpen = false;
        }
    }

    private void SyncFromService()
    {
        if (!ShouldShow)
        {
            return;
        }

        var current = PlayerNames.Initials.Trim();
        _letters = current.Length == 3 ? current : string.Empty;
        _model.Initials = _letters;
    }

    private void OnInput(ChangeEventArgs e)
    {
        var prevLen = _letters.Length;
        var raw = e.Value?.ToString() ?? string.Empty;
        // The prompt opens holding the current initials. With a full entry, the next letter
        // starts a new one instead of being dropped (the field has no maxlength for that
        // reason: a capped field swallows the keypress before this handler ever sees it).
        if (prevLen == 3 && raw.Length > 3 && raw.StartsWith(_letters, StringComparison.OrdinalIgnoreCase))
        {
            raw = raw[3..];
            prevLen = 0;
        }
        Span<char> buf = stackalloc char[3];
        var len = 0;
        foreach (var c in raw)
        {
            if (c is >= 'a' and <= 'z')
            {
                buf[len++] = (char)(c - 'a' + 'A');
            }
            else if (c is >= 'A' and <= 'Z')
            {
                buf[len++] = c;
            }
            if (len == 3) break;
        }
        _letters = new string(buf[..len]);
        _model.Initials = _letters;
        // Re-check the field as the player types, so a shown error clears the moment the
        // entry becomes valid (the hidden input is not an InputBase, so this is done by hand).
        if (_editContext.GetValidationMessages(_initialsField).Any())
        {
            _editContext.NotifyFieldChanged(_initialsField);
        }
        if (_letters.Length > prevLen)
        {
            _ = Feedback.ArcadeKeyAsync(_letters.Length);
        }
        else if (_letters.Length < prevLen)
        {
            _ = Feedback.ArcadeKeyAsync(_letters.Length, backspace: true);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // Enter submits the form natively (and so runs the validator).
        if (e.Key == "Escape" && !_submitting)
        {
            await SkipAsync();
        }
    }

    // Only reached through OnValidSubmit, so the validator has already passed.
    private async Task ConfirmAsync()
    {
        if (_submitting) return;
        _submitting = true;
        try
        {
            await Feedback.CompleteAsync();
            PlayerNames.SetInitials(_model.Initials);
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task SkipAsync()
    {
        await Feedback.TapAsync();
        if (PlayerNames.HasPrompted)
        {
            PlayerNames.ClosePrompt();
        }
        else
        {
            PlayerNames.SkipInitials();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _onStateChanged?.Invoke();

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        if (_onStateChanged is not null)
        {
            PlayerNames.StateChanged -= _onStateChanged;
        }
    }
}
