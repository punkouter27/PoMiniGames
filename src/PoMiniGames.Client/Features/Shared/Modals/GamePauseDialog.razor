@namespace PoMiniGamesClient.Features.Shared
@inject DialogService Dialogs
@inject IJSRuntime JS
@implements IAsyncDisposable

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? LabelledBy { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public EventCallback OnResume { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<GamePauseDialog>? _self;
    private bool _dialogOpen;

    private RenderFragment PauseContent => @<div id="@Id" class="game-pause-dialog @Class" role="dialog" aria-modal="true" tabindex="-1"
             aria-labelledby="@LabelledBy" aria-label="@Label" @ref="_root" @attributes="AdditionalAttributes">
        @ChildContent
        <PoDialogLifecycle OnMounted="OnDialogMountedAsync" />
    </div>;

    protected override void OnInitialized() => Dialogs.OnClose += OnDialogClosed;

    protected override void OnParametersSet()
    {
        if (_dialogOpen) Dialogs.Refresh();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return Task.CompletedTask;
        _dialogOpen = true;
        _ = Dialogs.OpenAsync(
            Label ?? "Paused",
            _ => PauseContent,
            new DialogOptions
            {
                ShowTitle = false,
                ShowClose = false,
                CloseDialogOnEsc = false,
                CloseDialogOnOverlayClick = false,
                AutoFocusFirstElement = false,
                CssClass = "po-rz-dialog po-rz-dialog--pause",
                WrapperCssClass = "po-rz-dialog-wrapper po-rz-dialog-wrapper--pause",
            });
        return Task.CompletedTask;
    }

    private async Task OnDialogMountedAsync()
    {
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/platform/gamePauseDialog.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _root, OnResume.HasDelegate ? _self : null);
        }
        catch { /* torn down */ }
    }

    private void OnDialogClosed(dynamic? _) => _dialogOpen = false;

    [JSInvokable] public Task ResumeAsync() => OnResume.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        Dialogs.OnClose -= OnDialogClosed;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            finally { _self?.Dispose(); }
        }
        if (_dialogOpen)
        {
            _dialogOpen = false;
            Dialogs.Close();
        }
    }
}
