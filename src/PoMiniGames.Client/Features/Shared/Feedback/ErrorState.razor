@namespace PoMiniGamesClient.Features.Shared

@*
    Recoverable-failure view: the error-toned <EmptyState>, plus a retry affordance.

    A one-line wrapper on purpose. The card's markup, ids and ARIA live in
    <EmptyState> so an empty list and a failed fetch cannot drift apart visually —
    before this they were two near-identical copies of the same flex column. Kept
    as its own component because a call site should say what it means.

    For the compact, inline shape (a strip inside a card that is still usable) use
    <InlineError>. For a process-level crash use <AppErrorBoundary> or
    <GameErrorBoundary>.
*@

<EmptyState Icon="@Icon"
            Title="@Title"
            Tone="StateTone.Error"
            RetryLabel="@RetryLabel"
            OnRetry="OnRetry"
            Action="Action">
    @ChildContent
</EmptyState>

@code {
    [Parameter] public string? Icon { get; set; } = "⚠️";
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional action slot; wins over <see cref="OnRetry"/> when both are set.</summary>
    [Parameter] public RenderFragment? Action { get; set; }

    /// <summary>
    /// When set, renders a retry button. Leave unset for non-retryable failures
    /// (auth, malformed input) where the user should be redirected, not retried.
    /// </summary>
    [Parameter] public EventCallback OnRetry { get; set; }

    [Parameter] public string RetryLabel { get; set; } = "Try again";
}
