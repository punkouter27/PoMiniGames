@* The ONE Couple Quiz lobby page: /couplequiz and /couplequiz/multi are bound to this single
   component. The online lobby is the shared OnlineLobby (one room, no codes): the first to arrive
   hosts and picks the rounds and topic pack, the guest readies, the host starts. On start both
   browsers get the match's internal code and move to the game page, which claims its seat.

   Couple Quiz is multiplayer-only: there is no solo mode and no kiosk demo (the game
   is not in GameCatalog.Demo's reel). *@
@page "/couplequiz"
@page "/couplequiz/multi"
@using PoMiniGames.Shared.Games
@using PoMiniGamesClient.Features.PoCoupleQuiz.Services
@using PoMiniGamesClient.Features.Shared
@inject CoupleQuizHubService Hub
@inject PlayerNameService PlayerNameService
@inject NavigationManager Navigation

<PageTitle>Couple Quiz · PoMiniGames</PageTitle>
<HeadContent><link rel="stylesheet" href="css/quiz.css" /></HeadContent>

@* Every way into a game opens on the same card: the opening card comes first, and the seat is
   taken when it is dismissed. *@
<GameShell Title=@TitleContent Player="@_playerName" BackTo="/">
    @if (!_introDone)
    {
        <GameIntro CueScope="pocouplequiz"
                   Title="@TitleContent"
                   Objective="Answer questions about each other. Each round one of you is the King and locks a secret answer; match it to score."
                   Controls="@HowToPlayContent"
                   OnStart="OnIntroStartAsync" />
    }
    else
    {
        <div class="cq-lobby-wrap">
            <OnlineLobby TPlayer="CoupleQuizLobbyPlayer"
                         HubPath="couplequiz/lobby-hub"
                         StartLabel="Start quiz"
                         MaxPlayersHint="2"
                         MinPlayers="2"
                         OnClient="OnClientAsync"
                         OnStateChanged="OnLobbyStateAsync"
                         OnGameStarted="OnMatchStarted"
                         OnLeave="Leave">
                <Picker>
                    @if (_lobby is { IsHost: true })
                    {
                        <label class="lobby-inline-opt">
                            <span>Topic</span>
                            <select aria-label="Topic" value="@TopicPack" @onchange="OnTopicPackChanged">
                                @foreach (var p in TopicPacks)
                                {
                                    <option value="@p.Id">@p.Label</option>
                                }
                            </select>
                        </label>
                    }
                    else
                    {
                        <p class="lobby__hint">Topic: @PackLabel(TopicPack)</p>
                    }
                </Picker>
            </OnlineLobby>
        </div>
    }
</GameShell>

@code {
    private static readonly (string Id, string Label)[] TopicPacks =
    [
        // Questions about the couple's own life together (the server's CoupleQuizQuestionBank), not trivia.
        ("Everything", "Everything"),
        ("OurStory", "Our story"),
        ("DatesAndTrips", "Dates & trips"),
        ("HomeLife", "Home life"),
        ("Celebrations", "Celebrations"),
        ("Adventures", "Adventures & mishaps"),
        ("JustUs", "Just us"),
    ];
    private static string PackLabel(string? id) =>
        TopicPacks.FirstOrDefault(p => string.Equals(p.Id, id, StringComparison.OrdinalIgnoreCase)).Label ?? "Everything";

    // Multiplayer-only route, so the title carries the mode like every other lobby
    // title rather than reading as the game's whole name.
    private static RenderFragment TitleContent => GameCatalog.TitleFor(GameKeys.PoCoupleQuiz);

    private RenderFragment HowToPlayContent => @<div>
        <ul>
            <li>Type your answer and submit — the round scores itself once everyone is in</li>
            <li>The King seat rotates every round, so you both get asked about</li>
            <li>Rounds are timed; whatever you've typed when the clock runs out is what counts</li>
        </ul>
    </div>;

    private string _playerName = string.Empty;
    private bool _introDone;
    private LobbyClient<CoupleQuizLobbyPlayer>? _lobby;

    // The host's picks ride on every seat; read them off the host's.
    private CoupleQuizLobbyPlayer? HostSeat => _lobby?.State is { } s
        ? s.Players.FirstOrDefault(p => p.ConnectionId == s.HostConnectionId) ?? s.Players.FirstOrDefault()
        : null;
    private string TopicPack => HostSeat?.TopicPack ?? "Everything";

    protected override async Task OnInitializedAsync()
    {
        await PlayerNameService.InitializeAsync();
        _playerName = string.IsNullOrWhiteSpace(PlayerNameService.GetPlayerName()) ? "Guest" : PlayerNameService.GetPlayerName().Trim();
    }

    /// <summary>The opening card was dismissed: the lobby mounts, connects and takes a seat.</summary>
    private void OnIntroStartAsync() => _introDone = true;

    private Task OnClientAsync(LobbyClient<CoupleQuizLobbyPlayer> client)
    {
        _lobby = client;
        return Task.CompletedTask;
    }

    // Repaints the host's picks for the guest as they change.
    private Task OnLobbyStateAsync(LobbyState<CoupleQuizLobbyPlayer> _) => Task.CompletedTask;

    private Task OnTopicPackChanged(ChangeEventArgs e) =>
        _lobby?.SendAsync("SetTopicPack", e.Value?.ToString() ?? "Everything") ?? Task.CompletedTask;

    // Both browsers get the match's internal code. The game page claims the seat under the
    // name the lobby gave it (made unique if both players carry the same initials).
    private void OnMatchStarted(OnlineLobbyStart start)
    {
        Hub.PendingMatch = new CoupleQuizPendingMatch(start.MatchCode, _lobby?.Me?.DisplayName ?? _playerName);
        Navigation.NavigateTo("/couplequiz/game");
    }

    private void Leave() => Navigation.NavigateTo("/");
}
