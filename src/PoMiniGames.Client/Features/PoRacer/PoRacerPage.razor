@page "/poracer"
@page "/poracer/1player"
@page "/poracer/multi"
@page "/poracer/demo"
@using PoMiniGames.Shared.Games
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject GameStatsService GameStats
@inject GameResultService GameResults
@inject KioskCoordinator Kiosk
@inject PlayerNameService PlayerNameService
@inject ApiEndpoints Endpoints
@inject UiFeedbackService Feedback
@inject ToastService ToastService
@implements IAsyncDisposable

<PageTitle>Racer · PoMiniGames</PageTitle>
<GameShell Title="@TitleContent" Player="@_playerName" BackTo="/" Fullscreen="true"
           GameOver="@_showResults" GameKey="@BoardKey"
           GameSummary="@SummaryContent">
    <div class="racer-root">
        <canvas id="racerCanvas" class="racer-canvas" role="img" tabindex="0" aria-label="Race track. Your car is marked YOU. Arrow keys or W A S D drive; Space drifts."></canvas>
        @if (_phase == RacePhase.Start && !_introDone)
        {
            @* The shared opening card, like every other game: the name, what the
               race is, the controls, and for a solo race the track, the field and the paint.
               .racer-intro is display:contents; it is only there so this page's scoped CSS can
               reach the shared card and give the three track cards room. *@
            <div class="racer-intro">
                <GameIntro CueScope="poracer"
                           Title="@TitleContent"
                           Objective="@IntroObjective"
                           Controls="@ControlsContent"
                           Options="@StartError"
                           Mode="@(IsDemo ? GameIntro.IntroMode.Demo : GameIntro.IntroMode.OnePlayer)"
                           OnStart="OnIntroStartAsync" />
            </div>
        }
        else if (_phase == RacePhase.Start)
        {
            <section class="racer-start" aria-label="Start a race">
                <div class="racer-card">
                    @if (_mode == RaceMode.Online && string.IsNullOrWhiteSpace(MatchCode))
                    {
                        <OnlineLobby TPlayer="PoRacerLobbyPlayer"
                                     HubPath="poracer/lobby-hub"
                                     Hint="First in hosts; bots fill open seats."
                                     MaxPlayersHint="PoRacerCatalog.CarCount"
                                     StartLabel="Start race"
                                     OnClient="OnLobbyClient"
                                     OnGameStarted="OnLobbyStarted"
                                     OnLeave="LeaveLobby" />
                    }
                    else
                    {
                        @* The card is gone and the race is not up yet: the track is still
                           loading, or the race connection is being made. *@
                        <p class="racer-note" role="status">@(_error ?? (_engineReady ? "Joining the race…" : "Loading track…"))</p>
                    }
                </div>
            </section>
        }
        @if (_phase == RacePhase.Racing)
        {
            <PoRacerHud Cars="_cars" Roster="_roster" PlayerId="_localCarId" TotalLaps="_totalLaps" IsDemo="IsDemo" Weather="@_raceWeather" OnPause="TogglePauseAsync" />
            @if (!_raceStarted || _elapsed < 0.9)
            {
                @* Five lamps come on one at a time over the last 2.5 s, hold, and go out together:
                   lights out is the start. The server's CountdownMs drives them, so a driver who
                   joins late sees the lamps everyone else sees. *@
                <div class="race-countdown" role="status" aria-live="assertive">
                    <div class="race-gantry @(_raceStarted ? "is-go" : "")" aria-hidden="true">
                        @for (var lamp = 0; lamp < 5; lamp++)
                        {
                            <i class="@(lamp < Lit ? "on" : "")"></i>
                        }
                    </div>
                    <strong class="@(_raceStarted ? "" : "sr-only")">@(_raceStarted ? "GO!" : _countdown.ToString())</strong>
                    @if (!IsDemo) { <PoRacerControls /> }
                </div>
            }
            @if (_pauseOpen)
            {
                <GamePauseDialog Class="racer-pause" Label="@(CanPause ? "Paused" : "Race menu")" OnResume="TogglePauseAsync">
                    <div class="racer-pause-card">
                        <h2>@(CanPause ? "Paused" : "Race menu")</h2>
                        @if (!CanPause) { <p class="racer-note">The race keeps running while this is open.</p> }
                        <div class="racer-actions">
                            <PoButton class="racer-primary" @ref="_resumeButton" Click="TogglePauseAsync">Resume</PoButton>
                            <PoButton class="racer-ghost" Click="RestartRaceAsync">Back to start</PoButton>
                        </div>
                        @if (CanGhost)
                        {
                            <div class="racer-ghost-toggle">
                                <RadzenCheckBox TValue="bool" Value="@_ghost" Change="@((bool on) => SetGhostAsync(on))" AriaLabel="Ghost: race your best lap on this track" />
                                <span aria-hidden="true" @onclick="() => SetGhostAsync(!_ghost)">Ghost: race your best lap on this track</span>
                            </div>
                        }
                        @if (!IsDemo) { <PoRacerControls /> }
                    </div>
                </GamePauseDialog>
            }
        }
        @if (_phase == RacePhase.Finished && !_showResults && !IsDemo)
        {
            <div class="race-flag" aria-hidden="true"></div>
        }
        @if (_connectionStatus is not null)
        {
            <p class="racer-connection" role="status">@_connectionStatus</p>
        }
        <span class="sr-only" aria-live="polite">@_announcement</span>
    </div>
</GameShell>

@code {
    private static RenderFragment TitleContent => GameCatalog.TitleFor(GameKeys.PoRacer);
    private RenderFragment SummaryContent => @<PoRacerResults Result="_result" Roster="_roster" PlayerId="_localCarId"
        Track="@PoRacerCatalog.GetTrack(_raceTrackId)" PreviousBest="_previousBest" IsTrial="_raceTrial"
        SubmitStatus="@_submitStatus" />;
    // Each track has its own board (UnifiedLeaderboardEndpoints): the oval keeps the original
    // "poracer" key, the other two are "poracer-{trackId}". The results' Top 3 is the raced track's.
    private string BoardKey => _raceTrackId == PoRacerCatalog.DefaultTrackId ? "poracer" : "poracer-" + _raceTrackId;

    private RenderFragment ControlsContent => @<PoRacerControls />;

    // Online, solo and demo have nothing to choose on the card; it only carries a failed start.
    private RenderFragment? StartError => _error is null ? null : @<InlineError Message="@_error" />;
}
