@inject IJSRuntime JS

@* Coach and Music, on the start card's Options next to Board (not the settings drawer).
   Both live in the browser (pominigames:connectfive:coach / :music, "on" or "off") and both
   start off; js/connectfive/extras.js reads them live, so a change applies on the next frame. *@
<div class="cfx-pick">
    <div class="cfx-pick__row">
        <p class="cfx-pick__label" id="cfx-coach-label">Coach</p>
        <div class="app-seg" role="radiogroup" aria-labelledby="cfx-coach-label">
            <button type="button" role="radio" class="app-seg__btn" aria-checked="@(!_coach ? "true" : "false")"
                    @onclick="() => SetAsync(Coach, false)">Off</button>
            <button type="button" role="radio" class="app-seg__btn" aria-checked="@(_coach ? "true" : "false")"
                    title="Empty holes glow where either side has three or four in a row they could finish."
                    @onclick="() => SetAsync(Coach, true)">On</button>
        </div>
    </div>
    <div class="cfx-pick__row">
        <p class="cfx-pick__label" id="cfx-music-label">Music</p>
        <div class="app-seg" role="radiogroup" aria-labelledby="cfx-music-label">
            <button type="button" role="radio" class="app-seg__btn" aria-checked="@(!_music ? "true" : "false")"
                    @onclick="() => SetAsync(Music, false)">Off</button>
            <button type="button" role="radio" class="app-seg__btn" aria-checked="@(_music ? "true" : "false")"
                    title="Music that builds as the board fills and someone gets close to five."
                    @onclick="() => SetAsync(Music, true)">On</button>
        </div>
    </div>
</div>

@code {
    private const string Coach = "coach";
    private const string Music = "music";
    private bool _coach;
    private bool _music;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _coach = await JS.InvokeAsync<string?>("localStorage.getItem", $"pominigames:connectfive:{Coach}") == "on";
            _music = await JS.InvokeAsync<string?>("localStorage.getItem", $"pominigames:connectfive:{Music}") == "on";
            if (_coach || _music) StateHasChanged();
        }
        catch
        {
            // Storage blocked: both start off and work for this visit only.
        }
    }

    private async Task SetAsync(string key, bool on)
    {
        if (key == Coach) _coach = on; else _music = on;
        try { await JS.InvokeVoidAsync("localStorage.setItem", $"pominigames:connectfive:{key}", on ? "on" : "off"); }
        catch { /* private mode: not remembered */ }
        try { await JS.InvokeVoidAsync("PoConnectFiveExtras.setPref", key, on); }
        catch { /* the effects module is not loaded yet: it reads the stored choice live */ }
    }
}
