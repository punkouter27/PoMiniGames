@using PoMiniGamesClient.Features.PoEcosystem.Components
@using PoMiniGamesClient.Features.PoEcosystem.Models
@implements IAsyncDisposable

<div class="poeco-root @(_narrow ? "poeco-narrow" : "")">

    @* The three.js canvas is created by the engine inside this host. Nothing is wired to a
       click here: a click on the world looks, locks or inspects (input.js), and the god-power
       "shockwave" cue that used to hang off it went with the rest of the powers. *@
    <div id="poeco-world" class="poeco-world" role="img" aria-label="First-person view of the living island"></div>

    @if (_booted)
    {
        @* NOT a glass panel. This element covers the whole view, so data-glass on it would
           make glassFx paint a blurred 128-pixel capture of the scene across it, and on every
           machine above the low tier the island would be seen through a smear. The chip, the
           minimap and the panels are the glass. *@
        <div class="poeco-hud @(_directorOn ? "poeco-hud--cinematic" : "") @(_photoMode ? "poeco-hud--photo" : "")" aria-hidden="@(_dashboardOpen ? "true" : "false")">
            <div class="poeco-crosshair" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="20" height="20"><circle cx="10" cy="10" r="1.5" fill="currentColor"></circle><path d="M10 2v4M10 14v4M2 10h4M14 10h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
            </div>

            <div class="poeco-hud-top">
                @* Its own render region: the stats tick re-renders this strip, not the whole viewer
                   (see RenderStats). *@
                <HudRegion @ref="_hudRegion">
                <HudBar @ref="_hudBar" Stats="_stats" Sound="_sound" Director="_directorOn" Pip="_pipOn" Ambient="_ambient" PhotoMode="_photoMode" Keys="_showKeys"
                        Lens="_lens" HasSubject="@(_selected >= 0)"
                        OnSound="ToggleSoundAsync" OnDashboard="ToggleDashboard" OnDirector="ToggleDirectorAsync" OnPip="TogglePipAsync"
                        OnReel="ToggleReelAsync" OnPhotoMode="TogglePhotoModeAsync" OnAmbient="ToggleAmbientAsync" OnKeys="ToggleKeys" OnFind="OpenFinder"
                        OnSpeed="SetSpeedAsync" OnFastForward="FastForwardAsync" OnLens="SetLensAsync" />
                </HudRegion>
            </div>

            @if (_directorOn)
            {
                <p class="poeco-director" role="status">
                    <span aria-hidden="true">🎬</span> @(_ambient ? "Ambient" : "Auto-director")
                    @if (!string.IsNullOrWhiteSpace(_directorCaption))
                    {
                        <span> · @_directorCaption</span>
                    }
                    <span class="poeco-director-hint">move to take the camera back</span>
                </p>
            }

            @if (ReadOnly)
            {
                <p class="poeco-visiting" role="status">
                    @(_past >= 0 ? $"Year {_past} of this island, as it was — read-only." : "Visiting a shared island — nothing here is saved.")
                </p>
            }

            <div class="poeco-minimap-wrap">
                <canvas id="poeco-minimap" class="poeco-minimap" width="200" height="200"
                        aria-label="Map of the island — click near a tribe to fly there, or use the overview button"
                        title="Click near a tribe's camp to fly to it" @onclick="MinimapClickAsync"></canvas>
                <button type="button" class="poeco-minimap-overview" title="Island overview"
                        aria-label="Fly to the island overview"
                        @onclick="() => SetCameraPresetAsync(CameraPreset.IslandOverview)">⤢</button>
                <button type="button" class="poeco-minimap-layer @(_layer != "none" ? "poeco-minimap-layer--on" : "")"
                        title="@LayerInfo.What — click for the next data layer" aria-label="Map layer: @LayerInfo.Label. Click for the next."
                        @onclick="CycleLayerAsync">@LayerInfo.Label</button>
            </div>

            @if (_showKeys)
            {
                <div class="poeco-keys" role="note" aria-label="Keys">
                    @foreach (var (key, what) in KeyLegend)
                    {
                        <span><kbd>@key</kbd> @what</span>
                    }
                </div>
            }

            @if (_narrow)
            {
                <div class="poeco-touch">
                    <div class="poeco-pad" @ontouchstart="TouchStart" @ontouchmove="TouchMove" @ontouchend="TouchEnd" aria-label="Move"></div>
                    <div class="poeco-touch-buttons">
                        <button class="poeco-btn poeco-btn--round" @onclick="() => Interop.ToggleFlyAsync()" aria-label="Toggle flying">F</button>
                        <button class="poeco-btn poeco-btn--round" @onclick="InspectAsync" aria-label="Inspect what is ahead">E</button>
                    </div>
                </div>
            }
        </div>

        @if (_finderOpen && !_dashboardOpen)
        {
            <FinderPanel Results="_found" Tribes="@_stats?.Tribes" OnQuery="FindAsync" OnPick="PickFoundAsync" OnPickTribe="PickTribeAsync" OnClose="CloseFinder" />
        }

        @* The inspector never rides over an auto-director shot: the director is a camera,
           not a readout, and a panel left open from an earlier inspection would sit on top
           of every cut that followed. *@
        @if (_detail is not null && !_dashboardOpen && !_directorOn)
        {
            <InspectorPopover @ref="_inspector"
                              Detail="_detail"
                              Family="_lineage"
                              FamilyOpen="_lineageOpen"
                              OnFollow="FollowAsync"
                              OnClose="ClearSelectionAsync"
                              OnWatch="ToggleWatchAsync"
                              OnRename="RenameAsync"
                              OnFamily="ToggleFamilyAsync"
                              OnSelectKin="SelectKinAsync" />
        }

        @* The ending is the shared GameOverModal on the page, not a lower-third banner:
           one end-of-game surface in every game. *@

        @if (_tourActive && !_dashboardOpen)
        {
            <TourOverlay Step="_tourStep" Done="_tourStepDone" OnNext="NextTourStepAsync" OnSkip="EndTourAsync" />
        }

        @if (_photoMode && !_dashboardOpen)
        {
            <div class="poeco-photo-bar" role="toolbar" aria-label="Naturalist photo mode">
                <button type="button" class="poeco-btn poeco-btn--primary" @onclick="CapturePostcardAsync">📷 Capture Postcard</button>
                <label class="poeco-photo-fov">
                    <span>FOV @((int)_photoFov)°</span>
                    <input type="range" min="30" max="95" step="1" value="@_photoFov" @oninput="OnPhotoFovInputAsync" aria-label="Camera field of view" />
                </label>
                <button type="button" class="poeco-pill" @onclick="TogglePhotoModeAsync">✕ Exit</button>
            </div>
        }

        @if (_dashboardOpen)
        {
            <DashboardOverlay InitialTab="@_dashTab"
                              Stats="_stats"
                              Events="_log"
                              Thoughts="_thoughts"
                              Worlds="_worlds"
                              Gallery="_gallery"
                              SignedIn="@Auth.IsAuthenticated"
                              CloudBusy="_cloudBusy"
                              CloudMessage="@_cloudMessage"
                              Tint="_lens"
                              Seed="@_seedInput"
                              SeedChanged="v => _seedInput = v"
                              CurrentSeed="_seed"
                              ReadOnly="@ReadOnly"
                              LocalPersist="_localPersist"
                              OnLocalPersistChanged="SetLocalPersistAsync"
                              OnClose="ToggleDashboard"
                              OnFocusTribe="FocusTribeFromDashboardAsync"
                              OnExportTelemetry="ExportTelemetryAsync"
                              OnSelectThought="SelectThoughtAsync"
                              OnSelectKin="SelectKinAsync"
                              OnUnwatch="UnwatchAsync"
                              OnTint="SetLensAsync"
                              OnNewWorld="NewWorldAsync"
                              OnPrintJournal="PrintJournalAsync"
                              OnCloudRefresh="() => RefreshCloudAsync()"
                              OnCloudSave="SaveToCloudAsync"
                              OnCloudLoad="LoadFromCloudAsync"
                              OnCloudDelete="DeleteFromCloudAsync"
                              OnCloudShare="t => ShareAsync(t.Slot, t.Public)"
                              OnVisit="VisitAsync"
                              OnCompare="CompareAsync"
                              OnLink="t => ShareLinkAsync(t.Code, t.Name)"
                              OnNeedThumbs="LoadThumbsAsync"
                              Thumbs="_thumbs"
                              Compare="_compare"
                              History="_history"
                              OnFlyToTile="FlyToTileAsync"
                              Keyframes="_keyframes"
                              Past="_past"
                              OnOpenKeyframe="OpenKeyframeAsync"
                              OnReturn="ReturnHomeAsync"
                              OnSonify="t => Interop.SonifyAsync(t.Rows, t.Peak).AsTask()"
                              Milestones="_milestones.Unlocked"
                              Wagers="_wagers"
                              Alerts="_alerts"
                              Cards="_cards"
                              ViewSettings="_viewSettings"
                              Capturing="@_capturing"
                              DailySeed="@DailySeed"
                              OnTodaysIsland="TodaysIslandAsync"
                              OnReplayTour="ReplayTourAsync"
                              OnQuality="SetQualityAsync"
                              OnRebind="RebindAsync"
                              OnResetBindings="ResetBindingsAsync"
                              OnTab="OnDashboardTabAsync" />
        }
    }

    @* The engine not starting at all is a page failure (the shared ErrorState, no retry: a
       browser without WebGL2 will not grow one). A fault while the island runs is a card-level
       failure on a world that is still on screen: the shared inline strip. *@
    @if (_startFailed)
    {
        <div class="poeco-error poeco-error--page">
            <ErrorState Title="The island couldn't start">@_error</ErrorState>
        </div>
    }
    else if (_error is not null)
    {
        <div class="poeco-error">
            <InlineError Message="@_error" />
        </div>
    }
</div>
