@page "/poecosystem"
@page "/poecosystem/{Mode}"
@using PoMiniGamesClient.Features.Shared
@using PoMiniGamesClient.Models
@inject PlayerNameService PlayerNameService

<PageTitle>Ecosystem · PoMiniGames</PageTitle>

<GameShell Title=@TitleContent
           Player="@_playerName"
           BackTo="/"
           GameKey="poecosystem"
           RequiresWebGl="true"
           TabDebug="false"
           GameOver="@(_ended is not null)"
           GameSummary="@SummaryContent"
           Fullscreen="true">

    @if (!_introDismissed)
    {
        <GameIntro CueScope="poecosystem"
                   Title=@TitleContent
                   Objective="A living island that runs without you — creatures born, hungry and ageing while you watch."
                   Controls=@HowToPlayContent
                   Mode="@GameIntro.IntroMode.OnePlayer"
                   OnStart="@(() => _introDismissed = true)" />
    }
    else
    {
        <PoEcosystemViewer VisitCode="@Island" OnEnded="HandleEnded" />
    }
</GameShell>

@code {
    /// <summary>
    /// A legacy mode segment (<c>/poecosystem/1player</c>). The game is demo-only now, so the
    /// segment no longer changes anything: every address opens the same kiosk island.
    /// </summary>
    [Parameter] public string? Mode { get; set; }

    /// <summary>A shared island's code (<c>?island=CODE</c>): the viewer sails straight to it, read-only.</summary>
    [SupplyParameterFromQuery(Name = "island")] public string? Island { get; set; }

    private string _playerName = "";
    private bool _introDismissed;
    private string? _ended;

    // Ends the way every other game ends: the shared modal, one Back to main menu.
    private void HandleEnded(string summary) => _ended = summary;

    private RenderFragment? SummaryContent => _ended is null ? null : @<div>@_ended</div>;

    private static RenderFragment TitleContent => GameCatalog.TitleFor(GameKeys.PoEcosystem);

    private RenderFragment HowToPlayContent => @<div>
        <p><strong>You are a naturalist drifting over the island. Nothing here needs you, and nothing you do changes it.</strong></p>
        <ul>
            <li><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> or arrows fly · <kbd>Space</kbd>/<kbd>Ctrl</kbd> rise and sink · <kbd>Shift</kbd> hurry · <kbd>F</kbd> fly or walk</li>
            <li><kbd>E</kbd> or click studies the creature under the crosshair · <kbd>T</kbd> follows it · <kbd>/</kbd> finds one by name</li>
            <li><kbd>L</kbd> lenses · <kbd>C</kbd> cinematic camera · <kbd>Tab</kbd> dashboard · <kbd>H</kbd> every key</li>
            <li><kbd>0</kbd> to <kbd>3</kbd> set the speed: pause, 1x, 2x, 4x</li>
        </ul>
    </div>;

    protected override void OnInitialized() => _playerName = PlayerNameService.GetPlayerName();
}
