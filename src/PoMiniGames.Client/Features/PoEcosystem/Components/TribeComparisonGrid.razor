@using PoMiniGames.Shared.Games.PoEcosystem
@using PoMiniGamesClient.Features.PoEcosystem.Models

<div class="poeco-tribe-grid-wrap" role="region" aria-label="Tribal Comparison Matrix">
    <div class="poeco-tribe-cards">
        @if (Tribes is null || Tribes.Count == 0)
        {
            <div class="poeco-note">Observing island... tribal factions have not established settlements yet.</div>
        }
        else
        {
            @foreach (var tribe in Tribes)
            {
                var buildings = Buildings?.Where(b => b.TribeId == tribe.Id).ToList() ?? [];
                var huts = buildings.Count(b => b.Kind == BuildingKind.Hut && b.IsComplete);
                var granaries = buildings.Count(b => b.Kind == BuildingKind.Granary && b.IsComplete);
                var towers = buildings.Count(b => b.Kind == BuildingKind.Watchtower && b.IsComplete);
                var inProgress = buildings.Count(b => !b.IsComplete);

                <div class="poeco-tribe-card" style="border-top-color: @tribe.BannerColor;">
                    <div class="poeco-tribe-card-header">
                        <div class="poeco-tribe-title-row">
                            <span class="poeco-tribe-dot" style="background-color: @tribe.BannerColor;"></span>
                            <h4 class="poeco-tribe-name">@tribe.Name</h4>
                            <span class="poeco-badge poeco-badge--tech">@tribe.Tech</span>
                        </div>
                        <button type="button" class="poeco-pill poeco-pill--focus" @onclick="() => OnSelectTribe.InvokeAsync(tribe.Id)" title="Focus camera on this tribe">
                            🎯 Focus
                        </button>
                    </div>

                    <div class="poeco-tribe-stats-row">
                        <div class="poeco-tribe-stat">
                            <span class="poeco-stat-lbl">Pop</span>
                            <strong class="poeco-stat-val">@tribe.Population</strong>
                            <small class="poeco-stat-sub">(@tribe.Warriors ⚔️)</small>
                        </div>
                        <div class="poeco-tribe-stat">
                            <span class="poeco-stat-lbl">Wood</span>
                            <strong class="poeco-stat-val">@tribe.Wood</strong>
                        </div>
                        <div class="poeco-tribe-stat">
                            <span class="poeco-stat-lbl">Stone</span>
                            <strong class="poeco-stat-val">@tribe.Stone</strong>
                        </div>
                        <div class="poeco-tribe-stat">
                            <span class="poeco-stat-lbl">Food</span>
                            <strong class="poeco-stat-val">@tribe.Food</strong>
                        </div>
                    </div>

                    <div class="poeco-tribe-structures">
                        <span class="poeco-struct-badge" title="Completed Huts (Housing)">🛖 @huts</span>
                        <span class="poeco-struct-badge" title="Completed Granaries (Grain Storage)">🌾 @granaries</span>
                        <span class="poeco-struct-badge" title="Watchtowers (Defense)">🗼 @towers</span>
                        @if (inProgress > 0)
                        {
                            <span class="poeco-struct-badge poeco-struct-badge--build" title="Under Construction">🔨 @inProgress</span>
                        }
                    </div>

                    <div class="poeco-tribe-diplomacy-row">
                        <span class="poeco-dip-lbl">Relations:</span>
                        <div class="poeco-dip-tags">
                            @for (var otherIdx = 0; otherIdx < Tribes.Count; otherIdx++)
                            {
                                if (Tribes[otherIdx].Id != tribe.Id)
                                {
                                    var other = Tribes[otherIdx];
                                    var rel = tribe.Relations is not null && otherIdx < tribe.Relations.Length
                                        ? (TribeDiplomacy)tribe.Relations[otherIdx]
                                        : TribeDiplomacy.Neutral;
                                    var badgeClass = rel switch
                                    {
                                        TribeDiplomacy.War => "poeco-dip-tag--war",
                                        TribeDiplomacy.Rival => "poeco-dip-tag--rival",
                                        TribeDiplomacy.Allied => "poeco-dip-tag--allied",
                                        _ => "poeco-dip-tag--neutral",
                                    };
                                    <span class="poeco-dip-tag @badgeClass" title="@tribe.Name vs @other.Name: @rel">
                                        @other.Name: @rel
                                    </span>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<TribeStateDto>? Tribes { get; set; }
    [Parameter] public IReadOnlyList<BuildingStateDto>? Buildings { get; set; }
    [Parameter] public EventCallback<int> OnSelectTribe { get; set; }
}
