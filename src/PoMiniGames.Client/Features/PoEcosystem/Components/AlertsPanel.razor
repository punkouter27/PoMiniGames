@using Microsoft.AspNetCore.Components.Forms
@using PoMiniGames.Shared.Validation
@* Watch alerts: the viewer's own rules — "tell me when wolves fall below 5".
   A rule reads the counts the page already receives; it watches and never acts. Kept in
   this browser across islands; fires once when it starts to hold and re-arms when it stops. *@
<div class="poeco-alerts">
    @if (Book.Rules.Count > 0)
    {
        <ul class="poeco-watch-list">
            @foreach (var rule in Book.Rules)
            {
                <li>
                    <span class="poeco-alert-rule @(Stats is not null && rule.Holds(Stats) ? "poeco-alert-rule--on" : "")">@rule.Describe()</span>
                    <button type="button" class="poeco-icon-btn" aria-label="Remove the alert: @rule.Describe()" title="Remove" @onclick="() => Remove(rule)">✕</button>
                </li>
            }
        </ul>
    }
    @* Validated with the shared EcoAlertInputValidator; errors show inline and the button is
       disabled while the rule is being added (forms standard, 2026-11-17). *@
    <EditForm EditContext="_context" OnValidSubmit="Add" class="poeco-alert-form" novalidate>
        <FluentValidationValidator TModel="EcoAlertInput" Validator="Validator" />
        <InputSelect @bind-Value="_input.Species" aria-label="Which creatures">
            <option value="-1">All creatures</option>
            @for (var s = 0; s < EcoSpeciesInfo.Count; s++)
            {
                <option value="@s">@EcoSpeciesInfo.PluralOf(s)</option>
            }
        </InputSelect>
        <InputSelect @bind-Value="_input.Op" aria-label="Below or above">
            <option value="below">fall below</option>
            <option value="above">rise above</option>
        </InputSelect>
        <InputNumber @bind-Value="_input.Value" min="0" max="@EcoAlertInput.MaxValue" aria-label="How many" />
        <button type="submit" class="poeco-pill poeco-pill--on" disabled="@(_submitting || Book.Rules.Count >= EcoAlertBook.MaxRules)">Alert me</button>
        <div class="poeco-field-error" aria-live="polite">
            <ValidationMessage For="() => _input.Species" />
            <ValidationMessage For="() => _input.Op" />
            <ValidationMessage For="() => _input.Value" />
        </div>
    </EditForm>
</div>

@code {
    [Parameter, EditorRequired] public EcoAlertBook Book { get; set; } = default!;
    [Parameter] public EcoStats? Stats { get; set; }

    private static readonly EcoAlertInputValidator Validator = new(EcoSpeciesInfo.Count);
    private readonly EcoAlertInput _input = new();
    private EditContext _context = default!;
    private bool _submitting;

    protected override void OnInitialized() => _context = new EditContext(_input);

    // Only reached through OnValidSubmit, so the rule has already passed the validator.
    private void Add()
    {
        if (_submitting) return;
        _submitting = true;
        try
        {
            Book.Add(new EcoAlertRule(_input.Species, _input.Op == "below", _input.Value ?? 0));
        }
        finally
        {
            _submitting = false;
        }
    }
    private void Remove(EcoAlertRule rule) => Book.Remove(rule);
}
