@using PoMiniGames.Shared.Games.PoEcosystem
@* The Tribes tab: the clans side by side, the ladder, their diplomacy, and the printable
   field journal. The ladder is read straight from the sim (sim/behavior/tech.js). *@
<div class="poeco-tribe">
    <div class="poeco-tribe-top">
        <TerritoryMinimap Tribes="@Stats?.Tribes" Buildings="@Stats?.Buildings" Caravans="@Stats?.Caravans" Thumb="@Thumb" OnFocusTribe="@OnFocusTribe" />
        <div class="poeco-tribe-side">
            @if (Stats?.Tribes is { Length: > 0 } clans)
            {
                var total = Math.Max(1, clans.Sum(t => t.Population));
                <div class="poeco-tribe-stacked-bar" role="img" aria-label="Share of the people: @string.Join(", ", clans.Select(t => $"{t.Name} {t.Population}"))">
                    @foreach (var clan in clans)
                    {
                        var pct = clan.Population * 100.0 / total;
                        <div class="poeco-tribe-bar-seg" style="width: @pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background-color: @clan.BannerColor;"
                             title="@clan.Name: @clan.Population people (@pct.ToString("F0")%)">
                            @if (pct > 15)
                            {
                                <span class="poeco-tribe-bar-text">@clan.Name</span>
                            }
                        </div>
                    }
                </div>
            }
            <h3>The @(Stats?.Tech?.Tribe ?? "island") tribe's ladder</h3>
            <ol class="poeco-ladder" aria-label="The tribe's ladder">
                @for (var k = 0; k < Tiers.Length; k++)
                {
                    var level = Stats?.Tech?.Level ?? 0;
                    <li class="@(k <= level ? "poeco-ladder--done" : "") @(k == level + 1 ? "poeco-ladder--next" : "")" title="@Tiers[k].What">
                        <span class="poeco-ladder-name">@Tiers[k].Name</span>
                        <span class="poeco-ladder-what">@Tiers[k].What</span>
                    </li>
                }
            </ol>
        </div>
    </div>

    <TribeComparisonGrid Tribes="@Stats?.Tribes" Buildings="@Stats?.Buildings" OnSelectTribe="@OnFocusTribe" />

    <div class="poeco-tribe-record">
        <section>
            @if (Stats?.Tribes is not null && Stats.Tribes.Length >= 2)
            {
                <DiplomacyWeb Tribes="@Stats.Tribes" Caravans="@Stats.Caravans" OnFocusTribe="@OnFocusTribe" />
            }
        </section>

        <section>
            <div class="poeco-cloud-head">
                <h3>Journal</h3>
                <button type="button" class="poeco-pill" title="Print the journal, or save it as a PDF: the timeline and your field notes"
                        @onclick="OnPrint">🖨 Journal</button>
            </div>
            <p class="poeco-note">The island's timeline and your field notes, ready to print or save as a PDF.</p>
        </section>
    </div>
</div>

@code {
    private static readonly (string Name, string What)[] Tiers =
    [
        ("Camp", "huts and hunting"),
        ("Fire", "a hearth that scares wolves and warms the tribe at night"),
        ("Palisade", "a fence with gates that keeps predators out of the village"),
        ("Farming", "berry fields that ripen three times faster"),
        ("Watchtower", "the tribe sees further and throws further"),
    ];

    [Parameter] public EcoStats? Stats { get; set; }
    /// <summary>The island's map (a data URL drawn from its seed), behind the territories.</summary>
    [Parameter] public string? Thumb { get; set; }
    [Parameter] public EventCallback OnPrint { get; set; }
    [Parameter] public EventCallback<int> OnFocusTribe { get; set; }
}
