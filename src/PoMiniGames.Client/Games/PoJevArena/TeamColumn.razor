@using System.Globalization
@using PoMiniGames.Shared.Games.PoJevArena

@* One side of the Dual Inspector layout: the team's 5×2 roster and, once the battle starts, the
   Jev Inspector for this side's selected unit. While drafting it also carries the side's tools
   (fill, copy, saved squads) and its build points against the other side's. *@
<section class="jev-team jev-team--@Team" aria-label="@($"Team {TeamName}")">
    <header class="jev-team__head">
        <h2 class="jev-team__title">@Heading</h2>
        <span class="jev-muted jev-small">@Filled / 10</span>
    </header>

    @if (Drafting)
    {
        <div class="jev-team__actions">
            <button type="button" class="jev-btn jev-btn--ghost jev-btn--sm" @onclick="OnFill" disabled="@(Filled == 10)">Fill</button>
            @if (ShowCopy)
            {
                <button type="button" class="jev-btn jev-btn--ghost jev-btn--sm" @onclick="OnCopy" title="Copy Blue's roster into Red">Copy Blue</button>
            }
            <button type="button" class="jev-btn jev-btn--ghost jev-btn--sm" @onclick="OnClear" disabled="@(Filled == 0)">Clear</button>
            <details class="jev-squads">
                <summary class="jev-btn jev-btn--ghost jev-btn--sm">Squads</summary>
                <div class="jev-squads__menu">
                    @foreach (var s in Squads)
                    {
                        <div class="jev-squads__row">
                            <button type="button" class="jev-link" @onclick="() => OnLoadSquad.InvokeAsync(s.Name)"
                                    aria-label="@($"Load squad {s.Name} into {TeamName}")">@s.Name</button>
                            <button type="button" class="jev-link jev-danger" @onclick="() => OnDeleteSquad.InvokeAsync(s.Name)"
                                    aria-label="@($"Delete squad {s.Name}")">×</button>
                        </div>
                    }
                    <form class="jev-squads__save" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                        <input class="jev-input" maxlength="32" placeholder="Squad name" aria-label="Squad name" @bind="_squadName" />
                        <button type="submit" class="jev-btn jev-btn--sm" disabled="@(Filled == 0)">Save</button>
                    </form>
                </div>
            </details>
        </div>
    }
    else
    {
        <JevInspector Team="@Team" View="Inspector" />
    }

    <ol class="jev-roster" aria-label="@($"{TeamName} roster")">
        @for (var i = 0; i < 10; i++)
        {
            var slot = i;
            var creature = Slots[slot];
            var selected = !Drafting && Inspector?.Index == SlotIndexBase + slot;
            <li>
                <button type="button" class="jev-slot @(creature is null ? "is-empty" : null) @(selected ? "is-selected" : null)"
                        aria-label="@SlotLabel(slot, creature)"
                        disabled="@(Drafting ? creature is null : creature is null)"
                        @onclick="() => OnSlot.InvokeAsync(slot)">
                    @if (creature is not null)
                    {
                        <CreaturePortrait Creature="creature" Team="@Team" Class="jev-slot__art" />
                    }
                    <span class="jev-slot__num">@(slot + 1)</span>
                </button>
            </li>
        }
    </ol>

    @if (Drafting && Filled > 0)
    {
        <div class="jev-points">
            <span class="jev-small">Build points <strong>@Own.ToString("0", CultureInfo.InvariantCulture)</strong></span>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Team { get; set; } = "blue";
    [Parameter, EditorRequired] public ArenaCreature?[] Slots { get; set; } = new ArenaCreature?[10];
    [Parameter] public bool Drafting { get; set; }
    [Parameter] public ArenaInspectorView? Inspector { get; set; }

    [Parameter] public IReadOnlyList<ArenaSquad> Squads { get; set; } = [];
    [Parameter] public bool ShowCopy { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public EventCallback OnFill { get; set; }
    [Parameter] public EventCallback OnCopy { get; set; }
    [Parameter] public EventCallback<string> OnSaveSquad { get; set; }
    [Parameter] public EventCallback<string> OnLoadSquad { get; set; }
    [Parameter] public EventCallback<string> OnDeleteSquad { get; set; }

    /// <summary>Drafting: removes the creature in that slot. In battle: selects that unit for this side's inspector.</summary>
    [Parameter] public EventCallback<int> OnSlot { get; set; }

    private string _squadName = "";

    private string TeamName => Team == "blue" ? "Blue" : "Red";
    private string Heading => $"Team {TeamName}";
    private int Filled => Slots.Count(s => s is not null);
    private int SlotIndexBase => Team == "blue" ? 0 : 10;
    private double Own => Slots.Sum(s => s?.BuildCost ?? 0);

    private async Task SaveAsync()
    {
        await OnSaveSquad.InvokeAsync(_squadName);
        _squadName = "";
    }

    private string SlotLabel(int slot, ArenaCreature? c) => c is null
        ? $"{TeamName} slot {slot + 1}, empty"
        : Drafting ? $"{TeamName} slot {slot + 1}: {c.Name}. Remove" : $"Inspect {TeamName}-{slot + 1:00}, {c.Name}";
}
