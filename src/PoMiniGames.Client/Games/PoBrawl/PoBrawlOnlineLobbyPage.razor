@page "/pobrawl/multi"
@using PoMiniGames.Shared.Games
@using PoMiniGamesClient.Components
@using PoBrawlFighter = PoMiniGames.Domain.Primitives.PoBrawlFighter
@using PoBrawlRoster = PoMiniGames.Domain.Primitives.PoBrawlRoster
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject ApiService Api
@inject ApiEndpoints Endpoints
@inject ToastService ToastService
@implements IAsyncDisposable

<PageTitle>Brawl · Lobby · PoMiniGames</PageTitle>

@* Every way into a game opens on the same card: the opening card sits in front of the
   lobby, and the seat is taken when it is dismissed. *@
<GameShell Title="@TitleContent" BackTo="/">
@* .pbl-room: this page's handle on the shared LobbyPanel (see the .razor.css). *@
<div class="pbl-room">
@if (!_introDone)
{
    <GameIntro CueScope="pobrawl"
               Title="@TitleContent"
               Objective="A real-time 1v1 in the arena: one round, 60 seconds, and the server keeps the HP."
               Controls="@IntroKeys"
               HowToPlay="@IntroTips"
               OnStart="OnIntroStartAsync" />
}
else if (_failed is { } why)
{
    <div class="pbl-failed" role="alert">
        <p>@why</p>
        <button type="button" class="app-btn app-btn--primary" @onclick="ConnectAsync">Try again</button>
    </div>
}
else
{
    @* 1v1, laid out like a slim 2P select: your card and your opponent's on one row, with
       your fighter dropdown under your card. Your card is your Ready toggle (the 2P lock-in),
       so the shared panel shows no Ready or Start button; the host's client starts the fight
       the moment both seats are ready (AutoStartAsync). *@
    <LobbyPanel TPlayer="PoBrawlLobbyPlayer"
                State="@_lobby.State"
                LocalConnectionId="@_lobby.ConnectionId"
                ConnectionState="@_lobby.ConnectionState"
                Hint="1v1 · first two in fight"
                MaxPlayersHint="2"
                StartLabel="Start Fight"
                ShowReady="false"
                ShowStart="false"
                HowTo="@HowToPlayContent"
                OnLeave="LeaveAsync">
        <PlayerBadges Context="p">
            <span class="app-chip">@FighterName(p.Fighter.Id)</span>
        </PlayerBadges>
        <Picker>
            @* .pb-lobby only carries the --pb-* tokens; the .razor.css flattens it so the
               Dossiers disclosure can share a row with Leave / Invite / How to play. *@
            <div class="pb-lobby">
                <div class="pb-select" data-stage="off">
                    <div class="pb-select-sides">
                        <button type="button"
                                class="pb-select-side pb-select-side--p1 @(MyReady ? "pb-select-side--locked" : "")"
                                aria-pressed="@(MyReady ? "true" : "false")"
                                aria-label="@($"You: {FighterName(MyFighterId)}, {(MyReady ? "ready — press to change your pick" : "press to ready up")}")"
                                disabled="@(_lobby.Me is null || _readyBusy)"
                                @onclick="ToggleReadyAsync">
                            <span class="pb-select-who">You</span>
                            <span class="pb-select-plate">
                                <span class="pb-select-pick">@FighterName(MyFighterId)</span>
                                <span class="pb-select-state">@(MyReady ? "✓ Ready" : "Ready up")</span>
                            </span>
                            @if (MyReady)
                            {
                                <span class="pb-select-seal" aria-hidden="true">@PoBrawlPage.SealSvg</span>
                            }
                        </button>
                        <span class="pb-select-vs" aria-hidden="true">VS</span>
                        <div class="pb-select-side pb-select-side--p2 pb-select-side--static @(Opponent?.IsReady == true ? "pb-select-side--locked" : "")"
                             role="status">
                            <span class="pb-select-who">@(Opponent is { } who ? LeaderboardNames.Pretty(who.DisplayName) : "Opponent")</span>
                            <span class="pb-select-plate">
                                <span class="pb-select-pick">@(Opponent is { } o ? FighterName(o.Fighter.Id) : "Waiting…")</span>
                                <span class="pb-select-state">@(Opponent is null ? "Seat open" : Opponent.IsReady ? "✓ Ready" : "Picking")</span>
                            </span>
                            @if (Opponent?.IsReady == true)
                            {
                                <span class="pb-select-seal" aria-hidden="true">@PoBrawlPage.SealSvg</span>
                            }
                        </div>
                        @* Your pick, under your card. Any fighter, ready or not (the hub allows a
                           change at any time); greyed out only until you hold a seat. *@
                        <div class="pbl-fighter">
                            <label for="pbl-fighter">Fighter</label>
                            <select id="pbl-fighter" value="@MyFighterId" disabled="@(_lobby.Me is null)" @onchange="OnFighterChangedAsync">
                                @foreach (var f in RosterForPicker)
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <details class="pb-dossier-disclosure">
                    <summary>📁 Dossiers</summary>
                    <div class="pb-dossier-pair">
                        @if (!string.IsNullOrEmpty(MyFighterId))
                        {
                            <PoBrawlDossierCard FighterId="@MyFighterId" Compact="true" />
                        }
                        @if (Opponent is { } opp)
                        {
                            <PoBrawlDossierCard FighterId="@opp.Fighter.Id" Compact="true" />
                        }
                    </div>
                </details>
            </div>
        </Picker>
    </LobbyPanel>
}
</div>
</GameShell>

@code {
    private LobbyClient<PoBrawlLobbyPlayer> _lobby = null!;
    private string? _failed;   // why the lobby could not be reached; the retry card shows it
    private bool _wired;       // lobby events subscribed (once — a retry must not double them)

    protected override void OnInitialized() => _lobby = new LobbyClient<PoBrawlLobbyPlayer>(Endpoints, "pobrawl/lobby-hub");

    private bool _introDone;

    // The opening card was dismissed. The lobby card goes up first, saying "connecting…",
    // while the availability probe and the hub handshake run.
    private async Task OnIntroStartAsync()
    {
        _introDone = true;
        StateHasChanged();
        await ConnectAsync();
    }

    private static RenderFragment TitleContent => GameCatalog.TitleFor(GameKeys.PoBrawl);
    private static RenderFragment HowToPlayContent => @<PoBrawlControls Mode="online" />;
    private static RenderFragment IntroKeys => @<PoBrawlControls Mode="online" Part="keys" />;
    private static RenderFragment IntroTips => @<PoBrawlControls Mode="online" Part="tips" />;

    // Picker order: 1P avatar first, then the presidents roster in ladder order.
    private static readonly IReadOnlyList<PoBrawlFighter> RosterForPicker =
        new[] { PoBrawlRoster.Bob }.Concat(PoBrawlRoster.Fighters).ToList();

    // An id this build no longer knows still renders, as itself.
    private static string FighterName(string id) => PoBrawlRoster.NameOf(id) ?? id;

    private string Name => AuthState.User?.DisplayName ?? "Player";
    private bool IsGuest => !AuthState.IsAuthenticated;
    private string MyFighterId => _lobby.Me?.Fighter.Id ?? "";

    private bool EveryoneReady =>
        _lobby.State is { } s && s.Players.Count == s.MaxPlayers && s.Players.All(p => p.IsReady);

    private bool MyReady => _lobby.IsReady;
    private PoBrawlLobbyPlayer? Opponent => _lobby.State?.Players.FirstOrDefault(p => p.ConnectionId != _lobby.ConnectionId);

    // One hub call at a time: a double tap must not toggle Ready straight back.
    private bool _readyBusy;

    private async Task ToggleReadyAsync()
    {
        if (_readyBusy) return;
        _readyBusy = true;
        try { await _lobby.ToggleReadyAsync(); }
        catch (Exception ex) { ToastService.Show(ex.Message, ToastType.Warning); }
        finally { _readyBusy = false; }
    }

    // The host's client starts the fight once both seats are ready, so nobody has to find a
    // Start button. Once per all-ready moment; an un-ready re-arms it.
    private bool _autoStarted;

    private async Task AutoStartAsync()
    {
        if (!EveryoneReady) { _autoStarted = false; return; }
        if (_autoStarted || !_lobby.IsHost) return;
        _autoStarted = true;
        try { await _lobby.StartGameAsync(); }
        catch (Exception ex)
        {
            _autoStarted = false;
            ToastService.Show(PoBrawlNetSession.HubMessage(ex, "Couldn't start the fight."), ToastType.Warning);
        }
    }

    private Task OnFighterChangedAsync(ChangeEventArgs e) =>
        e.Value?.ToString() is { Length: > 0 } id ? PickAsync(id) : Task.CompletedTask;

    private async Task ConnectAsync()
    {
        _failed = null;
        StateHasChanged();
        if (!await Api.IsAvailableAsync())
        {
            _failed = "The server isn't answering right now, so there's no lobby to join.";
            StateHasChanged();
            return;
        }
        if (!_wired)
        {
            _wired = true;
            _lobby.StateChanged += _ => InvokeAsync(async () =>
            {
                StateHasChanged();
                await AutoStartAsync();
            });
            _lobby.ConnectionChanged += _ => InvokeAsync(StateHasChanged);
            _lobby.EventReceived += ev => ToastService.Show(ev.Message, ev.Kind == "left" ? ToastType.Warning : ToastType.Info);
            _lobby.GameStarted += code => Nav.NavigateTo($"/pobrawl/online?code={Uri.EscapeDataString(code)}");
        }
        try
        {
            await _lobby.ConnectAndJoinAsync(Name, IsGuest);
        }
        catch (Exception ex)
        {
            // Unreachable, or the room is full / a fight is being set up: the hub's reason and a retry.
            _failed = PoBrawlNetSession.HubMessage(ex, "Couldn't reach the lobby.");
        }
        StateHasChanged();
    }

    private async Task PickAsync(string fighterId)
    {
        try { await _lobby.SendAsync("PickFighter", fighterId); }
        catch (Exception ex) { ToastService.Show(ex.Message, ToastType.Warning); }
    }

    private async Task LeaveAsync()
    {
        await _lobby.LeaveLobbyAsync();
        Nav.NavigateTo("/");
    }

    public ValueTask DisposeAsync() => _lobby.DisposeAsync();
}
