@using PoBrawlFighter = PoMiniGames.Domain.Primitives.PoBrawlFighter

@* The 2P select's fighter grid: two players at one keyboard pick from these glass tiles, each
   corner marked on its tile. The empty .pb-select-portrait spans are where selectStage.js
   paints each president's live rig when the host mounts it; without the stage
   (data-stage="off" on the .pb-select around this grid, or the low tier) they collapse and
   the tiles stay plain glass buttons.
   Styles: PoBrawlPage.razor.css (.pb-select-*); this component shares that CSS scope. *@
<ul class="pb-select-grid" role="radiogroup" aria-label="Fighters">
    @for (var i = 0; i < Fighters.Count; i++)
    {
        var idx = i;
        var f = Fighters[idx];
        var p1 = idx == P1Index;
        var p2 = idx == P2Index;
        <li role="none">
            <button type="button"
                    role="radio"
                    aria-checked="@(p1 || p2 ? "true" : "false")"
                    class="pb-select-tile @(p1 ? "pb-select-tile--p1" : "") @(p2 ? "pb-select-tile--p2" : "")"
                    aria-label="@(f.Name + (p1 ? ", Player 1" : "") + (p2 ? ", Player 2" : ""))"
                    @onclick="() => OnPick.InvokeAsync(idx)">
                <span class="pb-select-portrait" aria-hidden="true" data-fighter="@f.Id" data-index="@idx"></span>
                <span class="pb-select-name">@f.Name</span>
                @if (p1)
                {
                    <span class="pb-select-mark pb-select-mark--p1" aria-hidden="true">P1</span>
                }
                @if (p2)
                {
                    <span class="pb-select-mark pb-select-mark--p2" aria-hidden="true">P2</span>
                }
            </button>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PoBrawlFighter> Fighters { get; set; } = [];
    /// <summary>The left (green) corner's tile, or -1.</summary>
    [Parameter] public int P1Index { get; set; } = -1;
    /// <summary>The right (red) corner's tile, or -1.</summary>
    [Parameter] public int P2Index { get; set; } = -1;
    [Parameter] public EventCallback<int> OnPick { get; set; }
}
