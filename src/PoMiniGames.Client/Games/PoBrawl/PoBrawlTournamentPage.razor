@page "/pobrawl/demo"
@page "/pobrawl/tournament"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@* Aliases, not namespace imports — same reason as PoBrawlPage (Models mirrors Domain names). *@
@using PoBrawlFighter = PoMiniGames.Domain.Primitives.PoBrawlFighter
@using PoBrawlRoster = PoMiniGames.Domain.Primitives.PoBrawlRoster
@using PoBrawlDemoResultRequest = PoMiniGames.Domain.Models.PoBrawlDemoResultRequest
@implements IAsyncDisposable
@inject PlayerNameService PlayerNameService
@inject ApiService ApiService
@inject IJSRuntime JSRuntime
@inject SettingsService Settings
@inject AuthStateService Auth
@inject KioskCoordinator Kiosk
@inject NavigationManager Nav

@* The Brawl Cup (/pobrawl/demo — the app-wide Demo tab; /pobrawl/tournament, the old address,
   redirects here): the CPU-only knockout bracket. The literal routes win over PoBrawlPage's
   /pobrawl/{Mode}. Eight presidents are drawn at random, the seven bouts play out
   in the same arena the other modes use (engine mode 'tournament': both corners CPU, the page
   picks every pairing through PoBrawl.matchup), and each result moves both fighters' Elo.
   This component shares PoBrawlPage's CSS scope (CssScope in the csproj), so the engine's DOM —
   splash, banner, captions — and the fight chrome are styled exactly as there. *@

<PageTitle>Brawl Cup · PoMiniGames</PageTitle>

<GameShell Title=@TitleContent
           Player="@_playerName"
           BackTo="/"
           GameOver="@_showFinal"
           GameOverDelayMs="@FinalHoldMs"
           Fullscreen="true"
           GameKey="pobrawldemo"
           RequiresWebGl="true"
           GameSummary="@FinalSummary"
           Announcement="@_announcement">
    @if (!_introDone)
    {
        <div class="pb-intro">
            <GameIntro CueScope="pobrawl-cup"
                       Title="@TitleContent"
                       Objective="Eight presidents, seven bouts, one belt. The CPU fights every bout — you watch the bracket play out."
                       HowToPlay="@HowItWorks"
                       Mode="GameIntro.IntroMode.Demo"
                       DemoDelayMs="4000"
                       Options="@DrawPreview"
                       Wide="true"
                       DialogLabel="Brawl Cup: a CPU knockout"
                       CaptureKeys="false"
                       OnStart="StartAsync" />
        </div>
    }
    <div class="pb-wrap">
        <div id="pobrawl-container" class="pb-canvas-host"
             role="img" aria-label="Brawl arena — the tournament bout renders here"></div>

        <div class="pb-top">
            @if (_introDone)
            {
                <PoBrawlHud @ref="_hud"
                            P1Name="@HudName(_p1Char)" P2Name="@HudName(_p2Char)"
                            P1Fighter="@Name(_p1Char)" P2Fighter="@Name(_p2Char)"
                            Training="false"
                            Below="@BoutChip" />
            }
        </div>

        @if (_introDone)
        {
            @* One compact bar: the speed segment, the bracket drawer, and one camera button that
               steps through the broadcast set-ups. mousedown:preventDefault keeps a clicked button
               from taking focus (see PoBrawlPage's trainbar). *@
            <div class="pt-bar" role="toolbar" aria-label="Tournament controls" @onmousedown:preventDefault="true">
                <span class="pt-speed" role="group" aria-label="Bout speed">
                    @foreach (var s in Speeds)
                    {
                        var speed = s;
                        <button type="button" class="pt-speed-btn"
                                aria-pressed="@(speed == _speed ? "true" : "false")"
                                title="@($"Play the bouts at {speed}× speed")"
                                @onclick="() => SetSpeedAsync(speed)">@(speed)×</button>
                    }
                </span>
                @* The drawer never opens by itself (the arena's jumbotrons carry the bracket);
                   a fresh result only makes this button glow until it is opened. *@
                <button type="button" class="pb-seg pt-btn @(_bracketOpen ? "pt-seg--on" : "") @(_bracketFresh && !_bracketOpen ? "pt-btn--fresh" : "")"
                        aria-expanded="@(_bracketOpen ? "true" : "false")" aria-controls="pt-drawer"
                        @onclick="ToggleBracket">🗂 Bracket</button>
                <button type="button" class="pb-seg pt-btn"
                        title="@CameraHint"
                        aria-label="@($"Camera: {CameraName}. Press for {NextCameraName}.")"
                        @onclick="CycleCameraAsync">🎥 @CameraName</button>
            </div>
        }

        @if (_introDone && _bracketOpen && _cup is not null)
        {
            @* A drawer, not a modal: the arena stays in view beside it (under it on a phone). *@
            <aside class="pt-drawer" id="pt-drawer" aria-label="Tournament">
                <div class="pt-drawer-head">
                    <div class="pt-tabs" role="tablist" aria-label="Tournament views">
                        @foreach (var t in DrawerTabs)
                        {
                            var tab = t;
                            <button type="button" role="tab" id="pt-tab-@tab" class="pt-tab"
                                    aria-selected="@(tab == _drawerTab ? "true" : "false")" aria-controls="pt-tabpanel"
                                    tabindex="@(tab == _drawerTab ? 0 : -1)"
                                    @onclick="() => _drawerTab = tab">@DrawerTabLabel(tab)</button>
                        }
                    </div>
                    <button type="button" class="pt-drawer-close" aria-label="Close the bracket" @onclick="ToggleBracket">✕</button>
                </div>
                @if (_lastDecided is { } last)
                {
                    <p class="pt-panel-news @(last.IsUpset ? "pt-panel-news--upset" : "")" role="status">
                        @if (last.IsUpset)
                        {
                            <span class="pt-upset-tag">UPSET!</span>
                        }
                        @ResultSentence(last, tagged: false)
                    </p>
                }
                <div class="pt-tabpanel" id="pt-tabpanel" role="tabpanel" aria-labelledby="pt-tab-@_drawerTab">
                    @if (_drawerTab == "next")
                    {
                        @NextBout
                    }
                    else
                    {
                        @Bracket
                    }
                </div>
                @* Cup titles live on Brawl HQ, with every other Brawl board. *@
                <a class="pt-hq-link" href="/pobrawl/hq">📊 Cup titles and every board on Brawl HQ</a>
            </aside>
        }
    </div>
</GameShell>

@code {
    private static readonly PoBrawlFighter[] Roster = [.. PoBrawlRoster.Fighters];
    private static readonly int[] Speeds = [1, 2, 4];

    // Between bouts the jumbotrons show the bracket for this long before the next pairing.
    // Fast-forward trims it only a little: the bracket is the part of a tournament worth reading.
    private int BetweenBoutsMs => _speed switch { 4 => 2600, 2 => 3400, _ => 4200 };
    // After the final, the arena holds this long before the result modal covers it.
    private const int FinalHoldMs = 3500;
    // …and before that the arena crowns the champion (PoBrawl.ceremony): the belt comes
    // down, three confetti volleys, the flashbulbs.
    private const int CeremonyMs = 6500;

    private string _playerName = "";
    private PoBrawlTournament? _cup;
    private IReadOnlyDictionary<string, int> _ratings = new Dictionary<string, int>();
    // The draw is rebuilt from this seed when the board's ratings arrive, so the same eight
    // fighters keep their places and only the numbers change.
    private int _drawSeed = Random.Shared.Next();
    private bool _ratingsLoaded;
    private bool _report = true;
    private int _speed = 1;
    // The camera starts where the settings sheet's "Brawl show" row says: Full = Broadcast, Simple = Ringside.
    private bool _director;
    private bool _isoCam;

    private bool _introDone;
    private bool _bracketOpen;
    private bool _bracketFresh;   // a result landed since the drawer was last opened
    private bool _showFinal;
    private string _p1Char = "";
    private string _p2Char = "";
    private PoBrawlTournament.Bout? _lastDecided;
    // The bout whose result the bracket animates on its next opening (the winner's line
    // burns forward, the Elo rolls, the loser cracks); -1 once the next bout is under way.
    private int _freshIndex = -1;
    private string _announcement = "";
    private PoBrawlHud? _hud;
    private DotNetObjectReference<PoBrawlTournamentPage>? _ref;
    // Bumped on dispose and on every new bout, so a pending between-bouts roll can tell it is stale.
    private int _generation;

    // Tournament titles per fighter, kept in this browser across tournaments: "titles" in the
    // standings (Brawl HQ lists them all).
    private Dictionary<string, int> _titles = [];

    private static RenderFragment TitleContent => @<span><span aria-hidden="true">🥊</span> Brawl Cup</span>;

    private static string Name(string? id) => id is null ? "TBD" : PoBrawlRoster.NameOf(id) ?? id;

    private string HudName(string id) => _cup is null || string.IsNullOrEmpty(id) ? Name(id) : $"{Name(id)} · {_cup.EloOf(id)}";

    // ── Under the HUD clock: the round and one pip per bout ──
    private RenderFragment? BoutChip => _cup?.Current is { } now
        ? @<span class="pb-chip" role="img" aria-label="@now.Label — bout @(now.Index + 1) of @_cup.Bouts.Count">
            <b>@RoundShort(now.Round)</b>
            <span class="pb-chip-pips">
                @foreach (var b in _cup.Bouts)
                {
                    <span class="pb-chip-pip @(b.WinnerId is not null ? "pb-chip-pip--done" : b == now ? "pb-chip-pip--now" : "")"></span>
                }
            </span>
            <span>@(now.Index + 1)/@_cup.Bouts.Count</span>
        </span>
        : null;

    private static string RoundShort(PoBrawlTournament.Round round) => round switch
    {
        PoBrawlTournament.Round.Quarterfinal => "QF",
        PoBrawlTournament.Round.Semifinal => "SF",
        _ => "Final",
    };

    // ── Camera: one button through the director's set-ups (director.js + its iso PiP) ──
    // Broadcast = the director cutting angles with the picture-in-picture close-up; Director =
    // the cuts alone; Ringside = the fixed side view.
    private string CameraName => _director ? (_isoCam ? "Broadcast" : "Director") : "Ringside";
    private string NextCameraName => _director ? (_isoCam ? "Director" : "Ringside") : "Broadcast";
    private string CameraHint => _director
        ? _isoCam ? "TV cuts with a picture-in-picture close-up (the close-up needs medium or high graphics)" : "TV cuts between camera angles"
        : "The fixed ringside view";

    private async Task CycleCameraAsync()
    {
        (_director, _isoCam) = (_director, _isoCam) switch
        {
            (true, true) => (true, false),
            (true, false) => (false, false),
            _ => (true, true),
        };
        try
        {
            await JSRuntime.InvokeVoidAsync("PoBrawl.setDirector", _director);
            await JSRuntime.InvokeVoidAsync("PoBrawl.setIsoCam", _isoCam);
        }
        catch { }
    }

    // ── The drawer's tabs ──
    private static readonly string[] DrawerTabs = ["bracket", "next"];
    private string _drawerTab = "bracket";

    private static string DrawerTabLabel(string tab) => tab == "next" ? "Next bout" : "Bracket";

    private RenderFragment NextBout => @<div class="pt-next">
        @if (_cup?.Current is { } next)
        {
            <p class="pt-panel-next"><b>@Name(next.P1Id)</b> vs <b>@Name(next.P2Id)</b> — @next.Label</p>
            @if (next.P1Id is not null && next.P2Id is not null)
            {
                <div class="pt-dossiers">
                    <PoBrawlDossierCard FighterId="@next.P1Id" Compact="true" />
                    <PoBrawlDossierCard FighterId="@next.P2Id" Compact="true" />
                </div>
            }
        }
        else
        {
            <p class="pt-panel-next">The belt has a new owner: <b>@Name(_cup?.ChampionId)</b>.</p>
        }
    </div>;

    private static RenderFragment HowItWorks => @<ul>
        <li>🎲 Eight of the fifteen presidents in a random bracket, three 60-second CPU rounds a bout</li>
        <li>📈 Every result moves both fighters' Elo · ⏩ 2×/4× and 🗂 Bracket on the arena's bar</li>
    </ul>;

    private RenderFragment DrawPreview => @<div class="pt-draw">
        <div class="pt-draw-head">
            <span class="pt-draw-title">The draw</span>
        </div>
        @if (_cup is not null)
        {
            <ol class="pt-draw-list" aria-label="Quarterfinal pairings">
                @foreach (var b in _cup.Bouts.Where(b => b.Round == PoBrawlTournament.Round.Quarterfinal))
                {
                    <li>
                        <span class="pt-draw-who">@Name(b.P1Id) <small>@_cup.EloOf(b.P1Id!)</small></span>
                        <span class="pt-draw-vs" aria-label="versus">vs</span>
                        <span class="pt-draw-who">@Name(b.P2Id) <small>@_cup.EloOf(b.P2Id!)</small></span>
                    </li>
                }
            </ol>
            <p class="pt-draw-note">@(_ratingsLoaded ? "Starting Elo from the global Brawl fighter board." : "Loading ratings from the fighter board…")</p>
        }
        @* The speed lives on the arena's bar alone. Reporting needs a signed-in visitor (the
           POST is authorised), so a signed-out one is not offered a box that does nothing. *@
        @if (Auth.IsAuthenticated)
        {
            <label class="pt-draw-report">
                <input type="checkbox" @bind="_report" />
                <span>Report each bout to the global fighter Elo board</span>
            </label>
        }
    </div>;

    // The board: quarterfinals, semifinals, final and the belt in four columns on a fixed
    // grid (every row the same height), joined by SVG wires drawn to that grid's rem
    // geometry. Each bout lists its corners with the Elo they carry now and what this bout
    // moved it by. The bout just decided (_freshIndex) plays its result in: the loser's
    // card cracks, the winner's wire burns forward to the next round with a spark riding
    // it, the Elo rolls like an odometer and the winner's name lands in its new slot. Base
    // styles are the end state, so reduced motion simply shows the result.
    // Under 640 px the board stacks into one column and the wires go.
    private RenderFragment Bracket => @<div class="pt-bracket">
        <h3 class="pt-col-head" style="grid-column:1">Quarterfinals</h3>
        @for (var i = 0; i < 4; i++)
        {
            @Slot(_cup!.Bouts[i], 1, i + 2, 1)
        }
        @Wires(2, 2, 2, 0, 1)
        @Wires(2, 4, 2, 2, 3)
        <h3 class="pt-col-head" style="grid-column:3">Semifinals</h3>
        @Slot(_cup!.Bouts[4], 3, 2, 2)
        @Slot(_cup!.Bouts[5], 3, 4, 2)
        @Wires(4, 2, 4, 4, 5)
        <h3 class="pt-col-head" style="grid-column:5">Final</h3>
        @Slot(_cup!.Bouts[6], 5, 2, 4)
        @Wires(6, 2, 4, 6, -1)
        <h3 class="pt-col-head" style="grid-column:7">Champion</h3>
        <div class="pt-slot" style="grid-column:7;grid-row:2 / span 4">
            @if (_cup!.ChampionId is { } champ)
            {
                <div class="pt-champ @(_freshIndex == 6 ? "pt-champ--fresh" : "")"><span aria-hidden="true">🏆</span> @Name(champ)</div>
            }
            else
            {
                <div class="pt-champ pt-champ--tbd"><span aria-hidden="true">🏆</span> ?</div>
            }
        </div>
    </div>;

    private RenderFragment Slot(PoBrawlTournament.Bout b, int column, int row, int span) => @<div class="pt-slot" style="@($"grid-column:{column};grid-row:{row} / span {span}")">
        <div class="pt-bout @(b == _cup!.Current ? "pt-bout--now" : "") @(b.WinnerId is not null ? "pt-bout--done" : "")">
            @Corner(b, b.P1Id, b.P1Delta)
            @Corner(b, b.P2Id, b.P2Delta)
            @if (b.WinnerId is not null)
            {
                <div class="pt-bout-how">@(b.IsUpset ? "Upset · " : "")@(b.Knockout ? $"KO {b.ElapsedSeconds:0}s" : "Decision")</div>
            }
        </div>
    </div>;

    private RenderFragment Corner(PoBrawlTournament.Bout b, string? id, int delta)
    {
        var fresh = b.Index == _freshIndex;
        // The fresh winner landing in their next-round slot.
        var arrive = id is not null && b.WinnerId is null && _freshIndex >= 0 && _cup!.Bouts[_freshIndex].WinnerId == id;
        var state = id is not null && b.WinnerId == id ? "pt-corner--win" : id is not null && b.LoserId == id ? "pt-corner--out" : "";
        return @<div class="pt-corner @state @(fresh ? "pt-corner--fresh" : "") @(arrive ? "pt-corner--arrive" : "")">
            <span class="pt-corner-name">@Name(id)</span>
            @if (id is not null)
            {
                <span class="pt-corner-elo">
                    @if (fresh && b.WinnerId is not null)
                    {
                        @Odometer(_cup!.EloOf(id) - delta, _cup.EloOf(id))
                    }
                    else
                    {
                        @_cup!.EloOf(id)
                    }
                </span>
                @if (b.WinnerId is not null)
                {
                    <span class="pt-delta @(delta >= 0 ? "pt-delta--up" : "pt-delta--down")">@(delta >= 0 ? "+" : "")@delta</span>
                }
            }
        </div>;
    }

    // An Elo number rolling from `from` to `to`: one digit wheel per place, each turning the
    // short way in the direction of the change (up through 7, 8, 9, 0 for a gain; down for
    // a loss). The wheels' end position is their resting style; the roll is a CSS animation.
    private static RenderFragment Odometer(int from, int to) => @<span class="pt-odo pt-odo--roll">
        <span class="pt-visually-hidden">@to</span>
        @foreach (var (strip, fromEm, toEm) in OdometerWheels(from, to))
        {
            <span class="pt-odo-d" aria-hidden="true">
                <span class="pt-odo-strip" style="@($"--from:{fromEm}em;--to:{toEm}em")">
                    @foreach (var ch in strip)
                    {
                        <span>@ch</span>
                    }
                </span>
            </span>
        }
    </span>;

    /// <summary>
    /// Per digit place: the wheel's digits top to bottom, and its start / end offsets in
    /// line heights (1.2 em each). Places that do not change get a one-digit wheel.
    /// </summary>
    internal static IEnumerable<(string[] Strip, string FromEm, string ToEm)> OdometerWheels(int from, int to)
    {
        var up = to >= from;
        var a = from.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var b = to.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var len = Math.Max(a.Length, b.Length);
        a = a.PadLeft(len);
        b = b.PadLeft(len);
        for (var i = 0; i < len; i++)
        {
            var digits = new List<string> { a[i].ToString() };
            if (a[i] != b[i])
            {
                if (char.IsDigit(a[i]) && char.IsDigit(b[i]))
                {
                    var d = a[i] - '0';
                    while (d != b[i] - '0')
                    {
                        d = (d + (up ? 1 : 9)) % 10;
                        digits.Add(d.ToString(System.Globalization.CultureInfo.InvariantCulture));
                    }
                }
                else
                {
                    digits.Add(b[i].ToString());   // a place appearing or vanishing (999 → 1003)
                }
            }
            var far = (-(digits.Count - 1) * 1.2).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            // Up: the wheel reads old → new downward and scrolls up. Down: it reads new → old
            // and scrolls down, so the new digit drops in from above.
            if (up) yield return ([.. digits], "0", far);
            else
            {
                digits.Reverse();
                yield return ([.. digits], far, "0");
            }
        }
    }

    // The wires out of one or two feeder bouts into the next slot, in 0.1 rem units: a row
    // is 4.8 rem, the row gap 0.5, a wire column 1.6 wide (see .pt-bracket in the CSS —
    // change both together). `bottom` -1 is the single straight wire, final → belt.
    private RenderFragment Wires(int column, int row, int span, int top, int bottom)
    {
        var height = span * 48 + (span - 1) * 5;
        var mid = height / 2.0;
        var quarter = span == 2 ? 24.0 : 50.5;
        string Path(double y) => bottom < 0 ? Fmt($"M0 {mid} H16") : Fmt($"M0 {y} H8 V{mid} H16");
        (int Bout, double Y)[] feeders = bottom < 0 ? [(top, mid)] : [(top, quarter), (bottom, height - quarter)];
        return @<div class="pt-wire-cell" style="@($"grid-column:{column};grid-row:{row} / span {span}")" aria-hidden="true">
            <svg class="pt-wire" viewBox="@($"0 0 16 {height}")" preserveAspectRatio="none" focusable="false">
                @foreach (var f in feeders)
                {
                    <path class="pt-wire-base" d="@Path(f.Y)" />
                }
                @foreach (var f in feeders.Where(f => _cup!.Bouts[f.Bout].WinnerId is not null))
                {
                    var fresh = f.Bout == _freshIndex;
                    <path class="pt-wire-lit @(fresh ? "pt-wire-lit--fresh" : "")" d="@Path(f.Y)" pathLength="1" />
                    @if (fresh)
                    {
                        @* SMIL rides the path itself, so the spark stays on the wire at any size. Hidden
                           until it sets off and after it lands; CSS drops it under reduced motion. *@
                        <circle class="pt-spark" r="2.4" opacity="0">
                            <animateMotion dur="1.1s" begin="0.35s" fill="freeze" path="@Path(f.Y)" />
                            <animate attributeName="opacity" values="1;1;0" keyTimes="0;0.85;1" begin="0.35s" dur="1.1s" fill="freeze" />
                        </circle>
                    }
                }
            </svg>
        </div>;
    }

    private static string Fmt(FormattableString s) => s.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private RenderFragment FinalSummary => @<div>
        @if (_cup?.ChampionId is { } champ)
        {
            <section class="pb-ending" aria-label="Tournament champion">
                <div class="pb-ending-seal" aria-hidden="true">🏆</div>
                <h3 class="pb-ending-title">@Name(champ) wins the belt</h3>
                <p class="pb-ending-line">Three bouts, three wins. @Name(champ) leaves at @_cup.EloOf(champ) Elo (@Signed(_cup.EloOf(champ) - _cup.StartEloOf(champ))).</p>
            </section>
            <table class="pb-recap pt-standings">
                <caption>Elo after the tournament</caption>
                <thead>
                    <tr>
                        <th scope="col" class="pb-recap-stat">Fighter</th>
                        <th scope="col">W–L</th>
                        <th scope="col">Elo</th>
                        <th scope="col">±</th>
                        <th scope="col" title="Tournaments won in this browser">Titles</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in _cup.Standings)
                    {
                        var (w, l) = _cup.RecordOf(f.Id);
                        var d = _cup.EloOf(f.Id) - _cup.StartEloOf(f.Id);
                        <tr>
                            <th scope="row">@(f.Id == champ ? "🏆 " : "")@f.Name</th>
                            <td>@w–@l</td>
                            <td>@_cup.EloOf(f.Id)</td>
                            <td class="@(d >= 0 ? "pt-delta--up" : "pt-delta--down")">@Signed(d)</td>
                            <td>@(_titles.TryGetValue(f.Id, out var t) ? t : 0)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="pt-final-note">@(_report && Auth.IsAuthenticated ? "All seven bouts were reported to the global fighter Elo board." : "These bouts were not reported to the global board.")</p>
        }
    </div>;

    private static string Signed(int n) => n >= 0 ? $"+{n}" : n.ToString();

    // "UPSET! Carter beats Reagan by KO in 19 seconds as a 31% underdog and advances (Elo +17)."
    // `tagged` false leaves the "UPSET!" to the bracket's own stamp.
    private string ResultSentence(PoBrawlTournament.Bout b, bool tagged = true)
    {
        var winner = Name(b.WinnerId);
        var loser = Name(b.LoserId);
        var gain = b.WinnerId == b.P1Id ? b.P1Delta : b.P2Delta;
        var how = b.Knockout ? $"by KO in {b.ElapsedSeconds:0} seconds" : "on the cards";
        var odds = b.IsUpset ? $" as a {Math.Round(100 * (b.WinnerId == b.P1Id ? b.P1Expected : 1 - b.P1Expected)):0}% underdog" : "";
        var then = b.Round == PoBrawlTournament.Round.Final ? "takes the belt" : "advances";
        return $"{(tagged && b.IsUpset ? "UPSET! " : "")}{winner} beats {loser} {how}{odds} and {then} (Elo {Signed(gain)}).";
    }

    // The board for the arena's jumbotrons (PoBrawl.jumbotronBracket): plain names and who won,
    // in play order. Short names: the screens are 256 px wide.
    private object JumbotronData() => new
    {
        bouts = _cup!.Bouts.Select(b => new
        {
            p1 = b.P1Id is null ? null : Name(b.P1Id),
            p2 = b.P2Id is null ? null : Name(b.P2Id),
            w = b.WinnerId is null ? 0 : b.WinnerId == b.P1Id ? 1 : 2,
        }).ToArray(),
        fresh = _freshIndex,
        next = _cup.Current?.Index ?? -1,
        champ = _cup.ChampionId is { } c ? Name(c) : null,
        title = _cup.Current is { } n ? $"Next: {n.Label}" : "Champion",
    };

    private async Task ShowJumbotronBracketAsync()
    {
        try { await JSRuntime.InvokeVoidAsync("PoBrawl.jumbotronBracket", JumbotronData()); }
        catch (Exception ex) { Console.Error.WriteLine($"[pobrawl-cup] jumbotron bracket failed: {ex.Message}"); }
    }

    // Per-bout engine options: the round sets the arena's time of day and crowd, the left
    // corner's Elo expectation the crowd's upset storyline (PoBrawl.matchup's 5th argument).
    private object BoutOptions(PoBrawlTournament.Bout b) => new { round = (int)b.Round, p1Expected = _cup!.ExpectedP1(b) };

    protected override void OnInitialized()
    {
        // The old address: one Cup URL, so links and history converge on /pobrawl/demo.
        var uri = new Uri(Nav.Uri);
        if (uri.AbsolutePath.TrimEnd('/').EndsWith("/tournament", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/pobrawl/demo" + uri.Query, replace: true);
        }
        // Under ?autoGuest=1 the guest session can settle after first render: the report
        // box appears with it.
        Auth.StateChanged += OnAuthChanged;
        _playerName = PlayerNameService.GetPlayerName();
        _titles = PoBrawlProgressBook.LoadTitles();
        _director = _isoCam = PoBrawlShowPrefs.IsFull;
        _cup = PoBrawlTournament.Draw(Roster, new Random(_drawSeed), _ratings);
        // Brawl's slot on the "Watch all demos" reel.
        Kiosk.SetCurrent("pobrawl-demo");
    }

    protected override async Task OnInitializedAsync()
    {
        // Starting ratings from the global fighter board (anonymous read). Offline or empty, every
        // fighter simply starts at the seed rating.
        var board = await ApiService.GetGameLeaderboardAsync("pobrawldemo", PoBrawlRoster.Count);
        var ratings = new Dictionary<string, int>();
        foreach (var e in board?.Entries ?? [])
        {
            // The board carries display names (resolved server-side from the roster), not ids.
            if (Roster.FirstOrDefault(f => f.Name == e.Name) is { } f && e.Value > 0) ratings[f.Id] = (int)Math.Round(e.Value);
        }
        _ratings = ratings;
        _ratingsLoaded = true;
        if (!_introDone) _cup = PoBrawlTournament.Draw(Roster, new Random(_drawSeed), _ratings);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _ref = DotNetObjectReference.Create(this);
    }

    private async Task StartAsync()
    {
        if (_introDone || _cup?.Current is not { } first) return;
        _introDone = true;
        _p1Char = first.P1Id!;
        _p2Char = first.P2Id!;
        _announcement = $"Tournament on. {first.Label}: {Name(_p1Char)} versus {Name(_p2Char)}.";
        StateHasChanged();
        // DisposeAsync bumps _generation; a player who leaves while the engine is still
        // downloading must not have it initialised against a disposed reference.
        var generation = _generation;
        try
        {
            if (!await JSRuntime.InvokeAsync<bool>("loadEngine", "pobrawl"))
            {
                Console.Error.WriteLine("[pobrawl-cup] engine failed to load");
                return;
            }
            if (generation != _generation) return;
            _ref ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("PoBrawl.init", "pobrawl-container", _ref, new
            {
                mode = "tournament",
                p1Character = _p1Char,
                p2Character = _p2Char,
                // Both corners on the same mid-tier CPU, so the presidents' own patterns decide it.
                difficulty = "medium",
                roundLabel = first.Label.ToUpperInvariant(),
                introLine = PoBrawlPressLines.Intro(_p1Char, _p2Char)?.Text,
                round = (int)first.Round,
                p1Expected = _cup.ExpectedP1(first),
            });
            if (generation != _generation)
            {
                try { await JSRuntime.InvokeVoidAsync("PoBrawl.destroy"); } catch { }
                return;
            }
            await JSRuntime.InvokeVoidAsync("PoBrawl.setSpeed", _speed);
            await JSRuntime.InvokeVoidAsync("PoBrawl.setDirector", _director);
            await JSRuntime.InvokeVoidAsync("PoBrawl.setIsoCam", _isoCam);
            if (Settings.Muted) await JSRuntime.InvokeVoidAsync("PoBrawl.setMuted", true);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[pobrawl-cup] JS init failed: {ex.Message}");
        }
    }

    private async Task SetSpeedAsync(int speed)
    {
        _speed = speed;
        try { await JSRuntime.InvokeVoidAsync("PoBrawl.setSpeed", speed); } catch { }
    }

    private void ToggleBracket()
    {
        _bracketOpen = !_bracketOpen;
        if (_bracketOpen) _bracketFresh = false;
    }

    private void OnAuthChanged() => _ = InvokeAsync(StateHasChanged);

    // ── Engine callbacks (the same contract PoBrawlPage implements) ─────────

    /// <summary>HUD pump — exact arity contract with game.js _pushHud (see PoBrawlPage.OnHud).</summary>
    [JSInvokable]
    public void OnHud(int p1Hp, int p2Hp, double elapsed, int[]? p1Regions, int[]? p2Regions, int p1Energy, int p2Energy) =>
        _hud?.Update(p1Hp, p2Hp, elapsed, p1Regions, p2Regions, p1Energy, p2Energy);

    [JSInvokable]
    public void OnMatchStart(string p1Char, string p2Char)
    {
        if (!string.IsNullOrEmpty(p1Char)) _p1Char = p1Char;
        if (!string.IsNullOrEmpty(p2Char)) _p2Char = p2Char;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>No training room here; the engine still reports it on every spawn.</summary>
    [JSInvokable]
    public void OnTrainingState(bool active) { }

    /// <param name="winner">1 = left corner, 2 = right; tournament mode never reports a draw.</param>
    [JSInvokable]
    public async Task OnMatchEnd(int winner, double elapsedSeconds, PoBrawlPage.PoBrawlMatchRecap? recap = null)
    {
        if (_cup?.Current is not { } bout || bout.P1Id is null || bout.P2Id is null) return;
        // Belt and braces: an older cached engine without the tournament decision could still say 0.
        if (winner is not (1 or 2)) winner = recap is { } r && r.P2Hits > r.P1Hits ? 2 : 1;
        var decided = _cup.RecordResult(winner, elapsedSeconds, knockout: elapsedSeconds < 59.9);
        _lastDecided = decided;
        _freshIndex = decided.Index;
        _announcement = ResultSentence(decided);

        if (_report && Auth.IsAuthenticated)
        {
            _ = ApiService.SubmitPoBrawlDemoResultAsync(new PoBrawlDemoResultRequest(decided.WinnerId!, decided.LoserId!, IsDraw: false));
        }

        var generation = ++_generation;
        await InvokeAsync(StateHasChanged);

        // OnMatchEnd fires once the engine is in 'result' (the KO cinematic is over), so the
        // jumbotrons switch to the bracket straight away.
        // The arena's screens show the bracket (or, after the final, the champion). The drawer
        // stays as the viewer left it — opening it here covered most of the arena after every
        // bout; the Bracket button glows instead.
        await ShowJumbotronBracketAsync();
        _bracketFresh = true;
        if (_cup.IsComplete)
        {
            SaveTitle(_cup.ChampionId!);
            _announcement = $"{Name(_cup.ChampionId)} wins the tournament.";
            // The belt ceremony plays in the open arena first; then the modal.
            try { await JSRuntime.InvokeVoidAsync("PoBrawl.ceremony", _cup.ChampionId); }
            catch (Exception ex) { Console.Error.WriteLine($"[pobrawl-cup] ceremony failed: {ex.Message}"); }
            await InvokeAsync(StateHasChanged);
            await Task.Delay(CeremonyMs);
            if (generation != _generation) return;
            _showFinal = true;   // GameShell holds FinalHoldMs, then the modal
            await InvokeAsync(StateHasChanged);
            return;
        }
        await InvokeAsync(StateHasChanged);

        await Task.Delay(BetweenBoutsMs);
        if (generation != _generation || _cup.Current is not { } next) return;

        _freshIndex = -1;
        _p1Char = next.P1Id!;
        _p2Char = next.P2Id!;
        _hud?.Reset();
        _announcement = $"{next.Label}: {Name(_p1Char)} versus {Name(_p2Char)}.";
        await InvokeAsync(StateHasChanged);
        try
        {
            await JSRuntime.InvokeVoidAsync("PoBrawl.matchup", _p1Char, _p2Char, next.Label.ToUpperInvariant(),
                PoBrawlPressLines.Intro(_p1Char, _p2Char)?.Text, BoutOptions(next));
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[pobrawl-cup] next bout failed: {ex.Message}");
        }
    }

    private void SaveTitle(string championId) => _titles = PoBrawlProgressBook.RecordTitle(championId);

    public async ValueTask DisposeAsync()
    {
        ++_generation;
        Auth.StateChanged -= OnAuthChanged;
        try { await JSRuntime.InvokeVoidAsync("PoBrawl.destroy"); } catch { }
        _ref?.Dispose();
        _ref = null;
    }
}
