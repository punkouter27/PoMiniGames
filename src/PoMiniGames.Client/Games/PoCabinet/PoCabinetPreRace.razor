@*
    PoCabinetPreRace — the 1P start card's setup as one tabbed sheet: Track (the default: the
    track list, and the bedroom's room-scan choice when it is picked), Car (the paint shop) and
    Settings (the settings panel). It replaced the track list alone on the card, with the car and
    the settings one drawer away; the drawer (PoCabinetDrawer) is still how the pause card and
    the lobby reach them.

    Every control here is a tab, a radio or a switch, so OK stays the card's one action
    (LinkAuditUiTests), and the Settings tab leaves out the "App settings" button for the same
    reason. The Car and Settings panels scroll inside themselves, so the card never does.
*@

@using PoMiniGames.Shared.Games

<div class="pocabinet-prerace">
    <div class="pocabinet-prerace__tabs" role="tablist" aria-label="Race setup" @onkeydown="OnTabKey">
        @for (var i = 0; i < Tabs.Length; i++)
        {
            var idx = i;
            var (tab, label) = Tabs[idx];
            var selected = tab == _tab;
            <button type="button" role="tab" id="pocabinet-tab-@tab" @ref="_tabRefs[idx]"
                    class="pocabinet-prerace__tab"
                    aria-selected="@(selected ? "true" : "false")"
                    aria-controls="pocabinet-tabpanel-@tab"
                    tabindex="@(selected ? 0 : -1)"
                    @onclick="() => _tab = tab">@label</button>
        }
    </div>

    <div @key="_tab" class="pocabinet-prerace__panel pocabinet-prerace__panel--@_tab" role="tabpanel"
         id="pocabinet-tabpanel-@_tab" aria-labelledby="pocabinet-tab-@_tab">
        @switch (_tab)
        {
            case Tab.Track:
                <PoCabinetTrackSelector SelectedTrackId="@TrackId" SelectedTrackIdChanged="TrackIdChanged" Campaign="true" />
                @if (HasRoomScan(TrackId))
                {
                    @* The scanned room's own choice, beside the track it is for (the Settings tab has it too). *@
                    <div class="pocabinet-prerace__room" role="radiogroup" aria-label="Room scan">
                        <span>Room scan <small>Full is a 9.6 MB download; Lite is lighter on phones</small></span>
                        <span class="pocabinet-prerace__pills">
                            @foreach (var (value, text) in RoomOptions)
                            {
                                <label class="pocabinet-prerace__pill">
                                    <input type="radio" name="pocabinet-room-track" value="@value"
                                           checked="@(Settings.RoomDetail == value)" @onchange="() => SetRoomDetailAsync(value)" />
                                    <span>@text</span>
                                </label>
                            }
                        </span>
                    </div>
                }
                break;
            case Tab.Car:
                <section class="pocabinet-prerace__car" aria-label="Car colour">
                    <h3>Car colour <span class="pocabinet-muted">@Color</span></h3>
                    <PoCabinetPaintShop SelectedColor="@Color" SelectionChanged="PaintChanged" />
                    <p class="pocabinet-muted">A change applies from the next race.</p>
                </section>
                break;
            default:
                <PoCabinetSettingsPanel Value="Settings" ValueChanged="SettingsChanged" ShowAppSettings="false" />
                break;
        }
    </div>
</div>

@code {
    private enum Tab { Track, Car, Settings }

    private static readonly (Tab Tab, string Label)[] Tabs = [(Tab.Track, "Track"), (Tab.Car, "Car"), (Tab.Settings, "Settings")];
    private static readonly (string Value, string Text)[] RoomOptions = [("splat", "Full"), ("mesh", "Lite")];

    [Parameter] public string? TrackId { get; set; }
    [Parameter] public EventCallback<string> TrackIdChanged { get; set; }
    [Parameter] public PoCabinetUiSettings Settings { get; set; } = new();
    [Parameter] public EventCallback<PoCabinetUiSettings> SettingsChanged { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public EventCallback<string> PaintChanged { get; set; }

    private Tab _tab = Tab.Track;
    private readonly ElementReference[] _tabRefs = new ElementReference[Tabs.Length];
    /// <summary>An arrow key moved the selection: focus follows it after the render.</summary>
    private bool _focusTab;

    /// <summary>The tracks drawn from a room scan (scene.js loads its splat): the bedroom.</summary>
    public static bool HasRoomScan(string? trackId) =>
        string.Equals(trackId, "bedroom", StringComparison.OrdinalIgnoreCase);

    private async Task SetRoomDetailAsync(string value)
    {
        Settings.RoomDetail = value;
        if (SettingsChanged.HasDelegate) await SettingsChanged.InvokeAsync(Settings);
    }

    // The tab strip's arrow keys, Home and End (the WAI-ARIA tabs pattern).
    private void OnTabKey(KeyboardEventArgs e)
    {
        var i = Array.FindIndex(Tabs, t => t.Tab == _tab);
        var next = e.Key switch
        {
            "ArrowRight" => (i + 1) % Tabs.Length,
            "ArrowLeft" => (i - 1 + Tabs.Length) % Tabs.Length,
            "Home" => 0,
            "End" => Tabs.Length - 1,
            _ => i,
        };
        if (next == i) return;
        _tab = Tabs[next].Tab;
        _focusTab = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusTab) return;
        _focusTab = false;
        try { await _tabRefs[Array.FindIndex(Tabs, t => t.Tab == _tab)].FocusAsync(); }
        catch { /* the card closed under it */ }
    }
}
