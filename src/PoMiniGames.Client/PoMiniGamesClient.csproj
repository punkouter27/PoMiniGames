<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- TFM / Nullable / ImplicitUsings inherited from Directory.Build.props.
         Trimming. The app assembly is deliberately NOT IsTrimmable: Blazor's Router finds
         every @page component by reflecting over it, so trimming it removes every page
         nobody references statically and each route falls through to NotFound. Untrimmed,
         it ships whole (no TrimmerRoots descriptor needed); framework and library
         assemblies, and the IsTrimmable Shared/Domain projects, are still trimmed.
         EnableTrimAnalyzer still flags trim-unsafe code here. All HttpClient JSON call
         sites go through ApiJsonContext (source-generated). The only suppressions are
         IL2110/IL2111, scoped to App.razor's generated LayoutView/Router dispatch. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <PropertyGroup>
    <WasmEnableWebcilProtectedResources>false</WasmEnableWebcilProtectedResources>
    <StaticWebAssetsFingerprintingEnabled>false</StaticWebAssetsFingerprintingEnabled>
    <!-- PWA offline support. Generates service-worker-assets.js (the asset list +
         integrity hashes the published worker precaches) and swaps the no-op
         wwwroot/service-worker.js for service-worker.published.js on publish only.
         Offline behaviour therefore CANNOT be observed under `dotnet run` — verify
         against published output. -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js"
                   PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <!-- Typed localStorage (Blazored). Prefer the *AsString* members: the generic
         overloads serialise through reflection-based System.Text.Json, which the trim
         analyzer flags (IL2026) and the trimmer may break. -->
    <PackageReference Include="Blazored.LocalStorage" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <!-- One CSS scope for both Brawl pages: the tournament hosts the same engine, whose DOM
         (splash, banner, captions, news desk) is styled by PoBrawlPage.razor.css through ::deep
         under .pb-canvas-host. A shared scope id applies those rules to both components. -->
    <None Update="Games\PoBrawl\PoBrawlPage.razor.css" CssScope="b-pobrawl-arena" />
    <None Update="Games\PoBrawl\PoBrawlTournamentPage.razor.css" CssScope="b-pobrawl-arena" />
    <!-- The fighter grid and the online lobby reuse the 2P select's glass tiles and side cards. -->
    <None Update="Games\PoBrawl\PoBrawlFighterGrid.razor.css" CssScope="b-pobrawl-arena" />
    <None Update="Games\PoBrawl\PoBrawlOnlineLobbyPage.razor.css" CssScope="b-pobrawl-arena" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoMiniGames.Shared\PoMiniGames.Shared.csproj" />
    <!-- Domain models only: the board rows the leaderboard endpoints return are
         deserialized straight into PoMiniGames.Domain.Models types rather than mirrored
         here. -->
    <ProjectReference Include="..\PoMiniGames.Domain\PoMiniGames.Domain.csproj" />
  </ItemGroup>

  <!-- Build-date stamp. The YYMMDD (UTC) of the build is written into a generated
       constant, PoMiniGamesClient.BuildInfo.Date, which MainLayout shows in its corner.
       A constant, not an assembly attribute, so reading it needs no reflection under
       trimming. Pass -p:PoBuildDate=YYMMDD to pin it. The file is only rewritten when
       the date changes, so an unchanged day stays an incremental build. -->
  <PropertyGroup>
    <PoBuildDate Condition="'$(PoBuildDate)' == ''">$([System.DateTime]::UtcNow.ToString("yyMMdd"))</PoBuildDate>
  </PropertyGroup>

  <Target Name="PoWriteBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_PoBuildInfoFile>$(IntermediateOutputPath)PoBuildInfo.g.cs</_PoBuildInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_PoBuildInfoFile)"
                      Lines="// &lt;auto-generated /&gt;;namespace PoMiniGamesClient%3B;internal static class BuildInfo;{;    public const string Date = &quot;$(PoBuildDate)&quot;%3B;}"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_PoBuildInfoFile)" />
      <FileWrites Include="$(_PoBuildInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
