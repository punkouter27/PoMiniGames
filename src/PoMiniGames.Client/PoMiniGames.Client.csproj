<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- TFM / Nullable / ImplicitUsings inherited from Directory.Build.props.
         Trimming. The app assembly is deliberately NOT IsTrimmable: Blazor's Router finds
         every @page component by reflecting over it, so trimming it removes every page
         nobody references statically and each route falls through to NotFound. Untrimmed,
         it ships whole (no TrimmerRoots descriptor needed); framework and library
         assemblies, and the IsTrimmable Shared/Domain projects, are still trimmed.
         EnableTrimAnalyzer still flags trim-unsafe code here. All HttpClient JSON call
         sites go through ApiJsonContext (source-generated). The only suppressions are
         IL2110/IL2111, scoped to App.razor's generated LayoutView/Router dispatch. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <RootNamespace>PoMiniGamesClient</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <WasmEnableWebcilProtectedResources>false</WasmEnableWebcilProtectedResources>
    <StaticWebAssetsFingerprintingEnabled>false</StaticWebAssetsFingerprintingEnabled>
    <!-- PWA offline support. Generates service-worker-assets.js (the asset list +
         integrity hashes the published worker precaches) and swaps the no-op
         wwwroot/service-worker.js for service-worker.published.js on publish only.
         Offline behaviour therefore CANNOT be observed under `dotnet run` — verify
         against published output. -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js"
                   PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!-- wwwroot is served verbatim, so anything left in it is publicly fetchable from the
       deployed app. The dev/test overrides are for `dotnet run` only: production reads
       appsettings.json plus appsettings.Production.json, and neither of these two should
       ever be reachable at https://<site>/appsettings.Development.json. -->
  <ItemGroup>
    <Content Update="wwwroot\appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot\appsettings.Test.json" CopyToPublishDirectory="Never" />
    <None Update="wwwroot\appsettings.Development.json" CopyToPublishDirectory="Never" />
    <None Update="wwwroot\appsettings.Test.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <!-- One CSS scope for both Brawl pages: the tournament hosts the same engine, whose DOM
         (splash, banner, captions, news desk) is styled by PoBrawlPage.razor.css through ::deep
         under .pb-canvas-host. A shared scope id applies those rules to both components. -->
    <None Update="Features\PoBrawl\PoBrawlPage.razor.css" CssScope="b-pobrawl-arena" />
    <None Update="Features\PoBrawl\PoBrawlTournamentPage.razor.css" CssScope="b-pobrawl-arena" />
    <None Update="Features\PoBrawl\PoBrawlFfaPage.razor.css" CssScope="b-pobrawl-arena" />
    <!-- The fighter grid and the online lobby reuse the 2P select's glass tiles and side cards. -->
    <None Update="Features\PoBrawl\PoBrawlFighterGrid.razor.css" CssScope="b-pobrawl-arena" />
    <None Update="Features\PoBrawl\PoBrawlOnlineLobbyPage.razor.css" CssScope="b-pobrawl-arena" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoMiniGames.Shared\PoMiniGames.Shared.csproj" />
    <!-- Domain models only: the board rows the leaderboard endpoints return are
         deserialized straight into PoMiniGames.Domain.Models types rather than mirrored
         here. -->
    <ProjectReference Include="..\PoMiniGames.Domain\PoMiniGames.Domain.csproj" />
  </ItemGroup>

  <!-- Build stamp. PoStamp (YYMMDD, the UTC date of the HEAD commit) comes from the
       PoBuildStamp target in Directory.Build.props and is written into a generated constant,
       PoMiniGamesClient.BuildInfo.Date, shown by Layout/BuildVersion.razor (.po-version).
       A constant, not an assembly attribute, so reading it needs no reflection under
       trimming. The file is only rewritten when the value changes. -->
  <Target Name="PoWriteBuildInfo" BeforeTargets="CoreCompile" DependsOnTargets="PoBuildStamp">
    <PropertyGroup>
      <_PoBuildInfoFile>$(IntermediateOutputPath)PoBuildInfo.g.cs</_PoBuildInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_PoBuildInfoFile)"
                      Lines="// &lt;auto-generated /&gt;;namespace PoMiniGamesClient%3B;internal static class BuildInfo;{;    public const string Date = &quot;$(PoStamp)&quot;%3B;}"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_PoBuildInfoFile)" />
      <FileWrites Include="$(_PoBuildInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
