@* Scoped trim suppression (was a project-wide NoWarn). The generated render code below sets
   LayoutView.Layout and Router.NotFoundPage, whose [DynamicallyAccessedMembers] setters the
   Razor generator dispatches by reflection. The layout and page types are app-assembly types,
   which the trimmer keeps (the app is not IsTrimmable), so nothing it needs can be removed. *@
@attribute [System.Diagnostics.CodeAnalysis.UnconditionalSuppressMessage("Trimming", "IL2110", Justification = "Razor-generated LayoutView/Router parameter dispatch; the layout and page types live in the untrimmed app assembly.")]
@attribute [System.Diagnostics.CodeAnalysis.UnconditionalSuppressMessage("Trimming", "IL2111", Justification = "Razor-generated LayoutView/Router parameter dispatch; the layout and page types live in the untrimmed app assembly.")]

<AppErrorBoundary>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            @* Has an h1 so `<FocusOnNavigate Selector="h1">` above has something to
               focus, and a link home so the page is not a dead end. *@
            <PageTitle>Page not found · PoMiniGames</PageTitle>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <NotFound />
            </LayoutView>
        </NotFound>
    </Router>
</AppErrorBoundary>
