@namespace PoMiniGamesClient.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Logging
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services.Ui
@implements IDisposable

@* ─────────────────────────────────────────────────────────────────────────
   GameIntro — the one centered welcome/controls card every game opens on.

   A blocking overlay rendered inside a game's GameShell ChildContent (or
   standalone for games that can't host GameShell). It welcomes the player,
   shows the controls and the game's setup, and gates the start of play by
   mode. Every mode has the one OK button:

     • Demo       → flashes for DemoDelayMs (default 2s), then auto-starts
                    (OK starts it at once).
     • OnePlayer  → stays up until the player presses OK (or Enter/Space).
     • TwoPlayer  → shows an optional Options slot (e.g. Brawl's per-player
                    keyboard character select) and an OK button that is
                    disabled until StartEnabled. Keydowns are forwarded to
                    the host via OnKey so each game wires its own two-player
                    selection to its in-game keys.

   Styling lives in wwwroot/css/game-shell.css (.gps-intro-*), mirroring the
   shared end-of-game modal so intro + outro read as one system.
   ───────────────────────────────────────────────────────────────────────── *@

@* This card sits between the player and every 1-player game, so dismissing it
   must not require aiming. Keyboard users have Enter/Space; Escape returns home.
   pointer users have the OK button plus tap-to-dismiss on the BACKDROP — the
   whole screen outside the card, a generous target. Card taps do not dismiss:
   the card carries interactive controls (PoBrawl's "Training first" checkbox,
   TwoPlayer's character select) and clicks bubble to the overlay's handler, so
   a tap meant to tick the box would start the game. The card therefore stops
   propagation in every mode. *@
@* Always shown: there is no opt-out. The one exception is the demo attract loop
   (?kiosk=N), which starts at once and renders nothing (_kiosk). *@
@* One structure for every game, so no card ever scrolls:
     header  – icon + title, one objective line;
     body    – the controls (with the longer rules behind a "How to play" tab when a game
               has them) and the game's setup (Options). Wide cards put the two side by side;
     footer  – exactly one button, OK, plus any setup toggles that belong beside it (Actions).
   The card is a flex column that never scrolls itself; the body is the only part that may,
   and every game's content is cut to fit so it does not (LinkAuditUiTests holds the line). *@
@if (!_kiosk)
{
<dialog class="gps-intro-overlay" aria-label="@(string.IsNullOrWhiteSpace(DialogLabel) ? "Game intro" : DialogLabel)"
     style="width:100%;height:100%;max-width:none;max-height:none;margin:0;border:0;box-sizing:border-box;color:inherit"
     @ref="_root"
     @onclick="HandleOverlayClick"
     @oncancel="CancelAsync"
     @onkeydown="HandleKey" @onkeydown:preventDefault="CaptureKeys">
    <div class="gps-intro-card gps-intro-card--@ModeClass @(Wide ? "gps-intro-card--wide" : null)"
        @ref="_focusRoot" tabindex="-1"
        @onclick:stopPropagation="true">
        <header class="gps-intro-head">
            @if (Title != null)
            {
                <div class="gps-intro-title">@Title</div>
            }

            @if (!string.IsNullOrWhiteSpace(Objective))
            {
                <p class="gps-intro-objective">@Objective</p>
            }
        </header>

        @if (Status != null)
        {
            @Status
        }

        @if (Controls != null || HowToPlay != null || Options != null || Lobby != null)
        {
            <div class="gps-intro-body">
                @if (Controls != null || HowToPlay != null)
                {
                    <section class="gps-intro-controls" aria-label="@(ShowingRules ? "How to play" : "Controls")">
                        @if (Controls != null && HowToPlay != null)
                        {
                            @* Two views of one panel, not two actions: a tab strip. Keydowns stop
                               so Enter on a tab switches it instead of starting the game. *@
                            <div class="gps-intro-tabs" role="tablist" aria-label="Intro" @onkeydown="HandleControlKey" @onkeydown:stopPropagation="true">
                                <button type="button" role="tab" class="gps-intro-tab"
                                        aria-selected="@(!ShowingRules ? "true" : "false")"
                                        @onclick="() => _rules = false">Controls</button>
                                <button type="button" role="tab" class="gps-intro-tab"
                                        aria-selected="@(ShowingRules ? "true" : "false")"
                                        @onclick="() => _rules = true">How to play</button>
                            </div>
                        }
                        else
                        {
                            <div class="gps-intro-section-label">@(Controls != null ? "Controls" : "How to play")</div>
                        }
                        <div class="gps-intro-panel">@(ShowingRules ? HowToPlay : Controls)</div>
                    </section>
                }

                @if (Options != null)
                {
                    @* Keydowns stop here so Space
                       on a checkbox in the options must tick it, not start the game. A select
                       driven by per-player keys (ForwardOptionKeys) lets them through to OnKey,
                       so its keys keep working once a tile inside it has focus. *@
                    <div class="gps-intro-options" @onkeydown="HandleControlKey" @onkeydown:stopPropagation="@(!ForwardOptionKeys)">@Options</div>
                }
                @if (Lobby != null)
                {
                    <div @onkeydown="HandleControlKey" @onkeydown:stopPropagation="true">@Lobby</div>
                }
            </div>
        }

        @if (ShowStart)
        {
        <footer class="gps-intro-actions">
            @if (Mode == IntroMode.Demo)
            {
                <div class="gps-intro-demo-hint" role="status">
                    <span class="gps-intro-spinner" aria-hidden="true"></span>
                    Demo starting…
                </div>
            }
            @if (Actions != null)
            {
                @* Setup toggles beside OK (Brawl's "Training first"). Keydowns stop so Space
                   on a checkbox ticks it. *@
                <div class="gps-intro-actions-extra" @onkeydown="HandleControlKey" @onkeydown:stopPropagation="true">@Actions</div>
            }
            @* The card's one button. 1P and demo: focused on open, so Enter and Space take it. *@
            <button type="button" class="app-btn app-btn--lg app-btn--primary" data-intro-action
                    @ref="_ok"
                    disabled="@(!StartEnabled)"
                    @onkeydown:stopPropagation="@(Mode != IntroMode.TwoPlayer)"
                    @onclick="StartAsync">OK</button>
            @* The one gesture every game shares, learned once: Tab opens the live
               stats panel (GameShell's GameDebugOverlay). Cascaded, so it disappears
               on the two pages that already bind Tab themselves. *@
            @if (TabStats)
            {
                <p class="gps-intro-hint"><kbd class="gps-kbd">Tab</kbd> shows live stats</p>
            }
            @if (!string.IsNullOrWhiteSpace(StartHint))
            {
                <p class="gps-intro-hint" role="status">@StartHint</p>
            }
        </footer>
        }
    </div>
</dialog>
}

@code {
    public enum IntroMode { Demo, OnePlayer, TwoPlayer }

    /// <summary>Card heading — normally the game's title fragment.</summary>
    [Parameter] public RenderFragment? Title { get; set; }

    /// <summary>One-line welcome / objective shown under the title.</summary>
    [Parameter] public string? Objective { get; set; }

    /// <summary>Controls: compact key chips, one or two lines (keys, touch or pad, by device).</summary>
    [Parameter] public RenderFragment? Controls { get; set; }

    /// <summary>
    /// The longer rules, for a game that has more to say than its controls. Shown behind a
    /// "How to play" tab beside Controls, so the default view stays short.
    /// </summary>
    [Parameter] public RenderFragment? HowToPlay { get; set; }

    /// <summary>A long setup (track picker, campaign rung): the card goes wide, info beside setup.</summary>
    [Parameter] public bool Wide { get; set; }

    /// <summary>Optional extra content for TwoPlayer mode (e.g. character select).</summary>
    [Parameter] public RenderFragment? Options { get; set; }

    /// <summary>Optional status above the body and lobby content within it.</summary>
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public RenderFragment? Lobby { get; set; }

    /// <summary>
    /// Setup toggles that sit in the footer beside OK (PoBrawl's "Training first"), so the
    /// start choice and OK read together. Inputs only: OK is the card's one button.
    /// </summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public IntroMode Mode { get; set; } = IntroMode.OnePlayer;

    /// <summary>Gates every way of starting, including demo and kiosk starts.</summary>
    [Parameter] public bool StartEnabled { get; set; } = true;

    /// <summary>Optional helper line under the OK button.</summary>
    [Parameter] public string? StartHint { get; set; }

    /// <summary>Hide start actions while a lobby owns the card.</summary>
    [Parameter] public bool ShowStart { get; set; } = true;

    /// <summary>Allow another start attempt when the host keeps the intro open.</summary>
    [Parameter] public bool RepeatableStart { get; set; }

    /// <summary>Whether the shared start cue should play before invoking the host.</summary>
    [Parameter] public bool PlayStartCue { get; set; } = true;

    /// <summary>How long the demo card flashes before auto-starting.</summary>
    [Parameter] public int DemoDelayMs { get; set; } = 2000;

    /// <summary>
    /// Optional accessible label for the modal dialog. Games can provide a
    /// mode-specific label (for example, "Brawl two-player setup") so screen-reader
    /// users get immediate context.
    /// </summary>
    [Parameter] public string? DialogLabel { get; set; }

    /// <summary>Forward keydowns to the host (TwoPlayer option selection).</summary>
    [Parameter] public bool CaptureKeys { get; set; }

    /// <summary>
    /// TwoPlayer only: keydowns inside <see cref="Options"/> still bubble to the card and
    /// reach <see cref="OnKey"/>. For a select whose options are the per-player keys' targets
    /// (PoBrawl), where a focused tile must not swallow the other player's keys.
    /// </summary>
    [Parameter] public bool ForwardOptionKeys { get; set; }

    /// <summary>Fired once when the intro is dismissed and play should begin.</summary>
    [Parameter] public EventCallback OnStart { get; set; }

    /// <summary>Raw keydowns while the intro is up (used by TwoPlayer selection).</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> OnKey { get; set; }

    /// <summary>
    /// Cue scope for the start sound — the game key ("tictactoe", "pobrawl", …).
    /// When set, the round opens in that game's own timbre; otherwise it falls
    /// back to the shared rising "ui/open". Every game passes through this
    /// component, so wiring the cue here is what makes the start sound universal
    /// instead of present only in the pages that inject the feedback service.
    /// </summary>
    [Parameter] public string? CueScope { get; set; }

    [Inject] private Services.Ui.UiFeedbackService Feedback { get; set; } = null!;

    /// <summary>
    /// True when the host GameShell answers Tab with the shared diagnostics panel.
    /// Cascaded by GameShell; false when this card is rendered outside one (or on a
    /// page that opts out), which is exactly when the hint must not appear.
    /// </summary>
    [CascadingParameter(Name = "TabStats")] private bool TabStats { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = null!;

    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private ILogger<GameIntro> Logger { get; set; } = null!;

    private ElementReference _root;
    private ElementReference _focusRoot;
    private ElementReference _ok;
    private bool _started;
    private bool _disposed;
    private bool _cancelled;
    private bool _demoElapsed;
    private bool _lastShowStart;

    // The "How to play" tab is showing instead of Controls.
    private bool _rules;
    private bool ShowingRules => (_rules && HowToPlay != null) || Controls == null;
    private Timer? _demoTimer;

    // The demo attract loop (?kiosk=N) starts at once and never shows the card.
    private bool _kiosk;

    protected override void OnInitialized()
    {
        // When the URL carries ?kiosk=N (the "Watch all demos" attract loop) we skip
        // the intro card entirely, otherwise the same dialog would flash back at the
        // viewer on every loop iteration. Every demo page reads the same kiosk query
        // param, so the dialog stays suppressed across the whole loop.
        // Only applies to Demo mode — OnePlayer / TwoPlayer always show the card.
        if (Mode == IntroMode.Demo &&
            new Uri(Navigation.Uri).Query.Contains("kiosk=", StringComparison.OrdinalIgnoreCase))
        {
            _kiosk = true;
            _demoElapsed = true;
        }
    }

    private string ModeClass => Mode switch
    {
        IntroMode.Demo => "demo",
        IntroMode.TwoPlayer => "twoplayer",
        _ => "oneplayer",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (!_kiosk && ShowStart != _lastShowStart)
            {
                _lastShowStart = ShowStart;
                try { await (ShowStart && StartEnabled ? _ok : _focusRoot).FocusAsync(); }
                catch { /* dialog already gone */ }
            }
            if (_demoElapsed && StartEnabled && !_started) await StartAsync();
            return;
        }

        if (_kiosk)
        {
            if (StartEnabled) await StartAsync();
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("PoDialogInterop.holdOpen", _root);
            await _root.ShowModalAsync(JS);
        }
        catch (Exception ex) when (!_disposed)
        {
            Logger.LogWarning(ex, "Could not open the game intro modal for {Game}.", CueScope);
            throw new InvalidOperationException("The game intro could not open safely.", ex);
        }
        catch (Exception)
        {
            // Torn down mid-open: nothing left to show.
            return;
        }

        _lastShowStart = ShowStart;
        // Best-effort, like the re-render path above: a page that starts on its own
        // (PoCapitol's demo) can drop this card between showModal and focus, and a
        // missing focus target must not take the whole game down with it.
        try { await (Mode == IntroMode.TwoPlayer || !StartEnabled || !ShowStart ? _focusRoot : _ok).FocusAsync(); }
        catch (Exception ex) { Logger.LogDebug(ex, "Intro focus skipped for {Game}; the card is already gone.", CueScope); }
        if (_disposed) return;

        // The title swarm (gpuFxWebGPU.js): particles fall into the heading's letters and
        // burst away when this card leaves the DOM, which the module watches for itself.
        // Not awaited (it waits on a GPU adapter), and a no-op without WebGPU, on the low
        // tier or under reduced motion.
        _ = SwarmAsync();

        if (Mode == IntroMode.Demo && _demoTimer is null)
        {
            _demoTimer = new Timer(async _ => await InvokeAsync(async () =>
            {
                _demoElapsed = true;
                await StartAsync();
            }),
                null, DemoDelayMs, Timeout.Infinite);
        }
    }

    private async Task SwarmAsync()
    {
        // fxBootstrap.js fetches the module after the page's own scripts; on a direct load
        // into a game this card can be up a moment before it. One retry covers that. Under
        // reduced motion the module is never loaded and both calls simply fail.
        for (var attempt = 0; attempt < 2; attempt++)
        {
            try
            {
                await JS.InvokeVoidAsync("PoGpuWebGPU.assemble", _root);
                return;
            }
            catch
            {
                await Task.Delay(600);
            }
        }
    }

    private async Task StartAsync()
    {
        if (_disposed || _cancelled || _started) return;
        if (!StartEnabled || !ShowStart) return;
        _started = true;
        _demoTimer?.Dispose();
        _demoTimer = null;

        // Demo starts on a timer, not a gesture. Playing a sound there would be
        // audio the player never asked for, and on mobile the AudioContext is
        // still locked anyway (no gesture has happened), so it would be a no-op
        // that only looks like it works on desktop.
        if (Mode != IntroMode.Demo && PlayStartCue)
        {
            await Feedback.GameStartAsync(CueScope);
        }

        try
        {
            if (OnStart.HasDelegate) await OnStart.InvokeAsync();
        }
        finally
        {
            if (RepeatableStart) _started = false;
        }
    }

    /// <summary>
    /// Tap-on-backdrop dismissal for the informational cards. The
    /// CARD stops propagation in every mode — it carries interactive controls
    /// in some games (TwoPlayer's character select, PoBrawl's Training-first
    /// checkbox) that a stray tap must not dismiss past — so the dismiss
    /// surface is the screen outside the card, plus Enter.
    /// </summary>
    private async Task HandleOverlayClick()
    {
        if (Mode == IntroMode.TwoPlayer) return;
        await StartAsync();
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CancelAsync();
            return;
        }

        if (Mode == IntroMode.TwoPlayer)
        {
            if (OnKey.HasDelegate) await OnKey.InvokeAsync(e);
            return;
        }

        // 1P: keyboard players can dismiss without reaching for the mouse.
        if (e.Key is "Enter" or " " or "Spacebar")
        {
            await StartAsync();
        }
    }

    private Task HandleControlKey(KeyboardEventArgs e) =>
        e.Key == "Escape" ? CancelAsync() : Task.CompletedTask;

    private async Task CancelAsync()
    {
        if (_disposed || _cancelled) return;
        _cancelled = true;
        _demoTimer?.Dispose();
        _demoTimer = null;
        await _root.CloseAsync(JS);
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        _disposed = true;
        _demoTimer?.Dispose();
        _demoTimer = null;
    }
}
