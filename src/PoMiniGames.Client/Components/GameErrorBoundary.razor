@namespace PoMiniGamesClient.Components
@using Microsoft.Extensions.Logging
@inject ILogger<GameErrorBoundary> Logger

@*
    The per-game error boundary. GameShell wraps a game's ChildContent in it, so a crash
    in anything rendered there (the board, an engine host, the intro card) is caught at
    the game area: the top bar, the title and the swipe-back stay put, and a small Retry
    box takes the place of the game. Retry calls Recover(), which drops the broken
    components and renders the game's content again from new instances.

    It catches what renders INSIDE the shell. An exception thrown by the page component
    itself (its own lifecycle or handlers) is outside it and still reaches the app-wide
    AppErrorBoundary in App.razor.
*@

<ErrorBoundary @ref="_boundary">
    <ChildContent>@ChildContent</ChildContent>
    <ErrorContent Context="ex">
        @{ Log(ex); }
        <div class="game-error" role="alert">
            <div class="game-error__icon" aria-hidden="true">⚠️</div>
            <h2 class="game-error__title">This game hit a snag</h2>
            <p class="game-error__body">
                Something went wrong while it was running. Your scores and stats are safe.
            </p>
            <div class="game-error__actions">
                <button type="button" class="app-btn app-btn--primary" @onclick="Retry">Retry</button>
                <a class="app-btn app-btn--ghost" href="/">All games</a>
            </div>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ErrorBoundary? _boundary;
    private Exception? _logged;

    // ErrorContent re-renders while the box is up; log each exception once.
    private void Log(Exception ex)
    {
        if (ReferenceEquals(ex, _logged)) return;
        _logged = ex;
        Logger.LogError(ex, "Game crashed inside GameShell; showing the retry box");
    }

    private void Retry()
    {
        _logged = null;
        _boundary?.Recover();
    }
}
