@namespace PoMiniGamesClient.Components
@using PoMiniGamesClient.Services
@implements IAsyncDisposable

@* ─────────────────────────────────────────────────────────────────────────
   The one end-of-game modal for every game in PoMiniGames.

   Centered, blocking, no backdrop-dismiss: the final result (GameSummary), the
   stats grid (Stats), this game's top 3 (fetched from GameKey) and one button, Back to
   main menu. There is no Play again: a player picks the game on the hub again.

   It is also the one end-of-game MOMENT. When it opens it plays the result for
   every game at once (GameOverMoment): the outcome cue, confetti on a win or a new
   best, the palette pulse, a short hitstop, a grey vignette on a loss. A climb or a
   new best then assembles the number out of a particle swarm. Games do not fire
   their own; the gates for reduced motion and the quality tier are in the JS.

   Most games get this for free by passing GameOver to <GameShell>, which renders
   this component. It is a standalone component rather than markup inside
   GameShell so games that legitimately can't host GameShell — one running its own
   layout and store, say — still end on the identical dialog instead of
   hand-rolling a lookalike. Styling lives in wwwroot/css/game-shell.css.
   ───────────────────────────────────────────────────────────────────────── *@

@* Option #9: native <dialog>. Replaces a custom <div role="dialog" aria-modal="true">
   wrapper. The native element gives us the top-layer rendering (no z-index fights
   with fx flashes, particles, or the toast stack), a built-in focus trap so Tab
   cycles inside the dialog instead of leaking to the canvas behind, Escape-to-close
   via the browser's native cancel event (the manual `@onkeydown` Escape branch is
   removed), and the `:backdrop` pseudo-element for the dim layer (the
   `.gps-modal-overlay` rule below now styles it instead of a real div).

   `dialog.showModal()` is called from JS after first render, then `close()` is
   called immediately before navigation so the page transition runs cleanly.
   `<form method="dialog">` is intentionally NOT used here — the button is a
   normal Blazor button that calls our Back() callback, because we need to
   navigate rather than use the dialog's native "close + submit" semantics. *@
@* data-glass: glassFx.js paints a blurred capture of the game's last frame under the card
   (game-shell.css keeps it faint; a DOM game with no canvas simply gets the plain card). *@
<dialog class="gps-modal @(Moment.Vignette ? "gps-modal--loss" : null)" aria-label="Game over" data-fx-tilt="5" data-glass @ref="_dialog" @oncancel="HandleCancel">
        <header class="gps-modal-header">
            <div class="gps-modal-title">@Title</div>
        </header>

        @if (GameSummary != null)
        {
            <div class="gps-game-summary">@GameSummary</div>
        }

        @if (Stats != null && Stats.Any())
        {
            <div class="gps-modal-stats">
                @for (var i = 0; i < Stats.Count; i++)
                {
                    var stat = Stats[i];
                    <div class="gps-stat">
                        @* The first cell is the one a new best assembles out of the swarm. *@
                        @if (i == 0)
                        {
                            <span class="gps-stat-value" @ref="_firstStatRef">@stat.Value</span>
                        }
                        else
                        {
                            <span class="gps-stat-value">@stat.Value</span>
                        }
                        <span class="gps-stat-label">@stat.Label</span>
                    </div>
                }
            </div>
        }

        @* Where the player actually stands. Silently absent when they have no row
           on this board yet — an end-of-game modal should never invent a rank. *@
        @if (_loading)
        {
            @* The board is a fetch that lands after the dialog opens. Until it does, a
               placeholder the same height as the rank line and the top 3 holds their place,
               so the card does not grow under the player's thumb and the buttons stay put. *@
            <div class="gps-modal-skeleton" aria-hidden="true">
                @if (!string.IsNullOrWhiteSpace(Player))
                {
                    <div class="gps-modal-rank"><span class="gps-modal-rank-pos gps-skel gps-skel--rank">&nbsp;</span></div>
                }
                <div class="gps-modal-board">
                    <div class="gps-modal-board-head"><span class="gps-modal-board-title gps-skel gps-skel--head">&nbsp;</span></div>
                    <ol class="gps-modal-board-rows">
                        @for (var r = 0; r < 3; r++)
                        {
                            <li class="gps-modal-board-row gps-skel-row"><span>&nbsp;</span><span class="gps-skel gps-skel--line">&nbsp;</span><span></span></li>
                        }
                    </ol>
                </div>
            </div>
        }
        else if (_myRank is int rank)
        {
            <div class="gps-modal-rank @(_delta > 0 ? "gps-modal-rank--up" : null)">
                <span class="gps-modal-rank-pos" @ref="_rankRef">#@rank</span>
                <span class="gps-modal-rank-of">of @BoardSizeLabel</span>
                @if (_delta > 0)
                {
                    <span class="gps-modal-rank-delta" title="@_delta places since your last game">▲@_delta</span>
                }
            </div>
        }

        @* Silently omitted when the game has no board (GameKey null / 404) or the
           API is offline — the modal still works, it just shows no top 3. *@
        @if (!_loading && _board is not null && _board.Entries.Count > 0)
        {
            <div class="gps-modal-board">
                <div class="gps-modal-board-head">
                    <span class="gps-modal-board-title">🏆 Top 3</span>
                    <span class="gps-modal-board-unit">@_board.Unit</span>
                </div>
                <ol class="gps-modal-board-rows">
                    @foreach (var e in _board.Entries)
                    {
                        <li class="gps-modal-board-row gps-modal-board-row--@e.Rank @(IsMe(e) ? "gps-modal-board-row--me" : null)">
                            <span class="gps-modal-board-rank">@e.Rank</span>
                            <span class="gps-modal-board-name">@LeaderboardNames.Pretty(e.Name)</span>
                            <span class="gps-modal-board-value">@e.DisplayValue</span>
                        </li>
                    }
                </ol>
            </div>
        }

        @* One way out, and only one: back to the main menu. Playing again means picking the
           game on the hub again. Focused on open, so Enter takes it; Escape is the dialog's
           cancel (HandleCancel). *@
        <footer class="gps-play-again-actions">
            <button type="button" class="app-btn app-btn--primary" data-end-action
                    @onclick="Back" autofocus>
                <span>Back to main menu</span>
                <kbd class="gps-kbd gps-kbd--primary">Esc</kbd>
            </button>
        </footer>
</dialog>

@code {
    /// <summary>Modal heading — normally the game's title.</summary>
    [Parameter] public RenderFragment? Title { get; set; }

    /// <summary>The result line(s): who won, the final score.</summary>
    [Parameter] public RenderFragment? GameSummary { get; set; }

    /// <summary>Optional value-over-label stat cells.</summary>
    [Parameter] public List<Models.StatItem>? Stats { get; set; }

    /// <summary>
    /// Catalog key for this game's unified leaderboard (e.g. "connectfive").
    /// Null for modes with no meaningful board (local 2-player, demo).
    /// </summary>
    [Parameter] public string? GameKey { get; set; }

    /// <summary>Player name, used to highlight their own row in the top 3.</summary>
    [Parameter] public string? Player { get; set; }

    /// <summary>
    /// How the match ended, so the modal can sound the right cue. Left
    /// <see cref="Models.GameResult.InProgress"/> by games that do not report it,
    /// which sounds a neutral round-over rather than guessing — celebrating a
    /// loss is worse than saying nothing.
    /// </summary>
    [Parameter] public Models.GameResult Outcome { get; set; } = Models.GameResult.InProgress;

    /// <summary>
    /// The game just saved a new personal best. Earns confetti whatever the result and
    /// assembles the first stat out of the particle swarm; saying so in words is the
    /// game's GameSummary. May turn true after the modal opened (a server save confirming
    /// the best); the celebration follows then.
    /// </summary>
    [Parameter] public bool NewBest { get; set; }

    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private Services.Http.ApiService Api { get; set; } = null!;
    [Inject] private Services.Ui.UiFeedbackService Feedback { get; set; } = null!;
    [Inject] private Services.Ui.ScreenFxService ScreenFx { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private Services.Ui.GameOverMoment Moment => Services.Ui.GameOverMoment.For(Outcome, NewBest);

    /// <summary>True from open until the board fetch settles, while the skeleton holds its place.</summary>
    private bool _loading;

    private ElementReference _rankRef;
    private ElementReference _firstStatRef;
    private bool _confettiFired;
    private bool _bestCelebrated;

    private GameLeaderboardDto? _board;

    /// <summary>The player's own rank on this board, when they have a row on it.</summary>
    private int? _myRank;

    /// <summary>How many ranked rows came back, for the "of N" denominator.</summary>
    private int _boardSize;

    /// <summary>
    /// The denominator, marked "100+" when the read filled the server's page.
    /// A full page means there may be more players below it, so printing a bare
    /// "of 100" would state a total we did not actually measure.
    /// </summary>
    private string BoardSizeLabel =>
        _boardSize >= RankSearchDepth ? $"{RankSearchDepth}+" : _boardSize.ToString();

    /// <summary>
    /// Places gained since the last time this player saw this board. Zero when
    /// they lost ground, held station, or have no previous rank recorded — the
    /// modal only ever celebrates an improvement, never rubs in a drop.
    /// </summary>
    private int _delta;

    /// <summary>Mirrors the server's padding sentinel (UnifiedLeaderboardEndpoints.PlaceholderName).</summary>
    private const string PlaceholderName = "XXX";

    /// <summary>
    /// How deep to look for the player's own row. The visible top 3 cannot rank
    /// anyone outside it, and one wider read is cheaper than a second
    /// round-trip. A player ranked below this gets no rank line, which is the
    /// same graceful nothing as being offline.
    /// </summary>
    /// <remarks>
    /// 100 is the server's ceiling, not a preference:
    /// <c>UnifiedLeaderboardEndpoints</c> does <c>Math.Clamp(limit, 1, 100)</c>,
    /// so asking for more is silently truncated and would make this constant a
    /// lie about how deep the search actually goes.
    /// </remarks>
    private const int RankSearchDepth = 100;

    /// <summary>
    /// Last seen rank per game, so the next game can show the delta.
    /// Deliberately local-only: this is a personal "am I climbing?" cue, not a
    /// leaderboard fact, and it must survive being signed out.
    /// </summary>
    private static string RankKey(string gameKey) => $"pomini_lastrank_{gameKey}";

    /// <summary>
    /// Open the dialog and play the end-of-game moment, once, on first render.
    /// </summary>
    /// <remarks>
    /// This runs in <c>OnAfterRenderAsync</c> rather than <c>OnInitializedAsync</c>
    /// deliberately: the leaderboard fetch below awaits the network, and a cue
    /// queued behind it would land seconds after the modal appeared — or never,
    /// offline. The result is on screen the moment this fires.
    ///
    /// Option #9: also opens the native <dialog> here. showModal() has to run
    /// after the dialog element exists in the DOM (not in OnInitialized, which
    /// fires before the render). Re-running it on every render would re-trigger
    /// the open animation each StateHasChanged, so we gate on firstRender.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_dialogOpened && _dialog.Id != default)
        {
            // ShowModal places the dialog in the top layer (above fx overlays,
            // toasts, the kiosk control bar) and traps focus inside it. The
            // dialog's native Escape handler fires the `cancel` event, which
            // we hook into in HandleCancel to map to our Back() callback.
            _dialogOpened = true;
            // Score count-up: started before the dialog opens, so the stats are already at
            // zero in its first painted frame instead of flashing their final values.
            try { await JS.InvokeVoidAsync("PoImpact.countUp", _dialog); } catch { /* feel layer missing: the numbers just show */ }
            await _dialog.ShowModalAsync(JS);
            // Confetti lands on the card instead of falling through it (high tier).
            await ScreenFx.CollideWithAsync(_dialog);
        }

        if (firstRender && !_outcomeCued)
        {
            _outcomeCued = true;
            await PlayMomentAsync();
        }

        // The rank arrives with the board, a render or two after the dialog: land it once.
        // A climb is assembled out of the swarm instead of popped.
        if (_myRank is int rank && !_rankLanded)
        {
            _rankLanded = true;
            if (_delta > 0) await CelebrateBestAsync(_rankRef, $"#{rank}");
            else
            {
                try { await JS.InvokeVoidAsync("PoImpact.popSelector", ".gps-modal-rank-pos"); } catch { /* same */ }
            }
        }

        // A new best, whenever the game confirms it.
        if (_dialogOpened && NewBest && !_bestCelebrated)
        {
            var hasStat = Stats is { Count: > 0 };
            await CelebrateBestAsync(hasStat ? _firstStatRef : default, hasStat ? Stats![0].Value : null);
        }
    }

    /// <summary>
    /// The result, played once for every game: the outcome cue in the game's own voice
    /// (sound only: the visuals are drawn here, so nothing doubles), its haptic, a short
    /// hitstop, the palette pulse and, on a win or a new best, confetti.
    /// </summary>
    private async Task PlayMomentAsync()
    {
        var moment = Moment;
        Feedback.MarkGameOverMoment();

        // GameKey is null in unranked modes (local 2-player, demo). "ui" is the
        // shared scope and defines every fallback name, so the modal still
        // sounds — it just does not carry the game's timbre.
        var scope = moment.SharedScope || string.IsNullOrEmpty(GameKey) ? "ui" : GameKey;
        await Feedback.CueFirstAsync(scope, moment.Cues, soundOnly: true);
        await Feedback.VibrateAsync(moment.Haptic);

        if (moment.HitstopMs > 0) await ScreenFx.HitstopAsync(moment.HitstopMs);
        if (moment.PaletteMood is { } mood) await ScreenFx.PulseAsync(mood);
        if (moment.Confetti && !_confettiFired)
        {
            _confettiFired = true;
            await ScreenFx.CelebrateAsync();
        }
    }

    /// <summary>
    /// A climb or a new best: the personal-best cue, confetti if the result did not already
    /// bring some, and the number assembled out of the WebGPU swarm (a plain modal wherever
    /// the swarm cannot run). Once per modal.
    /// </summary>
    private async Task CelebrateBestAsync(ElementReference target, string? text)
    {
        if (_bestCelebrated) return;
        _bestCelebrated = true;
        await Feedback.PersonalBestAsync();
        if (!_confettiFired)
        {
            _confettiFired = true;
            await ScreenFx.CelebrateAsync();
        }
        if (target.Id != default) await ScreenFx.AssembleAsync(target, text);
    }

    private bool _outcomeCued;
    private bool _rankLanded;

    // Option #9: ElementReference to the native <dialog> so OnAfterRenderAsync
    // can call showModal() and Back() can call close() before navigating. The
    // ref is captured after the first render and never re-fetched. C# value
    // types can't be null, so the comparison uses `_dialog.Id != default`
    // (ElementReference has an Id field for the underlying DOM node) rather
    // than `is not null`.
    private ElementReference _dialog;
    private bool _dialogOpened;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(GameKey)) return;

        _loading = true;
        try
        {
            await LoadBoardAsync(GameKey);
        }
        catch
        {
            // Offline or the API down: the modal still works, it just shows no top 3.
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadBoardAsync(string gameKey)
    {
        // One read serves both the top 3 and the rank lookup.
        var board = await Api.GetGameLeaderboardAsync(gameKey, limit: RankSearchDepth);
        if (board is null) return;

        // Drop the server's "XXX" padding rows — an end-of-game modal should show
        // the real top 3 or nothing, not filler. Padding rows must also not count
        // toward the "of N" denominator, or a near-empty board claims 10 players.
        var ranked = board.Entries.Where(e => e.Name != PlaceholderName).ToList();
        _boardSize = ranked.Count;

        ResolveMyRank(ranked);

        // The board the modal renders is only ever the top 3. A climb is celebrated in
        // OnAfterRenderAsync, so it lands with the rank appearing on screen.
        _board = board with { Entries = ranked.Take(3).ToList() };
    }

    /// <summary>
    /// Find the player's row, then diff against their last recorded rank.
    /// </summary>
    /// <remarks>
    /// Name matching is all that is available here: <c>LeaderboardEntryDto</c>
    /// carries no user id (unlike the raw per-game boards the profile page
    /// reads). That means a player sharing a display name with someone else on
    /// the same board can be shown the wrong row — accepted, because the
    /// alternative is no rank line at all, and the unified DTO would have to
    /// grow a field to do better.
    /// </remarks>
    private void ResolveMyRank(List<LeaderboardEntryDto> ranked)
    {
        if (string.IsNullOrWhiteSpace(Player)) return;

        var mine = ranked.FirstOrDefault(e => e.Name.Equals(Player, StringComparison.OrdinalIgnoreCase));
        if (mine is null) return;

        _myRank = mine.Rank;

        try
        {
            var key = RankKey(GameKey!);
            var previous = Services.Play.LocalStorageService.GetItem<string>(key);
            // A smaller rank number is a better position, so the gain is
            // previous - current.
            if (int.TryParse(previous, out var prev) && prev > mine.Rank)
            {
                _delta = prev - mine.Rank;
            }
            Services.Play.LocalStorageService.SetItem(key, mine.Rank.ToString());
        }
        catch
        {
            // Storage unavailable (private mode) — the rank still shows, just
            // without a delta.
        }
    }

    private bool IsMe(LeaderboardEntryDto e) =>
        !string.IsNullOrEmpty(Player) && string.Equals(e.Name, Player, StringComparison.OrdinalIgnoreCase);

    /// <summary>The modal's one action: back to the main menu.</summary>
    private async Task Back()
    {
        // Option #9: close the native dialog before navigating. The dialog
        // sits in the top layer; if we navigate while it's still open, the
        // destination route mounts while the previous frame's modal is still
        // visible on top, and the user sees a frozen dialog over the new page
        // for the duration of the transition. close() fires the native `close`
        // event (no callback for it here — we just want the modal gone), then
        // we navigate home.
        if (_dialogOpened)
        {
            try { await _dialog.CloseAsync(JS); } catch { /* already closed */ }
        }
        Navigation.NavigateTo("/");
    }

    /// <summary>
    /// Maps the native <c>cancel</c> event (fires when the user presses
    /// Escape with the dialog open) to our <see cref="Back"/> flow.
    /// Without this, Escape would only close the dialog and leave the page
    /// in an inconsistent "modal is gone, game is over" state. We let the
    /// default action run first (the dialog closes itself) by not calling
    /// <c>event.preventDefault</c>, then we kick off navigation.
    /// </summary>
    private async Task HandleCancel(System.EventArgs e)
        => await Back();

    public async ValueTask DisposeAsync()
    {
        // Nothing left on screen to land on.
        await ScreenFx.CollideWithAsync();
    }
}
