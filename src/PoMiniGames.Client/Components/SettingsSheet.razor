@namespace PoMiniGamesClient.Components
@inject SettingsService Settings
@inject InviteService Invites
@inject AuthStateService AuthState
@inject UiFeedbackService Feedback
@inject IJSRuntime JS
@implements IDisposable

@* ─────────────────────────────────────────────────────────────────────────
   The one settings sheet: theme, sound, haptics, motion, colour-blind palettes,
   per-game choices, game invites and the account's data (export / erase), for every
   game at once.

   It is a <dialog>, not a page: a drawer on the right edge on a wide window, a bottom
   sheet on a phone. There is no gear in the top bar; the sheet opens through
   SettingsService.RequestOpen(), from the account menu and from a game's own settings
   panel (PoCabinet's pause menu, PoEcosystem's dashboard). Opened from inside one of
   those, the layer under it is put away until the sheet closes, so only one modal is
   ever up (DialogExtensions.ShowModalAloneAsync).

   What a game does with these: sound is the shared audio bus, so mute and
   volume reach every engine. Motion and colour ride <html data-motion> and
   <html data-colorsafe>, which the engines read on top of their own settings —
   either source turns the calmer/safer option on. Key bindings and gamepad
   stay in each game's own panel; they are different keys per game.

   Rendered once, in MainLayout. Each fieldset is announced by its legend.
   ───────────────────────────────────────────────────────────────────────── *@

<dialog @ref="_dialog" class="prefs-sheet" closedby="any" aria-labelledby="prefs-sheet-title">
    <header class="prefs-sheet-head">
        <h2 id="prefs-sheet-title" class="prefs-sheet-title">Settings</h2>
        <button type="button" class="prefs-sheet-close" aria-label="Close settings" @onclick="CloseAsync">×</button>
    </header>

    <div class="prefs-grid">
        <fieldset class="prefs-group">
            <legend class="prefs-group-legend">Look</legend>
            <div class="prefs-row">
                <div class="prefs-label">
                    <span class="prefs-name">Theme</span>
                    <span class="prefs-hint">Auto follows your device setting.</span>
                </div>
                <div class="app-seg" role="radiogroup" aria-label="Theme">
                    @foreach (var mode in ThemeModes)
                    {
                        <button type="button"
                                role="radio"
                                class="app-seg__btn"
                                aria-checked="@Aria(Settings.Theme == mode)"
                                @onclick="() => SetTheme(mode)">
                            @ThemeLabel(mode)
                        </button>
                    }
                </div>
            </div>

            <div class="prefs-row">
                <div class="prefs-label">
                    <span class="prefs-name">Graphics</span>
                    <span class="prefs-hint">Auto picks for your device. Lower is smoother on a slow one.</span>
                </div>
                <div class="app-seg" role="radiogroup" aria-label="Graphics quality">
                    @foreach (var tier in SettingsService.GraphicsTiers)
                    {
                        <button type="button"
                                role="radio"
                                class="app-seg__btn"
                                aria-checked="@Aria(Settings.Graphics == tier)"
                                @onclick="() => SetGraphics(tier)">
                            @GraphicsLabel(tier)
                        </button>
                    }
                </div>
            </div>
        </fieldset>

        <fieldset class="prefs-group">
            <legend class="prefs-group-legend">Sound &amp; feel</legend>
            <div class="prefs-row">
                <div class="prefs-label">
                    <span class="prefs-name">Sound</span>
                    <span class="prefs-hint">Effects and menu sounds in every game.</span>
                </div>
                <button type="button"
                        class="prefs-toggle @(Settings.Muted ? null : "prefs-toggle--on")"
                        role="switch"
                        aria-checked="@Aria(!Settings.Muted)"
                        aria-label="Sound"
                        @onclick="ToggleMuted">
                    <span class="prefs-toggle-knob"></span>
                </button>
            </div>

            <div class="prefs-row @(Settings.Muted ? "prefs-row--disabled" : null)">
                <div class="prefs-label">
                    <span class="prefs-name">Volume</span>
                    <span class="prefs-hint">@Settings.Volume%</span>
                </div>
                @* Bound on oninput so the level tracks the drag. audioBus ramps the
                   gain node, so a per-pixel update neither clicks nor thrashes. *@
                <input type="range" class="prefs-range"
                       min="0" max="100" step="5"
                       aria-label="Volume"
                       disabled="@Settings.Muted"
                       value="@Settings.Volume"
                       @oninput="OnVolumeInput" />
            </div>

            <div class="prefs-row @(Settings.Muted ? "prefs-row--disabled" : null)">
                <div class="prefs-label">
                    <span class="prefs-name">Effects</span>
                    <span class="prefs-hint">@Settings.SfxVolume%</span>
                </div>
                <input type="range" class="prefs-range"
                       min="0" max="100" step="5"
                       aria-label="Effects volume"
                       disabled="@Settings.Muted"
                       value="@Settings.SfxVolume"
                       @oninput="OnSfxVolumeInput" />
            </div>

            <div class="prefs-row @(Settings.Muted ? "prefs-row--disabled" : null)">
                <div class="prefs-label">
                    <span class="prefs-name">Music</span>
                    <span class="prefs-hint">@(Settings.MusicVolume == 0 ? "Off" : $"{Settings.MusicVolume}%") · adaptive music in PoRacer and PoBrawl</span>
                </div>
                <input type="range" class="prefs-range"
                       min="0" max="100" step="5"
                       aria-label="Music volume"
                       disabled="@Settings.Muted"
                       value="@Settings.MusicVolume"
                       @oninput="OnMusicVolumeInput" />
            </div>

            <div class="prefs-row">
                <div class="prefs-label">
                    <span class="prefs-name">Haptics</span>
                    <span class="prefs-hint">Vibration on phones and controllers that have it.</span>
                </div>
                <button type="button"
                        class="prefs-toggle @(Settings.Haptics ? "prefs-toggle--on" : null)"
                        role="switch"
                        aria-checked="@Aria(Settings.Haptics)"
                        aria-label="Haptics"
                        @onclick="ToggleHaptics">
                    <span class="prefs-toggle-knob"></span>
                </button>
            </div>
        </fieldset>

        <fieldset class="prefs-group">
            <legend class="prefs-group-legend">Accessibility</legend>
            <div class="prefs-row">
                <div class="prefs-label">
                    <span class="prefs-name">Reduce motion</span>
                    <span class="prefs-hint">
                        @if (_osReducedMotion)
                        {
                            @:Your device already asks for reduced motion.
                        }
                        else
                        {
                            @:Less shake, flash and animation, in menus and in games.
                        }
                    </span>
                </div>
                <button type="button"
                        class="prefs-toggle @(Settings.ReducedMotion ? "prefs-toggle--on" : null)"
                        role="switch"
                        aria-checked="@Aria(Settings.ReducedMotion)"
                        aria-label="Reduce motion"
                        @onclick="ToggleReducedMotion">
                    <span class="prefs-toggle-knob"></span>
                </button>
            </div>

            <div class="prefs-row">
                <div class="prefs-label">
                    <span class="prefs-name">Colour-blind safe colours</span>
                    <span class="prefs-hint">Used by PoEcosystem's charts and Cabinet's minimap.</span>
                </div>
                <button type="button"
                        class="prefs-toggle @(Settings.ColorSafe ? "prefs-toggle--on" : null)"
                        role="switch"
                        aria-checked="@Aria(Settings.ColorSafe)"
                        aria-label="Colour-blind safe colours"
                        @onclick="ToggleColorSafe">
                    <span class="prefs-toggle-knob"></span>
                </button>
            </div>
        </fieldset>

        @* Games: one row per game-wide choice most players care about (which questions a
           quiz draws, how answers are matched, invites). Add a row here with a simple
           default, so a player who never opens the sheet still gets a sensible game.
           Rows from a child component keep the prefs-row classes; the sheet styles them.
           Choices that only matter to one game's enthusiasts go under Advanced below. *@
        <fieldset class="prefs-group prefs-group--games">
            <legend class="prefs-group-legend">Games</legend>
            <QuizPrefsRows />
            <div class="prefs-row @(InvitesAvailable ? null : "prefs-row--disabled")">
                <div class="prefs-label">
                    <span class="prefs-name">Game invites</span>
                    <span class="prefs-hint">@InviteHint</span>
                </div>
                <button type="button"
                        class="prefs-toggle @(_invites == InviteState.On ? "prefs-toggle--on" : null)"
                        role="switch"
                        aria-checked="@Aria(_invites == InviteState.On)"
                        aria-label="Game invites on this device"
                        disabled="@(!InvitesAvailable || _invitesBusy)"
                        @onclick="ToggleInvites">
                    <span class="prefs-toggle-knob"></span>
                </button>
            </div>
        </fieldset>

        @* Advanced: the niche, one-game choices, collapsed by default so the sheet opens on
           the settings everyone uses. A native <details>, so it needs no state of its own and
           the summary is a real disclosure button for keyboards and screen readers. The rows
           stay mounted while it is shut, so each one still reads its value when the sheet
           opens. Holds Brawl's show level (pobrawl_show). The FPS badge has no
           preference to put here: it is the Development / ?debug=1 diagnostic. *@
        <details class="prefs-advanced">
            <summary class="prefs-advanced-summary">Advanced</summary>
            <fieldset class="prefs-group prefs-group--advanced">
                <legend class="prefs-group-legend">Advanced game options</legend>
                <PoMiniGamesClient.Games.PoBrawl.PoBrawlShowPrefs />
            </fieldset>
        </details>

        <fieldset class="prefs-group">
            <legend class="prefs-group-legend">Your data</legend>
            <AccountDataCard />
        </fieldset>
    </div>
</dialog>

@code {
    /// <summary>
    /// Renders a bool as the literal string ARIA requires. Blazor treats a bool-valued
    /// attribute as an HTML boolean attribute (present/absent), which is not a valid ARIA
    /// state — never inline a bare bool into an aria-* attribute.
    /// </summary>
    private static string Aria(bool value) => value ? "true" : "false";

    private static readonly ThemeMode[] ThemeModes = [ThemeMode.Auto, ThemeMode.Light, ThemeMode.Dark];

    private ElementReference _dialog;
    private bool _osReducedMotion;
    private InviteState _invites = InviteState.Unsupported;
    private bool _invitesBusy;
    private bool _inviteFailed;

    private bool InvitesAvailable =>
        AuthState.IsAuthenticated && _invites is InviteState.On or InviteState.Off;

    private string InviteHint => _invites switch
    {
        _ when !AuthState.IsAuthenticated => "Sign in to be invited by players you have met.",
        InviteState.Unsupported => "This browser cannot show invites. On an iPhone, add the app to your Home Screen first.",
        InviteState.Denied => "Notifications are blocked for this site in your browser settings.",
        _ when _inviteFailed => "Could not turn invites on. Try again in a moment.",
        InviteState.On => "Players you have met online can invite you to a lobby.",
        _ => "Get a notification when a player you have met invites you to a lobby.",
    };

    private static string ThemeLabel(ThemeMode mode) => mode switch
    {
        ThemeMode.Light => "Light",
        ThemeMode.Dark => "Dark",
        _ => "Auto",
    };

    protected override void OnInitialized()
    {
        Settings.Changed += OnSettingsChanged;
        Settings.OpenRequested += OnOpenRequested;
    }

    private void OnSettingsChanged() => InvokeAsync(StateHasChanged);

    private void OnOpenRequested() => InvokeAsync(OpenAsync);

    private async Task OpenAsync()
    {
        // Asked on open rather than on mount: both answers can change while the app is running
        // (a permission revoked in the browser, the OS switching motion), and neither is worth
        // an interop call on every page that never opens the sheet.
        _osReducedMotion = await Settings.OsPrefersReducedMotionAsync();
        _invites = await Invites.StateAsync();
        _inviteFailed = false;
        StateHasChanged();
        await _dialog.ShowModalAloneAsync(JS);
        // After the sheet is up, so a slow API never delays it. See InviteService.PrepareAsync.
        if (InvitesAvailable) await Invites.PrepareAsync();
    }

    private async Task CloseAsync() => await _dialog.CloseAsync(JS);

    public void Dispose()
    {
        Settings.Changed -= OnSettingsChanged;
        Settings.OpenRequested -= OnOpenRequested;
    }

    private async Task SetTheme(ThemeMode mode)
    {
        if (Settings.Theme == mode) return;
        await Settings.SetThemeAsync(mode);
        await Feedback.ClickAsync();
    }

    private static string GraphicsLabel(string tier) => tier switch
    {
        "low" => "Low",
        "medium" => "Med",
        "high" => "High",
        _ => "Auto",
    };

    private async Task SetGraphics(string tier)
    {
        if (Settings.Graphics == tier) return;
        await Settings.SetGraphicsAsync(tier);
        await Feedback.ClickAsync();
    }

    // Audio feedback fires only when turning sound ON — playing a confirmation
    // tone as the user mutes would be the one cue they just asked not to hear.
    private async Task ToggleMuted()
    {
        var nowMuted = !Settings.Muted;
        await Settings.SetMutedAsync(nowMuted);
        if (!nowMuted) await Feedback.ClickAsync();
    }

    private async Task OnVolumeInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var pct))
        {
            await Settings.SetVolumeAsync(pct);
        }
    }

    private async Task OnSfxVolumeInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var pct)) await Settings.SetSfxVolumeAsync(pct);
    }

    private async Task OnMusicVolumeInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var pct)) await Settings.SetMusicVolumeAsync(pct);
    }

    // Fire the haptic *after* enabling so the user feels the setting they just
    // turned on; skip it when disabling, for the same reason as mute above.
    private async Task ToggleHaptics()
    {
        var enabled = !Settings.Haptics;
        await Settings.SetHapticsAsync(enabled);
        if (enabled) await Feedback.TapAsync();
    }

    private async Task ToggleReducedMotion()
    {
        await Settings.SetReducedMotionAsync(!Settings.ReducedMotion);
        await Feedback.ClickAsync();
    }

    private async Task ToggleColorSafe()
    {
        await Settings.SetColorSafeAsync(!Settings.ColorSafe);
        await Feedback.ClickAsync();
    }

    private async Task ToggleInvites()
    {
        if (_invitesBusy) return;
        _invitesBusy = true;
        _inviteFailed = false;
        try
        {
            if (_invites == InviteState.On)
            {
                await Invites.DisableAsync();
            }
            else
            {
                _inviteFailed = !await Invites.EnableAsync();
            }
            _invites = await Invites.StateAsync();
            // Declining the prompt lands on Denied or Off with nothing wrong; only an Off
            // after an attempt that was not declined is worth calling a failure.
            if (_invites != InviteState.Off) _inviteFailed = false;
        }
        finally
        {
            _invitesBusy = false;
        }
    }
}
