{
  "KeyVault": {
    "Uri": "https://kv-poshared2.vault.azure.net/"
  },
  "Auth": {
    "EnableFakeAuth": true,
    "AutoGuestLogin": false
  },
  "PoMiniGames": {
    "ApplicationInsights": {
      "ConnectionString": ""
    },
    "MicrosoftAuth": {
      "_comment": "Dev surface: both Guest dev-bypass AND Microsoft OAuth are available. Put ClientId/ApiClientId in this file (local only, do not commit them) or in Key Vault; this repo does not use 'dotnet user-secrets'. When they are present, sign-in completes against your Entra app registration. Until then the Microsoft button is visible but the call returns a friendly 'configure ClientId' message.",
      "Authority": "https://login.microsoftonline.com/common/v2.0",
      "ClientId": "",
      "ApiClientId": "",
      "Scope": "api://<your-api-client-id>/access_as_user",
      "RedirectPath": "/auth/callback",
      "Enabled": true,
      "AllowedTenantIds": []
    },
    "Storage": {
      "TableService": {
        "ConnectionString": "UseDevelopmentStorage=true",
        "Endpoint": "",
        "AccountName": "",
        "TableName": "pominigames"
      }
    }
  },
  "FeatureFlags": {
    "EnableDiagnostics": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
