<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TFM / Nullable / ImplicitUsings inherited from Directory.Build.props -->
    <IsPackable>false</IsPackable>
    <!-- Project name == assembly name == root namespace, matching the
         <sln>.<Tier> convention (PoMiniGames.Unit / .Integration / .E2EAPI / .E2EUI). -->
    <AssemblyName>PoMiniGames.Unit</AssemblyName>
    <RootNamespace>PoMiniGames.Unit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Verify.Xunit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PoMiniGames.Api\PoMiniGames.Api.csproj" />
    <ProjectReference Include="..\..\src\PoMiniGames.Client\PoMiniGames.Client.csproj" />
    <!-- TierCeilingGuard (the 100/50/25/25 assertion, shared by all four tiers). -->
  </ItemGroup>

  <ItemGroup>
    <!-- The per-game voice manifests (VoiceManifestTests): copied next to the tests, so no path to the repo is assumed. -->
    <None Include="..\..\src\PoMiniGames.Client\wwwroot\audio\pobrawl\voices.json" Link="VoiceManifests\pobrawl\voices.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PoMiniGames.Client\wwwroot\audio\pofighter\voices.json" Link="VoiceManifests\pofighter\voices.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>