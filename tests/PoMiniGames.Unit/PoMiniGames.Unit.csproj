<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TFM / Nullable / ImplicitUsings inherited from Directory.Build.props -->
    <IsPackable>false</IsPackable>
    <!-- Project name == assembly name == root namespace, matching the
         <sln>.<Tier> convention (PoMiniGames.Unit / .Integration / .E2EAPI / .E2EUI). -->
    <AssemblyName>PoMiniGames.Unit</AssemblyName>
    <RootNamespace>PoMiniGames.Unit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Verify.Xunit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PoMiniGames.Api\PoMiniGames.Api.csproj" />
    <ProjectReference Include="..\..\src\PoMiniGames.Client\PoMiniGames.Client.csproj" />
    <!-- TierCeilingGuard (the 100/50/25/25 assertion, shared by all four tiers). -->
    <ProjectReference Include="..\Shared\PoMiniGames.TestUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The PoBrawl rollback sim contract, shared with tests/pobrawl-rollback.test.mjs. -->
    <None Include="..\pobrawl-rollback-golden.json" Link="pobrawl-rollback-golden.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>